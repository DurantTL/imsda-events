{
  "name": "imsda-events",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:public-capacity": "tsx scripts/verify-public-registration-capacity.ts",
    "test:public-access": "tsx scripts/verify-public-registration-access.ts",
    "test:public-messaging": "tsx scripts/verify-public-registration-messaging.ts",
    "test:public-roster": "tsx scripts/verify-public-registration-roster.ts",
    "test:honor-capacity": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-honor-class-capacity.ts",
    "test:staff-act-as": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-staff-act-as.ts",
    "test:club-transfers": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-club-member-transfers.ts",
    "test:background-check-list": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-background-check-list.ts",
    "test:club-supplies": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-club-supply-catalog.ts",
    "test:club-imports": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-club-imports.ts",
    "test:club-orders": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-club-order-fulfillment.ts",
    "test:uniform-orders": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-uniform-orders.ts",
    "test:earned-awards": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-earned-awards.ts",
    "test:honor-entry-void": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-honor-entry-void.ts",
    "test:event-templates": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-event-templates.ts",
    "test:church-promo-codes": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-church-promo-codes.ts",
    "test:honor-sites": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-honor-sites.ts",
    "test:event-locations": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-event-locations.ts",
    "test:club-forms": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-club-forms.ts",
    "test:location-waitlist": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-location-waitlist.ts",
    "test:event-cloning": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-event-cloning.ts",
    "test:form-revisions": "tsx --require ./scripts/support/allow-server-only.cjs scripts/verify-form-revisions.ts",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:refresh-demo": "tsx scripts/refresh-local-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-mfa": "tsx scripts/reset-mfa.ts",
    "registrations:cleanup": "tsx scripts/cleanup-imported-duplicates.ts",
    "event:readiness": "tsx scripts/event-readiness.ts",
    "payments:reconcile": "tsx scripts/payments-reconcile.ts",
    "payments:match-audit": "tsx scripts/square-match-audit.ts",
    "event:shirt-sizes": "tsx scripts/shirt-size-audience.ts",
    "attendee-types:backfill": "tsx scripts/backfill-attendee-types.ts",
    "household-membership:backfill": "tsx scripts/backfill-household-membership-effective-dates.ts",
    "event-audience:backfill": "tsx --require ./scripts/support/allow-server-only.cjs scripts/backfill-event-audience.ts",
    "issue:from-spec": "tsx scripts/spec-to-issue.ts",
    "background-checks:migration-dry-run": "tsx scripts/background-check-migration-dry-run.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "nanoid": "^3.3.18"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@lexical/extension": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/markdown": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "leaflet": "^1.9.4",
    "lexical": "0.49.0",
    "lucide-react": "^1.25.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "svix": "^1.99.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
