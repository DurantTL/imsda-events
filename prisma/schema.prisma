  CLUB
}

/// A person's authority over one club (#354, #375). DEPUTY carries the same
/// club access as DIRECTOR. REGISTRAR keeps the roster and registers for
/// events but sees ages, never full birth dates. REPORTER submits monthly
/// reports only. Order matters: the first role listed wins when one person
/// holds two.
enum ClubDirectorRole {
  DIRECTOR
  DEPUTY
  REGISTRAR
  REPORTER
}

/// Pathfinder class level on a club roster (#375). No level is stored as null.
enum ClubClassLevel {
  FRIEND
  COMPANION
  EXPLORER
  RANGER
  VOYAGER
  GUIDE
  TLT
  MASTER_GUIDE
}

enum ExternalSystem {
  EADVENTIST
  ULTRACAMP
  STERLING
  CMMS
  WR26
  /// The old website's Fluent Forms entries (#376). Scope is `form-<id>:<club year>`.
  FLUENT_FORMS
}

/// How an account-to-person link was established. Recorded on the link
/// itself so the link's provenance survives independently of whoever reads
/// it later — see `AttendeeAccountPersonLink` and `UserPersonLink`.
enum PersonLinkProvenance {
  /// The account holder verified their own identity (e.g. matched and
  /// confirmed a prefilled record) without staff involvement.
  SELF_SERVICE_VERIFICATION
  /// A staff member established the link directly.
  STAFF_ACTION
  /// The link was produced by a data import.
  IMPORT
}

