  ACTIVE
}

enum MfaChallengeKind {
  SIGN_IN
}

/// A registrant's own account, which is not staff. Deliberately a separate type
/// from `UserAccountStatus`: the two populations never share a status value, so
/// a query cannot accidentally treat one as the other (ADR 0003).
enum AttendeeAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
}

enum AttendeeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// What a freshly emailed code is being spent on. Only registration edits need
/// one today; the enum exists so adding the next reason is not a migration.
enum AttendeeStepUpPurpose {
  REGISTRATION_EDIT
}

enum AttendeeEditPolicy {
  TIERED
  VERIFY_EVERY_EDIT
}

enum AttendeeIdentityProvider {
  GOOGLE
}

