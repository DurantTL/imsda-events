  formVersion  RegistrationFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  registration Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([formVersionId, idempotencyKey])
  @@index([eventId, createdAt])
  @@index([formVersionId, createdAt])
}

model RegistrationCapacityReservation {
  id                     String    @id @default(cuid())
  eventId                String
  formId                 String
  formVersionId          String
  registrationId         String
  registrationAttendeeId String?
  participantKey         String    @default("registration")
  fieldId                String
  fieldKey               String
  optionValue            String
  rank                   Int?
  releasedAt             DateTime?
  createdAt              DateTime  @default(now())

  event                Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  form                 RegistrationForm        @relation(fields: [formId], references: [id], onDelete: Restrict)
  formVersion          RegistrationFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  registration         Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationAttendee RegistrationAttendee?   @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)

  @@unique([registrationId, participantKey, fieldId, optionValue], map: "RegistrationCapacityReservation_scoped_choice_key")
  @@index([registrationAttendeeId])
  @@index([formId, fieldId, optionValue, releasedAt])
  @@index([eventId, createdAt])
}

model EventPaymentInstructionVersion {
  id              String   @id @default(cuid())
  eventId         String
  versionNumber   Int
  instructions    String?
  approvedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("PaymentInstructionVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, versionNumber])
  @@index([eventId, createdAt])
}

model EventMessageSettings {
  id                         String              @id @default(cuid())
  eventId                    String              @unique
  deliveryMode               MessageDeliveryMode @default(LOCAL_CAPTURE)
  senderName                 String
  senderEmail                String?
  replyToEmail               String?
  internalNotificationEmails Json                @default("[]")
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventMessageTemplate {
  id        String             @id @default(cuid())
  eventId   String
  key       MessageTemplateKey
  isEnabled Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  event    Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions MessageTemplateVersion[]

  @@unique([eventId, key])
  @@index([eventId, updatedAt])
}

model MessageTemplateVersion {
  id              String                @id @default(cuid())
  templateId      String
  createdByUserId String?
  versionNumber   Int
  status          MessageTemplateStatus @default(DRAFT)
  subjectTemplate String
  bodyTemplate    String
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  template  EventMessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("MessageTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages  MessageOutbox[]

  @@unique([templateId, versionNumber])
  @@index([templateId, status, versionNumber])
}

model MessageOutbox {
  id                     String                         @id @default(cuid())
  // Null for account email — activation and password reset belong to a person,
  // not to an event, and must be deliverable before any event exists.
  eventId                String?
  registrationId         String?
  // Set only on account email. The delivery step mints the one-time link from
  // this, so the raw token is never written to the outbox.
  accountUserId          String?
  // The attendee equivalent. Exclusive with `accountUserId`: a message belongs
  // to one population or the other, never both.
  accountAttendeeId      String?
  templateVersionId      String?
  templateKey            MessageTemplateKey
  recipientKind          MessageRecipientKind
  recipientEmail         String
  recipientName          String?
  senderNameSnapshot     String
  senderEmailSnapshot    String?
  replyToEmailSnapshot   String?
  subjectSnapshot        String
  bodyTextSnapshot       String
  /// The formatted body, rendered from the same template and context as
  /// `bodyTextSnapshot` in the same call. Null for rows queued before HTML
  /// bodies existed; those are delivered as text only, because the untrusted
  /// spans a safe HTML render depends on cannot be recovered from the text.
  bodyHtmlSnapshot       String?
  metadata               Json?
  idempotencyKey         String                         @unique
  correlationId          String
  status                 MessageOutboxStatus            @default(PENDING)
  availableAt            DateTime                       @default(now())
  lockedAt               DateTime?
  lockToken              String?
  attemptCount           Int                            @default(0)
  capturedAt             DateTime?
  sentAt                 DateTime?
  provider               String?
  providerMessageId      String?                        @unique
  providerDeliveryStatus MessageProviderDeliveryStatus?
  providerStatusAt       DateTime?
  deliveredAt            DateTime?
  failedAt               DateTime?
  lastError              String?
  retryOfMessageId       String?
  /// One file sent with the message (#168: an invoice PDF), stored once in `MessageAttachment` and shared by every
  /// message that carries it, so a resend attaches the very same bytes.
  attachmentId           String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  attachment      MessageAttachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  event           Event?                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration    Registration?            @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  accountUser     User?                    @relation("AccountMessageRecipient", fields: [accountUserId], references: [id], onDelete: Cascade)
  accountAttendee AttendeeAccount?         @relation("AttendeeMessageRecipient", fields: [accountAttendeeId], references: [id], onDelete: Cascade)
  templateVersion MessageTemplateVersion?  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  retryOf         MessageOutbox?           @relation("MessageRetry", fields: [retryOfMessageId], references: [id], onDelete: SetNull)
  retries         MessageOutbox[]          @relation("MessageRetry")
  attempts        MessageDeliveryAttempt[]
  providerEvents  MessageProviderEvent[]
  invoiceRecipients InvoiceDeliveryRecipient[]

  @@index([status, availableAt, createdAt])
  @@index([eventId, createdAt])
  @@index([registrationId, createdAt])
  @@index([accountUserId, createdAt])
  @@index([accountAttendeeId, createdAt])
  @@index([retryOfMessageId])
  @@index([attachmentId])
  @@index([provider, providerDeliveryStatus, providerStatusAt])
}

/// A file attached to outbox messages (#168), stored once and immutable (database trigger); `sha256` is the hash of
/// `content` (a check constraint keeps them equal). Never publicly addressable: it is read only by the delivery
/// worker and by staff routes that check the event permission.
model MessageAttachment {
  id          String   @id @default(cuid())
  eventId     String?
  filename    String
  contentType String
  sizeBytes   Int
  sha256      String
  content     Bytes
  createdAt   DateTime @default(now())

  event           Event?                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages        MessageOutbox[]
  invoiceDocument InvoiceVersionDocument?

  @@index([eventId])
}

model MessageDeliveryAttempt {
  id                String               @id @default(cuid())
  messageOutboxId   String
  attemptNumber     Int
  provider          String
  status            MessageAttemptStatus
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  providerMetadata  Json?
  startedAt         DateTime             @default(now())
  completedAt       DateTime?

  message MessageOutbox @relation(fields: [messageOutboxId], references: [id], onDelete: Cascade)

  @@unique([messageOutboxId, attemptNumber])
  @@index([status, startedAt])
}

model MessageProviderEvent {
  id                   String                         @id @default(cuid())
  messageOutboxId      String?
  provider             String
  providerEventId      String
  providerMessageId    String
  eventType            String
  mappedDeliveryStatus MessageProviderDeliveryStatus?
  occurredAt           DateTime
  payload              Json
  receivedAt           DateTime                       @default(now())

  message MessageOutbox? @relation(fields: [messageOutboxId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([provider, providerMessageId, occurredAt])
  @@index([messageOutboxId, occurredAt])
}

model ProgramAssignmentRun {
  id                     String   @id @default(cuid())
  eventId                String
  formId                 String
  formVersionId          String
  fieldId                String
  fieldKeySnapshot       String
  fieldLabelSnapshot     String
  formNameSnapshot       String
  formVersionNumber      Int
  optionsSnapshot        Json
  limitsSnapshot         Json
  summarySnapshot        Json
  sourceFingerprint      String
  sourceParticipantCount Int
  clientRequestId        String
  appliedByUserId        String?
  appliedByNameSnapshot  String
  supersedesRunId        String?
  invalidatedAt          DateTime?
  appliedAt              DateTime @default(now())
  createdAt              DateTime @default(now())

  event        Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  form         RegistrationForm            @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion  RegistrationFormVersion     @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  appliedBy    User?                       @relation("ProgramAssignmentAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  supersedes   ProgramAssignmentRun?       @relation("ProgramAssignmentSupersession", fields: [supersedesRunId], references: [id], onDelete: SetNull)
  supersededBy ProgramAssignmentRun[]      @relation("ProgramAssignmentSupersession")
  assignments  ProgramAttendeeAssignment[]

  @@unique([eventId, clientRequestId])
  @@index([eventId, formVersionId, fieldId, invalidatedAt, appliedAt])
  @@index([supersedesRunId])
}

model ProgramAttendeeAssignment {
  id                       String                   @id @default(cuid())
  runId                    String
  attendeeIdSnapshot       String
  registrationIdSnapshot   String
  confirmationCodeSnapshot String
  registrationSubmittedAt  DateTime?
  attendeePositionSnapshot Int
  stableOrder              Int
  firstNameSnapshot        String
  lastNameSnapshot         String
  attendeeTypeSnapshot     String
  preferencesSnapshot      Json
  optionValue              String?
  preferenceRank           Int?
  outcome                  ProgramAssignmentOutcome
  unassignedReason         ProgramUnassignedReason?
  createdAt                DateTime                 @default(now())

  run ProgramAssignmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, attendeeIdSnapshot])
  @@index([runId, optionValue, stableOrder])
  @@index([runId, outcome, stableOrder])
}

/// Staff-maintained catalog of Pathfinder/Adventurer honors (#357). Global,
/// not per event, so every Honors Weekend site offers from the same list.
model Honor {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  normalizedName String
  description    String         @default("")
  isActive       Boolean        @default(true)
  /// The AdventSource catalog number for this honor's patch (#531), kept as
  /// a string so leading zeros survive. Every "X - Advanced" honor shares
  /// 007400 (the Advanced Honor Star), so this is never unique.
  catalogNumber  String?
  /// The General Conference honor category (#531).
  category       HonorCategory?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  offerings       HonorOffering[]
  memberEntries   MemberHonorEntry[]
  clubSupplyItems ClubSupplyItem[]
  masterAwardGroupHonors MasterAwardRuleGroupHonor[]

  @@index([isActive, name])
  @@index([normalizedName])
  @@index([category])
}

/// The General Conference honor categories (#531), plus Master Awards.
enum HonorCategory {
  NATURE
  HEALTH_AND_SCIENCE
  SPIRITUAL_GROWTH_OUTREACH_AND_HERITAGE
  ARTS_CRAFTS_AND_HOBBIES
  RECREATION
  HOUSEHOLD_ARTS
  VOCATIONAL
  OUTDOOR_INDUSTRIES
  MISCELLANEOUS_HONORS
  MASTER_AWARDS
}

/// Every section of the club supply catalog (#531). The last ten are the
/// honor categories (same names as `HonorCategory`); their rows link to a
/// matching `Honor` when one exists.
enum ClubSupplySection {
  INVESTITURE
  CAMPOREES
  PATHFINDER_BIBLE_EXPERIENCE
  TEEN_LEADERSHIP_TRAINING
  MISCELLANEOUS
  CLASS_A_DRESS_APPAREL
  CLASS_A_UNIFORM_ACCESSORIES
  OTHER_APPAREL
  NATURE
  HEALTH_AND_SCIENCE
  SPIRITUAL_GROWTH_OUTREACH_AND_HERITAGE
  ARTS_CRAFTS_AND_HOBBIES
  RECREATION
  HOUSEHOLD_ARTS
  VOCATIONAL
  OUTDOOR_INDUSTRIES
  MISCELLANEOUS_HONORS
  MASTER_AWARDS
}

/// A conference-wide club supply catalog item (#531): one AdventSource order
/// line, one row per size. Identity is section plus normalized name; catalog
/// numbers repeat in the real data (Good Conduct Stars, belts, every
/// Advanced honor), so they are indexed, never unique. Changed only by the
/// staff CSV import and the active toggle; nothing is auto-seeded.
model ClubSupplyItem {
  id             String            @id @default(cuid())
  section        ClubSupplySection
  name           String
  normalizedName String
  /// Kept as a string so leading zeros survive; optional (conference-made
  /// camporee patches have none).
  catalogNumber  String?
  /// A size parsed from the item name ("Size 8", "XL"), or null.
  sizeLabel      String?
  isActive       Boolean           @default(true)
  /// The honor this row is the patch for, when an honor-section row's name
  /// matches an existing `Honor`.
  honorId        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  honor Honor?            @relation(fields: [honorId], references: [id], onDelete: SetNull)
  stock ClubSupplyStock[]
  orderNeeds ClubOrderNeed[]
  orderLines ClubSupplyOrderLine[]
  orderListLines ClubOrderListLine[]
  eventAwardItems EventAwardItem[]
  masterAwardRules MasterAwardRule[]

  @@unique([section, normalizedName])
  @@index([catalogNumber])
  @@index([honorId])
  @@index([isActive, section, name])
}

/// How many of one catalog item a club has on hand (#531). One row per club
/// per item. Directors and deputies edit it; registrars and Area
/// Coordinators only view it.
model ClubSupplyStock {
  id                 String   @id @default(cuid())
  organizationId     String
  itemId             String
  quantityOnHand     Int      @default(0)
  updatedByAccountId String?
  /// Set instead of `updatedByAccountId` for a staff "act as" director (#442).
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item             ClubSupplyItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  updatedByAccount AttendeeAccount? @relation("ClubSupplyStockUpdatedByAccount", fields: [updatedByAccountId], references: [id], onDelete: SetNull)
  updatedByUser    User?            @relation("ClubSupplyStockUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, itemId])
  @@index([itemId])
}

/// Where a `ClubOrderNeed` came from (#487). Honors is the first source;
/// uniform ordering (#497) is the second (a director records the need by hand,
/// so its `sourceId` is a generated key). Earned awards (#532) are the third:
/// class insignia, event patches, Good Conduct/TLT and Master Awards, with
/// stable keys for the suggested ones and a generated key for hand-picked
/// ones. No change to this table's shape.
enum ClubOrderSourceType {
  HONOR
  UNIFORM
  AWARD
}

/// How one need for a catalog item has moved along (#487): completed/needed
/// (no row yet — computed from the source), then ordered, received, and
/// finally awarded (handed to the person) or issued.
enum ClubOrderNeedStatus {
  NEEDED
  ORDERED
  RECEIVED
  AWARDED
}

/// One club's need for one catalog item, for one person, from one source
/// instance (#487): an honor completion today, a uniform size or an earned
/// award tomorrow. `sourceType`/`sourceId` is the only source-specific part;
/// everything else — the item, the person, and the fulfillment state — is
/// generic. Unique on the source pair, so re-scanning a source never creates
/// the same need twice. For honors the `sourceId` is `personId:honorId`, so a
/// re-completion or a completion-date correction (#486 records are
/// append-only) never makes a second need for the same patch.
model ClubOrderNeed {
  id             String              @id @default(cuid())
  organizationId String
  sourceType     ClubOrderSourceType
  sourceId       String
  personId       String
  /// Null when the source item has no matching `ClubSupplyItem` at all (an
  /// unmatched honor); flagged in the order list rather than silently dropped.
  itemId         String?
  /// What the source calls this need, for the screen when there's no catalog
  /// item to name it by (an honor's name today). Never a personal field.
  sourceLabel    String              @default("")
  /// The calendar date (`YYYY-MM-DD`) the need arose at the source (an honor's
  /// completion date), or blank when the source has none. Lets a club mark
  /// "already handed out" everything completed before a date (#487).
  sourceDate     String              @default("")
  status         ClubOrderNeedStatus @default(NEEDED)
  batchId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  item         ClubSupplyItem?       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch        ClubSupplyOrderBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([organizationId, status])
  @@index([itemId])
  @@index([batchId])
}

/// A director's edit to one line of the club's order helper list (#654): the
/// quantity the club wants on the list for one catalog item, replacing the
/// count worked out from honors, uniforms and awards. 0 takes the item off
/// the list; a positive number on an item with no need adds it. Deleting the
/// row puts the line back to the computed count. It is a planning aid only;
/// nothing is ordered from it.
model ClubOrderListLine {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         ClubSupplyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([organizationId, itemId])
  @@index([itemId])
}

/// A `ClubSupplyOrderBatch`'s own two states: placed, or received.
enum ClubSupplyOrderBatchStatus {
  ORDERED
  RECEIVED
}

/// One AdventSource order a club placed (#487): a set of catalog items and
/// quantities, moved from ordered to received in bulk. Receiving adds each
/// line's `quantityOrdered` to the club's stock; awarding a specific person's
/// item later draws down that same stock.
model ClubSupplyOrderBatch {
  id                  String    @id @default(cuid())
  organizationId      String
  status              ClubSupplyOrderBatchStatus @default(ORDERED)
  createdByAccountId  String?
  /// Set instead of `createdByAccountId` for a staff "act as" director (#442).
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  receivedAt          DateTime?
  receivedByAccountId String?
  /// Set instead of `receivedByAccountId` for a staff "act as" director (#442).
  receivedByUserId    String?

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByAccount  AttendeeAccount?      @relation("ClubSupplyOrderBatchCreatedByAccount", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser     User?                 @relation("ClubSupplyOrderBatchCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receivedByAccount AttendeeAccount?      @relation("ClubSupplyOrderBatchReceivedByAccount", fields: [receivedByAccountId], references: [id], onDelete: SetNull)
  receivedByUser    User?                 @relation("ClubSupplyOrderBatchReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  lines             ClubSupplyOrderLine[]
  needs             ClubOrderNeed[]

  @@index([organizationId, status])
}

/// One catalog item's line on an order batch (#487): the count needed and any
/// extras at the moment the order was placed, and the stock on hand then
/// (context for later review; never re-derived).
model ClubSupplyOrderLine {
  id               String   @id @default(cuid())
  batchId          String
  itemId           String
  neededCount      Int
  extraCount       Int      @default(0)
  stockAtOrderTime Int
  /// What was actually put on the AdventSource order: needed plus extras,
  /// less the stock free to cover them then, never below zero. Receiving adds
  /// exactly this to stock (#487).
  quantityOrdered  Int
  createdAt        DateTime @default(now())

  batch ClubSupplyOrderBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  item  ClubSupplyItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([batchId, itemId])
  @@index([itemId])
}

/// A named class period at one Honors Weekend site (event). Names differ by
/// site, so they are data, never hard-coded.
model HonorSession {
  id             String   @id @default(cuid())
  eventId        String
  /// Site of a multi-location event (#589); null when the event has none, or
  /// for a session every site shares.
  locationId     String?
  name           String
  normalizedName String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location  EventLocation?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  offerings HonorOffering[]

  // Name uniqueness is two partial unique indexes the migration adds (Prisma
  // can't model them, and `migrate diff` leaves them alone): (eventId,
  // normalizedName) WHERE locationId IS NULL, and (eventId, locationId,
  // normalizedName) WHERE locationId IS NOT NULL.
  @@index([eventId, sortOrder])
  @@index([locationId])
}

/// An honor taught at a site: in one session, or across all sessions.
/// `capacity` counts youth seats only. The migration adds CHECK constraints
/// and a partial unique index for ALL_SESSIONS offerings.
model HonorOffering {
  id           String            @id @default(cuid())
  eventId      String
  honorId      String
  sessionId    String?
  /// Site of an ALL_SESSIONS class (#589); a single-session class takes its
  /// site from its session, so this stays null for it (a CHECK enforces that).
  /// `location` below is the room; this is the site.
  locationId   String?
  span         HonorOfferingSpan
  capacity     Int
  minimumAge   Int?
  perClubLimit Int?
  teacherName  String            @default("")
  location     String            @default("")
  /// Extra cost of this class in cents (#651); null means none. Shown on the public class grid.
  additionalCostCents Int?
  /// A special requirement shown as a badge on the public class grid (#651), e.g. "Bring a flashlight".
  requirementNote String         @default("")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  honor       Honor             @relation(fields: [honorId], references: [id], onDelete: Restrict)
  session     HonorSession?     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  site        EventLocation?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  enrollments HonorEnrollment[]

  // The all-sessions uniqueness is two partial unique indexes the migration
  // maintains (one per honor per site; one per honor with no site).
  @@unique([sessionId, honorId])
  @@index([eventId, isActive])
  @@index([locationId])
  @@index([honorId])
}

/// One person on one club's roster for one club year (#356). Birth dates are
/// sealed with `lib/secret-box.ts` (purpose `club-roster:birth-date`) and never
/// stored in plain text (ADR 0005 Addendum A).
model ClubRosterMember {
  id                   String                 @id @default(cuid())
  healthRecord        HealthRecord?
  healthRecordLinks   HealthRecordLink[]
  organizationId       String
  clubYear             String
  personId             String?
  attendeeType         ClubRosterAttendeeType
  role                 String                 @default("")
  classLevel           ClubClassLevel?
  /// Age as a form reported it (#376), for people imported without a birth
  /// date. Shown with "birth date needed" until the director adds one.
  reportedAge          Int?
  gender               ClubRosterGender?
  sealedBirthDate      String?
  status               ClubRosterStatus       @default(ACTIVE)
  source               ClubRosterSource
  sourceRegistrationId String?
  createdByAccountId   String?
  /// Set instead of `createdByAccountId` for a staff "act as" director (#442).
  createdByUserId      String?
  removedAt            DateTime?
  /// Unused since #544: the app no longer has any driving feature, and roster
  /// writes ignore this field. The column stays until a human-approved
  /// migration removes it.
  willingToDrive       Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person             Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdBy          AttendeeAccount? @relation("ClubRosterMemberCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser      User?            @relation("ClubRosterMemberCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Transfer requests (#489) that matched this row as the sending club's member.
  transferAsSender   MemberTransfer[] @relation("MemberTransferFromRoster")
  /// The transfer, if any, that created this row at the receiving club (#489).
  transferAsReceiver MemberTransfer?  @relation("MemberTransferToRoster")
  clubFormSubmissions ClubFormSubmission[]
  clubFormLinks       ClubFormLink[]
  meetingAttendance   ClubMeetingAttendance[]
  /// Up to two guardian contacts (#510). Deleted with the member's removal.
  guardians           ClubRosterGuardian[]

  @@unique([organizationId, clubYear, personId])
  @@index([organizationId, clubYear, status])
  @@index([personId])
}

/// A guardian contact for a roster member (#510): slot 1 or 2, every field
/// optional, plain text (director decision Oct 1, 2026: not encrypted). Only
/// the club's director and deputy, Area Coordinators and staff holding
/// VIEW_SENSITIVE_DATA may read it. The row lives exactly as long as the
/// member is on the roster: it cascades with the member and is deleted when the
/// member is removed or erased. Values never go into audit metadata or logs.
model ClubRosterGuardian {
  id             String   @id @default(cuid())
  rosterMemberId String
  /// 1 or 2 (a CHECK constraint in the migration enforces it).
  position       Int
  name           String   @default("")
  relationship   String   @default("")
  email          String   @default("")
  phone          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rosterMember ClubRosterMember @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)

  @@unique([rosterMemberId, position])
}

/// A club-owned, named roster export format (#490): which columns, in what
/// order, and under what header names to hand a specific outside camporee.
/// `columns` holds only that structure (an ordered array of `{key, header}`)
/// and is never a copy of any roster row.
model ClubRosterExportFormat {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  columns            Json
  createdByAccountId String?
  /// Set instead of `createdByAccountId` for a staff "act as" director (#442).
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     AttendeeAccount? @relation("ClubRosterExportFormatCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser User?            @relation("ClubRosterExportFormatCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
}

/// The pre-#527 one-row-per-person background-check table, kept read-only
/// for one release after the #527 migration carried every row over to the
/// list below (renamed from "BackgroundCheck"; nothing writes to it any
/// more). A later migration drops it — see
/// docs/BACKGROUND-CHECK-LIST-MIGRATION.md. Ignored by Prisma Client so no
/// code can read or write it; modelled here only so the migration history
/// and this schema agree.
model BackgroundCheckPre527 {
  id               String                           @id(map: "BackgroundCheck_pkey") @default(cuid())
  personId         String                           @unique(map: "BackgroundCheck_personId_key")
  provider         String                           @default("STERLING")
  checkedOn        String?
  expiresOn        String?
  complianceStatus BackgroundCheckComplianceStatus?
  issuesNote       String?
  recordedByUserId String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade, map: "BackgroundCheck_personId_fkey")

  @@index([expiresOn], map: "BackgroundCheck_expiresOn_idx")
  @@map("BackgroundCheck_pre527")
  @@ignore
}

/// The single stored background-check list (#527). Both the Sterling
/// Volunteers CSV and the roster compliance CSV feed this same list; each
/// upload is the complete current export and replaces it entirely (the
/// `BackgroundCheckUpload.format` on the current entries records which
/// layout produced them). Matching a person happens at lookup, from
/// `BackgroundCheckMatch` — never re-run on every render.
model BackgroundCheckUpload {
  id               String   @id @default(cuid())
  format           String
  rowCount         Int
  added            Int
  changed          Int
  dropped          Int
  uploadedByUserId String
  createdAt        DateTime @default(now())

  entries BackgroundCheckEntry[]

  @@index([createdAt])
}

/// One row of the currently uploaded list (#527), kept whether or not it
/// matches anyone today ("the CSV is the base"). Replaced wholesale by the
/// next upload (cascades from `BackgroundCheckUpload`).
model BackgroundCheckEntry {
  id       String @id @default(cuid())
  uploadId String
  line     Int
  firstName String
  lastName  String
  /// `matchableName(firstName + " " + lastName)`, indexed so matching a
  /// person against the list is a lookup, not a scan. Computed in
  /// TypeScript only, never in SQL: null on an entry carried over by the #527
  /// migration until the first refresh or upload fills it in
  /// (`backfillNormalizedNames`).
  normalizedName String?
  email          String?
  /// Sealed the same way roster birth dates are sealed (ADR 0005 Addendum A,
  /// `modules/club-rosters/birth-dates.ts`). Never stored in plain text.
  sealedBirthDate String?
  /// The person's club or sponsoring church (the roster format's `sites`).
  site            String?
  /// The roster CSV's `user_id`, when the row has one (Sterling rows never do).
  sourceUserId    String?
  /// What recognizes the same entry across uploads
  /// (`backgroundCheckIdentityKey`): `userId:<user_id>` when the row has one
  /// — the same format `ExternalIdentity.externalId` (provider
  /// `ROSTER_IMPORT`) uses — otherwise a key derived from the row's own
  /// identifying fields.
  identityKey      String
  /// Set by a roster row's `compliance` column (y/!/n). Null for a Sterling
  /// row, which is current/expired by `expiresOn` instead.
  complianceStatus BackgroundCheckComplianceStatus?
  /// Calendar dates ("2026-09-23"). Current through `expiresOn`. Null for a
  /// roster row, which has no expiration date at all.
  checkedOn String?
  expiresOn String?
  /// The roster row's `issues` column: the check and training dates. Staff
  /// only, never shown to a club director or on a club's own portal roster.
  issuesNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  upload  BackgroundCheckUpload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  match   BackgroundCheckMatch?
  review  BackgroundCheckReview?

  @@index([normalizedName])
  @@index([uploadId])
  @@index([identityKey])
}

/// The derived, fast-to-read match from a person to their current list entry
/// (#527) — a single indexed row per person, so a roster render or event flag
/// check is a join, never a scan. Refreshed at upload, when a person or
/// roster member is added or edited, and when staff resolve a review.
model BackgroundCheckMatch {
  id        String                     @id @default(cuid())
  personId  String                     @unique
  entryId   String                     @unique
  matchedBy BackgroundCheckMatchSource
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  person Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  entry  BackgroundCheckEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

/// How a `BackgroundCheckMatch` was decided. `IDENTITY`: a remembered
/// `user_id` whose name still agrees. `AUTO`: normalized name plus exactly
/// one of email, birth date, or site, with nothing else it could be. `MANUAL`:
/// a staff decision; it holds across refreshes and uploads (carried to the
/// next upload's entry with the same `identityKey`) until staff undo it.
/// `MIGRATED`: carried over from the old per-person `BackgroundCheck` row
/// when this list replaced it (#527), so nobody's status changed that day.
/// `NAME_ONLY` (#598): the name is the only person and only row with it and
/// nothing contradicts it, but the row's site didn't match; recomputed like
/// `AUTO`, and shown to staff for an informational spot check. Since #619 a
/// `user_id` row's name-only match is remembered like `AUTO`, so the next
/// upload finds it as `IDENTITY`; a first-name variant with one agreeing
/// detail is also `NAME_ONLY` (not remembered).
enum BackgroundCheckMatchSource {
  IDENTITY
  AUTO
  MANUAL
  MIGRATED
  NAME_ONLY
}

/// A list entry that could match more than one person, or whose only
/// candidate people also match another entry — never guessed (#527). Staff
/// resolve it by hand from `candidatePersonIds`; picking one becomes a
/// `MANUAL` match that holds on the next upload. At most one per entry.
/// "None of these is right" keeps the row with `dismissedAt` set: a
/// dismissed entry is matched to no one — not by a refresh, not at read
/// time — until the next upload replaces the list.
model BackgroundCheckReview {
  id                 String    @id @default(cuid())
  entryId            String    @unique
  reason             String
  candidatePersonIds Json
  dismissedAt        DateTime?
  createdAt          DateTime  @default(now())

  entry BackgroundCheckEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

/// Staff said a list row is not a given person (#598, "Not the same person" on
/// a name-only match). Keyed by the row's `identityKey`, not its entry id, so
/// the decision survives every upload; matching never offers that person for
/// that row (name-only, automatic, or variant) until staff match them by
/// hand, which clears it. No foreign keys: a row's key outlives any one
/// upload, and a deleted person just leaves an inert pair. Any future person
/// merge must re-point `personId` here (there is no foreign key to do it).
model BackgroundCheckRejectedPairing {
  id               String   @id @default(cuid())
  identityKey      String
  personId         String
  rejectedByUserId String
  createdAt        DateTime @default(now())

  @@unique([identityKey, personId])
}

/// A name-only or first-name-variant match (#619) of a list row with no roster
/// `user_id`, remembered by the row's `identityKey` so a later upload matches
/// it again (as `IDENTITY`, so it isn't listed as new). Rows with a `user_id`
/// use `ExternalIdentity` instead. `matchedName` is the row's normalized name
/// when it was made; a later upload uses the memory only while that name, the
/// person, and the row's email and birth date still fit, and no staff
/// rejection exists. Deleted by "not the same person" and by a match by hand.
/// No foreign keys, like `BackgroundCheckRejectedPairing`: a deleted person
/// just leaves an inert row. Any future person merge must re-point `personId`.
model BackgroundCheckRememberedMatch {
  id          String   @id @default(cuid())
  identityKey String   @unique
  personId    String
  matchedName String
  matchedBy   String
  createdAt   DateTime @default(now())
}

/// A background check's compliance mark from a roster import (#427): the
/// CSV's `compliance` column, y/yes → `CLEAR`, "!" → `FLAGGED` (expiring soon;
/// still current at events, and `issuesNote` gives the dates), n/no →
/// `NOT_COMPLIANT`. Any other value is a row-level parse problem, never
/// guessed into one of these.
enum BackgroundCheckComplianceStatus {
  CLEAR
  FLAGGED
  NOT_COMPLIANT
}

/// Unused since #544: the app no longer has any driving feature (this table
/// held #491 driver review decisions and #544 staff overrides). No code reads
/// or writes it; the table stays until a human-approved migration removes it.
model DriverVerification {
  id                  String    @id @default(cuid())
  personId            String    @unique
  clearedToTransport  Boolean
  note                String    @default("")
  reviewedByAccountId String?
  reviewedByUserId    String?
  reviewedAt          DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  person         Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  reviewedBy     AttendeeAccount? @relation("DriverVerificationReviewedBy", fields: [reviewedByAccountId], references: [id], onDelete: SetNull)
  reviewedByUser User?           @relation("DriverVerificationReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([reviewedByAccountId])
  @@index([reviewedByUserId])
}

/// A club's single registration for a club event (#358): an ordinary
/// Registration, billed to the church, tied to the club that made it.
model ClubEventRegistration {
  id                   String   @id @default(cuid())
  eventId              String
  organizationId       String
  registrationId       String   @unique
  submittedByAccountId String?
  /// Set instead of `submittedByAccountId` for a staff "act as" director (#442).
  submittedByUserId    String?
  createdAt            DateTime @default(now())

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registration    Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  submittedBy     AttendeeAccount? @relation("ClubEventRegistrationSubmittedBy", fields: [submittedByAccountId], references: [id], onDelete: SetNull)
  submittedByUser User?            @relation("ClubEventRegistrationSubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  assignment      ClubEventAssignment?

  @@unique([eventId, organizationId])
  @@index([organizationId])
}

/// A "Group" registration on a club event (#650): people who are not in a
/// club (homeschoolers, unaffiliated adults) registered by one contact. It is an
/// ordinary Registration, but it is deliberately NOT a `ClubEventRegistration`:
/// it names no club or church, creates no roster members, and the contact is
/// the billing party (billed on the back end after the event).
model GroupEventRegistration {
  id              String   @id @default(cuid())
  eventId         String
  registrationId  String   @unique
  /// The contact person the group is billed to after the event.
  billingPersonId String
  createdAt       DateTime @default(now())

  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration  Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  billingPerson Person       @relation(fields: [billingPersonId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([billingPersonId])
}

/// A staff-set campsite/duty/activity assignment for one club's event
/// registration (#410). Kept separate from `ClubEventRegistration` /
/// `PublicRegistrationSubmission` so a club's submitted preferences and
/// staff's assignment decisions never overwrite each other. Simple and
/// replaceable by the general grouping engine (#89) if that lands later.
///
/// `version` bumps on every staff edit; `lastEmailedVersion` records which
/// version the assignment email last went out for. When they differ (or
/// nothing has been sent yet while something is set), the assignment has
/// "changed since sent".
model ClubEventAssignment {
  id                      String   @id @default(cuid())
  eventId                 String
  organizationId          String
  clubEventRegistrationId String   @unique
  campsiteLocation        String   @default("")
  campsiteNotes           String   @default("")
  dutyLabel               String   @default("")
  dutyDay                 String   @default("")
  dutyTime                String   @default("")
  activityLabel           String   @default("")
  notes                   String   @default("")
  version                 Int      @default(1)
  lastEmailSentAt         DateTime?
  lastEmailedVersion      Int?
  updatedByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  event                 Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clubEventRegistration ClubEventRegistration @relation(fields: [clubEventRegistrationId], references: [id], onDelete: Cascade)
  updatedBy             User?                 @relation("ClubEventAssignmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, organizationId])
  @@index([eventId, updatedAt])
}

/// A director's unsubmitted club registration, saved as they work so a reload
/// or closed tab loses nothing. Never holds birth dates: people are roster IDs.
model ClubRegistrationDraft {
  id                 String   @id @default(cuid())
  eventId            String
  organizationId     String
  selectedMemberIds  String[]
  /// People going who aren't on the roster (#388), e.g. a visiting parent:
  /// [{ id, firstName, lastName, age, email }]. For this event only; they're
  /// never added to the roster. The server reads them from here at submit.
  guests             Json     @default("[]")
  responses          Json     @default("{}")
  attendeeResponses  Json     @default("{}")
  /// Honors picked while registering (#618): { [attendee client id]: [offering id] }.
  /// Only a draft; seats are taken by the enrollment domain after the registration is submitted.
  honorSelections    Json     @default("{}")
  /// Ages typed in for roster people with no birth date on file (#639):
  /// { [roster member id]: age on the event date }. For this registration only.
  rosterAges         Json     @default("{}")
  /// Roster member ids whose typed-in age should NOT also be saved to the roster
  /// when the registration is submitted (#639). Saving back is the default.
  rosterAgeSaveOff   Json     @default("[]")
  /// The location the director picked (#659), kept so a reload doesn't lose it.
  /// Not a foreign key: a location removed later is explained on restore rather
  /// than blocking the draft. A draft reserves no seats.
  locationId         String?
  /// Bumped by every save. A save must name the revision it was based on, so a
  /// second tab's stale save is refused instead of silently overwriting (#659).
  revision           Int      @default(0)
  /// The client id of the last save, so a retry of a save whose response was lost
  /// is recognised as already landed rather than a conflict (#659).
  lastSaveId         String?
  updatedByAccountId String?
  /// Set instead of `updatedByAccountId` for a staff "act as" director (#442).
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy     AttendeeAccount? @relation("ClubRegistrationDraftUpdatedBy", fields: [updatedByAccountId], references: [id], onDelete: SetNull)
  updatedByUser User?            @relation("ClubRegistrationDraftUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, organizationId])
}

/// A person's place in an Honors Weekend class (#359). Taken on the server
/// inside a serializable transaction with the class rows locked, so a class
/// can't be overfilled. Only youth consume a seat (`consumesSeat`).
model HonorEnrollment {
  id                     String   @id @default(cuid())
  eventId                String
  offeringId             String
  registrationId         String
  registrationAttendeeId String
  /// The club that holds the seat. Null for a "Group" registration (#650),
  /// which is never attributable to a club: its per-club limit is counted per
  /// registration instead.
  organizationId         String?
  consumesSeat           Boolean
  createdAt              DateTime @default(now())

  event                Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offering             HonorOffering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  registration         Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationAttendee RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  weekendCompletion    HonorWeekendCompletionLink?

  @@unique([registrationAttendeeId, offeringId])
  @@index([offeringId, consumesSeat])
  @@index([offeringId, organizationId, consumesSeat])
  @@index([registrationId])
}

enum MemberHonorStatus {
  IN_PROGRESS
  COMPLETED
}

/// One append-only entry in a member's year-round honor record (#486). The
/// record follows the durable `Person`, never a `ClubRosterMember` row, so it
/// carries across a club-year rollover (#414) and a future club transfer
/// (#489) without copying. A correction is never edited in place: it is a new
/// entry, and `seq` (not `createdAt`, which can tie under a bulk write) orders
/// history so the highest `seq` per (personId, honorId) is always the current
/// status. `organizationId` records which club made the entry, for the audit
/// trail only — it is never part of the identity or the read key.
model MemberHonorEntry {
  id                  String            @id @default(cuid())
  seq                 Int               @default(autoincrement())
  personId            String
  honorId             String
  status              MemberHonorStatus
  /// A calendar date (`YYYY-MM-DD`), required for COMPLETED and blank for
  /// IN_PROGRESS. Never a birth date or any other sealed field.
  completionDate      String            @default("")
  note                String            @default("")
  organizationId      String
  recordedByAccountId String?
  /// Set instead of `recordedByAccountId` for a staff "act as" director (#442).
  recordedByUserId    String?
  createdAt           DateTime          @default(now())

  person            Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  honor             Honor            @relation(fields: [honorId], references: [id], onDelete: Restrict)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recordedByAccount AttendeeAccount? @relation("MemberHonorEntryRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: SetNull)
  recordedByUser    User?            @relation("MemberHonorEntryRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  weekendCompletionLinks HonorWeekendCompletionLink[]
  /// Set when the entry was voided (#591); the entry row itself is never changed.
  void                   MemberHonorEntryVoid?

  @@index([personId, honorId, seq])
  @@index([organizationId, createdAt])
  @@index([honorId])
}

/// An audited void of one `MemberHonorEntry` (#591): its own append-only
/// record, so the entry row is never edited or deleted. Current status is the
/// highest non-voided `seq` per (personId, honorId), so every current-status
/// reader skips an entry that has a void row; when all of a person's entries
/// for an honor are voided, they have no status for it. Unique on `entryId`
/// (a second void of the same entry is refused) and there is no un-void: to
/// restore, record a new entry. Exactly one of `voidedByAccountId` /
/// `voidedByUserId` is set when written (a staff "act as" director uses the
/// user); the FK is SET NULL so deleting the actor's account keeps the void,
/// so the migration's CHECK allows at most one, never both.
model MemberHonorEntryVoid {
  id                String   @id @default(cuid())
  entryId           String   @unique
  /// 3 to 500 characters, enforced in the app and by a CHECK.
  reason            String
  voidedByAccountId String?
  voidedByUserId    String?
  createdAt         DateTime @default(now())

  entry           MemberHonorEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  voidedByAccount AttendeeAccount? @relation("MemberHonorEntryVoidedBy", fields: [voidedByAccountId], references: [id], onDelete: SetNull)
  voidedByUser    User?            @relation("MemberHonorEntryVoidedByUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)
}

/// Marks one Honors Weekend class enrollment (#357–#360) as already written
/// back into the member's year-round honor record (#487, #486). Unique on
/// `enrollmentId`, so writing back is idempotent: running the job again over
/// the same enrollments creates nothing new. Not unique on the entry: when
/// the member's latest entry for that honor is already COMPLETED (recorded by
/// hand, or by an earlier weekend), the enrollment links to that entry rather
/// than appending a second one.
model HonorWeekendCompletionLink {
  id                 String   @id @default(cuid())
  enrollmentId       String   @unique
  memberHonorEntryId String
  createdAt          DateTime @default(now())

  enrollment       HonorEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  memberHonorEntry MemberHonorEntry @relation(fields: [memberHonorEntryId], references: [id], onDelete: Cascade)

  @@index([memberHonorEntryId])
}

/// How a club member transfer (#489) was brought to a close.
enum MemberTransferResolution {
  /// The sending club accepted the request itself.
  SENDING_CLUB_ACCEPTED
  /// Conference staff finished a request the sending club had not answered within 14 days.
  STAFF_FINISHED
  /// Conference staff overrode the request (any time, with a note): a decline, an unmatched request, or one routed to staff.
  STAFF_OVERRIDDEN
}

/// What a `MemberTransferEvent` recorded happening, for both clubs' history and staff's audit trail.
enum MemberTransferEventType {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  STAFF_FINISHED
  STAFF_OVERRIDDEN
  REGISTRATION_MOVE_QUEUED
  REGISTRATION_MOVE_APPROVED
  REGISTRATION_MOVE_SKIPPED
  NOTIFIED
}

enum MemberTransferStatus {
  /// Matched to one active member of the named club, waiting on that club.
  PENDING
  /// No single exact match (or it could not be sent to the club): on the conference staff list only.
  UNMATCHED
  /// The sending club declined: on the conference staff list.
  DECLINED
  COMPLETED
  CANCELLED
}

/// Why a request needs conference staff rather than the sending club (#489).
enum MemberTransferStaffReason {
  /// No active member of the named club has exactly that name this club year.
  NO_MATCH
  /// More than one active member of the named club has exactly that name.
  AMBIGUOUS_MATCH
  /// The matched person already has another open transfer.
  ALREADY_PENDING
  /// The requesting director also leads the sending club: no self-acknowledgment (#489 N6).
  SAME_DIRECTOR
}

/// A club member transfer request (#489). The receiving club's director
/// enters the member's exact name and current club; the server matches on
/// normalized exact names inside that club's current-year roster and always
/// answers "request sent", so the request can't be used to probe a roster.
/// A match goes to the sending club (`PENDING`); anything else goes to the
/// conference staff list (`UNMATCHED`). The receiving club's roster row
/// (`toRosterMember`) is created only when the transfer completes, and the
/// sending row is erased at that moment (ADR 0005 Addendum A section 6).
///
/// Once the person is erased from every roster (their `Person` deleted),
/// `personId` and `pendingPersonId` fall to null and the typed names are
/// blanked: the record keeps the two clubs, the dates, the status, and the
/// reason, but nothing that names the person.
model MemberTransfer {
  id                   String                     @id @default(cuid())
  personId             String?
  /// Set only while a matched request is open (PENDING or DECLINED): one open matched transfer per person, enforced here.
  pendingPersonId      String?                    @unique
  /// Hash of receiving club, sending club, and the normalized typed name, set while the request is open: no duplicate open request from one club.
  requestKey           String?                    @unique
  clubYear             String
  fromOrganizationId   String
  toOrganizationId     String
  fromRosterMemberId   String?
  toRosterMemberId     String?                    @unique
  requestedFirstName   String
  requestedLastName    String
  reason               String
  status               MemberTransferStatus       @default(PENDING)
  staffReason          MemberTransferStaffReason?
  /// True once the sending club has been shown this request (a match), so an unmatched request never appears on another club's page.
  sendingClubVisible   Boolean                    @default(false)
  resolution           MemberTransferResolution?
  initiatedByAccountId String?
  /// Set instead of `initiatedByAccountId` for a staff "act as" director (#442).
  initiatedByUserId    String?
  initiatedAt          DateTime                   @default(now())
  /// `initiatedAt` + 14 days: when a pending request becomes overdue for the conference staff queue.
  acknowledgeDueAt     DateTime
  declinedAt           DateTime?
  resolvedByAccountId  String?
  resolvedByUserId     String?
  /// Completed or cancelled.
  resolvedAt           DateTime?
  staffNote            String                     @default("")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  person             Person?                          @relation("MemberTransferPerson", fields: [personId], references: [id], onDelete: SetNull)
  pendingPerson      Person?                          @relation("MemberTransferPendingPerson", fields: [pendingPersonId], references: [id], onDelete: SetNull)
  fromOrganization   Organization                     @relation("MemberTransferFrom", fields: [fromOrganizationId], references: [id], onDelete: Restrict)
  toOrganization     Organization                     @relation("MemberTransferTo", fields: [toOrganizationId], references: [id], onDelete: Restrict)
  fromRosterMember   ClubRosterMember?                @relation("MemberTransferFromRoster", fields: [fromRosterMemberId], references: [id], onDelete: SetNull)
  toRosterMember     ClubRosterMember?                @relation("MemberTransferToRoster", fields: [toRosterMemberId], references: [id], onDelete: SetNull)
  initiatedByAccount AttendeeAccount?                 @relation("MemberTransferInitiatedByAccount", fields: [initiatedByAccountId], references: [id], onDelete: SetNull)
  initiatedByUser    User?                            @relation("MemberTransferInitiatedByUser", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  resolvedByAccount  AttendeeAccount?                 @relation("MemberTransferResolvedByAccount", fields: [resolvedByAccountId], references: [id], onDelete: SetNull)
  resolvedByUser     User?                            @relation("MemberTransferResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  events             MemberTransferEvent[]
  registrationMoves  MemberTransferRegistrationMove[]

  @@index([personId])
  @@index([fromRosterMemberId])
  @@index([toOrganizationId, createdAt])
  @@index([fromOrganizationId, createdAt])
  @@index([status, acknowledgeDueAt])
}

/// One append-only entry in a transfer's audit trail (#489), shown as the
/// transfer's history on both clubs' roster pages and to conference staff.
model MemberTransferEvent {
  id             String                  @id @default(cuid())
  transferId     String
  type           MemberTransferEventType
  actorAccountId String?
  actorUserId    String?
  note           String                  @default("")
  metadata       Json?
  createdAt      DateTime                @default(now())

  transfer     MemberTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  actorAccount AttendeeAccount? @relation("MemberTransferEventActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorUser    User?            @relation("MemberTransferEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([transferId, createdAt])
}

enum MemberTransferRegistrationMoveStatus {
  PENDING
  APPROVED
  SKIPPED
}

/// One of a transferred member's open club-billed event registrations,
/// waiting on conference staff (#489 decision 2). Completing a transfer
/// moves nothing on its own: staff approve or skip each move. An approved
/// move takes the attendee and every row keyed to them to the receiving
/// club's registration for that event; nothing is repriced.
model MemberTransferRegistrationMove {
  id                     String                               @id @default(cuid())
  transferId             String
  eventId                String
  registrationAttendeeId String?
  fromRegistrationId     String?
  /// The receiving club's registration the attendee moved to, once approved.
  toRegistrationId       String?
  status                 MemberTransferRegistrationMoveStatus @default(PENDING)
  decidedByUserId        String?
  decidedAt              DateTime?
  note                   String                               @default("")
  createdAt              DateTime                             @default(now())

  transfer         MemberTransfer        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee         RegistrationAttendee? @relation(fields: [registrationAttendeeId], references: [id], onDelete: SetNull)
  fromRegistration Registration?         @relation("MemberTransferMoveFrom", fields: [fromRegistrationId], references: [id], onDelete: SetNull)
  toRegistration   Registration?         @relation("MemberTransferMoveTo", fields: [toRegistrationId], references: [id], onDelete: SetNull)
  decidedBy        User?                 @relation("MemberTransferMoveDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([transferId, registrationAttendeeId])
  @@index([status, createdAt])
  @@index([eventId])
  @@index([registrationAttendeeId])
  @@index([fromRegistrationId])
  @@index([toRegistrationId])
}

enum CalendarEntryStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
}

/// What a calendar entry is (#444). A closure ("Conference office closed")
/// is shown with its own label and icon rather than as an ordinary date.
enum CalendarEntryType {
  STANDARD
  CLOSURE
}

/// An informational item on the public conference calendar (#107) for
/// something registered or managed elsewhere. Dates are calendar dates in the
/// conference's time zone; `timeLabel` is shown as written ("7–9 pm").
model CalendarEntry {
  id              String              @id @default(cuid())
  title           String
  description     String              @default("")
  startsOn        String
  endsOn          String
  timeLabel       String              @default("")
  location        String              @default("")
  category        String              @default("")
  linkUrl         String?
  status          CalendarEntryStatus @default(SCHEDULED)
  entryType       CalendarEntryType   @default(STANDARD)
  /// RFC 5545 RRULE value (e.g. `FREQ=WEEKLY;BYDAY=MO,WE;COUNT=6`), or null
  /// for a one-off. `startsOn`/`endsOn` describe the first occurrence.
  repeatRule      String?
  /// Skipped occurrences (EXDATEs): start dates, YYYY-MM-DD, that don't happen.
  repeatExceptions String[]           @default([])
  isPublished     Boolean             @default(false)
  /// Imported from an ICS feed (#444 part B). All null for entries staff made.
  /// The feed link is cleared (not the entry deleted) when its feed is deleted.
  sourceFeedId              String?
  sourceUid                 String?
  /// The overridden occurrence's id for a RECURRENCE-ID item; "" for the master.
  sourceRecurrenceId        String?
  /// Hash of the last imported mapped fields; an unchanged hash means no write.
  sourceHash                String?
  /// The deleted feed's keyed address fingerprint, written when the feed is
  /// deleted. Only a feed with the same address may re-link this item.
  sourceUrlFingerprint      String?
  /// Set when the item is gone from the feed. It is unpublished, never deleted,
  /// so anything linked to it (#445) survives and relinks if it comes back.
  sourceRemovedAt           DateTime?
  sourceRemovedWasPublished Boolean             @default(false)
  /// Mapped fields staff changed after import; a refresh never overwrites these.
  locallyEditedFields       String[]            @default([])
  /// Hidden by staff here only; a refresh never unhides it.
  isHiddenLocally           Boolean             @default(false)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  sourceFeed CalendarFeed? @relation(fields: [sourceFeedId], references: [id], onDelete: SetNull)

  @@unique([sourceFeedId, sourceUid, sourceRecurrenceId])
  @@index([isPublished, startsOn])
}

enum CalendarFeedStatus {
  OK
  FAILED
}

/// A read-only ICS feed (for example a Google Calendar) whose events are
/// imported into the public calendar (#444 part B). The URL can be a private
/// "secret address", so it is stored sealed and only a short hint is shown back.
model CalendarFeed {
  id               String              @id @default(cuid())
  name             String
  sealedUrl        String
  /// Host and the last four characters: the only form of the URL ever shown.
  urlHint          String
  /// Keyed HMAC of the normalized address: finds a duplicate or the same calendar without opening any sealed URL.
  urlFingerprint   String              @unique
  defaultCategory  String              @default("")
  defaultEntryType CalendarEntryType   @default(STANDARD)
  publishNewItems  Boolean             @default(false)
  isEnabled        Boolean             @default(true)
  refreshMinutes   Int                 @default(60)
  lastFetchedAt    DateTime?
  lastSucceededAt  DateTime?
  lastStatus       CalendarFeedStatus?
  /// A short, sanitized message. Never contains the feed URL.
  lastError        String?
  lastItemCount    Int?
  createdByUserId  String
  updatedByUserId  String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  entries CalendarEntry[]
}

/// A passkey an attendee registered as their second step (e.g. to open club
/// rosters). Only the public key is stored; nothing biometric ever reaches
/// the server. Removing one sets `revokedAt` and it never verifies again.
model AttendeePasskey {
  id           String    @id @default(cuid())
  accountId    String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
}

enum PasskeyChallengePurpose {
  REGISTER
  VERIFY
  SIGN_IN
}

/// A one-time WebAuthn challenge, tied to the attendee session that asked for
/// it and consumed on first use so a response can't be replayed.
/// A single-use passkey prompt. REGISTER and VERIFY belong to a signed-in
/// session; SIGN_IN (#374) has none yet: it is tied to the browser by a
/// short-lived cookie holding its id, and the account is found only from the
/// verified credential.
model AttendeePasskeyChallenge {
  id        String                  @id @default(cuid())
  sessionId String?
  purpose   PasskeyChallengePurpose
  challenge String                  @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  session AttendeeSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, purpose])
  @@index([purpose, expiresAt])
}

/// A passkey a staff account (`User`) registered, either as a second factor
/// alongside a password or, for a UV (user-verified) assertion, as a
/// phishing-resistant way to complete sign-in on its own (#429). Kept in a
/// table separate from `AttendeePasskey`: the two principals' sign-in and
/// session models never share state. Only the public key is stored; nothing
/// biometric ever reaches the server. Removing one sets `revokedAt` and it
/// never verifies again.
model UserPasskey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// A one-time WebAuthn challenge for a staff passkey ceremony, consumed on
/// first use so a response can't be replayed. Mirrors
/// `AttendeePasskeyChallenge`: REGISTER and VERIFY belong to a signed-in
/// session; SIGN_IN has none yet and is tied to the browser by a short-lived
/// cookie holding its id, with the account found only from the verified
/// credential.
model UserPasskeyChallenge {
  id        String                  @id @default(cuid())
  sessionId String?
  purpose   PasskeyChallengePurpose
  challenge String                  @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, purpose])
  @@index([purpose, expiresAt])
}

/// Provenance for one reviewed annual clone (#157): a new draft `Event` built
/// from the configuration of a prior event. `resultEventId` is unique, so one
/// clone request yields one event; `(actorUserId, requestKey)` makes retries
/// idempotent. `sourceEventId` is nulled if the source is ever deleted; the
/// `snapshot` keeps the source's name and slug so provenance still reads.
/// Nothing here is a live link: the clone never follows later source edits.
model EventCloneRecord {
  id                String   @id @default(cuid())
  sourceEventId     String?
  resultEventId     String   @unique
  actorUserId       String
  requestKey        String
  /// The confirm body as sent (minus the key): what a retry with the same
  /// `requestKey` is compared against.
  requestInput      Json
  /// Hash of the source configuration the reviewer previewed; the clone was
  /// refused with SOURCE_CHANGED unless the source still matched it.
  sourceFingerprint String
  /// Ids and version numbers of the source configuration that was copied:
  /// registration form versions and message template versions.
  sourceVersions    Json
  /// Which domains were included, and which were excluded.
  selections        Json
  exclusions        Json
  /// Counts, the values that were reset or supplied anew, and the source's
  /// identity, as of the clone. Ids and counts only.
  snapshot          Json
  createdAt         DateTime @default(now())

  sourceEvent Event? @relation("EventCloneSource", fields: [sourceEventId], references: [id], onDelete: SetNull)
  resultEvent Event  @relation("EventCloneResult", fields: [resultEventId], references: [id], onDelete: Cascade)
  actor       User   @relation("EventCloneRecordActor", fields: [actorUserId], references: [id])

  @@unique([actorUserId, requestKey])
  @@index([sourceEventId, createdAt])
}

/// A class a member finished, recorded by a director (#532). The roster only
/// stores a member's *current* class (`ClubRosterMember.classLevel`), so this
/// is the explicit, least-invasive signal that "completed a class" happened:
/// one row per club, person and class. Recording it never orders anything; it
/// only makes that class's insignia set a *suggestion* the director confirms
/// (`insigniaDismissedAt` is set when the director chooses "Not now").
model MemberClassCompletion {
  id                  String         @id @default(cuid())
  organizationId      String
  personId            String
  classLevel          ClubClassLevel
  /// The calendar date (`YYYY-MM-DD`) the class was completed.
  completedOn         String
  insigniaDismissedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([organizationId, personId, classLevel])
  @@index([personId])
}

/// A catalog item staff link to a club event (#532): the camporee or PBE
/// patch or pin attendees earn. Linking never orders anything; it lets the
/// awards screen *suggest* the item for every member who attended.
model EventAwardItem {
  id        String   @id @default(cuid())
  eventId   String
  itemId    String
  createdAt DateTime @default(now())

  event Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item  ClubSupplyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([eventId, itemId])
  @@index([itemId])
}

/// Where a Master Award rule stands (#532). Rules arrive as DRAFT from the
/// staff-reviewed import; only ACTIVE rules are used for progress.
enum MasterAwardRuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// A Master Award's requirements, stored as data (#532): one or more honor
/// groups, each with a minimum; the award is earned when every group reaches
/// its minimum. Changed only by a system administrator, and audited.
model MasterAwardRule {
  id               String                @id @default(cuid())
  name             String
  normalizedName   String                @unique
  /// The Master Awards catalog item this rule's patch is (matched by name at import).
  itemId           String?
  status           MasterAwardRuleStatus @default(DRAFT)
  /// Parsed only partly, or honors that didn't match: a system administrator
  /// must clear this before the rule can be activated.
  needsManualCheck Boolean               @default(false)
  reviewNote       String                @default("")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  item   ClubSupplyItem?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  groups MasterAwardRuleGroup[]

  @@index([status])
}

model MasterAwardRuleGroup {
  id                  String   @id @default(cuid())
  ruleId              String
  position            Int
  minimum             Int
  /// Honor names from the import that matched no `Honor` row, shown for review.
  unmatchedHonorNames String[]

  rule   MasterAwardRule              @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  honors MasterAwardRuleGroupHonor[]

  @@unique([ruleId, position])
}

model MasterAwardRuleGroupHonor {
  groupId String
  honorId String

  group MasterAwardRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  honor Honor                @relation(fields: [honorId], references: [id], onDelete: Cascade)

  @@id([groupId, honorId])
  @@index([honorId])
}

enum ClubFormSubmissionStatus {
  DRAFT
  SUBMITTED
}

/// How a club form submission was entered (#610): a club director or deputy
/// signed in with their own account, a system administrator acting as that
/// director, or the person who opened a single-use private link.
enum ClubFormEntryChannel {
  ATTENDEE
  STAFF_ACTING
  LINK
}

/// OPEN links can still be used (until `expiresAt`); USED links submitted once
/// and are dead; REVOKED links were withdrawn by the club or lost an email
/// delivery. Expiry is derived from `expiresAt`, never stored.
enum ClubFormLinkStatus {
  OPEN
  USED
  REVOKED
}

/// A conference-managed club form (#610): forms that are not tied to an event
/// (membership application, staff service form, permission slip, passenger
/// list). `definition` is validated by the registration-form definition
/// schema, so the builder's field types and validation apply. Every template
/// is off (`enabled = false`) until a system administrator turns it on, and
/// clubs never see a disabled one. Sensitive fields are marked per field key.
model ClubFormTemplate {
  id                 String    @id @default(cuid())
  key                String    @unique
  name               String
  description        String    @default("")
  /// Bumped when the seeded definition changes; submissions record the
  /// version they were filled in against.
  version            Int       @default(1)
  definition         Json
  /// Display-only paragraphs per section id, for text a field label cannot
  /// carry (the Pathfinder Pledge and Law, approval and waiver text).
  sectionNotes       Json      @default("{}")
  /// Field keys whose answers are sealed with `lib/secret-box.ts`, redacted
  /// for Area Coordinators, and left out of CSVs, drafts and logs.
  sensitiveFieldKeys String[]  @default([])
  /// The birth-date class of sensitive field, a subset of `sensitiveFieldKeys`:
  /// readable only by the club's own director and deputies and system
  /// administrators (ADR 0005 Addendum A); Event Admins and Area Coordinators
  /// see "Restricted".
  birthDateFieldKeys String[]  @default([])
  /// Field keys a private-link filler never sees (for example office use).
  staffOnlyFieldKeys String[]  @default([])
  /// "STANDARD", or "PASSENGER_LIST" for the roll-call print layout.
  printLayout        String    @default("STANDARD")
  /// Field keys kept in the definition (so their sensitive flags and old
  /// answers stay put) but not offered to new fills (#712).
  hiddenFieldKeys    String[]  @default([])
  sortOrder          Int       @default(0)
  enabled            Boolean   @default(false)
  enabledAt          DateTime?
  enabledByUserId    String?
  /// Set the first time the template is edited or created in the app (#712).
  /// `club-forms:sync` never overwrites a customized template.
  customizedAt       DateTime?
  /// The unpublished draft of the next version (#712): the whole spec as JSON.
  /// Null when there is no draft. Publishing writes it to the columns above,
  /// bumps `version` and records a `ClubFormTemplateVersion`.
  draft                Json?
  draftUpdatedAt       DateTime?
  /// The published `version` the draft was started on (#712). A code sync that moves the version on makes the draft stale.
  draftBaseVersion     Int?
  draftUpdatedByUserId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enabledBy   User?                     @relation("ClubFormTemplateEnabledBy", fields: [enabledByUserId], references: [id], onDelete: SetNull)
  submissions ClubFormSubmission[]
  links       ClubFormLink[]
  versions    ClubFormTemplateVersion[]
}

/// A frozen copy of one published version of a club form template (#712), so a
/// submission is always shown and exported against the version it was filled
/// in against. Rows are only ever added.
model ClubFormTemplateVersion {
  id                 String   @id @default(cuid())
  templateId         String
  version            Int
  name               String
  description        String   @default("")
  definition         Json
  sectionNotes       Json     @default("{}")
  sensitiveFieldKeys String[] @default([])
  birthDateFieldKeys String[] @default([])
  staffOnlyFieldKeys String[] @default([])
  hiddenFieldKeys    String[] @default([])
  printLayout        String   @default("STANDARD")
  createdByUserId    String?
  createdAt          DateTime @default(now())

  template ClubFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, version])
}

/// One filled-in club form (#610). `answers` holds only non-sensitive answers;
/// sensitive ones are sealed into `sealedSensitiveAnswers` (AES-256-GCM, key
/// bound to this row's id). Every read of a row with sensitive answers writes
/// an audit row that carries no answer text.
model ClubFormSubmission {
  id                     String                   @id @default(cuid())
  templateId             String
  organizationId         String
  clubYear               String
  rosterMemberId         String?
  /// A display label for lists ("by member"): the roster member's name, or
  /// what the director typed for a non-member form.
  subjectName            String                   @default("")
  status                 ClubFormSubmissionStatus @default(DRAFT)
  answers                Json                     @default("{}")
  sealedSensitiveAnswers String?
  hasSensitiveAnswers    Boolean                  @default(false)
  templateVersion        Int
  enteredVia             ClubFormEntryChannel
  enteredByAccountId     String?
  /// Set instead of `enteredByAccountId` for a staff "act as" director.
  enteredByUserId        String?
  linkId                 String?                  @unique
  submittedAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  template         ClubFormTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember     ClubRosterMember? @relation(fields: [rosterMemberId], references: [id], onDelete: SetNull)
  enteredByAccount AttendeeAccount?  @relation("ClubFormSubmissionEnteredByAccount", fields: [enteredByAccountId], references: [id], onDelete: SetNull)
  enteredByUser    User?             @relation("ClubFormSubmissionEnteredByUser", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  link             ClubFormLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([organizationId, templateId, status])
  @@index([organizationId, clubYear])
  @@index([rosterMemberId])
  @@index([templateId, submittedAt])
}

/// A single-use, expiring private link (#610) for a parent or staff person to
/// fill in one form for one club, with no account. Only the SHA-256 of the
/// token is stored (`tokenHash`); the token itself is minted when the email is
/// delivered and never written to the outbox or a log.
model ClubFormLink {
  id                 String             @id @default(cuid())
  templateId         String
  organizationId     String
  clubYear           String
  rosterMemberId     String?
  /// The director's own label for who this link is for; never shown on the
  /// public page.
  subjectName        String             @default("")
  recipientEmail     String
  status             ClubFormLinkStatus @default(OPEN)
  tokenHash          String?            @unique
  expiresAt          DateTime
  usedAt             DateTime?
  revokedAt          DateTime?
  /// The outbox message that carries the link, for delivery-time minting.
  messageId          String?            @unique
  createdByAccountId String?
  createdByUserId    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  template         ClubFormTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember     ClubRosterMember?   @relation(fields: [rosterMemberId], references: [id], onDelete: SetNull)
  createdByAccount AttendeeAccount?    @relation("ClubFormLinkCreatedByAccount", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser    User?               @relation("ClubFormLinkCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submission       ClubFormSubmission?

  @@index([organizationId, status])
  @@index([templateId, organizationId])
  @@index([status, expiresAt])
}

// ---------------------------------------------------------------------------
// Pathfinder Health Record (#611). Built switched off behind
// HEALTH_RECORDS_ENABLED; see ADR 0005 Addendum B (Proposed).

enum HealthRecordLinkStatus {
  OPEN
  USED
  REVOKED
}

enum HealthRecordEntryChannel {
  DIRECTOR
  LINK
}

/// One health record for one club member (#611). It holds no health text: every
/// health field is a separate `HealthRecordField` row, sealed with
/// `lib/secret-box.ts`. `hasHealthNote` is the plain "a record exists" flag.
model HealthRecord {
  id                String                    @id @default(cuid())
  organizationId    String
  rosterMemberId    String                    @unique
  /// The club year (for example "2026-27") the record was last confirmed or
  /// saved in. Anything else shows "Needs update".
  confirmedClubYear String?
  hasHealthNote     Boolean                   @default(false)
  lastEnteredVia    HealthRecordEntryChannel?
  /// Who last saved it: an attendee account id, or a staff user id for an act-as. Never shown.
  lastSavedByActor  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember ClubRosterMember    @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)
  fields       HealthRecordField[]

  @@index([organizationId])
}

/// One sealed health field. `sealedValue` is `v1.<nonce>.<tag>.<ciphertext>`
/// under the purpose `health-record:<recordId>:<fieldKey>`.
model HealthRecordField {
  id          String   @id @default(cuid())
  recordId    String
  fieldKey    String
  sealedValue String
  updatedAt   DateTime @updatedAt

  record HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, fieldKey])
}

/// A single-use, expiring private link for a parent to fill in one member's
/// health record, with no account. Only the SHA-256 of the token is stored.
model HealthRecordLink {
  id             String                 @id @default(cuid())
  organizationId String
  rosterMemberId String
  clubYear       String
  recipientEmail String
  status         HealthRecordLinkStatus @default(OPEN)
  tokenHash      String?                @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  messageId      String?                @unique
  /// Attendee account id or staff user id of the sender, for attribution only.
  createdByActor String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember ClubRosterMember @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([rosterMemberId])
  @@index([status, expiresAt])
}

/// An organization's billing contact (#165), usually the church treasurer. Entered by office
/// staff once and reused for every event. Effective-dated: replacing it ends the previous row
/// (`effectiveTo`) and starts a new, unverified one; a row is never edited in place or deleted
/// (a trigger refuses DELETE). At most one row per organization is active (`effectiveTo` IS
/// NULL), enforced by a partial unique index the migration adds. Distinct from the club
/// director, the registration submitter, and any registration-facing contact.
model OrganizationBillingContact {
  id               String               @id @default(cuid())
  organizationId   String
  name             String
  email            String
  phone            String?
  /// A label such as "Treasurer".
  roleLabel        String
  source           BillingContactSource @default(STAFF_ENTERED)
  effectiveFrom    DateTime             @default(now())
  effectiveTo      DateTime?
  verifiedAt       DateTime?
  verifiedByUserId String?
  createdByUserId  String?
  endedByUserId    String?
  endReason        String?
  createdAt        DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  verifiedBy   User?        @relation("BillingContactVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("BillingContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedBy      User?        @relation("BillingContactEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, effectiveFrom])
}

/// Who is financially responsible for one deferred-invoice registration (#165). One current row
/// per registration; every change also appends a `RegistrationBillingResponsibilityChange`.
/// STAFF_LINKED and STAFF_OVERRIDE rows are human decisions that re-resolution never replaces.
model RegistrationBillingResponsibility {
  id             String                      @id @default(cuid())
  eventId        String
  registrationId String                      @unique
  kind           BillingResponsibleKind
  organizationId String?
  personId       String?
  source         BillingResponsibilitySource
  /// Why staff chose this (required for an override).
  reason         String?
  setByUserId    String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  setBy        User?         @relation("BillingResponsibilitySetBy", fields: [setByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, kind])
  @@index([organizationId])
}

/// Append-only history of responsibility changes (#165): the before and after of each one.
model RegistrationBillingResponsibilityChange {
  id                 String                          @id @default(cuid())
  eventId            String
  registrationId     String
  changeType         BillingResponsibilityChangeType
  fromKind           BillingResponsibleKind?
  fromOrganizationId String?
  fromPersonId       String?
  fromSource         BillingResponsibilitySource?
  toKind             BillingResponsibleKind
  toOrganizationId   String?
  toPersonId         String?
  toSource           BillingResponsibilitySource
  reason             String?
  actorUserId        String?
  createdAt          DateTime                        @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("BillingResponsibilityChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([registrationId, createdAt])
  @@index([eventId, createdAt])
}

/// A staff correction of one registered person's attendance on a deferred-invoice event (#166):
/// "came but was missed at check-in" (MARK_ATTENDED), "checked in by mistake" (MARK_NOT_ATTENDED),
/// or CLEAR (go back to the check-in record). Append-only: a correction is never edited; a later one
/// for the same person supersedes it (`supersededAt`), and the database keeps one active row per
/// person. The reason is required and the actor is recorded.
model AttendanceCorrection {
  id                       String                   @id @default(cuid())
  eventId                  String
  registrationId           String
  registrationAttendeeId   String
  kind                     AttendanceCorrectionKind
  reason                   String
  actorUserId              String?
  createdAt                DateTime                 @default(now())
  supersededAt             DateTime?
  supersededByCorrectionId String?

  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)
  actor        User?                @relation("AttendanceCorrectionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([registrationId])
  @@index([registrationAttendeeId, createdAt])
}

/// One reconciliation of attended people into billable units for a deferred-invoice event (#166).
/// DRAFT -> APPROVED -> SUPERSEDED. Everything but the status fields is an immutable snapshot of the
/// inputs, the rule version and the per-registration and per-group counts, enforced by triggers.
/// `fingerprint` hashes those facts: preparing again with nothing changed returns the existing
/// version (a partial unique index lets only one non-superseded version carry a fingerprint), and at
/// most one version per event is APPROVED.
model AttendanceReconciliationVersion {
  id                    String                         @id @default(cuid())
  eventId               String
  versionNumber         Int
  status                AttendanceReconciliationStatus @default(DRAFT)
  fingerprint           String
  ruleVersion           String
  invoiceGrouping       InvoiceGrouping
  registeredCount       Int
  checkedInCount        Int
  noShowCount           Int
  addedByStaffCount     Int
  removedByStaffCount   Int
  billableCount         Int
  /// What the registered roster would cost (the #409 estimate), for comparison.
  estimatedCents        Int
  billableCents         Int
  snapshot              Json
  preparedByUserId      String?
  createdAt             DateTime                       @default(now())
  approvedByUserId      String?
  approvedAt            DateTime?
  supersededAt          DateTime?
  supersededByVersionId String?

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  preparedBy User? @relation("AttendanceVersionPreparedBy", fields: [preparedByUserId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("AttendanceVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  invoiceVersions InvoiceVersion[]

  @@unique([eventId, versionNumber])
  @@index([eventId, status])
}

/// Staff acknowledgement that a registration's prices may not belong to the people now on its roster
/// (a member was transferred after pricing, #166). The figure for that registration is prorated from
/// its estimate, and approval waits for this record. `reviewKey` names exactly the mismatch seen, so a
/// new transfer needs a new acknowledgement. Append-only with supersede (like corrections); the reason is
/// required and the actor recorded.
model AttendanceReviewAcknowledgement {
  id             String   @id @default(cuid())
  eventId        String
  registrationId String
  reviewKey      String
  /// The basis staff chose to bill: the per-person best match, or the prorated estimate.
  choice         AttendanceReviewChoice
  reason         String
  actorUserId    String?
  createdAt      DateTime @default(now())
  /// Set when staff acknowledge the same review again with a different choice or reason: the latest wins.
  supersededAt   DateTime?
  supersededById String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AttendanceReviewAckActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one active (not superseded) row per registration and review key.
  @@index([registrationId, reviewKey])
  @@index([eventId, createdAt])
}

/// A declaration of who is responsible for a minor at an event (#131), made on the registration form or by
/// staff. Append-only. Authority exists only here: household, surname, email, canManage and being the
/// account holder never create a row. `adultPersonId` is null when the registrant chose "None of us".
/// One ACTIVE row per (event, minor) by a partial unique index; a change supersedes the old row, staff
/// can revoke with a reason, and a trigger refuses every other edit and every delete. Grants no access
/// to health, incident or other registration data.
model GuardianAuthority {
  id               String                  @id @default(cuid())
  eventId          String
  /// The registration the declaration was made on (for staff, the minor's registration they acted on).
  registrationId   String
  minorPersonId    String
  adultPersonId    String?
  source           GuardianAuthoritySource
  state            GuardianAuthorityState  @default(ACTIVE)
  declaredAt       DateTime                @default(now())
  /// Why staff set this (required for a staff declaration; null for the registration form).
  declarationReason String?
  /// The private-link access grant a manage-link declaration was made through (plain id: grants are revoked and expire).
  accessTokenId    String?
  /// Who declared: staff (`actorUserId`) or the registrant (`actorPersonId`).
  actorUserId      String?
  actorPersonId    String?
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?
  supersededAt     DateTime?
  supersededById   String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  minor        Person       @relation("GuardianAuthorityMinor", fields: [minorPersonId], references: [id], onDelete: Restrict)
  adult        Person?      @relation("GuardianAuthorityAdult", fields: [adultPersonId], references: [id], onDelete: Restrict)
  actorUser    User?        @relation("GuardianAuthorityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPerson  Person?      @relation("GuardianAuthorityActorPerson", fields: [actorPersonId], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("GuardianAuthorityRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one ACTIVE row per (event, minor).
  @@index([eventId, minorPersonId, declaredAt])
  @@index([registrationId])
  @@index([adultPersonId])
}

/// A second adult claiming a minor who already has an ACTIVE declaration from a different registration
/// (#131). Never resolved automatically: it waits for staff, and neither adult is silently blocked.
/// Changes only from OPEN to RESOLVED, once.
model GuardianAuthorityConflict {
  id                   String                         @id @default(cuid())
  eventId              String
  registrationId       String
  minorPersonId        String
  claimedAdultPersonId String
  /// The ACTIVE declaration that stood when the claim arrived (plain id: history rows are never deleted).
  existingAuthorityId  String
  declaredAt           DateTime                       @default(now())
  state                GuardianAuthorityConflictState @default(OPEN)
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolutionReason     String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  minor        Person       @relation("GuardianConflictMinor", fields: [minorPersonId], references: [id], onDelete: Restrict)
  claimedAdult Person       @relation("GuardianConflictAdult", fields: [claimedAdultPersonId], references: [id], onDelete: Restrict)
  resolvedBy   User?        @relation("GuardianConflictResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one OPEN row per (event, minor, claiming adult).
  @@index([eventId, state])
  @@index([minorPersonId])
}

enum InvoiceVersionStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
  /// A draft staff threw away (never numbered); kept for the record, hidden from the screens.
  DISCARDED
}

/// How a version was built: from the approved attendance reconciliation, or by copying the prior
/// finalized version with only the billing contact refreshed (a contact-only revision).
enum InvoiceVersionBasis {
  RECONCILIATION
  CONTACT_ONLY_COPY
}

/// What is owed on one finalized invoice version. OPEN until the version is superseded by a revision.
/// Payment states arrive when the ledger links in (#117-#120); see docs/INVOICES.md.
enum InvoiceReceivableStatus {
  OPEN
  SUPERSEDED
}

/// One invoice for one invoice group of a deferred-invoice event (#167). The number is assigned exactly
/// once, when the first version is finalized; revisions are versions of this invoice (`-R1`, `-R2`).
model Invoice {
  id              String                 @id @default(cuid())
  eventId         String
  /// The #165 invoice group key (a church, a club under per-club grouping, or a billing person).
  groupKey        String
  invoiceGrouping InvoiceGrouping
  partyKind       BillingResponsibleKind
  partyId         String?
  clubId          String?
  /// "SC27-0001": null until the first finalization, then never changed.
  baseNumber      String?                @unique
  numberCode      String?
  numberYear      Int?
  numberSequence  Int?
  createdAt       DateTime               @default(now())

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions    InvoiceVersion[]
  receivables InvoiceReceivable[]
  deliveries  InvoiceDelivery[]
  arPostings  InvoiceArPosting[]
  payments    InvoicePayment[]

  @@unique([eventId, groupKey])
  @@index([eventId])
}

/// An invoice version: a DRAFT is replaced only by regeneration; FINALIZED and SUPERSEDED versions are
/// immutable snapshots (database trigger). `snapshot` holds the lines; the columns hold what the
/// screen and the receivable read.
model InvoiceVersion {
  id                      String               @id @default(cuid())
  invoiceId               String
  eventId                 String
  /// 0 for the original, 1 for -R1, and so on.
  revision                Int
  status                  InvoiceVersionStatus @default(DRAFT)
  basis                   InvoiceVersionBasis
  /// The finalized version this one revises.
  supersedesVersionId     String?
  reconciliationVersionId String
  /// Full number such as "SC27-0001-R1", assigned at finalization only.
  number                  String?              @unique
  groupTitle              String
  organizationName        String
  contactName             String?
  contactEmail            String?
  contactRoleLabel        String?
  contactVerified         Boolean              @default(false)
  registeredCount         Int
  billableCount           Int
  amountDueCents          Int
  /// Hash of every billable amount (lines, credits, promo, charges, total); a revision with the same
  /// fingerprint as the finalized version it replaces changed no billable amount.
  amountsFingerprint      String
  snapshot                Json
  revisionReason          String?
  createdByUserId         String?
  createdAt               DateTime             @default(now())
  regenerationCount       Int                  @default(0)
  regeneratedAt           DateTime?
  finalizedAt             DateTime?
  finalizedByUserId       String?
  /// The approver's name as it was when they finalized.
  finalizedByName         String?
  finalizeIdempotencyKey  String?              @unique
  supersededAt            DateTime?
  supersededByVersionId   String?
  discardedAt             DateTime?

  event                 Event                           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice               Invoice                         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reconciliationVersion AttendanceReconciliationVersion @relation(fields: [reconciliationVersionId], references: [id], onDelete: NoAction)
  createdBy             User?                           @relation("InvoiceVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  finalizedBy           User?                           @relation("InvoiceVersionFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  receivable            InvoiceReceivable?
  document              InvoiceVersionDocument?
  deliveries            InvoiceDelivery[]
  arPostings            InvoiceArPosting[]
  payments              InvoicePayment[]

  /// A migration-level partial unique index allows one non-discarded version per invoice and revision.
  @@index([invoiceId, revision])
  @@index([eventId, status])
  @@index([reconciliationVersionId])
}

/// The per-invoice receivable (#167): one row per finalized version, created in the finalization
/// transaction. A later ledger links to `invoiceVersionId`.
model InvoiceReceivable {
  id                    String                  @id @default(cuid())
  eventId               String
  invoiceId             String
  invoiceVersionId      String                  @unique
  amountCents           Int
  status                InvoiceReceivableStatus @default(OPEN)
  createdAt             DateTime                @default(now())
  supersededAt          DateTime?
  supersededByVersionId String?

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  payments       InvoicePayment[]

  @@index([eventId, status])
  @@index([invoiceId])
}

/// The running invoice number for one event's code and year (#167). One row per (code, year), so a number
/// can never be issued twice across events; allocated by an atomic increment inside the finalize transaction.
model InvoiceNumberCounter {
  id         String   @id @default(cuid())
  eventId    String
  code       String
  year       Int
  lastNumber Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([code, year])
  @@index([eventId])
}

/// Whether a payment entry records money received or reverses an earlier entry (#168).
enum InvoicePaymentEntryKind {
  PAYMENT
  REVERSAL
}

/// Who an invoice email went to (#168): the church's billing contact, or the director of a club on the invoice.
enum InvoiceRecipientKind {
  BILLING_CONTACT
  CLUB_DIRECTOR
}

/// The PDF of one finalized invoice version (#168), made once from the immutable snapshot at the first send or
/// download and never regenerated: a resend attaches these very bytes. `sha256` is the hash of the stored file.
model InvoiceVersionDocument {
  id                  String   @id @default(cuid())
  eventId             String
  invoiceId           String
  invoiceVersionId    String   @unique
  attachmentId        String   @unique
  sha256              String
  /// The layout version of the generator, so a later layout change is visible on old documents.
  generatorVersion    Int
  /// The finance setting and organization name as they were when the PDF was made.
  paymentInstructions String
  headerName          String
  createdAt           DateTime @default(now())

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion    @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  attachment     MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  deliveries     InvoiceDelivery[]

  @@index([eventId])
}

/// One staff send (or resend) of a finalized invoice version (#168). Append-only. Each recipient is one outbox
/// message, whose status, bounce and suppression the outbox and provider events keep up to date.
model InvoiceDelivery {
  id                              String   @id @default(cuid())
  eventId                         String
  invoiceId                       String
  invoiceVersionId                String
  documentId                      String
  /// 1 for the first send of the version, 2 for the first resend, and so on.
  sequence                        Int
  sentByUserId                    String?
  sentByName                      String
  subject                         String
  /// The current billing contact was not the contact the invoice was finalized with (staff saw the flag first).
  contactChangedSinceFinalization Boolean  @default(false)
  idempotencyKey                  String   @unique
  createdAt                       DateTime @default(now())

  event          Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion             @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  document       InvoiceVersionDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sentBy         User?                      @relation("InvoiceDeliverySentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  recipients     InvoiceDeliveryRecipient[]

  @@unique([invoiceVersionId, sequence])
  @@index([eventId, createdAt])
}

model InvoiceDeliveryRecipient {
  id                String               @id @default(cuid())
  deliveryId        String
  kind              InvoiceRecipientKind
  /// The director's attendee account, or null for the billing contact.
  attendeeAccountId String?
  /// The club a director leads on this invoice, or null for the billing contact.
  clubId            String?
  messageOutboxId   String               @unique
  createdAt         DateTime             @default(now())

  delivery InvoiceDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  message  MessageOutbox   @relation(fields: [messageOutboxId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

/// Staff marked a finalized version "Posted to AR" in the conference's own accounting (#168). One root row per
/// version; a correction is a new row that corrects the latest one (append-only, never edited).
model InvoiceArPosting {
  id                String            @id @default(cuid())
  eventId           String
  invoiceId         String
  invoiceVersionId  String
  postedOn          DateTime          @db.Date
  reference         String?
  correctsPostingId String?           @unique
  reason            String?
  recordedByUserId  String?
  recordedByName    String
  createdAt         DateTime          @default(now())

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion    @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  corrects       InvoiceArPosting? @relation("InvoiceArPostingCorrection", fields: [correctsPostingId], references: [id], onDelete: NoAction)
  correctedBy    InvoiceArPosting? @relation("InvoiceArPostingCorrection")
  recordedBy     User?             @relation("InvoiceArPostingRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one root (uncorrecting) posting per version.
  @@index([invoiceId, createdAt])
  @@index([eventId])
}

/// A check received against an invoice, recorded by hand (#168). Append-only: a mistake is voided by a REVERSAL
/// entry that names the payment and gives a reason. Outstanding is computed across every entry on the invoice.
model InvoicePayment {
  id                String                  @id @default(cuid())
  eventId           String
  invoiceId         String
  /// The finalized version the entry was recorded against, and that version's receivable.
  invoiceVersionId  String
  receivableId      String
  kind              InvoicePaymentEntryKind
  amountCents       Int
  checkNumber       String?
  receivedOn        DateTime                @db.Date
  note              String?
  reversesPaymentId String?                 @unique
  reason            String?
  /// Minted by the page and reused on a retry, so a double click records one entry.
  requestKey        String?                 @unique
  recordedByUserId  String?
  recordedByName    String
  createdAt         DateTime                @default(now())

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion    @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  receivable     InvoiceReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  reverses       InvoicePayment?   @relation("InvoicePaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: NoAction)
  reversedBy     InvoicePayment?   @relation("InvoicePaymentReversal")
  recordedBy     User?             @relation("InvoicePaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@index([eventId])
}
