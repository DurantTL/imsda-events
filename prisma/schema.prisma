}

/// What a club tells people about itself (#375): editable by its director or
/// deputy and by conference staff. `listPublicly` is for a later "find a club".
model ClubProfile {
  organizationId    String   @id
  meetingPlace      String   @default("")
  meetingSchedule   String   @default("")
  contactEmail      String   @default("")
  contactPhone      String   @default("")
  publicDescription String   @default("")
  listPublicly      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * Explicit, time-bounded, revocable authority for an attendee account to act
 * for one club (#354). Nothing else grants it: not an email domain, not
 * registering a club, not a form answer, not roster membership. A grant counts
 * only between `effectiveFrom` and `effectiveTo` and while `revokedAt` is empty;
 * revoking keeps the row so past actions stay attributed.
 */
model ClubDirectorGrant {
  id                String           @id @default(cuid())
  organizationId    String
  attendeeAccountId String
  role              ClubDirectorRole @default(DIRECTOR)
  effectiveFrom     DateTime         @default(now())
  effectiveTo       DateTime?
  reason            String
  grantedByUserId   String?
  /// Set when the club's own director or deputy gave the role (#375).
  grantedByAccountId String?
  revokedAt         DateTime?
  revokedByUserId   String?
  revokedByAccountId String?
  revokeReason      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendeeAccount  AttendeeAccount  @relation(fields: [attendeeAccountId], references: [id], onDelete: Restrict)
  grantedBy        User?            @relation("ClubDirectorGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy        User?            @relation("ClubDirectorGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  grantedByAccount AttendeeAccount? @relation("ClubDirectorGrantGrantedByAccount", fields: [grantedByAccountId], references: [id], onDelete: SetNull)
  revokedByAccount AttendeeAccount? @relation("ClubDirectorGrantRevokedByAccount", fields: [revokedByAccountId], references: [id], onDelete: SetNull)

  @@index([attendeeAccountId, revokedAt])
  @@index([organizationId, revokedAt])
}

/**
 * Stable provider keys. A row belongs to exactly one IMSDA entity; the
 * database migration carries the XOR check Prisma cannot express.
 */
model ExternalIdentity {
  id             String         @id @default(cuid())
  organizationId String?
  personId       String?
  provider       ExternalSystem
  providerScope  String         @default("")
  externalId     String
  displayLabel   String?
  lastVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([provider, providerScope, externalId])
  @@unique([organizationId, provider, providerScope])
  @@unique([personId, provider, providerScope])
  @@index([organizationId])
  @@index([personId])
}

/// Identity slice 2 (#126): a generated, reviewable suggestion that two
/// `Person` records may be the same person. Candidates are evidence, never
/// action — nothing in this codebase applies one automatically at any
/// confidence. Applying a candidate (merging the two people) is slice 3
/// (#127) and does not exist yet.
///
/// `personAId` is always lexicographically less than `personBId` (a
/// canonical ordering enforced by the `PersonMatchCandidate_ordered_pair_check`
/// database check constraint, since Prisma cannot express a self-referential
/// unordered pair natively). This is what makes the pair itself, rather than
/// an ordered `(x, y)` vs `(y, x)`, the unit the unique constraint below can
/// reason about.
///
/// `fingerprint` is a deterministic hash of every input that produced
/// `matchedSignals` / `contradictingSignals` (both people's normalized
/// email, phone, and name, plus the sorted ids of any shared household and
/// any shared external identity tuple) together with `ruleVersion`. Two
/// generation runs over unchanged data produce the same fingerprint, which
/// is what makes generation idempotent
/// (`@@unique([personAId, personBId, fingerprint])`: a rerun that computes
/// the same fingerprint for the same pair finds its own row and writes
/// nothing) and what lets a dismissed pair stay suppressed until something
/// about the two people actually changes (a changed fingerprint no longer
/// matches the dismissed row, so generation creates a fresh OPEN row instead
/// of reusing it — see `modules/people/duplicate-match-repository.ts`).
model PersonMatchCandidate {
  id                    String                 @id @default(cuid())
  personAId             String
  personBId             String
  matchedSignals        PersonMatchSignal[] @default([])
  contradictingSignals  PersonMatchSignal[] @default([])
  confidence            PersonMatchConfidence
  /// Bumped whenever `duplicate-match-domain.ts`'s matching rules change
  /// behavior, so an old candidate never silently claims to have been
  /// produced by rules that no longer exist.
  ruleVersion           Int
  state                 PersonMatchState       @default(OPEN)
  /// See the model doc: a hash of the inputs (plus `ruleVersion`) that
  /// produced this candidate.
  fingerprint           String
  computedAt            DateTime               @default(now())
  dismissedAt           DateTime?
  dismissedByUserId     String?
  dismissalReason       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  personA        Person @relation("PersonMatchCandidateAsA", fields: [personAId], references: [id], onDelete: Cascade)
  personB        Person @relation("PersonMatchCandidateAsB", fields: [personBId], references: [id], onDelete: Cascade)
  dismissedByUser User? @relation("PersonMatchCandidateDismissedBy", fields: [dismissedByUserId], references: [id], onDelete: SetNull)

  @@unique([personAId, personBId, fingerprint])
  @@index([personAId])
  @@index([personBId])
  @@index([state])
}

model Registration {
  id                    String             @id @default(cuid())
  eventId               String
  accountHolderPersonId String
  householdId           String?
  confirmationCode      String
  status                RegistrationStatus @default(DRAFT)
  totalAmount           Decimal            @db.Decimal(12, 2)
  contactSnapshot       Json               @default("{}")
  submittedAt           DateTime?
  cancelledAt           DateTime?
  /// Site of a multi-location event (#413); null when the event has none.
  locationId            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  event                   Event                                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location                EventLocation?                       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationWaitlistChanges LocationWaitlistChange[]
  accountHolderPerson     Person                               @relation(fields: [accountHolderPersonId], references: [id])
  household               Household?                           @relation(fields: [householdId], references: [id])
  attendees               RegistrationAttendee[]
  payments                Payment[]
  publicFormSubmission    PublicRegistrationSubmission?
  capacityReservations    RegistrationCapacityReservation[]
  messages                MessageOutbox[]
  waitlistEntry           RegistrationWaitlistEntry?
  accessTokens            RegistrationAccessToken[]
  paymentAttempts         PaymentAttempt[]
  squareHostedCheckouts   SquareHostedCheckout[]
  squareDuplicateCharges  SquareDuplicateCharge[]
  promoCodeRedemption     PromoCodeRedemption?
  churchSponsorFinanceReviews ChurchSponsorFinanceReview[]
  operations              RegistrationOperation[]
  paymentChoiceOperations RegistrationPaymentChoiceOperation[]
  merchandiseOrders       MerchandiseOrder[]
  notes                   StaffNote[]
  tagAssignments          RegistrationTagAssignment[]
  clubRegistration        ClubEventRegistration?
  generalLinkSubmission   GeneralLinkSubmission?
  staffInvitation         StaffInvitation?
  groupRegistration       GroupEventRegistration?
  billingResponsibility        RegistrationBillingResponsibility?
  billingResponsibilityChanges RegistrationBillingResponsibilityChange[]
  attendanceCorrections        AttendanceCorrection[]
  attendanceReviewAcknowledgements AttendanceReviewAcknowledgement[]
  formNotificationDeliveries       RegistrationNotificationDelivery[]
  guardianAuthorities     GuardianAuthority[]
  acknowledgmentEvidence  AcknowledgmentEvidence[]
  acknowledgmentVoids AcknowledgmentVoid[]
  guardianAuthorityConflicts GuardianAuthorityConflict[]
  lodgingRequests         EventLodgingRequest[]
  lodgingChangeRequests   EventLodgingChangeRequest[]
  lodgingWaitlistEntries  EventLodgingWaitlistEntry[]
  assetIssuances          AssetIssuance[]
  lodgingAssignmentNotices EventLodgingAssignmentNotice[]
  mealSelections          EventMealSelection[]
  mealLedgerEntries       EventMealLedgerEntry[]
  assetLedgerEntries      AssetLedgerEntry[]
  lodgingRoommateRequestsFrom EventLodgingRoommateRequest[] @relation("LodgingRoommateFrom")
  lodgingRoommateRequestsTo   EventLodgingRoommateRequest[] @relation("LodgingRoommateTarget")
  honorEnrollments        HonorEnrollment[]
  honorClassWaitlist      HonorClassWaitlistEntry[]
  adjustments             RegistrationAdjustment[]
  scholarshipAwards       ScholarshipAward[]
  memberTransferMovesFrom MemberTransferRegistrationMove[] @relation("MemberTransferMoveFrom")
  memberTransferMovesTo   MemberTransferRegistrationMove[] @relation("MemberTransferMoveTo")
  pdfDocuments            RegistrationPdfDocument[]

  @@unique([eventId, confirmationCode])
  @@index([eventId, status])
  @@index([accountHolderPersonId])
  @@index([locationId])
  /// Operations search (#180): the canonical order inside one event (newest first, id as the tie-break).
  @@index([eventId, createdAt, id])
  /// Operations search (#180): the default order (submitted newest first, unknown last; the migration builds it NULLS LAST).
  /// scripts/verify-operations-search.ts asserts the default-order EXPLAIN plan uses this index with no Sort node.
  @@index([eventId, submittedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "Registration_eventId_submittedAt_createdAt_id_idx")
}

model RegistrationPaymentChoiceOperation {
  id                       String                    @id
  eventId                  String
  registrationId           String
  sequence                 Int
  clientRequestId          String
  requestFingerprint       String
  expectedPriorOperationId String?
  choice                   RegistrationPaymentChoice
  baseSubtotalCents        Int
  processingFeeCents       Int
  resultingTotalCents      Int
  responseSnapshot         Json
  createdAt                DateTime                  @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@unique([registrationId, sequence])
  @@unique([registrationId, clientRequestId])
  @@index([eventId, createdAt])
  @@index([registrationId, createdAt])
}

model PromoCode {
  id                   String            @id @default(cuid())
  eventId              String
  code                 String
  normalizedCode       String
  isActive             Boolean           @default(true)
  discountType         PromoDiscountType
  discountValue        Int
  startsOn             String?
  endsOn               String?
  minimumSubtotalCents Int?
  maximumUses          Int?
  maximumDiscountCents Int?
  redeemedCount        Int               @default(0)
  /// Church-sponsored code (#545): the church that owes the discount for each
  /// active registration that redeemed it. Only on a GENERAL event, and only
  /// an active CHURCH organization when linked; staff-set. Nothing is stored
  /// per redemption — what the church owes is computed on demand from
  /// PromoCodeRedemption, like church-billed club registrations (#409).
  sponsoringOrganizationId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsoringOrganization Organization? @relation("PromoCodeSponsor", fields: [sponsoringOrganizationId], references: [id], onDelete: Restrict)
  redemptions PromoCodeRedemption[]
  adjustments RegistrationAdjustment[]

  @@unique([eventId, normalizedCode])
  @@index([eventId, isActive, updatedAt])
  @@index([sponsoringOrganizationId])
}

model PromoCodeRedemption {
  id                           String            @id @default(cuid())
  eventId                      String
  promoCodeId                  String
  registrationId               String            @unique
  codeSnapshot                 String
  discountTypeSnapshot         PromoDiscountType
  discountValueSnapshot        Int
  startsOnSnapshot             String?
  endsOnSnapshot               String?
  minimumSubtotalCentsSnapshot Int?
  maximumUsesSnapshot          Int?
  maximumDiscountCentsSnapshot Int?
  eligibleSubtotalCents        Int
  discountAmountCents          Int
  /// What staff lodging edits have moved the church's share by since the code was used (#813): signed, summed over
  /// edits, and never touched by an amendment (which rewrites `discountAmountCents` from the form). The church owes
  /// `discountAmountCents + sponsorLodgingChangeCents`; the registrant's own discount stays `discountAmountCents`.
  sponsorLodgingChangeCents    Int               @default(0)
  pricingDate                  String
  createdAt                    DateTime          @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoCode    PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, registrationId])
  @@index([eventId, createdAt])
  @@index([promoCodeId, createdAt])
}

/// A lodging change that moved a church's share after the church's invoice was finalized (#813), raised for the finance office. The invoice is never
/// revised automatically and the church's amount owed is not changed; the finance office sees this row (and clears it
/// once they have dealt with it). Ids and amounts only. One open row per registration.
model ChurchSponsorFinanceReview {
  id                      String    @id @default(cuid())
  eventId                 String
  registrationId          String
  churchId                String
  /// The finalized invoice version the change would have touched.
  invoiceVersionId        String?
  /// What last raised or updated it: "lodging:<request version id>" or "amendment:<id>".
  sourceKey               String
  /// The signed difference between what the church's share should be and what it is (and stays, while the invoice is
  /// finalized): the amount the finance office is asked to review. Updated in place while the flag is open.
  deltaCents              Int
  /// What the church's share should be (the recompute) when this flag was last raised or updated.
  desiredShareCents       Int
  createdAt               DateTime  @default(now())
  clearedAt               DateTime?
  clearedByUserId         String?
  clearNote               String?
  /// Set when the finance office clears the flag: the share they reviewed. A later recompute raises a new flag only if it
  /// differs from this figure. A flag that closes itself (the share returned to the invoiced amount) leaves it null.
  reviewedShareCents      Int?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  church       Organization @relation("ChurchSponsorFinanceReviewChurch", fields: [churchId], references: [id], onDelete: Restrict)

  @@index([registrationId, clearedAt])
  @@index([eventId, clearedAt])
  @@index([churchId])
}

