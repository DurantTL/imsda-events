model Honor {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  normalizedName String
  description    String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  offerings HonorOffering[]

  @@index([isActive, name])
  @@index([normalizedName])
}

/// A named class period at one Honors Weekend site (event). Names differ by
/// site, so they are data, never hard-coded.
model HonorSession {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  normalizedName String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offerings HonorOffering[]

  @@unique([eventId, normalizedName])
  @@index([eventId, sortOrder])
}

/// An honor taught at a site: in one session, or across all sessions.
/// `capacity` counts youth seats only. The migration adds CHECK constraints
/// and a partial unique index for ALL_SESSIONS offerings.
model HonorOffering {
  id           String            @id @default(cuid())
  eventId      String
  honorId      String
  sessionId    String?
  span         HonorOfferingSpan
  capacity     Int
  minimumAge   Int?
  perClubLimit Int?
  teacherName  String            @default("")
  location     String            @default("")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  honor       Honor             @relation(fields: [honorId], references: [id], onDelete: Restrict)
  session     HonorSession?     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollments HonorEnrollment[]

  @@unique([sessionId, honorId])
  @@index([eventId, isActive])
  @@index([honorId])
}

/// One person on one club's roster for one club year (#356). Birth dates are
/// sealed with `lib/secret-box.ts` (purpose `club-roster:birth-date`) and never
/// stored in plain text (ADR 0005 Addendum A).
model ClubRosterMember {
  id                   String                 @id @default(cuid())
  organizationId       String
  clubYear             String
  personId             String?
  attendeeType         ClubRosterAttendeeType
  role                 String                 @default("")
  classLevel           ClubClassLevel?
  /// Age as a form reported it (#376), for people imported without a birth
  /// date. Shown with "birth date needed" until the director adds one.
  reportedAge          Int?
  gender               ClubRosterGender?
  sealedBirthDate      String?
  status               ClubRosterStatus       @default(ACTIVE)
  source               ClubRosterSource
  sourceRegistrationId String?
  createdByAccountId   String?
  removedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdBy    AttendeeAccount? @relation("ClubRosterMemberCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, clubYear, personId])
  @@index([organizationId, clubYear, status])
  @@index([personId])
}

/// A person's Sterling Volunteers background check (#388), recorded from the
/// CSV a system administrator uploads. Only the dates are kept, never the file,
/// the birth date used to match, or any result that wasn't a clear check. One
/// row per person: a later upload with a later expiry replaces it.
model BackgroundCheck {
  id               String   @id @default(cuid())
  personId         String   @unique
  provider         String   @default("STERLING")
  /// Calendar dates ("2026-09-23"). Current through `expiresOn`.
  checkedOn        String?
  expiresOn        String
  recordedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([expiresOn])
}

/// A club's single registration for a club event (#358): an ordinary
/// Registration, billed to the church, tied to the club that made it.
model ClubEventRegistration {
  id                   String   @id @default(cuid())
  eventId              String
  organizationId       String
  registrationId       String   @unique
  submittedByAccountId String?
  createdAt            DateTime @default(now())

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  submittedBy  AttendeeAccount? @relation("ClubEventRegistrationSubmittedBy", fields: [submittedByAccountId], references: [id], onDelete: SetNull)
  assignment   ClubEventAssignment?

  @@unique([eventId, organizationId])
  @@index([organizationId])
}

/// A staff-set campsite/duty/activity assignment for one club's event
/// registration (#410). Kept separate from `ClubEventRegistration` /
/// `PublicRegistrationSubmission` so a club's submitted preferences and
/// staff's assignment decisions never overwrite each other. Simple and
/// replaceable by the general grouping engine (#89) if that lands later.
///
/// `version` bumps on every staff edit; `lastEmailedVersion` records which
/// version the assignment email last went out for. When they differ (or
/// nothing has been sent yet while something is set), the assignment has
/// "changed since sent".
model ClubEventAssignment {
  id                      String   @id @default(cuid())
  eventId                 String
  organizationId          String
  clubEventRegistrationId String   @unique
  campsiteLocation        String   @default("")
  campsiteNotes           String   @default("")
  dutyLabel               String   @default("")
  dutyDay                 String   @default("")
  dutyTime                String   @default("")
  activityLabel           String   @default("")
  notes                   String   @default("")
  version                 Int      @default(1)
  lastEmailSentAt         DateTime?
  lastEmailedVersion      Int?
  updatedByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  event                 Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clubEventRegistration ClubEventRegistration @relation(fields: [clubEventRegistrationId], references: [id], onDelete: Cascade)
  updatedBy             User?                 @relation("ClubEventAssignmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, organizationId])
  @@index([eventId, updatedAt])
}

/// A director's unsubmitted club registration, saved as they work so a reload
/// or closed tab loses nothing. Never holds birth dates: people are roster IDs.
model ClubRegistrationDraft {
  id                 String   @id @default(cuid())
  eventId            String
  organizationId     String
  selectedMemberIds  String[]
  /// People going who aren't on the roster (#388), e.g. a parent driver:
  /// [{ id, firstName, lastName, age, email }]. For this event only; they're
  /// never added to the roster. The server reads them from here at submit.
  guests             Json     @default("[]")
  responses          Json     @default("{}")
  attendeeResponses  Json     @default("{}")
  updatedByAccountId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy AttendeeAccount? @relation("ClubRegistrationDraftUpdatedBy", fields: [updatedByAccountId], references: [id], onDelete: SetNull)

  @@unique([eventId, organizationId])
}

/// A person's place in an Honors Weekend class (#359). Taken on the server
/// inside a serializable transaction with the class rows locked, so a class
/// can't be overfilled. Only youth consume a seat (`consumesSeat`).
model HonorEnrollment {
  id                     String   @id @default(cuid())
  eventId                String
  offeringId             String
  registrationId         String
  registrationAttendeeId String
  organizationId         String
  consumesSeat           Boolean
  createdAt              DateTime @default(now())

  event                Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offering             HonorOffering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  registration         Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationAttendee RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([registrationAttendeeId, offeringId])
  @@index([offeringId, consumesSeat])
  @@index([offeringId, organizationId, consumesSeat])
  @@index([registrationId])
}


enum CalendarEntryStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
}

/// An informational item on the public conference calendar (#107) for
/// something registered or managed elsewhere. Dates are calendar dates in the
/// conference's time zone; `timeLabel` is shown as written ("7–9 pm").
model CalendarEntry {
  id              String              @id @default(cuid())
  title           String
  description     String              @default("")
  startsOn        String
  endsOn          String
  timeLabel       String              @default("")
  location        String              @default("")
  category        String              @default("")
  linkUrl         String?
  status          CalendarEntryStatus @default(SCHEDULED)
  isPublished     Boolean             @default(false)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([isPublished, startsOn])
}

/// A passkey an attendee registered as their second step (e.g. to open club
/// rosters). Only the public key is stored; nothing biometric ever reaches
/// the server. Removing one sets `revokedAt` and it never verifies again.
model AttendeePasskey {
  id           String    @id @default(cuid())
  accountId    String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
}

enum PasskeyChallengePurpose {
  REGISTER
  VERIFY
  SIGN_IN
}

/// A one-time WebAuthn challenge, tied to the attendee session that asked for
/// it and consumed on first use so a response can't be replayed.
/// A single-use passkey prompt. REGISTER and VERIFY belong to a signed-in
/// session; SIGN_IN (#374) has none yet: it is tied to the browser by a
/// short-lived cookie holding its id, and the account is found only from the
/// verified credential.
model AttendeePasskeyChallenge {
  id        String                  @id @default(cuid())
  sessionId String?
  purpose   PasskeyChallengePurpose
  challenge String                  @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  session AttendeeSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, purpose])
  @@index([purpose, expiresAt])
}
