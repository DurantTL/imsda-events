enum MessageOutboxStatus {
  PENDING
  PROCESSING
  CAPTURED
  SENT
  FAILED
  SUPPRESSED
  CANCELLED
}

enum MessageAttemptStatus {
  CAPTURED
  SENT
  FAILED
