/// Whether an Honors Weekend offering fills one named session or every session
/// of its event (the 2026 "2-session honor").
enum ClubRosterAttendeeType {
  YOUTH
  STAFF
  ADULT
  UNDERAGE
}

enum ClubRosterGender {
  FEMALE
  MALE
}

/// REMOVED means the club took the person off: birth date and personal
/// fields are erased and the row stays only as history.
enum ClubRosterStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum ClubRosterSource {
  DIRECTOR
  REGISTRATION
  IMPORT
  /// Created by the receiving club's director starting a club member transfer (#489).
  TRANSFER
}

/// A conference invite to become a club's director or deputy (#376). Created
/// PENDING (by the club import); nothing is emailed until an administrator
/// presses Send. Only a SENT invite can be accepted, and only by a signed-in
/// account whose verified email is the invite's address.
enum ClubInviteStatus {
  PENDING
  SENT
  ACCEPTED
  CANCELLED
}

enum HonorOfferingSpan {
  SINGLE_SESSION
  ALL_SESSIONS
}

/// How an Honors Weekend instructor hears that a youth joined or left one of their classes (#1098).
enum HonorClassChangeEmails {
  DAILY
  IMMEDIATE
  OFF
}

enum HonorClassChangeKind {
  JOINED
  LEFT
}

enum ProgramAssignmentOutcome {
  ASSIGNED
  UNASSIGNED
}

enum ProgramUnassignedReason {
  NO_RANKED_CHOICES
  CAPACITY_FULL
}

model User {
  id            String            @id @default(cuid())
  healthPrivacyAcknowledgments HealthPrivacyAcknowledgment[]
  healthSnapshotHolds          HealthSnapshotHold[]        @relation("HealthSnapshotHoldPlacedBy")
  healthSnapshotHoldsLifted    HealthSnapshotHold[]        @relation("HealthSnapshotHoldLiftedBy")
  healthSnapshotBreakGlass     HealthSnapshotBreakGlass[]
  healthBreakGlassUses         HealthBreakGlassUse[]
  emailSuppressionsReenabled EmailAddressSuppression[] @relation("EmailSuppressionReenabledBy")
  email         String            @unique
  displayName   String
  jobTitle      String?
  phone         String?
  bio           String?
  globalRole    GlobalRole?
  accountStatus UserAccountStatus @default(ACTIVE)
  activatedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  /// The person's attendee side (#554, ADR 0013): one staff `User` links 1:1 to one
  /// `AttendeeAccount`. Nullable and unique; every row starts NULL and nothing reads or
  /// writes it yet. ON DELETE SET NULL: deleting an attendee account only unlinks, it
  /// never deletes the staff user (and deleting a user never touches the account).
  attendeeAccountId String? @unique
  attendeeAccount   AttendeeAccount? @relation("UserAttendeeLink", fields: [attendeeAccountId], references: [id], onDelete: SetNull)

  memberships               EventMembership[]
  credential                AuthCredential?
  sessions                  UserSession[]
  resetTokens               PasswordResetToken[]
  announcements             Announcement[]
  pinnedAnnouncements       Announcement[]        @relation("AnnouncementPinnedBy")
  auditLogs                 AuditLog[]
  archivedEvents            Event[]               @relation("EventArchivedBy")
  moduleRequests            ModuleRequest[] @relation("ModuleRequestRequester")
  moduleRequestsDecided     ModuleRequest[] @relation("ModuleRequestDecider")
  importRuns                ImportRun[]
  createdRegistrationForms  RegistrationForm[]        @relation("RegistrationFormCreatedBy")
  createdInformationForms         InformationForm[]        @relation("InformationFormCreatedBy")
  createdInformationFormVersions  InformationFormVersion[] @relation("InformationFormVersionCreatedBy")
  createdFormVersions       RegistrationFormVersion[] @relation("RegistrationFormVersionCreatedBy")
  formTestSubmissions       FormTestSubmission[]      @relation("FormTestSubmissionSubmittedBy")
  createdMessageVersions    MessageTemplateVersion[]  @relation("MessageTemplateVersionCreatedBy")
  createdPaymentInstructionVersions EventPaymentInstructionVersion[] @relation("PaymentInstructionVersionApprovedBy")
  platformSettingsUpdates   PlatformSettings[]        @relation("PlatformSettingsUpdatedBy")
  notificationSettingUpdates NotificationSetting[]    @relation("NotificationSettingUpdatedBy")
  adminAlertFeedReceipts     AdminAlertFeedReceipt[]
  uploadedEventAssets       EventAsset[]              @relation("EventAssetUploadedBy")
  uploadedMessageFiles      MessageFile[]             @relation("MessageFileUploadedBy")
  appliedProgramAssignments ProgramAssignmentRun[]    @relation("ProgramAssignmentAppliedBy")
  clubAssignmentUpdates     ClubEventAssignment[]     @relation("ClubEventAssignmentUpdatedBy")
  teamResultUpdates         ClubTeamResult[]          @relation("ClubTeamResultUpdatedBy")
  teamLevelCheckIns         ClubTeamLevelCheckIn[]    @relation("ClubTeamLevelCheckInBy")
  teamPermissionDecisions   ClubTeamMemberPermission[] @relation("ClubTeamPermissionDecidedBy")
  registrationOperations    RegistrationOperation[]   @relation("RegistrationOperationActor")
  accountMessages           MessageOutbox[]           @relation("AccountMessageRecipient")
  mfaEnrollment             UserMfaEnrollment?
  mfaChallenges             MfaChallenge[]
  updatedCommunitySettings  EventCommunitySettings[]  @relation("CommunitySettingsUpdatedBy")
  moderatedCommunityPosts   CommunityPost[]           @relation("CommunityPostModeratedBy")
  resolvedCommunityReports  CommunityReport[]         @relation("CommunityReportResolvedBy")
  createdMerchandiseAvailability MerchandiseVariantAvailability[] @relation("MerchandiseAvailabilityCreatedBy")
  createdMerchandiseOrders       MerchandiseOrder[]               @relation("MerchandiseOrderCreatedBy")
  merchandiseOrderStatusChanges  MerchandiseOrderStatusChange[]   @relation("MerchandiseOrderStatusActor")
  authoredStaffNotes             StaffNote[]                      @relation("StaffNoteAuthor")
  audienceSnapshots              EventAudienceSnapshot[]          @relation("EventAudienceSnapshotCreatedBy")
  scheduledEmailsCreated         ScheduledEmailBatch[]            @relation("ScheduledEmailCreatedBy")
  scheduledEmailsActivated       ScheduledEmailBatch[]            @relation("ScheduledEmailActivatedBy")
  authoredStaffNoteRevisions     StaffNoteRevision[]              @relation("StaffNoteRevisionAuthor")
  appliedRegistrationTags        RegistrationTagAssignment[]      @relation("RegistrationTagAppliedBy")
  removedRegistrationTags        RegistrationTagAssignment[]      @relation("RegistrationTagRemovedBy")
  appliedAttendeeTags            AttendeeTagAssignment[]          @relation("AttendeeTagAppliedBy")
  dismissedPersonMatchCandidates PersonMatchCandidate[]           @relation("PersonMatchCandidateDismissedBy")
  removedAttendeeTags            AttendeeTagAssignment[]          @relation("AttendeeTagRemovedBy")
  grantedClubDirectorships       ClubDirectorGrant[]              @relation("ClubDirectorGrantGrantedBy")
  revokedClubDirectorships       ClubDirectorGrant[]              @relation("ClubDirectorGrantRevokedBy")
  createdClubInvites             ClubInvite[]                     @relation("ClubInviteCreatedBy")
  decidedNewClubApplications     NewClubApplication[]             @relation("NewClubApplicationDecider")
  createdNewClubApplicationInvites NewClubApplicationInvite[]     @relation("NewClubApplicationInviteCreator")
  passkeys                       UserPasskey[]
  driverVerificationsReviewed    DriverVerification[]              @relation("DriverVerificationReviewedByUser")
  /// The person this staff account is explicitly linked to, if any. Grants
  /// nothing by itself — see `UserPersonLink`.
  personLink                        UserPersonLink?              @relation("UserPersonLinkUser")
  actorOnUserPersonLinks             UserPersonLink[]             @relation("UserPersonLinkActor")
  actorOnAttendeeAccountPersonLinks  AttendeeAccountPersonLink[]  @relation("AttendeeAccountPersonLinkActorUser")
  staffActAs                         StaffActAs[]                 @relation("StaffActAsUser")
  createdClubRosterMembers           ClubRosterMember[]           @relation("ClubRosterMemberCreatedByUser")
  createdRosterExportFormats         ClubRosterExportFormat[]     @relation("ClubRosterExportFormatCreatedByUser")
  confirmedRosterCarryForwards       ClubRosterCarryForward[]     @relation("ClubRosterCarryForwardByUser")

  recordedMemberHonorEntries         MemberHonorEntry[]           @relation("MemberHonorEntryRecordedByUser")
  honorEnrollmentOverrides           HonorEnrollment[]            @relation("HonorEnrollmentRequirementOverriddenBy")
  honorEnrollmentAdminPlacements     HonorEnrollment[]            @relation("HonorEnrollmentAdminPlacedBy")
  honorClassWaitlistOverrides        HonorClassWaitlistEntry[]    @relation("HonorClassWaitlistOverriddenBy")
  voidedMemberHonorEntries           MemberHonorEntryVoid[]       @relation("MemberHonorEntryVoidedByUser")
  initiatedMemberTransfers           MemberTransfer[]             @relation("MemberTransferInitiatedByUser")
  resolvedMemberTransfers            MemberTransfer[]             @relation("MemberTransferResolvedByUser")
  memberTransferEvents               MemberTransferEvent[]        @relation("MemberTransferEventActorUser")
  decidedMemberTransferMoves         MemberTransferRegistrationMove[] @relation("MemberTransferMoveDecidedBy")
  createdClubMeetingNotes            ClubMeetingNote[]             @relation("ClubMeetingNoteCreatedByUser")
  updatedClubMeetingNotes            ClubMeetingNote[]             @relation("ClubMeetingNoteUpdatedByUser")
  submittedClubEventRegistrations    ClubEventRegistration[]      @relation("ClubEventRegistrationSubmittedByUser")
  resolvedGeneralLinkSubmissions     GeneralLinkSubmission[]      @relation("GeneralLinkSubmissionResolvedBy")
  createdStaffInvitations            StaffInvitation[]            @relation("StaffInvitationCreatedBy")
  decidedStaffInvitations            StaffInvitation[]            @relation("StaffInvitationDecidedBy")
  updatedClubRegistrationDrafts      ClubRegistrationDraft[]      @relation("ClubRegistrationDraftUpdatedByUser")
  updatedClubSupplyStock             ClubSupplyStock[]            @relation("ClubSupplyStockUpdatedByUser")
  createdClubOrderBatches            ClubSupplyOrderBatch[]       @relation("ClubSupplyOrderBatchCreatedByUser")
  receivedClubOrderBatches           ClubSupplyOrderBatch[]       @relation("ClubSupplyOrderBatchReceivedByUser")

  createdEventTemplates              EventTemplate[]              @relation("EventTemplateCreatedBy")
  createdEventTemplateVersions       EventTemplateVersion[]       @relation("EventTemplateVersionCreatedBy")
  eventTemplateApplications          EventTemplateApplication[]   @relation("EventTemplateApplicationActor")
  eventCloneRecords                  EventCloneRecord[]           @relation("EventCloneRecordActor")
  enabledClubFormTemplates           ClubFormTemplate[]           @relation("ClubFormTemplateEnabledBy")
  createdClubFormLinks               ClubFormLink[]               @relation("ClubFormLinkCreatedByUser")
  enteredClubFormSubmissions         ClubFormSubmission[]         @relation("ClubFormSubmissionEnteredByUser")
  verifiedBillingContacts      OrganizationBillingContact[]              @relation("BillingContactVerifiedBy")
  createdBillingContacts       OrganizationBillingContact[]              @relation("BillingContactCreatedBy")
  endedBillingContacts         OrganizationBillingContact[]              @relation("BillingContactEndedBy")
  createdOrganizationContacts  OrganizationContact[]                     @relation("OrganizationContactCreatedBy")
  endedOrganizationContacts    OrganizationContact[]                     @relation("OrganizationContactEndedBy")
  setBillingResponsibilities   RegistrationBillingResponsibility[]       @relation("BillingResponsibilitySetBy")
  billingResponsibilityChanges RegistrationBillingResponsibilityChange[] @relation("BillingResponsibilityChangeActor")
  attendanceCorrections        AttendanceCorrection[]                    @relation("AttendanceCorrectionActor")
  preparedAttendanceVersions   AttendanceReconciliationVersion[]         @relation("AttendanceVersionPreparedBy")
  approvedAttendanceVersions   AttendanceReconciliationVersion[]         @relation("AttendanceVersionApprovedBy")
  attendanceReviewAcknowledgements AttendanceReviewAcknowledgement[]     @relation("AttendanceReviewAckActor")
  guardianAuthoritiesDeclared  GuardianAuthority[]                       @relation("GuardianAuthorityActorUser")
  acknowledgmentEvidenceRecorded AcknowledgmentEvidence[]                 @relation("AcknowledgmentEvidenceRecordedBy")
  acknowledgmentVoids AcknowledgmentVoid[] @relation("AcknowledgmentVoidedBy")
  guardianAuthoritiesRevoked   GuardianAuthority[]                       @relation("GuardianAuthorityRevokedBy")
  guardianConflictsResolved    GuardianAuthorityConflict[]               @relation("GuardianConflictResolvedBy")

  createdInvoiceVersions       InvoiceVersion[]                          @relation("InvoiceVersionCreatedBy")
  finalizedInvoiceVersions     InvoiceVersion[]                          @relation("InvoiceVersionFinalizedBy")
  sentInvoiceDeliveries        InvoiceDelivery[]                         @relation("InvoiceDeliverySentBy")
  recordedInvoiceArPostings    InvoiceArPosting[]                        @relation("InvoiceArPostingRecordedBy")
  recordedInvoicePayments      InvoicePayment[]                          @relation("InvoicePaymentRecordedBy")

  createdConsentPolicies         ConsentPolicy[]        @relation("ConsentPolicyCreatedBy")
  createdConsentPolicyVersions   ConsentPolicyVersion[] @relation("ConsentPolicyVersionCreatedBy")
  publishedConsentPolicyVersions ConsentPolicyVersion[] @relation("ConsentPolicyVersionPublishedBy")

  @@index([accountStatus])
}

model AuthCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordUpdatedAt DateTime  @default(now())
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  disabledAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  userAgentHash String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkeyChallenges UserPasskeyChallenge[]
  staffActAs StaffActAs[]

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

/**
 * Staff "act as" Area Coordinator or club director (#442), tied to the staff
 * session that started it, never to the staff member's own attendee account
 * (the accounts stay separate, decision 2026-09-25/27). Active only while
 * `endedAt` is null, `expiresAt` is in the future, AND the `staffSessionId`
 * session is itself still valid — a revoked or expired session makes this
 * inactive even before `endedAt` is written. A partial unique index keeps at
 * most one active row per staff session at the database level; starting a
 * new act-as ends the old one first (`REPLACED`) in the same transaction.
 */
model StaffActAs {
  id             String              @id @default(cuid())
  userId         String
  staffSessionId String
  role           StaffActAsRole
  /// Required for CLUB_DIRECTOR; null for AREA_COORDINATOR.
  organizationId String?
  startedAt      DateTime            @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  endedReason    StaffActAsEndReason?
  createdAt      DateTime            @default(now())

  user         User          @relation("StaffActAsUser", fields: [userId], references: [id], onDelete: Cascade)
  staffSession UserSession   @relation(fields: [staffSessionId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([staffSessionId, endedAt])
  @@index([organizationId])
}

enum StaffActAsRole {
  AREA_COORDINATOR
  CLUB_DIRECTOR
}

enum StaffActAsEndReason {
  STOPPED
  REPLACED
  SIGNED_OUT
  EXPIRED
}

/**
 * Second-factor enrolment. The TOTP secret is the one credential in this schema
 * that cannot be a digest — verifying a code needs the secret itself — so it is
 * sealed with AES-256-GCM instead (`lib/secret-box.ts`).
 */
model UserMfaEnrollment {
  id             String    @id @default(cuid())
  userId         String    @unique
  method         MfaMethod @default(TOTP)
  status         MfaStatus @default(PENDING)
  sealedSecret   String
  // The last accepted time step. A code, and everything before it, is spent —
  // this is what stops one being replayed inside its own thirty seconds.
  lastUsedStep   BigInt?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  confirmedAt    DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@index([status])
}

/**
 * Single-use fallbacks, stored as digests exactly like a session token.
 */
model MfaRecoveryCode {
  id           String    @id @default(cuid())
  enrollmentId String
  codeHash     String    @unique
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  enrollment UserMfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, usedAt])
}

/**
 * The state between a correct password and a completed second factor. Holding
 * it here rather than issuing a provisional session means a challenge can never
 * be mistaken for a signed-in session by any other code path.
 */
model MfaChallenge {
  id         String           @id @default(cuid())
  userId     String
  tokenHash  String           @unique
  purpose    MfaChallengeKind @default(SIGN_IN)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)
  userAgent  String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String              @id @default(cuid())
  userId    String
  tokenHash String              @unique
  purpose   AccountTokenPurpose @default(PASSWORD_RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/**
 * A registrant's identity, separate from `User` by decision (ADR 0003).
 * The separation is the security property, not an accident of modelling: every
 * permission in this schema is granted by an `EventMembership` pointing at a
 * `User`, and an account in this table has no way to reach one. Widening the
 * staff table to hold attendees would put a far larger population through the
 * checks that guard roster export and sensitive data, where one careless query
 * is the difference between a registrant and staff access.
 * `email` is the whole claim. An account reaches every registration whose
 * contact address matches it and nothing else, so the address is stored already
 * normalised and is only load-bearing once `emailVerifiedAt` is set.
 */
model AttendeeAccount {
  id                 String                @id @default(cuid())
  healthPrivacyAcknowledgments HealthPrivacyAcknowledgment[]
  teamPermissionDecisions ClubTeamMemberPermission[] @relation("ClubTeamPermissionDecidedByAccount")
  /// The staff `User` linked to this account (#554), if any. See `User.attendeeAccountId`.
  linkedUser         User?                 @relation("UserAttendeeLink")
  informationFormResponses InformationFormResponse[]
  email              String                @unique
  displayName        String
  firstName          String?
  lastName           String?
  phone              String?
  shirtSize          String?
  dietaryNeeds       String?
  accessibilityNeeds String?
  /// Optional mailing address and emergency contact the attendee keeps for
  /// themselves (#742). Used only to prefill their own registration forms;
  /// never listed or exported for staff. Components follow `AddressValue`.
  mailingLine1                 String?
  mailingLine2                 String?
  mailingCity                  String?
  mailingRegion                String?
  mailingPostalCode            String?
  mailingCountry               String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  status             AttendeeAccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?
  /**
   * Shuts the person out, whatever they sign in with. Distinct from
   * `AttendeeCredential.disabledAt`, which retires one method: an account that
   * only ever used Google has no credential row for a method-level flag to
   * live on, so the master switch has to be here.
   */
  disabledAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  honorInstructorRoles         HonorInstructor[]
  credential                   AttendeeCredential?
  identities                   AttendeeIdentity[]
  sessions                     AttendeeSession[]
  tokens                       AttendeeAccountToken[]
  mfaEnrollment                AttendeeMfaEnrollment?
  passkeys                     AttendeePasskey[]
  stepUpCodes                  AttendeeStepUpCode[]
  messages                     MessageOutbox[]          @relation("AttendeeMessageRecipient")
  communityParticipations      CommunityParticipation[]
  communityPosts               CommunityPost[]          @relation("CommunityPostAuthor")
  communityReports             CommunityReport[]        @relation("CommunityReportReporter")
  communityNotifications       CommunityNotification[]  @relation("CommunityNotificationRecipient")
  communityNotificationActions CommunityNotification[]  @relation("CommunityNotificationActor")
  /// The person this attendee account is explicitly linked to, if any.
  /// Grants nothing by itself — see `AttendeeAccountPersonLink`.
  personLink                        AttendeeAccountPersonLink?  @relation("AttendeeAccountPersonLinkAccount")
  actorOnAttendeeAccountPersonLinks AttendeeAccountPersonLink[] @relation("AttendeeAccountPersonLinkActorAccount")
  driverVerificationsReviewed       DriverVerification[]        @relation("DriverVerificationReviewedBy")
  /// Clubs this account directs. Explicit staff grants only — never inferred.
  clubDirectorGrants                ClubDirectorGrant[]
  areaCoordinatorGrant              AreaCoordinatorGrant?
  coordinatedLocations              EventLocation[]                  @relation("EventLocationCoordinator")
  grantedClubRoles                  ClubDirectorGrant[]              @relation("ClubDirectorGrantGrantedByAccount")
  acceptedClubInvites               ClubInvite[]                     @relation("ClubInviteAcceptedAccount")
  createdClubInvites                ClubInvite[]                     @relation("ClubInviteCreatedByAccount")
  revokedClubRoles                  ClubDirectorGrant[]              @relation("ClubDirectorGrantRevokedByAccount")
  createdClubRosterMembers          ClubRosterMember[]          @relation("ClubRosterMemberCreatedBy")
  createdRosterExportFormats        ClubRosterExportFormat[]    @relation("ClubRosterExportFormatCreatedBy")
  confirmedRosterCarryForwards      ClubRosterCarryForward[]    @relation("ClubRosterCarryForwardByAccount")

  recordedMemberHonorEntries        MemberHonorEntry[]          @relation("MemberHonorEntryRecordedBy")
  voidedMemberHonorEntries          MemberHonorEntryVoid[]      @relation("MemberHonorEntryVoidedBy")
  initiatedMemberTransfers          MemberTransfer[]            @relation("MemberTransferInitiatedByAccount")
  resolvedMemberTransfers           MemberTransfer[]            @relation("MemberTransferResolvedByAccount")
  memberTransferEvents              MemberTransferEvent[]       @relation("MemberTransferEventActorAccount")
  submittedClubRegistrations        ClubEventRegistration[]     @relation("ClubEventRegistrationSubmittedBy")
  clubRegistrationDrafts            ClubRegistrationDraft[]     @relation("ClubRegistrationDraftUpdatedBy")
  /// Club registration amendments this account made as a director reopening
  /// their own club's registration (H3b, #366).
  amendedRegistrationOperations     RegistrationOperation[]     @relation("RegistrationOperationActorAttendeeAccount")
  updatedClubSupplyStock            ClubSupplyStock[]           @relation("ClubSupplyStockUpdatedByAccount")
  createdClubOrderBatches           ClubSupplyOrderBatch[]      @relation("ClubSupplyOrderBatchCreatedByAccount")
  receivedClubOrderBatches          ClubSupplyOrderBatch[]      @relation("ClubSupplyOrderBatchReceivedByAccount")
  createdClubFormLinks              ClubFormLink[]              @relation("ClubFormLinkCreatedByAccount")
  enteredClubFormSubmissions        ClubFormSubmission[]        @relation("ClubFormSubmissionEnteredByAccount")

  @@index([status])
}

/**
 * A sign-in method owned by somebody else — today, Google.
 * `subject` is the provider's immutable identifier for the person, and it is
 * what the account is actually keyed on. The address is stored alongside it for
 * display and support, never for matching: a Google account can change its
 * email, and following that change blindly would move an account onto an
 * address it never proved control of.
 * The unique constraint on (provider, subject) is what stops one Google account
 * from reaching two attendee accounts.
 */
model AttendeeIdentity {
  id         String                   @id @default(cuid())
  accountId  String
  provider   AttendeeIdentityProvider
  subject    String
  email      String
  createdAt  DateTime                 @default(now())
  lastUsedAt DateTime?

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([accountId, provider])
  @@index([accountId])
}

/// Mirrors `AuthCredential`, including its lockout counters. Kept as its own
/// table so a query for staff credentials can never return an attendee's.
model AttendeeCredential {
  id                String    @id @default(cuid())
  accountId         String    @unique
  passwordHash      String
  passwordUpdatedAt DateTime  @default(now())
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  disabledAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// Mirrors `UserSession`. A distinct table and a distinct cookie name are what
/// stop an attendee session from ever being resolved by `getCurrentSession`.
model AttendeeSession {
  id            String    @id @default(cuid())
  accountId     String
  tokenHash     String    @unique
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  userAgentHash String?
  /// When this session last passed the authenticator check that opens club
  /// rosters (ADR 0005 Addendum A). Sign-in alone never sets it.
  secondFactorVerifiedAt DateTime?
  createdAt     DateTime  @default(now())

  account           AttendeeAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passkeyChallenges AttendeePasskeyChallenge[]

  @@index([accountId, expiresAt])
  @@index([expiresAt, revokedAt])
}

/**
 * One-time credentials belonging to an account rather than to a session.
 * Both purposes carry both halves: `tokenHash` is the handle held by the
 * browser that asked, and `codeHash` is the secret that arrives by email.
 * Needing both is what binds the act to the person who started it — a code
 * forwarded out of an inbox is useless without the session that requested it,
 * which is the same reasoning ADR 0003 applies to editing.
 * `codeHash` is null between issuing and sending: the code is minted when the
 * message actually leaves, so a database read never yields a usable credential.
 */
model AttendeeAccountToken {
  id                String               @id @default(cuid())
  accountId         String
  tokenHash         String               @unique
  codeHash          String?
  // Retry-stable association with the outbox row that first prepared the code.
  deliveryMessageId String?              @unique
  // Recoverable only by the application encryption key. This lets a retry send
  // the same code without storing a usable credential in a database dump.
  sealedCode        String?
  // The request handle may outlive a slow queue; the code itself gets a fresh,
  // shorter lifetime when delivery preparation first succeeds.
  codeExpiresAt     DateTime?
  purpose           AttendeeTokenPurpose
  expiresAt         DateTime
  usedAt            DateTime?
  attempts          Int                  @default(0)
  createdAt         DateTime             @default(now())

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, usedAt])
  @@index([expiresAt])
  @@index([codeExpiresAt])
}

/**
 * Second factor for an attendee account. Built now rather than later because
 * retrofitting one means a migration, a recovery-code scheme, and a rollout
 * across accounts that already exist (ADR 0003).
 * Holding an enrolment is not a condition of holding an account. It becomes
 * required by what is being touched — medical information and club rosters —
 * not by who is touching it.
 */
model AttendeeMfaEnrollment {
  id             String    @id @default(cuid())
  accountId      String    @unique
  method         MfaMethod @default(TOTP)
  status         MfaStatus @default(PENDING)
  sealedSecret   String
  lastUsedStep   BigInt?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  confirmedAt    DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account       AttendeeAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recoveryCodes AttendeeMfaRecoveryCode[]

  @@index([status])
}

model AttendeeMfaRecoveryCode {
  id           String    @id @default(cuid())
  enrollmentId String
  codeHash     String    @unique
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  enrollment AttendeeMfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, usedAt])
}

/**
 * The freshly emailed code that authorises a change, held here rather than
 * expressed as a link.
 * `sessionId` is why this table exists at all. A link in an inbox works for
 * whoever opens it and survives forwarding; a code has to be carried back into
 * the session that asked for it, which binds the change to the person making
 * it. Storing the requesting session is what makes that check possible.
 */
model AttendeeStepUpCode {
  id                String                @id @default(cuid())
  accountId         String
  sessionId         String
  codeHash          String?               @unique
  deliveryMessageId String?               @unique
  sealedCode        String?
  codeExpiresAt     DateTime?
  purpose           AttendeeStepUpPurpose @default(REGISTRATION_EDIT)
  expiresAt         DateTime
  consumedAt        DateTime?
  attempts          Int                   @default(0)
  createdAt         DateTime              @default(now())

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, consumedAt])
  @@index([expiresAt])
  @@index([codeExpiresAt])
}

/**
 * One row per alert condition, so a condition that persists pages once an hour
 * rather than every time the monitor runs. Without this, a backed-up queue
 * would send an alert every five minutes and be muted by whoever receives it.
 */
model AlertNotification {
  id          String    @id @default(cuid())
  key         String    @unique
  severity    String
  summary     String
  firstSeenAt DateTime  @default(now())
  lastSentAt  DateTime
  sendCount   Int       @default(1)
  resolvedAt  DateTime?

  @@index([lastSentAt])
  @@index([resolvedAt])
}

/**
 * When each unattended job last finished. The outbox sweep also runs the alert
 * scan, so it cannot raise an alert about itself stopping; this row is what
 * lets `/api/health` and the command center notice a sweep that went quiet.
 */
model SystemJobHeartbeat {
  job             String    @id
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  updatedAt       DateTime  @updatedAt
}

/**
 * One row per backup run or restore rehearsal, written by the backup container
 * (scripts/backup/record-status.sh) and read by `/api/health`. Holds times,
 * sizes and pass/fail only: no file names, paths, row contents or credentials.
 * `kind` is BACKUP or REHEARSAL; `offsiteOk` is null when no off-site copy is
 * configured (or for a rehearsal).
 */
model BackupRun {
  id          Int       @id @default(autoincrement())
  kind        String
  startedAt   DateTime
  finishedAt  DateTime
  ok          Boolean
  dumpBytes   BigInt?
  assetsBytes BigInt?
  offsiteOk   Boolean?

  @@index([kind, finishedAt])
}

model RateLimitBucket {
  id              String   @id @default(cuid())
  policy          String
  subjectHash     String
  count           Int
  windowStartedAt DateTime
  windowEndsAt    DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([policy, subjectHash, windowStartedAt])
  @@index([expiresAt])
  @@index([policy, windowEndsAt])
}

/// A block of an event's public page: speaker bios, seminar descriptions,
/// lodging, the schedule, the teen programme.
///
/// Deliberately generic rather than a model per topic. Every one of those is a
/// heading and a body, and a table called Speaker would have to grow a second
/// one called Seminar the first time staff wanted something the platform had
/// not anticipated. Publishing is per section, so a half-written page can sit
/// beside a live one without a draft of the whole page.
model EventContentSection {
  id          String                  @id @default(cuid())
  eventId     String
  kind        EventContentSectionKind @default(RICH_TEXT)
  title       String
  /// Plain text with blank-line paragraphs. Not HTML: this is rendered on a
  /// public page, and accepting markup from a form is how a content field
  /// becomes a cross-site scripting hole.
  body        String                  @default("")
  /// Set for NOTICE cards only.
  tone        EventContentTone?
  placement   EventContentPlacement   @default(PUBLIC_PAGE)
  /// STEPS and CHECKLIST entries: `[{ "title": string, "text": string }]`.
  /// Plain text, validated by modules/events/content-schemas.ts.
  items       Json                    @default("[]")
  /// Per-kind content for the #816 blocks (HERO, IMAGE, GALLERY, EMBED, FAQ,
  /// SCHEDULE, SPEAKERS, CONTACT, COUNTDOWN). Validated by zod in
  /// modules/events/content-schemas.ts on save and again on read. `{}` for
  /// every older kind.
  data        Json                    @default("{}")
  position    Int
  isPublished Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  event  Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  links  EventContentLink[]
  assets EventContentSectionAsset[]

  @@index([eventId, position])
  @@index([eventId, isPublished])
}

/// An uploaded image a block's `data` points at (#816), derived from `data` on
/// every save. It is what lets the public asset route serve a published
/// block's image, and what makes deleting a file that a block still shows fail
/// loudly (Restrict) instead of leaving a broken picture.
model EventContentSectionAsset {
  sectionId String
  assetId   String

  section EventContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  asset   EventAsset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([sectionId, assetId])
  @@index([assetId])
}

/// One resource tile inside a RESOURCE_LINKS section.
/// One resource tile: either an address elsewhere, or a file uploaded here.
/// Exactly one of `url` and `assetId` is set; the migration carries the XOR
/// check Prisma cannot express.
model EventContentLink {
  id          String  @id @default(cuid())
  sectionId   String
  label       String
  description String  @default("")
  url         String?
  assetId     String?
  position    Int

  section EventContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Restrict, not cascade: deleting a file that a published page still links
  /// to should fail loudly rather than quietly leave a dead tile.
  asset   EventAsset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([sectionId, position])
  @@index([assetId])
}

/// A file staff uploaded for an event page.
///
/// `contentType` is the verified type, not the one the upload claimed, and
/// `storageKey` is generated here — never derived from the uploaded filename.
/// `displayName` is a label only, and is what a download is offered as.
model EventAsset {
  id               String   @id @default(cuid())
  eventId          String
  displayName      String
  contentType      String
  byteSize         Int
  checksum         String
  storageKey       String   @unique
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation("EventAssetUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  links      EventContentLink[]
  blockRefs  EventContentSectionAsset[]
  merchandiseArtworkProducts MerchandiseProduct[] @relation("MerchandiseProductArtwork")
  badgeBackgroundEvents      Event[]              @relation("EventBadgeBackground")

  @@index([eventId, createdAt])
}

/// Platform-wide identity and the defaults a new event inherits.
///
/// Exactly one row, pinned by `id`. A singleton in a table rather than
/// environment variables because staff change these, and a value staff can
/// change should not require a deploy. The messaging defaults exist because
/// every event previously began on LOCAL_CAPTURE with no sender at all: the
/// event looked ready, and the first symptom was a registrant who never got
/// their confirmation.
model PlatformSettings {
  id                        String             @id @default("platform")
  organizationName          String             @default("IMSDA Events")
  logoUrl                   String?
  supportContact            String?
  publicWebsiteUrl          String?
  defaultTimezone           String             @default("America/Chicago")
  defaultSenderName         String             @default("IMSDA Events")
  defaultSenderEmail        String?
  defaultReplyToEmail       String?
  defaultAttendeeEditPolicy AttendeeEditPolicy @default(VERIFY_EVERY_EDIT)
  /// The WebAuthn relying-party ID (the site's domain, e.g. "events.imsda.org").
  /// Passkeys stay hidden until it is set and matches the page's origin, so an
  /// unconfigured or misconfigured deployment falls back to authenticator codes.
  passkeyRpId               String?
  /// Where the short lockout alert goes (#456), in addition to the account
  /// holder. Blank means only the account holder is emailed.
  securityAlertEmail        String?
  /// The editable header block of the church invoice PDF (#780). All blank: the PDF falls back to `organizationName`.
  invoiceHeaderDepartment   String?
  invoiceHeaderOrganization String?
  /// Mailing address, one line per row.
  invoiceHeaderAddress      String?
  invoiceHeaderPhone        String?
  /// Where "a new club applied" notices go (#817), e.g. the youth department administrative assistant. Blank means no notice is sent; applications still wait in the queue.
  newClubApplicationEmail   String?
  /// The one-sign-in switch (#554, ADR 0013). OFF by default; nothing reads it yet.
  /// Later slices put the unified sign-in and role-aware landing behind it.
  unifiedSignInEnabled      Boolean            @default(false)
  updatedAt                 DateTime           @updatedAt
  updatedByUserId           String?

  updatedBy User? @relation("PlatformSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

/// One on/off switch per automatic staff alert (#1016). The alert's key lives in
/// `modules/notifications/catalog.ts`. A missing row means ON, so nothing changes
/// until someone turns an alert off.
model NotificationSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  enabled         Boolean  @default(true)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("NotificationSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

/// One alert occurrence in the system administrator feed (#1033). Written in the same transaction as the alert's
/// outbox email, never carries answers, medical or payment details, and is dropped from the feed after 90 days.
model AdminAlertFeedItem {
  id              String   @id @default(cuid())
  /// A `notificationKeys` value from the #1016 catalog.
  notificationKey String
  /// One value per alert occurrence (retries and extra recipients share it), so a rewrite is a no-op.
  occurrenceKey   String   @unique
  /// A short neutral label, never free text from a person.
  summary         String
  /// An internal same-site path, or null when there is nothing to open.
  href            String?
  occurredAt      DateTime @default(now())

  receipts AdminAlertFeedReceipt[]

  @@index([occurredAt])
}

/// One administrator has read one feed item. A missing row means unread.
model AdminAlertFeedReceipt {
  itemId String
  userId String
  readAt DateTime @default(now())

  item AdminAlertFeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
}

model Event {
  id                   String             @id @default(cuid())
  healthSnapshots      HealthRecordSnapshot[]
  healthSnapshotHolds  HealthSnapshotHold[]
  slug                 String             @unique
  name                 String
  startsAt             DateTime
  endsAt               DateTime
  timezone             String             @default("America/Chicago")
  location             String?
  capacity             Int?
  publicInfoUrl        String?
  supportContact       String?
  /// Theme or tagline shown in the public event header (#651), e.g. "Lest We Forget".
  tagline              String?
  /// One line under the header's dates (#651).
  subtitle             String?
  /// Where the event's help card and notices send people (#651); club events fall back to youth@imsda.org.
  helpEmail            String?
  /// Heading of the attendee event hub (#104). Null shows the default, "Event hub".
  hubTitle             String?
  /// Intro paragraph under the hub heading (#104). Null shows the default intro.
  hubIntro             String?
  /// Refund policy shown to registrants (#891): plain text, paragraphs split on blank lines. Display only; refund rules and processing live elsewhere. Blank hides it.
  refundPolicy         String?
  isPublished          Boolean            @default(false)
  registrationOpensOn  String?
  registrationClosesOn String?
  /// The date balances are due by (#993), in the event's own calendar. Only a date that "N days before payment due" scheduled emails count back from: no late fee, nothing is blocked, and it changes no wording. Null means none.
  paymentDueOn         String?
  waitlistEnabled      Boolean            @default(false)
  autoPromoteWaitlist  Boolean            @default(true)
  /// How many hours a club director has to accept a seat offered from an Honors Weekend class waitlist (#831); an offer not accepted in time passes to the next youth in line.
  honorWaitlistOfferHours Int             @default(24)
  /// Whether this event collects a shirt size per attendee. Replaces a match on
  /// the event's name, which meant only one event could ever collect sizes and
  /// renaming it turned collection off without telling anyone.
  collectsShirtSizes   Boolean            @default(false)
  /// Event-owned selections for the grouped operational packets (#155): which sections print and which
  /// registration answer groups them. Null prints the default packet (every section, automatic grouping).
  /// Parsed by `parseEventPacketConfig`; never read directly.
  operationalPacketConfig Json?
  /// A youth or children's event, where parents aren't normally present (#388).
  /// Every adult registered is flagged until they have a current Sterling
  /// Volunteers background check on file. Registration is never blocked; check-in holds a not-current
  /// adult or staff member unless staff type an audited override (#874).
  checksAdultBackgrounds Boolean          @default(false)
  /// Offers "Pay on Square" (Square's hosted checkout page) next to the embedded card form (#327).
  /// Off by default; staff turn it on for attendee-paid events.
  hostedPaymentLinkEnabled Boolean        @default(false)
  /// One public "general registration link" for a club event (#931): directors with no account register a team through
  /// it, and it is matched to the club they pick. Off by default; on for the Pathfinder Bible Experience starter.
  generalRegistrationLinkEnabled Boolean  @default(false)
  /// A person is a minor at this event when their age on the event's start date is below this (#131).
  ageOfMajority        Int                @default(18)
  attendeeEditPolicy   AttendeeEditPolicy @default(VERIFY_EVERY_EDIT)
  billingMode          EventBillingMode   @default(ATTENDEE_PAY)
  /// Invoice grouping for a deferred-invoice event (#165); only MANAGE_FINANCE changes it, and every change is audited.
  invoiceGrouping                    InvoiceGrouping    @default(PER_CHURCH)
  /// Explicit invoice-number prefix (#167), letters only; blank derives it from the name. Staff set it
  /// before the first invoice is finalized; a trigger refuses a change after the event has a number series.
  invoiceCode                        String?
  /// The payment instruction printed on every invoice PDF (#168), editable by finance staff; blank uses the built-in
  /// default. Copied onto each invoice's document when its PDF is first made, so later edits never change an earlier PDF.
  invoicePaymentInstructions         String?
  /// The heading the invoice PDF groups registration lines under, such as "Pathfinders" (#780). Blank prints "Registrations".
  invoiceClubType                    String?
  /// Explicit audience (#481), independent of `billingMode`: club and church
  /// navigation, club registration oversight, and club reports key off this
  /// field, not the billing mode.
  audience             EventAudience      @default(GENERAL)
  seminarPreferenceClosesOn          String?
  seminarPreferenceSelfServiceLocked Boolean @default(false)
  /// Lodging for this event, rendered into messages through the
  /// `{{hotel_information}}` token. Every field is optional and the block is
  /// omitted entirely when `hotelName` is unset, because most events book no
  /// room block and a hotel embedded in a shared template would follow an event
  /// that never used it.
  hotelName            String?
  hotelBookingUrl      String?
  hotelPhone           String?
  hotelGroupName       String?
  hotelRate            String?
  hotelInstructions    String?
  /// Artwork printed behind every attendee name badge for this event. An
  /// event's own uploaded image, so a conference badge does not have to be
  /// laid out in another tool and hand-fed through a printer twice.
  badgeBackgroundAssetId String?
  /// Published events appear on the public conference calendar unless a
  /// system administrator hides them there (#107). Unpublished events never do.
  showOnCalendar       Boolean            @default(true)
  /// Short label for filtering the public calendar, e.g. "Youth" or "Camp meeting".
  calendarCategory     String?
  /// Set when staff archive the event (#635): hidden from pickers, default selection and every public page, and registration
  /// is closed, but nothing is deleted or changed. Null means the event is not archived. Unarchiving clears both fields.
  archivedAt           DateTime?
  /// Who archived it. Kept as an id only; cleared with `archivedAt`, and null if that account is later deleted.
  archivedByUserId     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  /// The calendar items this event was set up from or linked to (#445). Several items can share one registration
  /// event (#1086): different dates or sites of one event, or a snow date.
  calendarEntryLinks                  CalendarEntry[]    @relation("CalendarEntryLinkedEvent")
  calendarMatchDismissals             CalendarEventMatchDismissal[] @relation("CalendarMatchDismissalEvent")
  archivedBy                          User?              @relation("EventArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)

  badgeBackground                     EventAsset?        @relation("EventBadgeBackground", fields: [badgeBackgroundAssetId], references: [id], onDelete: Restrict)
  memberships                         EventMembership[]
  contentSections                     EventContentSection[]
  assets                              EventAsset[]
  messageFiles                        MessageFile[]
