model User {
  id            String            @id @default(cuid())
  email         String            @unique
  displayName   String
  jobTitle      String?
  phone         String?
  bio           String?
  globalRole    GlobalRole?
  accountStatus UserAccountStatus @default(ACTIVE)
  activatedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  memberships               EventMembership[]
  credential                AuthCredential?
  sessions                  UserSession[]
  resetTokens               PasswordResetToken[]
  announcements             Announcement[]
  pinnedAnnouncements       Announcement[]        @relation("AnnouncementPinnedBy")
  auditLogs                 AuditLog[]
  moduleRequests            ModuleRequest[] @relation("ModuleRequestRequester")
  moduleRequestsDecided     ModuleRequest[] @relation("ModuleRequestDecider")
  importRuns                ImportRun[]
  createdRegistrationForms  RegistrationForm[]        @relation("RegistrationFormCreatedBy")
  createdFormVersions       RegistrationFormVersion[] @relation("RegistrationFormVersionCreatedBy")
  formTestSubmissions       FormTestSubmission[]      @relation("FormTestSubmissionSubmittedBy")
  createdMessageVersions    MessageTemplateVersion[]  @relation("MessageTemplateVersionCreatedBy")
  createdPaymentInstructionVersions EventPaymentInstructionVersion[] @relation("PaymentInstructionVersionApprovedBy")
  platformSettingsUpdates   PlatformSettings[]        @relation("PlatformSettingsUpdatedBy")
  uploadedEventAssets       EventAsset[]              @relation("EventAssetUploadedBy")
  appliedProgramAssignments ProgramAssignmentRun[]    @relation("ProgramAssignmentAppliedBy")
  clubAssignmentUpdates     ClubEventAssignment[]     @relation("ClubEventAssignmentUpdatedBy")
  registrationOperations    RegistrationOperation[]   @relation("RegistrationOperationActor")
  accountMessages           MessageOutbox[]           @relation("AccountMessageRecipient")
  mfaEnrollment             UserMfaEnrollment?
  mfaChallenges             MfaChallenge[]
  updatedCommunitySettings  EventCommunitySettings[]  @relation("CommunitySettingsUpdatedBy")
  moderatedCommunityPosts   CommunityPost[]           @relation("CommunityPostModeratedBy")
  resolvedCommunityReports  CommunityReport[]         @relation("CommunityReportResolvedBy")
  createdMerchandiseAvailability MerchandiseVariantAvailability[] @relation("MerchandiseAvailabilityCreatedBy")
  createdMerchandiseOrders       MerchandiseOrder[]               @relation("MerchandiseOrderCreatedBy")
  merchandiseOrderStatusChanges  MerchandiseOrderStatusChange[]   @relation("MerchandiseOrderStatusActor")
  authoredStaffNotes             StaffNote[]                      @relation("StaffNoteAuthor")
  authoredStaffNoteRevisions     StaffNoteRevision[]              @relation("StaffNoteRevisionAuthor")
  appliedRegistrationTags        RegistrationTagAssignment[]      @relation("RegistrationTagAppliedBy")
  removedRegistrationTags        RegistrationTagAssignment[]      @relation("RegistrationTagRemovedBy")
  appliedAttendeeTags            AttendeeTagAssignment[]          @relation("AttendeeTagAppliedBy")
  dismissedPersonMatchCandidates PersonMatchCandidate[]           @relation("PersonMatchCandidateDismissedBy")
  removedAttendeeTags            AttendeeTagAssignment[]          @relation("AttendeeTagRemovedBy")
  grantedClubDirectorships       ClubDirectorGrant[]              @relation("ClubDirectorGrantGrantedBy")
  revokedClubDirectorships       ClubDirectorGrant[]              @relation("ClubDirectorGrantRevokedBy")
  createdClubInvites             ClubInvite[]                     @relation("ClubInviteCreatedBy")
  passkeys                       UserPasskey[]
  driverVerificationsReviewed    DriverVerification[]              @relation("DriverVerificationReviewedByUser")
  /// The person this staff account is explicitly linked to, if any. Grants
  /// nothing by itself — see `UserPersonLink`.
  personLink                        UserPersonLink?              @relation("UserPersonLinkUser")
  actorOnUserPersonLinks             UserPersonLink[]             @relation("UserPersonLinkActor")
  actorOnAttendeeAccountPersonLinks  AttendeeAccountPersonLink[]  @relation("AttendeeAccountPersonLinkActorUser")
  staffActAs                         StaffActAs[]                 @relation("StaffActAsUser")
  createdClubRosterMembers           ClubRosterMember[]           @relation("ClubRosterMemberCreatedByUser")
  createdRosterExportFormats         ClubRosterExportFormat[]     @relation("ClubRosterExportFormatCreatedByUser")

  recordedMemberHonorEntries         MemberHonorEntry[]           @relation("MemberHonorEntryRecordedByUser")
  voidedMemberHonorEntries           MemberHonorEntryVoid[]       @relation("MemberHonorEntryVoidedByUser")
  initiatedMemberTransfers           MemberTransfer[]             @relation("MemberTransferInitiatedByUser")
  resolvedMemberTransfers            MemberTransfer[]             @relation("MemberTransferResolvedByUser")
  memberTransferEvents               MemberTransferEvent[]        @relation("MemberTransferEventActorUser")
  decidedMemberTransferMoves         MemberTransferRegistrationMove[] @relation("MemberTransferMoveDecidedBy")
  createdClubMeetingNotes            ClubMeetingNote[]             @relation("ClubMeetingNoteCreatedByUser")
  updatedClubMeetingNotes            ClubMeetingNote[]             @relation("ClubMeetingNoteUpdatedByUser")
  submittedClubEventRegistrations    ClubEventRegistration[]      @relation("ClubEventRegistrationSubmittedByUser")
  updatedClubRegistrationDrafts      ClubRegistrationDraft[]      @relation("ClubRegistrationDraftUpdatedByUser")
  updatedClubSupplyStock             ClubSupplyStock[]            @relation("ClubSupplyStockUpdatedByUser")
  createdClubOrderBatches            ClubSupplyOrderBatch[]       @relation("ClubSupplyOrderBatchCreatedByUser")
  receivedClubOrderBatches           ClubSupplyOrderBatch[]       @relation("ClubSupplyOrderBatchReceivedByUser")

  createdEventTemplates              EventTemplate[]              @relation("EventTemplateCreatedBy")
  createdEventTemplateVersions       EventTemplateVersion[]       @relation("EventTemplateVersionCreatedBy")
  eventTemplateApplications          EventTemplateApplication[]   @relation("EventTemplateApplicationActor")
  eventCloneRecords                  EventCloneRecord[]           @relation("EventCloneRecordActor")
  enabledClubFormTemplates           ClubFormTemplate[]           @relation("ClubFormTemplateEnabledBy")
  createdClubFormLinks               ClubFormLink[]               @relation("ClubFormLinkCreatedByUser")
  enteredClubFormSubmissions         ClubFormSubmission[]         @relation("ClubFormSubmissionEnteredByUser")
  verifiedBillingContacts      OrganizationBillingContact[]              @relation("BillingContactVerifiedBy")
  createdBillingContacts       OrganizationBillingContact[]              @relation("BillingContactCreatedBy")
  endedBillingContacts         OrganizationBillingContact[]              @relation("BillingContactEndedBy")
  setBillingResponsibilities   RegistrationBillingResponsibility[]       @relation("BillingResponsibilitySetBy")
  billingResponsibilityChanges RegistrationBillingResponsibilityChange[] @relation("BillingResponsibilityChangeActor")
  attendanceCorrections        AttendanceCorrection[]                    @relation("AttendanceCorrectionActor")
  preparedAttendanceVersions   AttendanceReconciliationVersion[]         @relation("AttendanceVersionPreparedBy")
  approvedAttendanceVersions   AttendanceReconciliationVersion[]         @relation("AttendanceVersionApprovedBy")
  attendanceReviewAcknowledgements AttendanceReviewAcknowledgement[]     @relation("AttendanceReviewAckActor")
  guardianAuthoritiesDeclared  GuardianAuthority[]                       @relation("GuardianAuthorityActorUser")
  guardianAuthoritiesRevoked   GuardianAuthority[]                       @relation("GuardianAuthorityRevokedBy")
  guardianConflictsResolved    GuardianAuthorityConflict[]               @relation("GuardianConflictResolvedBy")

  createdInvoiceVersions       InvoiceVersion[]                          @relation("InvoiceVersionCreatedBy")
  finalizedInvoiceVersions     InvoiceVersion[]                          @relation("InvoiceVersionFinalizedBy")
  sentInvoiceDeliveries        InvoiceDelivery[]                         @relation("InvoiceDeliverySentBy")
  recordedInvoiceArPostings    InvoiceArPosting[]                        @relation("InvoiceArPostingRecordedBy")
  recordedInvoicePayments      InvoicePayment[]                          @relation("InvoicePaymentRecordedBy")

  @@index([accountStatus])
}

model AuthCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordUpdatedAt DateTime  @default(now())
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  disabledAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  userAgentHash String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkeyChallenges UserPasskeyChallenge[]
  staffActAs StaffActAs[]

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

/**
 * Staff "act as" Area Coordinator or club director (#442), tied to the staff
 * session that started it, never to the staff member's own attendee account
 * (the accounts stay separate, decision 2026-09-25/27). Active only while
 * `endedAt` is null, `expiresAt` is in the future, AND the `staffSessionId`
 * session is itself still valid — a revoked or expired session makes this
 * inactive even before `endedAt` is written. A partial unique index keeps at
 * most one active row per staff session at the database level; starting a
 * new act-as ends the old one first (`REPLACED`) in the same transaction.
 */
model StaffActAs {
  id             String              @id @default(cuid())
  userId         String
  staffSessionId String
  role           StaffActAsRole
  /// Required for CLUB_DIRECTOR; null for AREA_COORDINATOR.
  organizationId String?
  startedAt      DateTime            @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  endedReason    StaffActAsEndReason?
  createdAt      DateTime            @default(now())

  user         User          @relation("StaffActAsUser", fields: [userId], references: [id], onDelete: Cascade)
  staffSession UserSession   @relation(fields: [staffSessionId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([staffSessionId, endedAt])
  @@index([organizationId])
}

enum StaffActAsRole {
  AREA_COORDINATOR
  CLUB_DIRECTOR
}

enum StaffActAsEndReason {
  STOPPED
  REPLACED
  SIGNED_OUT
  EXPIRED
}

/**
 * Second-factor enrolment. The TOTP secret is the one credential in this schema
 * that cannot be a digest — verifying a code needs the secret itself — so it is
 * sealed with AES-256-GCM instead (`lib/secret-box.ts`).
 */
model UserMfaEnrollment {
  id             String    @id @default(cuid())
  userId         String    @unique
  method         MfaMethod @default(TOTP)
  status         MfaStatus @default(PENDING)
  sealedSecret   String
  // The last accepted time step. A code, and everything before it, is spent —
  // this is what stops one being replayed inside its own thirty seconds.
  lastUsedStep   BigInt?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  confirmedAt    DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@index([status])
}

/**
 * Single-use fallbacks, stored as digests exactly like a session token.
 */
model MfaRecoveryCode {
  id           String    @id @default(cuid())
  enrollmentId String
  codeHash     String    @unique
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  enrollment UserMfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, usedAt])
}

/**
 * The state between a correct password and a completed second factor. Holding
 * it here rather than issuing a provisional session means a challenge can never
 * be mistaken for a signed-in session by any other code path.
 */
model MfaChallenge {
  id         String           @id @default(cuid())
  userId     String
  tokenHash  String           @unique
  purpose    MfaChallengeKind @default(SIGN_IN)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)
  userAgent  String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String              @id @default(cuid())
  userId    String
  tokenHash String              @unique
  purpose   AccountTokenPurpose @default(PASSWORD_RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/**
 * A registrant's identity, separate from `User` by decision (ADR 0003).
 * The separation is the security property, not an accident of modelling: every
 * permission in this schema is granted by an `EventMembership` pointing at a
 * `User`, and an account in this table has no way to reach one. Widening the
 * staff table to hold attendees would put a far larger population through the
 * checks that guard roster export and sensitive data, where one careless query
 * is the difference between a registrant and staff access.
 * `email` is the whole claim. An account reaches every registration whose
 * contact address matches it and nothing else, so the address is stored already
 * normalised and is only load-bearing once `emailVerifiedAt` is set.
 */
model AttendeeAccount {
  id                 String                @id @default(cuid())
  email              String                @unique
  displayName        String
  firstName          String?
  lastName           String?
  phone              String?
  shirtSize          String?
  dietaryNeeds       String?
  accessibilityNeeds String?
  /// Optional mailing address and emergency contact the attendee keeps for
  /// themselves (#742). Used only to prefill their own registration forms;
  /// never listed or exported for staff. Components follow `AddressValue`.
  mailingLine1                 String?
  mailingLine2                 String?
  mailingCity                  String?
  mailingRegion                String?
  mailingPostalCode            String?
  mailingCountry               String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  status             AttendeeAccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?
  /**
   * Shuts the person out, whatever they sign in with. Distinct from
   * `AttendeeCredential.disabledAt`, which retires one method: an account that
   * only ever used Google has no credential row for a method-level flag to
   * live on, so the master switch has to be here.
   */
  disabledAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  credential                   AttendeeCredential?
  identities                   AttendeeIdentity[]
  sessions                     AttendeeSession[]
  tokens                       AttendeeAccountToken[]
  mfaEnrollment                AttendeeMfaEnrollment?
  passkeys                     AttendeePasskey[]
  stepUpCodes                  AttendeeStepUpCode[]
  messages                     MessageOutbox[]          @relation("AttendeeMessageRecipient")
  communityParticipations      CommunityParticipation[]
  communityPosts               CommunityPost[]          @relation("CommunityPostAuthor")
  communityReports             CommunityReport[]        @relation("CommunityReportReporter")
  communityNotifications       CommunityNotification[]  @relation("CommunityNotificationRecipient")
  communityNotificationActions CommunityNotification[]  @relation("CommunityNotificationActor")
  /// The person this attendee account is explicitly linked to, if any.
  /// Grants nothing by itself — see `AttendeeAccountPersonLink`.
  personLink                        AttendeeAccountPersonLink?  @relation("AttendeeAccountPersonLinkAccount")
  actorOnAttendeeAccountPersonLinks AttendeeAccountPersonLink[] @relation("AttendeeAccountPersonLinkActorAccount")
  driverVerificationsReviewed       DriverVerification[]        @relation("DriverVerificationReviewedBy")
  /// Clubs this account directs. Explicit staff grants only — never inferred.
  clubDirectorGrants                ClubDirectorGrant[]
  areaCoordinatorGrant              AreaCoordinatorGrant?
  coordinatedLocations              EventLocation[]                  @relation("EventLocationCoordinator")
  grantedClubRoles                  ClubDirectorGrant[]              @relation("ClubDirectorGrantGrantedByAccount")
  acceptedClubInvites               ClubInvite[]                     @relation("ClubInviteAcceptedAccount")
  createdClubInvites                ClubInvite[]                     @relation("ClubInviteCreatedByAccount")
  revokedClubRoles                  ClubDirectorGrant[]              @relation("ClubDirectorGrantRevokedByAccount")
  createdClubRosterMembers          ClubRosterMember[]          @relation("ClubRosterMemberCreatedBy")
  createdRosterExportFormats        ClubRosterExportFormat[]    @relation("ClubRosterExportFormatCreatedBy")

  recordedMemberHonorEntries        MemberHonorEntry[]          @relation("MemberHonorEntryRecordedBy")
  voidedMemberHonorEntries          MemberHonorEntryVoid[]      @relation("MemberHonorEntryVoidedBy")
  initiatedMemberTransfers          MemberTransfer[]            @relation("MemberTransferInitiatedByAccount")
  resolvedMemberTransfers           MemberTransfer[]            @relation("MemberTransferResolvedByAccount")
  memberTransferEvents              MemberTransferEvent[]       @relation("MemberTransferEventActorAccount")
  submittedClubRegistrations        ClubEventRegistration[]     @relation("ClubEventRegistrationSubmittedBy")
  clubRegistrationDrafts            ClubRegistrationDraft[]     @relation("ClubRegistrationDraftUpdatedBy")
  /// Club registration amendments this account made as a director reopening
  /// their own club's registration (H3b, #366).
  amendedRegistrationOperations     RegistrationOperation[]     @relation("RegistrationOperationActorAttendeeAccount")
  updatedClubSupplyStock            ClubSupplyStock[]           @relation("ClubSupplyStockUpdatedByAccount")
  createdClubOrderBatches           ClubSupplyOrderBatch[]      @relation("ClubSupplyOrderBatchCreatedByAccount")
  receivedClubOrderBatches          ClubSupplyOrderBatch[]      @relation("ClubSupplyOrderBatchReceivedByAccount")
  createdClubFormLinks              ClubFormLink[]              @relation("ClubFormLinkCreatedByAccount")
  enteredClubFormSubmissions        ClubFormSubmission[]        @relation("ClubFormSubmissionEnteredByAccount")

  @@index([status])
}

/**
 * A sign-in method owned by somebody else — today, Google.
 * `subject` is the provider's immutable identifier for the person, and it is
 * what the account is actually keyed on. The address is stored alongside it for
 * display and support, never for matching: a Google account can change its
 * email, and following that change blindly would move an account onto an
 * address it never proved control of.
 * The unique constraint on (provider, subject) is what stops one Google account
 * from reaching two attendee accounts.
 */
model AttendeeIdentity {
  id         String                   @id @default(cuid())
  accountId  String
  provider   AttendeeIdentityProvider
  subject    String
  email      String
  createdAt  DateTime                 @default(now())
  lastUsedAt DateTime?

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([accountId, provider])
  @@index([accountId])
}

/// Mirrors `AuthCredential`, including its lockout counters. Kept as its own
/// table so a query for staff credentials can never return an attendee's.
model AttendeeCredential {
  id                String    @id @default(cuid())
  accountId         String    @unique
  passwordHash      String
  passwordUpdatedAt DateTime  @default(now())
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  disabledAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// Mirrors `UserSession`. A distinct table and a distinct cookie name are what
/// stop an attendee session from ever being resolved by `getCurrentSession`.
model AttendeeSession {
  id            String    @id @default(cuid())
  accountId     String
  tokenHash     String    @unique
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  userAgentHash String?
  /// When this session last passed the authenticator check that opens club
  /// rosters (ADR 0005 Addendum A). Sign-in alone never sets it.
  secondFactorVerifiedAt DateTime?
  createdAt     DateTime  @default(now())

  account           AttendeeAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passkeyChallenges AttendeePasskeyChallenge[]

  @@index([accountId, expiresAt])
  @@index([expiresAt, revokedAt])
}

/**
 * One-time credentials belonging to an account rather than to a session.
 * Both purposes carry both halves: `tokenHash` is the handle held by the
 * browser that asked, and `codeHash` is the secret that arrives by email.
 * Needing both is what binds the act to the person who started it — a code
 * forwarded out of an inbox is useless without the session that requested it,
 * which is the same reasoning ADR 0003 applies to editing.
 * `codeHash` is null between issuing and sending: the code is minted when the
 * message actually leaves, so a database read never yields a usable credential.
 */
model AttendeeAccountToken {
  id                String               @id @default(cuid())
  accountId         String
  tokenHash         String               @unique
  codeHash          String?
  // Retry-stable association with the outbox row that first prepared the code.
  deliveryMessageId String?              @unique
  // Recoverable only by the application encryption key. This lets a retry send
  // the same code without storing a usable credential in a database dump.
  sealedCode        String?
  // The request handle may outlive a slow queue; the code itself gets a fresh,
  // shorter lifetime when delivery preparation first succeeds.
  codeExpiresAt     DateTime?
  purpose           AttendeeTokenPurpose
  expiresAt         DateTime
  usedAt            DateTime?
  attempts          Int                  @default(0)
  createdAt         DateTime             @default(now())

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, usedAt])
  @@index([expiresAt])
  @@index([codeExpiresAt])
}

/**
 * Second factor for an attendee account. Built now rather than later because
 * retrofitting one means a migration, a recovery-code scheme, and a rollout
 * across accounts that already exist (ADR 0003).
 * Holding an enrolment is not a condition of holding an account. It becomes
 * required by what is being touched — medical information and club rosters —
 * not by who is touching it.
 */
model AttendeeMfaEnrollment {
  id             String    @id @default(cuid())
  accountId      String    @unique
  method         MfaMethod @default(TOTP)
  status         MfaStatus @default(PENDING)
  sealedSecret   String
  lastUsedStep   BigInt?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  confirmedAt    DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account       AttendeeAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recoveryCodes AttendeeMfaRecoveryCode[]

  @@index([status])
}

model AttendeeMfaRecoveryCode {
  id           String    @id @default(cuid())
  enrollmentId String
  codeHash     String    @unique
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  enrollment AttendeeMfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, usedAt])
}

/**
 * The freshly emailed code that authorises a change, held here rather than
 * expressed as a link.
 * `sessionId` is why this table exists at all. A link in an inbox works for
 * whoever opens it and survives forwarding; a code has to be carried back into
 * the session that asked for it, which binds the change to the person making
 * it. Storing the requesting session is what makes that check possible.
 */
model AttendeeStepUpCode {
  id                String                @id @default(cuid())
  accountId         String
  sessionId         String
  codeHash          String?               @unique
  deliveryMessageId String?               @unique
  sealedCode        String?
  codeExpiresAt     DateTime?
  purpose           AttendeeStepUpPurpose @default(REGISTRATION_EDIT)
  expiresAt         DateTime
  consumedAt        DateTime?
  attempts          Int                   @default(0)
  createdAt         DateTime              @default(now())

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, consumedAt])
  @@index([expiresAt])
  @@index([codeExpiresAt])
}

/**
 * One row per alert condition, so a condition that persists pages once an hour
 * rather than every time the monitor runs. Without this, a backed-up queue
 * would send an alert every five minutes and be muted by whoever receives it.
 */
model AlertNotification {
  id          String    @id @default(cuid())
  key         String    @unique
  severity    String
  summary     String
  firstSeenAt DateTime  @default(now())
  lastSentAt  DateTime
  sendCount   Int       @default(1)
  resolvedAt  DateTime?

  @@index([lastSentAt])
  @@index([resolvedAt])
}

/**
 * When each unattended job last finished. The outbox sweep also runs the alert
 * scan, so it cannot raise an alert about itself stopping; this row is what
 * lets `/api/health` and the command center notice a sweep that went quiet.
 */
model SystemJobHeartbeat {
  job             String    @id
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  updatedAt       DateTime  @updatedAt
}

model RateLimitBucket {
  id              String   @id @default(cuid())
  policy          String
  subjectHash     String
  count           Int
  windowStartedAt DateTime
  windowEndsAt    DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([policy, subjectHash, windowStartedAt])
  @@index([expiresAt])
  @@index([policy, windowEndsAt])
}

/// A block of an event's public page: speaker bios, seminar descriptions,
/// lodging, the schedule, the teen programme.
///
/// Deliberately generic rather than a model per topic. Every one of those is a
/// heading and a body, and a table called Speaker would have to grow a second
/// one called Seminar the first time staff wanted something the platform had
/// not anticipated. Publishing is per section, so a half-written page can sit
/// beside a live one without a draft of the whole page.
model EventContentSection {
  id          String                  @id @default(cuid())
  eventId     String
  kind        EventContentSectionKind @default(RICH_TEXT)
  title       String
  /// Plain text with blank-line paragraphs. Not HTML: this is rendered on a
  /// public page, and accepting markup from a form is how a content field
  /// becomes a cross-site scripting hole.
  body        String                  @default("")
  /// Set for NOTICE cards only.
  tone        EventContentTone?
  placement   EventContentPlacement   @default(PUBLIC_PAGE)
  /// STEPS and CHECKLIST entries: `[{ "title": string, "text": string }]`.
  /// Plain text, validated by modules/events/content-schemas.ts.
  items       Json                    @default("[]")
  position    Int
  isPublished Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  event Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  links EventContentLink[]

  @@index([eventId, position])
  @@index([eventId, isPublished])
}

/// One resource tile inside a RESOURCE_LINKS section.
/// One resource tile: either an address elsewhere, or a file uploaded here.
/// Exactly one of `url` and `assetId` is set; the migration carries the XOR
/// check Prisma cannot express.
model EventContentLink {
  id          String  @id @default(cuid())
  sectionId   String
  label       String
  description String  @default("")
  url         String?
  assetId     String?
  position    Int

  section EventContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Restrict, not cascade: deleting a file that a published page still links
  /// to should fail loudly rather than quietly leave a dead tile.
  asset   EventAsset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([sectionId, position])
  @@index([assetId])
}

/// A file staff uploaded for an event page.
///
/// `contentType` is the verified type, not the one the upload claimed, and
/// `storageKey` is generated here — never derived from the uploaded filename.
/// `displayName` is a label only, and is what a download is offered as.
model EventAsset {
  id               String   @id @default(cuid())
  eventId          String
  displayName      String
  contentType      String
  byteSize         Int
  checksum         String
  storageKey       String   @unique
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation("EventAssetUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  links      EventContentLink[]
  merchandiseArtworkProducts MerchandiseProduct[] @relation("MerchandiseProductArtwork")
  badgeBackgroundEvents      Event[]              @relation("EventBadgeBackground")

  @@index([eventId, createdAt])
}

/// Platform-wide identity and the defaults a new event inherits.
///
/// Exactly one row, pinned by `id`. A singleton in a table rather than
/// environment variables because staff change these, and a value staff can
/// change should not require a deploy. The messaging defaults exist because
/// every event previously began on LOCAL_CAPTURE with no sender at all: the
/// event looked ready, and the first symptom was a registrant who never got
/// their confirmation.
model PlatformSettings {
  id                        String             @id @default("platform")
  organizationName          String             @default("IMSDA Events")
  logoUrl                   String?
  supportContact            String?
  publicWebsiteUrl          String?
  defaultTimezone           String             @default("America/Chicago")
  defaultSenderName         String             @default("IMSDA Events")
  defaultSenderEmail        String?
  defaultReplyToEmail       String?
  defaultAttendeeEditPolicy AttendeeEditPolicy @default(VERIFY_EVERY_EDIT)
  /// The WebAuthn relying-party ID (the site's domain, e.g. "events.imsda.org").
  /// Passkeys stay hidden until it is set and matches the page's origin, so an
  /// unconfigured or misconfigured deployment falls back to authenticator codes.
  passkeyRpId               String?
  /// Where the short lockout alert goes (#456), in addition to the account
  /// holder. Blank means only the account holder is emailed.
  securityAlertEmail        String?
  updatedAt                 DateTime           @updatedAt
  updatedByUserId           String?

  updatedBy User? @relation("PlatformSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model Event {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  startsAt             DateTime
  endsAt               DateTime
  timezone             String             @default("America/Chicago")
  location             String?
  capacity             Int?
  publicInfoUrl        String?
  supportContact       String?
  /// Theme or tagline shown in the public event header (#651), e.g. "Lest We Forget".
  tagline              String?
  /// One line under the header's dates (#651).
  subtitle             String?
  /// Where the event's help card and notices send people (#651); club events fall back to youth@imsda.org.
  helpEmail            String?
  isPublished          Boolean            @default(false)
  registrationOpensOn  String?
  registrationClosesOn String?
  waitlistEnabled      Boolean            @default(false)
  autoPromoteWaitlist  Boolean            @default(true)
  /// Whether this event collects a shirt size per attendee. Replaces a match on
  /// the event's name, which meant only one event could ever collect sizes and
  /// renaming it turned collection off without telling anyone.
  collectsShirtSizes   Boolean            @default(false)
  /// A youth or children's event, where parents aren't normally present (#388).
  /// Every adult registered is flagged until they have a current Sterling
  /// Volunteers background check on file. Flags only: nothing is blocked.
  checksAdultBackgrounds Boolean          @default(false)
  /// A person is a minor at this event when their age on the event's start date is below this (#131).
  ageOfMajority        Int                @default(18)
  attendeeEditPolicy   AttendeeEditPolicy @default(VERIFY_EVERY_EDIT)
  billingMode          EventBillingMode   @default(ATTENDEE_PAY)
  /// Invoice grouping for a deferred-invoice event (#165); only MANAGE_FINANCE changes it, and every change is audited.
  invoiceGrouping                    InvoiceGrouping    @default(PER_CHURCH)
  /// Explicit invoice-number prefix (#167), letters only; blank derives it from the name. Staff set it
  /// before the first invoice is finalized; a trigger refuses a change after the event has a number series.
  invoiceCode                        String?
  /// The payment instruction printed on every invoice PDF (#168), editable by finance staff; blank uses the built-in
  /// default. Copied onto each invoice's document when its PDF is first made, so later edits never change an earlier PDF.
  invoicePaymentInstructions         String?
  /// Explicit audience (#481), independent of `billingMode`: club and church
  /// navigation, club registration oversight, and club reports key off this
  /// field, not the billing mode.
  audience             EventAudience      @default(GENERAL)
  seminarPreferenceClosesOn          String?
  seminarPreferenceSelfServiceLocked Boolean @default(false)
  /// Lodging for this event, rendered into messages through the
  /// `{{hotel_information}}` token. Every field is optional and the block is
  /// omitted entirely when `hotelName` is unset, because most events book no
  /// room block and a hotel embedded in a shared template would follow an event
  /// that never used it.
  hotelName            String?
  hotelBookingUrl      String?
  hotelPhone           String?
  hotelGroupName       String?
  hotelRate            String?
  hotelInstructions    String?
  /// Artwork printed behind every attendee name badge for this event. An
  /// event's own uploaded image, so a conference badge does not have to be
  /// laid out in another tool and hand-fed through a printer twice.
  badgeBackgroundAssetId String?
  /// Published events appear on the public conference calendar unless a
  /// system administrator hides them there (#107). Unpublished events never do.
  showOnCalendar       Boolean            @default(true)
  /// Short label for filtering the public calendar, e.g. "Youth" or "Camp meeting".
  calendarCategory     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  badgeBackground                     EventAsset?        @relation("EventBadgeBackground", fields: [badgeBackgroundAssetId], references: [id], onDelete: Restrict)
  memberships                         EventMembership[]
  contentSections                     EventContentSection[]
  assets                              EventAsset[]
  registrations                       Registration[]
  attendees                           RegistrationAttendee[]
  payments                            Payment[]
  registrationAdjustments             RegistrationAdjustment[]
  refunds                             Refund[]
  checkIns                            CheckIn[]
  announcements                       Announcement[]
  auditLogs                           AuditLog[]
  importRuns                          ImportRun[]
  awardItems                          EventAwardItem[]
  registrationForms                   RegistrationForm[]
  formTestSubmissions                 FormTestSubmission[]
  publicFormSubmissions               PublicRegistrationSubmission[]
  capacityReservations                RegistrationCapacityReservation[]
  messageSettings                     EventMessageSettings?
  messageTemplates                    EventMessageTemplate[]
  paymentInstructionVersions          EventPaymentInstructionVersion[]
  messageOutbox                       MessageOutbox[]
  waitlistEntries                     RegistrationWaitlistEntry[]
  paymentAttempts                     PaymentAttempt[]
  squareWebhookEvents                 SquareWebhookEvent[]
  promoCodes                          PromoCode[]
  promoCodeRedemptions                PromoCodeRedemption[]
  programAssignmentRuns               ProgramAssignmentRun[]
  honorSessions                       HonorSession[]
  honorOfferings                      HonorOffering[]
  clubRegistrations                   ClubEventRegistration[]
  groupRegistrations                  GroupEventRegistration[]
  billingResponsibilities             RegistrationBillingResponsibility[]
  billingResponsibilityChanges        RegistrationBillingResponsibilityChange[]
  attendanceCorrections               AttendanceCorrection[]
  attendanceReconciliationVersions    AttendanceReconciliationVersion[]
  attendanceReviewAcknowledgements    AttendanceReviewAcknowledgement[]
  guardianAuthorities                 GuardianAuthority[]
  guardianAuthorityConflicts          GuardianAuthorityConflict[]

  invoices                            Invoice[]
  invoiceVersions                     InvoiceVersion[]
  invoiceReceivables                  InvoiceReceivable[]
  invoiceNumberCounters               InvoiceNumberCounter[]
  invoiceDocuments                    InvoiceVersionDocument[]
  invoiceDeliveries                   InvoiceDelivery[]
  invoiceArPostings                   InvoiceArPosting[]
  invoicePayments                     InvoicePayment[]
  messageAttachments                  MessageAttachment[]
  clubRegistrationDrafts              ClubRegistrationDraft[]
  clubAssignments                     ClubEventAssignment[]
  honorEnrollments                    HonorEnrollment[]
  memberTransferRegistrationMoves     MemberTransferRegistrationMove[]
  registrationOperations              RegistrationOperation[]
  registrationPaymentChoiceOperations RegistrationPaymentChoiceOperation[]
  communitySettings                   EventCommunitySettings?
  communityParticipations             CommunityParticipation[]
  communityPosts                      CommunityPost[]
  communityReports                    CommunityReport[]
  communityNotifications              CommunityNotification[]
  merchandiseProducts                 MerchandiseProduct[]
  merchandiseCatalog                   MerchandiseCatalog?
  merchandiseOrders                   MerchandiseOrder[]
  merchandiseOrderLines               MerchandiseOrderLine[]
  merchandiseOrderStatusChanges       MerchandiseOrderStatusChange[]
  attendeeTypes                       EventAttendeeType[]
  attendeeClassifications             EventAttendeeClassification[]
  tags                                EventTag[]
  notes                               StaffNote[]
  registrationTagAssignments          RegistrationTagAssignment[]
  attendeeTagAssignments              AttendeeTagAssignment[]
  templateApplication                 EventTemplateApplication?
  cloneRecord                         EventCloneRecord?            @relation("EventCloneResult")
  clonedInto                          EventCloneRecord[]           @relation("EventCloneSource")
  locations                           EventLocation[]
  locationWaitlistChanges             LocationWaitlistChange[]
  modules                             EventModule[]
  moduleRequests                      ModuleRequest[]

  @@index([badgeBackgroundAssetId])
}

/// A feature turned on for one event (#741). A row means "enabled"; the
/// catalog of keys, their titles and applicability live in code
/// (`modules/event-modules`), so there is no boolean column per module.
/// Turning a module off removes only this row, never the data behind it.
/// Only system administrators change rows.
model EventModule {
  id        String   @id @default(cuid())
  eventId   String
  moduleKey String
  enabledAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, moduleKey])
}

enum ModuleRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// An event admin's request that a system administrator turn an event module on
/// (#741 slice 3). Only a system administrator decides. The migration adds a
/// partial unique index Prisma cannot express, `ModuleRequest_one_pending_per_module`
/// on (eventId, moduleKey) WHERE status = 'PENDING', so concurrent submissions
/// leave one pending request. A declined request stays as history and may be
/// asked for again.
model ModuleRequest {
  id                String              @id @default(cuid())
  eventId           String
  moduleKey         String
  requestedByUserId String?
  /// Why the event needs it. Free text from the requester; kept out of audit metadata.
  reason            String
  status            ModuleRequestStatus @default(PENDING)
  decidedByUserId   String?
  decidedAt         DateTime?
  /// Why a system administrator declined. Required to decline; kept out of audit metadata.
  declineReason     String?
  createdAt         DateTime            @default(now())

  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("ModuleRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedBy   User?  @relation("ModuleRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([status, createdAt])
}

/// One site of a multi-location event (#413), e.g. one Honors Weekend site or
/// one Camporee campus. An event with no locations behaves as before; with
/// active locations every new club registration picks one. `firstDay` and
/// `lastDay` are date-only `YYYY-MM-DD` strings in the event's time zone, like
/// `Event.registrationClosesOn`; when unset the event's own dates apply.
/// `capacity` is counted the same way as `Event.capacity`. `name` is unique per
/// event case-insensitively, enforced by the `normalizedName` unique index.
/// Deactivate instead of deleting once any registration uses a location.
model EventLocation {
  id                   String   @id @default(cuid())
  eventId              String
  name                 String
  normalizedName       String
  address              String?
  firstDay             String?
  lastDay              String?
  capacity             Int?
  registrationClosesOn String?
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  /// The Area Coordinator for this location (#599): an attendee account that
  /// holds an active `AreaCoordinatorGrant`. Optional. Whether the person is
  /// still active is decided when it matters (emails, the portal), so a revoked
  /// or expired coordinator simply stops being notified.
  coordinatorAccountId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event           Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coordinator     AttendeeAccount?         @relation("EventLocationCoordinator", fields: [coordinatorAccountId], references: [id], onDelete: SetNull)
  registrations   Registration[]
  waitlistChanges LocationWaitlistChange[]
  honorSessions   HonorSession[]
  honorOfferings  HonorOffering[]

  @@unique([eventId, normalizedName])
  @@index([eventId, isActive, sortOrder])
  @@index([coordinatorAccountId])
}

enum LocationWaitlistChangeKind {
  JOINED
  PROMOTED
  REMOVED
}

/// One change to a location's waitlist (#599): a club joined, was promoted, or
/// was removed. Written in the same transaction as the registration change and
/// read by the daily digest to Area Coordinators and event staff. `digestedAt`
/// is set once a digest covering the row has been queued. The club, location
/// and counts are snapshots, so the digest reads as things were when they
/// happened. `place` is the club's place in line at that location (joined:
/// after joining; removed: where it stood; promoted: where it had stood).
model LocationWaitlistChange {
  id             String                     @id @default(cuid())
  eventId        String
  locationId     String
  registrationId String
  kind           LocationWaitlistChangeKind
  clubName       String
  locationName   String
  attendeeCount  Int
  place          Int?
  occurredAt     DateTime                   @default(now())
  digestedAt     DateTime?

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location     EventLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([digestedAt, occurredAt])
  @@index([locationId, occurredAt])
  @@index([registrationId])
}

/// Event-owned identity used by registration, pricing, capacity, and restriction
/// modules. `label` is mutable; RegistrationAttendee.attendeeType is the snapshot.
model EventAttendeeType {
  id          String   @id @default(cuid())
  eventId     String
  code        String
  label       String
  description String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  minimumAge  Int?
  maximumAge  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendees RegistrationAttendee[]

  @@unique([eventId, code])
  @@index([eventId, isActive, sortOrder, label])
}

/// Orthogonal event-owned groupings. An attendee has one type but can have any
/// number of categories, tracks, and departments.
model EventAttendeeClassification {
  id          String                     @id @default(cuid())
  eventId     String
  kind        AttendeeClassificationKind
  code        String
  label       String
  description String                     @default("")
  sortOrder   Int                        @default(0)
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  event       Event                              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments RegistrationAttendeeClassification[]

  @@unique([eventId, kind, code])
  @@index([eventId, kind, isActive, sortOrder, label])
}

enum NoteVisibility {
  STAFF
  RESTRICTED
}

/// Configured event vocabulary staff apply to registrations and attendees.
/// Never free text: `normalizedName` enforces one spelling per event, so
/// filters and exports do not fracture across near-duplicate tag names.
model EventTag {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  normalizedName String
  color          String
  description    String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event                   Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationAssignments RegistrationTagAssignment[]
  attendeeAssignments     AttendeeTagAssignment[]

  @@unique([eventId, normalizedName])
  @@index([eventId, isActive, name])
}

/// Applying and removing a tag are both recorded rows. Removal sets
/// `removedAt`/`removedByUserId` rather than deleting the row, so the history
/// that a tag was once applied survives even after it is taken off.
model RegistrationTagAssignment {
  id              String    @id @default(cuid())
  eventId         String
  registrationId  String
  tagId           String
  appliedByUserId String
  appliedAt       DateTime  @default(now())
  removedByUserId String?
  removedAt       DateTime?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tag          EventTag     @relation(fields: [tagId], references: [id], onDelete: Restrict)
  appliedBy    User         @relation("RegistrationTagAppliedBy", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  removedBy    User?        @relation("RegistrationTagRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, registrationId, removedAt])
  @@index([tagId, removedAt])
}

/// Attendee-level counterpart of `RegistrationTagAssignment`, same
/// apply/remove-preserves-history shape.
model AttendeeTagAssignment {
  id              String    @id @default(cuid())
  eventId         String
  attendeeId      String
  tagId           String
  appliedByUserId String
  appliedAt       DateTime  @default(now())
  removedByUserId String?
  removedAt       DateTime?

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee  RegistrationAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  tag       EventTag             @relation(fields: [tagId], references: [id], onDelete: Restrict)
  appliedBy User                 @relation("AttendeeTagAppliedBy", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  removedBy User?                @relation("AttendeeTagRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, attendeeId, removedAt])
  @@index([tagId, removedAt])
}

/// Attached to exactly one of a registration, an attendee, or a person (a
/// database check constraint enforces the XOR Prisma cannot express). The
/// note itself never carries body text — `StaffNoteRevision` rows are the
/// append-only history, mirroring how `RegistrationOperation` treats history.
/// Not for medical, safeguarding, or incident detail: see #44 and #79.
model StaffNote {
  id                   String         @id @default(cuid())
  eventId              String
  registrationId       String?
  attendeeId           String?
  personId             String?
  visibility           NoteVisibility @default(STAFF)
  /// Required, and only meaningful, when visibility is RESTRICTED: the named
  /// EventPermission a viewer must hold to read this note's body.
  restrictedPermission String?
  authorUserId         String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration?         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     RegistrationAttendee? @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  person       Person?               @relation(fields: [personId], references: [id], onDelete: Cascade)
  author       User                  @relation("StaffNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  revisions    StaffNoteRevision[]

  @@index([eventId, registrationId])
  @@index([eventId, attendeeId])
  @@index([eventId, personId])
}

/// One row per version of a note's body, oldest first by `sequence`. Editing
/// a note appends a revision; nothing is ever overwritten or deleted.
model StaffNoteRevision {
  id           String   @id @default(cuid())
  noteId       String
  sequence     Int
  body         String
  authorUserId String
  createdAt    DateTime @default(now())

  note   StaffNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User      @relation("StaffNoteRevisionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([noteId, sequence])
  @@index([noteId, createdAt])
}

model EventMembership {
  id          String            @id @default(cuid())
  eventId     String
  userId      String
  role        EventRole
  permissions EventPermission[] @default([])
  status      MembershipStatus  @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model Person {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  normalizedEmail String?  @unique
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  householdMembers   HouseholdMember[]
  heldRegistrations  Registration[]
  groupBillingRegistrations GroupEventRegistration[]
  billingResponsibilities   RegistrationBillingResponsibility[]
  groupContactOperations RegistrationOperation[] @relation("RegistrationOperationActorPerson")
  registrationEvents RegistrationAttendee[]
  externalIdentities ExternalIdentity[]
  notes              StaffNote[]
  attendeeAccountLinks AttendeeAccountPersonLink[]
  userLinks            UserPersonLink[]
  matchCandidatesAsA   PersonMatchCandidate[] @relation("PersonMatchCandidateAsA")
  matchCandidatesAsB   PersonMatchCandidate[] @relation("PersonMatchCandidateAsB")
  clubRosterMemberships ClubRosterMember[]
  backgroundCheckMatch  BackgroundCheckMatch?
  backgroundChecksPre527 BackgroundCheckPre527[] @ignore
  driverVerification    DriverVerification?

  memberHonorEntries    MemberHonorEntry[]
  memberTransfers       MemberTransfer[] @relation("MemberTransferPerson")
  pendingMemberTransfer MemberTransfer?  @relation("MemberTransferPendingPerson")
  clubOrderNeeds        ClubOrderNeed[]
  memberClassCompletions MemberClassCompletion[]
  guardianAuthoritiesAsMinor GuardianAuthority[] @relation("GuardianAuthorityMinor")
  guardianAuthoritiesAsAdult GuardianAuthority[] @relation("GuardianAuthorityAdult")
  guardianAuthoritiesDeclared GuardianAuthority[] @relation("GuardianAuthorityActorPerson")
  guardianConflictsAsMinor   GuardianAuthorityConflict[] @relation("GuardianConflictMinor")
  guardianConflictsAsAdult   GuardianAuthorityConflict[] @relation("GuardianConflictAdult")

  @@index([lastName, firstName])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       HouseholdMember[]
  registrations Registration[]
}

/// Which signals fired (or contradicted) when comparing two `Person`
/// records for `PersonMatchCandidate`. Kept as an enum, not a free-text
/// string, so evidence is queryable and the domain logic that emits it
/// (`modules/people/duplicate-match-domain.ts`) stays exhaustive-checkable.
/// A shared external identity is the only signal strong enough to stand
/// alone; the rest only raise confidence in combination — see the domain
/// module's rule table. Email is deliberately not a signal: IMSDA
/// households routinely register every member under one adult's email, so
/// a shared email is common between genuinely different people.
enum PersonMatchSignal {
  /// Both people have the same non-null normalized phone number.
  PHONE_MATCH
  /// Both people have a normalized last name that is identical.
  SAME_SURNAME
  /// Both people have a normalized first and last name that are identical.
  SAME_FULL_NAME
  /// The two people share at least one currently-active household.
  HOUSEHOLD_SHARED
  /// The two people each have an `ExternalIdentity` with the same
  /// `(provider, providerScope, externalId)` tuple. Strong evidence, never
  /// proof — see the `PersonMatchCandidate` model doc and #40.
  EXTERNAL_IDENTITY_SHARED
  /// Both people have a non-null normalized phone number, and they differ.
  PHONE_MISMATCH
}

/// Deterministic, rule-based confidence for a `PersonMatchCandidate` — never
/// a fuzzy score. Each tier is produced by an explicit, documented
/// combination of `PersonMatchSignal`s in
/// `modules/people/duplicate-match-domain.ts`, so a reviewer (or a future
/// maintainer) can always trace a tier back to the exact rule that set it.
enum PersonMatchConfidence {
  LOW
  MEDIUM
  HIGH
}

/// Lifecycle of a `PersonMatchCandidate`. Rows are never deleted — a
/// candidate only ever moves forward through this enum, mirroring the
/// append-only / time-bounded philosophy used elsewhere in this module
/// (see `HouseholdMember`'s doc comment).
enum PersonMatchState {
  /// Awaiting staff review. The only state the review queue lists.
  OPEN
  /// A staff member decided this pair is not the same person, with a
  /// required reason. Suppresses regeneration for the same underlying data
  /// (see `PersonMatchCandidate.fingerprint`) until something about the
  /// pair actually changes.
  DISMISSED
  /// Replaced by a newer OPEN candidate for the same pair (the rule version
  /// or the underlying data changed while this one was still open). Kept
  /// for history rather than deleted.
  SUPERSEDED
  /// Reserved for slice 3 (#127, merge/unmerge — not yet built). Nothing in
  /// this codebase ever sets this value; it exists so the enum does not
  /// need a breaking migration when merge ships.
  MERGED
}

/// A person's membership in a household, time-bounded so a past registration
/// can read its historical household context instead of today's. Removing a
/// member closes the row (`effectiveTo`); it is never deleted — mirrors the
/// apply/remove-preserves-history shape of `RegistrationTagAssignment`.
///
/// `effectiveFrom` is nullable only for legacy rows awaiting the
/// `household-membership:backfill` script (see
/// `modules/people/household-backfill.ts`); every row created through the
/// repository sets it. A null `effectiveFrom` is treated as "always active
/// from before recorded history" by point-in-time resolution, and a null
/// `effectiveTo` means the membership is still open.
///
/// A database-level exclusion constraint (added in the
/// `identity_account_links_and_household_effective_dates` migration, since
/// Prisma cannot express `EXCLUDE USING gist`) prevents two overlapping
/// memberships of the same person in the same household — the person can
/// still belong to several households at once, and can rejoin a household
/// after leaving it, but never twice at once in the same one.
///
/// `canManage` is a household-convenience flag only (e.g. "can update this
/// household's contact details"). It is NOT guardian authority. Guardian
/// authority is declared explicitly, never inferred from household
/// membership — that is #43's scope, not this model's.
model HouseholdMember {
  id            String    @id @default(cuid())
  householdId   String
  personId      String
  relationship  String?
  /// Household-convenience flag, not guardian authority. See the model doc.
  canManage     Boolean   @default(false)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([householdId, personId])
  @@index([personId])
}

/// Explicit, provenance-carrying link from an `AttendeeAccount` to a
/// `Person`. This link grants nothing by itself: no staff permission, no
/// event access, no cross-event visibility. `AttendeeAccount`, `Person`, and
/// `RegistrationAttendee` remain distinct concepts — see
/// `modules/access/authorization.ts`, which never reads this table.
/// One account links to exactly one person (`accountId` is unique); a person
/// may have several account links.
model AttendeeAccountPersonLink {
  id        String               @id @default(cuid())
  accountId String
  personId  String
  provenance PersonLinkProvenance
  /// Set when `provenance` is SELF_SERVICE_VERIFICATION: the account itself
  /// performed the link. Mutually exclusive with `actorUserId` (enforced by
  /// a database check constraint).
  actorAttendeeAccountId String?
  /// Set when `provenance` is STAFF_ACTION or IMPORT: the staff member who
  /// performed the link or ran the import. Mutually exclusive with
  /// `actorAttendeeAccountId`.
  actorUserId String?
  /// Free-text pointer to the evidence behind this link (a verification
  /// token id, a staff note id, an import run id, ...). Required.
  evidenceReference String
  createdAt         DateTime @default(now())

  account      AttendeeAccount  @relation("AttendeeAccountPersonLinkAccount", fields: [accountId], references: [id], onDelete: Cascade)
  person       Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  actorAccount AttendeeAccount? @relation("AttendeeAccountPersonLinkActorAccount", fields: [actorAttendeeAccountId], references: [id], onDelete: SetNull)
  actorUser    User?            @relation("AttendeeAccountPersonLinkActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([accountId])
  @@index([personId])
}

/// Explicit, provenance-carrying link from a staff `User` to a `Person`.
/// Same invariant as `AttendeeAccountPersonLink`: grants nothing by itself.
/// One staff account links to exactly one person (`userId` is unique).
model UserPersonLink {
  id       String @id @default(cuid())
  userId   String
  personId String
  provenance  PersonLinkProvenance
  /// The staff member who established the link — themself for a
  /// self-service verification of their own identity, or another staff
  /// member for a staff action or import.
  actorUserId String
  /// Free-text pointer to the evidence behind this link.
  evidenceReference String
  createdAt         DateTime @default(now())

  user      User   @relation("UserPersonLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  person    Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  actorUser User   @relation("UserPersonLinkActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@index([personId])
}

/**
 * Permanent IMSDA-owned organizations. Clubs can point to their sponsoring
 * church without making either external provider authoritative for the
 * relationship.
 */
model Organization {
  id                   String           @id @default(cuid())
  healthRecords       HealthRecord[]
  healthRecordLinks   HealthRecordLink[]
  type                 OrganizationType
  name                 String
  normalizedName       String
  parentOrganizationId String?
  isActive             Boolean          @default(true)

  /// eAdventist organizations export (#649). `eadventistId` is the export's
  /// OrganizationID: unique, and the key a re-import matches on.
  eadventistId         String?          @unique
  orgCode              String?
  /// The export's OrgType text ("PK-08 School", "Camp/Conf center", ...), kept
  /// because several of them collapse into one `type`.
  sourceOrgType        String?
  streetAddress        String?
  city                 String?
  state                String?
  postalCode           String?
  website              String?
  officePhone          String?
  district             String?
  language             String?
  /// A DisbandedOn date on file. Informational: it never changes `isActive`.
  disbandedOn          DateTime?        @db.Date
  /// The export's SubOrgOf, resolved by name. Kept apart from
  /// `parentOrganizationId`, which means "sponsoring church" for a club.
  affiliatedOrganizationId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  parentOrganization Organization?      @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: Restrict)
  childOrganizations Organization[]     @relation("OrganizationHierarchy")
  affiliatedOrganization Organization?  @relation("OrganizationAffiliation", fields: [affiliatedOrganizationId], references: [id], onDelete: SetNull)
  affiliatedChildren Organization[]     @relation("OrganizationAffiliation")
  externalIdentities ExternalIdentity[]
  directorGrants     ClubDirectorGrant[]
  rosterMembers      ClubRosterMember[]
  rosterExportFormats ClubRosterExportFormat[]
  eventRegistrations ClubEventRegistration[]
  registrationDrafts ClubRegistrationDraft[]
  eventAssignments   ClubEventAssignment[]
  honorEnrollments   HonorEnrollment[]
  clubProfile        ClubProfile?
  clubInvites        ClubInvite[]
  monthlyReports     ClubMonthlyReport[]
  yearEndReports     ClubYearEndReport[]
  meetingNotes       ClubMeetingNote[]
  yearStandings      ClubYearStanding[]
  churchLocation     ChurchLocation?
  churchGeocodeResult ChurchGeocodeResult?
  staffActAs         StaffActAs[]
  memberHonorEntries MemberHonorEntry[]
  transfersReceived  MemberTransfer[]   @relation("MemberTransferTo")
  transfersSent      MemberTransfer[]   @relation("MemberTransferFrom")
  clubSupplyStock    ClubSupplyStock[]
  clubOrderNeeds     ClubOrderNeed[]
  clubOrderBatches   ClubSupplyOrderBatch[]
  clubOrderListLines ClubOrderListLine[]
  memberClassCompletions MemberClassCompletion[]
  sponsoredPromoCodes PromoCode[] @relation("PromoCodeSponsor")
  clubFormSubmissions ClubFormSubmission[]
  billingContacts         OrganizationBillingContact[]
  billingResponsibilities RegistrationBillingResponsibility[]
  clubFormLinks       ClubFormLink[]

  @@index([type, isActive, name])
  @@index([parentOrganizationId, isActive])
  @@index([affiliatedOrganizationId])
  @@index([normalizedName])
}

/**
 * A church's town and, when known, map coordinates (#437, #724). `source`
 * records who set the row: IMPORT (city, state and ZIP filled by the
 * eAdventist import), GEOCODED (a staff-accepted Census Bureau match), or
 * MANUAL (a person typed it or placed the pin). Neither the import nor the
 * geocoder ever overwrites a MANUAL row. Existing rows were backfilled MANUAL.
 */
model ChurchLocation {
  organizationId String               @id
  city           String               @default("")
  state          String               @default("")
  zip            String               @default("")
  latitude       Float?
  longitude      Float?
  source         ChurchLocationSource @default(MANUAL)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ChurchLocationSource {
  IMPORT
  MANUAL
  GEOCODED
}

enum ChurchGeocodeStatus {
  MATCHED
  NO_MATCH
}

enum ChurchGeocodeDecision {
  PENDING
  ACCEPTED
  SKIPPED
}

/**
 * The result of the staff-triggered "Find map locations" step (#724), one row
 * per church, kept for review. A MATCHED row holds a proposed point that only
 * reaches ChurchLocation when staff accept it.
 */
model ChurchGeocodeResult {
  organizationId  String                @id
  status          ChurchGeocodeStatus
  decision        ChurchGeocodeDecision @default(PENDING)
  latitude        Float?
  longitude       Float?
  matchedAddress  String                @default("")
  provider        String
  /// The address that was sent. Accepting is refused once the church's address no longer matches.
  inputStreet     String                @default("")
  inputCity       String                @default("")
  inputState      String                @default("")
  inputZip        String                @default("")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// An Area Coordinator (#387): sees every club, view only, from their own
/// account. Given and taken away by system administrators; one row per
/// account, kept after removal for the record.
model AreaCoordinatorGrant {
  id                String    @id @default(cuid())
  attendeeAccountId String    @unique
  grantedByUserId   String?
  grantedAt         DateTime  @default(now())
  /// Set when a system administrator acts as an Area Coordinator for a while
  /// (#387); null for a lasting role.
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedByUserId   String?
  updatedAt         DateTime  @updatedAt

  attendeeAccount AttendeeAccount @relation(fields: [attendeeAccountId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
}

model ClubInvite {
  id                String           @id @default(cuid())
  organizationId    String
  email             String
  name              String           @default("")
  role              ClubDirectorRole
  status            ClubInviteStatus @default(PENDING)
  /// "IMPORT" (the club import, held for staff to Send) or "CLUB" (a club
  /// director or deputy adding a Registrar or Reporter, sent right away; #425).
  source            String           @default("IMPORT")
  createdByUserId   String?
  /// Set when a club's own director or deputy created the invite (#425).
  createdByAccountId String?
  sentAt            DateTime?
  sentCount         Int              @default(0)
  lastMessageId     String?
  /// When a SENT invite stops being acceptable (#425). Null for invites
  /// created before expiry existed.
  expiresAt         DateTime?
  acceptedAt        DateTime?
  acceptedAccountId String?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User?            @relation("ClubInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByAccount  AttendeeAccount? @relation("ClubInviteCreatedByAccount", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  acceptedAccount   AttendeeAccount? @relation("ClubInviteAcceptedAccount", fields: [acceptedAccountId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([organizationId, status])
}

/// Draft or filed (#426). A report starts DRAFT; SUBMITTED is what staff and
/// Area Coordinators see as filed. A club may reopen a SUBMITTED report back
/// to DRAFT until the report's due date, the same rule that already locks
/// edits (`isLockedForClub`).
enum ClubReportStatus {
  DRAFT
  SUBMITTED
}

/// One club's monthly report (#377), replacing the old website's form 114.
/// `points` holds the picked value per item (see `modules/club-reports`);
/// `onTimePoints` is worked out from `firstSubmittedAt` and never picked.
/// `status`/`submittedAt` are the draft/submit state (#426); `firstSubmittedAt`
/// is set the first time a report reaches SUBMITTED and never moves after,
/// even across a reopen and resubmit, so on-time credit can't be replayed.
model ClubMonthlyReport {
  id                   String           @id @default(cuid())
  organizationId       String
  clubYear             String
  reportMonth          String
  meetingPlace         String           @default("")
  meetingSchedule      String           @default("")
  averageAttendance    Int?
  pathfinderCount      Int?
  tltCount             Int?
  staffCount           Int?
  investitureDate      String?
  classLevels          ClubClassLevel[]
  points               Json
  honors               Json
  onTimePoints         Int
  totalPoints          Int
  signatureName        String
  signedOn             String
  status               ClubReportStatus @default(DRAFT)
  submittedAt          DateTime?
  firstSubmittedAt     DateTime?
  submittedByAccountId String?
  updatedByAccountId   String?
  updatedByUserId      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reportMonth])
  @@index([clubYear, reportMonth])
  @@index([clubYear, status])
}

/// One club's Pathfinder Year-End Report (#607) for one Pathfinder year
/// (May 1 - April 30, labelled by its start year, e.g. "2026-27"), due April 1.
/// Counts only, never a name. `prefill` is the roster/honors/investiture
/// snapshot the server worked out at the last save (frozen once SUBMITTED);
/// `overrides` holds only the pre-filled fields the director changed, so the
/// original number is always kept beside the override; `manual` holds the
/// fields the platform has no data for. Totals are never stored.
model ClubYearEndReport {
  id                   String           @id @default(cuid())
  organizationId       String
  reportYear           String
  status               ClubReportStatus @default(DRAFT)
  contactName          String           @default("")
  contactWorkPhone     String           @default("")
  contactHomePhone     String           @default("")
  contactCellPhone     String           @default("")
  contactEmail         String           @default("")
  prefill              Json             @default("{}")
  overrides            Json             @default("{}")
  manual               Json             @default("{}")
  submittedAt          DateTime?
  firstSubmittedAt     DateTime?
  submittedByAccountId String?
  updatedByAccountId   String?
  updatedByUserId      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reportYear])
  @@index([reportYear, status])
}

/// One club meeting's notes (#426): a simple record so a monthly report's
/// attendance and honors don't have to be retyped. No names of young people —
/// counts only; free text is the club's own.
model ClubMeetingNote {
  id                 String   @id @default(cuid())
  organizationId     String
  meetingDate        String
  pathfinderCount    Int?
  tltCount           Int?
  staffCount         Int?
  honors             Json     @default("[]")
  notes              String   @default("")
  createdByAccountId String?
  /// Set instead of `createdByAccountId` for a staff "act as" director (#442).
  createdByUserId    String?
  updatedByAccountId String?
  /// Set instead of `updatedByAccountId` for a staff "act as" director (#442).
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser   User?        @relation("ClubMeetingNoteCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?        @relation("ClubMeetingNoteUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  /// Optional per-member check-off (#653). Empty when a club only keeps head counts.
  attendance      ClubMeetingAttendance[]

  @@index([organizationId, meetingDate])
}

/// One roster member's check-off for one meeting (#653). Names come from the
/// roster; nothing health-related or otherwise sensitive is stored here.
model ClubMeetingAttendance {
  id             String   @id @default(cuid())
  meetingNoteId  String
  rosterMemberId String
  present        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meetingNote  ClubMeetingNote  @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  rosterMember ClubRosterMember @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)

  @@unique([meetingNoteId, rosterMemberId])
  @@index([rosterMemberId])
}

/// A club's standing for one club year (#377): whether the yearly
/// registration came in on time, which adds 1,500 points to the year.
model ClubYearStanding {
  organizationId     String
  clubYear           String
  registrationOnTime Boolean  @default(false)
  updatedByUserId    String?
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, clubYear])
}

/// What a club tells people about itself (#375): editable by its director or
/// deputy and by conference staff. `listPublicly` is for a later "find a club".
model ClubProfile {
  organizationId    String   @id
  meetingPlace      String   @default("")
  meetingSchedule   String   @default("")
  contactEmail      String   @default("")
  contactPhone      String   @default("")
  publicDescription String   @default("")
  listPublicly      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * Explicit, time-bounded, revocable authority for an attendee account to act
 * for one club (#354). Nothing else grants it: not an email domain, not
 * registering a club, not a form answer, not roster membership. A grant counts
 * only between `effectiveFrom` and `effectiveTo` and while `revokedAt` is empty;
 * revoking keeps the row so past actions stay attributed.
 */
model ClubDirectorGrant {
  id                String           @id @default(cuid())
  organizationId    String
  attendeeAccountId String
  role              ClubDirectorRole @default(DIRECTOR)
  effectiveFrom     DateTime         @default(now())
  effectiveTo       DateTime?
  reason            String
  grantedByUserId   String?
  /// Set when the club's own director or deputy gave the role (#375).
  grantedByAccountId String?
  revokedAt         DateTime?
  revokedByUserId   String?
  revokedByAccountId String?
  revokeReason      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendeeAccount  AttendeeAccount  @relation(fields: [attendeeAccountId], references: [id], onDelete: Restrict)
  grantedBy        User?            @relation("ClubDirectorGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy        User?            @relation("ClubDirectorGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  grantedByAccount AttendeeAccount? @relation("ClubDirectorGrantGrantedByAccount", fields: [grantedByAccountId], references: [id], onDelete: SetNull)
  revokedByAccount AttendeeAccount? @relation("ClubDirectorGrantRevokedByAccount", fields: [revokedByAccountId], references: [id], onDelete: SetNull)

  @@index([attendeeAccountId, revokedAt])
  @@index([organizationId, revokedAt])
}

/**
 * Stable provider keys. A row belongs to exactly one IMSDA entity; the
 * database migration carries the XOR check Prisma cannot express.
 */
model ExternalIdentity {
  id             String         @id @default(cuid())
  organizationId String?
  personId       String?
  provider       ExternalSystem
  providerScope  String         @default("")
  externalId     String
  displayLabel   String?
  lastVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([provider, providerScope, externalId])
  @@unique([organizationId, provider, providerScope])
  @@unique([personId, provider, providerScope])
  @@index([organizationId])
  @@index([personId])
}

/// Identity slice 2 (#126): a generated, reviewable suggestion that two
/// `Person` records may be the same person. Candidates are evidence, never
/// action — nothing in this codebase applies one automatically at any
/// confidence. Applying a candidate (merging the two people) is slice 3
/// (#127) and does not exist yet.
///
/// `personAId` is always lexicographically less than `personBId` (a
/// canonical ordering enforced by the `PersonMatchCandidate_ordered_pair_check`
/// database check constraint, since Prisma cannot express a self-referential
/// unordered pair natively). This is what makes the pair itself, rather than
/// an ordered `(x, y)` vs `(y, x)`, the unit the unique constraint below can
/// reason about.
///
/// `fingerprint` is a deterministic hash of every input that produced
/// `matchedSignals` / `contradictingSignals` (both people's normalized
/// email, phone, and name, plus the sorted ids of any shared household and
/// any shared external identity tuple) together with `ruleVersion`. Two
/// generation runs over unchanged data produce the same fingerprint, which
/// is what makes generation idempotent
/// (`@@unique([personAId, personBId, fingerprint])`: a rerun that computes
/// the same fingerprint for the same pair finds its own row and writes
/// nothing) and what lets a dismissed pair stay suppressed until something
/// about the two people actually changes (a changed fingerprint no longer
/// matches the dismissed row, so generation creates a fresh OPEN row instead
/// of reusing it — see `modules/people/duplicate-match-repository.ts`).
model PersonMatchCandidate {
  id                    String                 @id @default(cuid())
  personAId             String
  personBId             String
  matchedSignals        PersonMatchSignal[] @default([])
  contradictingSignals  PersonMatchSignal[] @default([])
  confidence            PersonMatchConfidence
  /// Bumped whenever `duplicate-match-domain.ts`'s matching rules change
  /// behavior, so an old candidate never silently claims to have been
  /// produced by rules that no longer exist.
  ruleVersion           Int
  state                 PersonMatchState       @default(OPEN)
  /// See the model doc: a hash of the inputs (plus `ruleVersion`) that
  /// produced this candidate.
  fingerprint           String
  computedAt            DateTime               @default(now())
  dismissedAt           DateTime?
  dismissedByUserId     String?
  dismissalReason       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  personA        Person @relation("PersonMatchCandidateAsA", fields: [personAId], references: [id], onDelete: Cascade)
  personB        Person @relation("PersonMatchCandidateAsB", fields: [personBId], references: [id], onDelete: Cascade)
  dismissedByUser User? @relation("PersonMatchCandidateDismissedBy", fields: [dismissedByUserId], references: [id], onDelete: SetNull)

  @@unique([personAId, personBId, fingerprint])
  @@index([personAId])
  @@index([personBId])
  @@index([state])
}

model Registration {
  id                    String             @id @default(cuid())
  eventId               String
  accountHolderPersonId String
  householdId           String?
  confirmationCode      String
  status                RegistrationStatus @default(DRAFT)
  totalAmount           Decimal            @db.Decimal(12, 2)
  contactSnapshot       Json               @default("{}")
  submittedAt           DateTime?
  cancelledAt           DateTime?
  /// Site of a multi-location event (#413); null when the event has none.
  locationId            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  event                   Event                                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location                EventLocation?                       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationWaitlistChanges LocationWaitlistChange[]
  accountHolderPerson     Person                               @relation(fields: [accountHolderPersonId], references: [id])
  household               Household?                           @relation(fields: [householdId], references: [id])
  attendees               RegistrationAttendee[]
  payments                Payment[]
  publicFormSubmission    PublicRegistrationSubmission?
  capacityReservations    RegistrationCapacityReservation[]
  messages                MessageOutbox[]
  waitlistEntry           RegistrationWaitlistEntry?
  accessTokens            RegistrationAccessToken[]
  paymentAttempts         PaymentAttempt[]
  promoCodeRedemption     PromoCodeRedemption?
  operations              RegistrationOperation[]
  paymentChoiceOperations RegistrationPaymentChoiceOperation[]
  merchandiseOrders       MerchandiseOrder[]
  notes                   StaffNote[]
  tagAssignments          RegistrationTagAssignment[]
  clubRegistration        ClubEventRegistration?
  groupRegistration       GroupEventRegistration?
  billingResponsibility        RegistrationBillingResponsibility?
  billingResponsibilityChanges RegistrationBillingResponsibilityChange[]
  attendanceCorrections        AttendanceCorrection[]
  attendanceReviewAcknowledgements AttendanceReviewAcknowledgement[]
  guardianAuthorities     GuardianAuthority[]
  guardianAuthorityConflicts GuardianAuthorityConflict[]
  honorEnrollments        HonorEnrollment[]
  adjustments             RegistrationAdjustment[]
  memberTransferMovesFrom MemberTransferRegistrationMove[] @relation("MemberTransferMoveFrom")
  memberTransferMovesTo   MemberTransferRegistrationMove[] @relation("MemberTransferMoveTo")

  @@unique([eventId, confirmationCode])
  @@index([eventId, status])
  @@index([accountHolderPersonId])
  @@index([locationId])
}

model RegistrationPaymentChoiceOperation {
  id                       String                    @id
  eventId                  String
  registrationId           String
  sequence                 Int
  clientRequestId          String
  requestFingerprint       String
  expectedPriorOperationId String?
  choice                   RegistrationPaymentChoice
  baseSubtotalCents        Int
  processingFeeCents       Int
  resultingTotalCents      Int
  responseSnapshot         Json
  createdAt                DateTime                  @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@unique([registrationId, sequence])
  @@unique([registrationId, clientRequestId])
  @@index([eventId, createdAt])
  @@index([registrationId, createdAt])
}

model PromoCode {
  id                   String            @id @default(cuid())
  eventId              String
  code                 String
  normalizedCode       String
  isActive             Boolean           @default(true)
  discountType         PromoDiscountType
  discountValue        Int
  startsOn             String?
  endsOn               String?
  minimumSubtotalCents Int?
  maximumUses          Int?
  maximumDiscountCents Int?
  redeemedCount        Int               @default(0)
  /// Church-sponsored code (#545): the church that owes the discount for each
  /// active registration that redeemed it. Only on a GENERAL event, and only
  /// an active CHURCH organization when linked; staff-set. Nothing is stored
  /// per redemption — what the church owes is computed on demand from
  /// PromoCodeRedemption, like church-billed club registrations (#409).
  sponsoringOrganizationId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsoringOrganization Organization? @relation("PromoCodeSponsor", fields: [sponsoringOrganizationId], references: [id], onDelete: Restrict)
  redemptions PromoCodeRedemption[]
  adjustments RegistrationAdjustment[]

  @@unique([eventId, normalizedCode])
  @@index([eventId, isActive, updatedAt])
  @@index([sponsoringOrganizationId])
}

model PromoCodeRedemption {
  id                           String            @id @default(cuid())
  eventId                      String
  promoCodeId                  String
  registrationId               String            @unique
  codeSnapshot                 String
  discountTypeSnapshot         PromoDiscountType
  discountValueSnapshot        Int
  startsOnSnapshot             String?
  endsOnSnapshot               String?
  minimumSubtotalCentsSnapshot Int?
  maximumUsesSnapshot          Int?
  maximumDiscountCentsSnapshot Int?
  eligibleSubtotalCents        Int
  discountAmountCents          Int
  pricingDate                  String
  createdAt                    DateTime          @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoCode    PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, registrationId])
  @@index([eventId, createdAt])
  @@index([promoCodeId, createdAt])
}

model RegistrationAccessToken {
  id             String                         @id @default(cuid())
  registrationId String
  tokenHash      String                         @unique
  purpose        RegistrationAccessTokenPurpose @default(MANAGE_REGISTRATION)
  expiresAt      DateTime
  firstUsedAt    DateTime?
  expiryRecordedAt DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                       @default(now())

  registration    Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentAttempts PaymentAttempt[]

  @@index([registrationId, purpose, revokedAt, expiresAt])
  @@index([expiresAt, revokedAt])
}

model RegistrationWaitlistEntry {
  id                String              @id @default(cuid())
  eventId           String
  registrationId    String              @unique
  position          Int
  attendeeCount     Int
  status            WaitlistEntryStatus @default(WAITING)
  lastBlockedReason String?
  joinedAt          DateTime            @default(now())
  promotedAt        DateTime?
  removedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([eventId, position])
  @@index([eventId, status, position])
}

model RegistrationAttendee {
  id              String   @id @default(cuid())
  eventId         String
  registrationId  String
  personId        String
  attendeeType    String
  attendeeTypeDefinitionId String?
  position        Int      @default(0)
  profileSnapshot Json
  formResponses   Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event                  Event                             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration           Registration                      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  person                 Person                            @relation(fields: [personId], references: [id])
  attendeeTypeDefinition EventAttendeeType?                @relation(fields: [attendeeTypeDefinitionId], references: [id], onDelete: Restrict)
  classifications        RegistrationAttendeeClassification[]
  checkIns               CheckIn[]
  attendanceCorrections  AttendanceCorrection[]
  capacityReservations   RegistrationCapacityReservation[]
  substitutionOperations RegistrationOperation[]
  notes                  StaffNote[]
  tagAssignments         AttendeeTagAssignment[]
  honorEnrollments       HonorEnrollment[]
  adjustments            RegistrationAdjustment[]
  memberTransferMoves    MemberTransferRegistrationMove[]

  @@unique([registrationId, personId])
  @@index([registrationId, position])
  @@index([eventId, attendeeType])
  @@index([attendeeTypeDefinitionId])
}

model RegistrationAttendeeClassification {
  attendeeId      String
  classificationId String
  assignedAt      DateTime @default(now())

  attendee       RegistrationAttendee        @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  classification EventAttendeeClassification @relation(fields: [classificationId], references: [id], onDelete: Restrict)

  @@id([attendeeId, classificationId])
  @@index([classificationId])
}

model RegistrationOperation {
  id                 String                    @id @default(cuid())
  eventId            String
  registrationId     String
  attendeeId         String?
  type               RegistrationOperationType
  clientRequestId    String
  requestFingerprint String
  /// Set when the amendment engine ran for a staff user. Mutually exclusive
  /// with `actorAttendeeAccountId` (enforced by a database check
  /// constraint), same XOR shape as `AttendeeAccountPersonLink`.
  actorUserId        String?
  /// Set when a club director reopened and amended their own club
  /// registration (H3b, #366) instead of a staff user amending it.
  actorAttendeeAccountId String?
  /// Set when the contact of a "Group" registration (#650) changed it through
  /// the registration's private manage link: a person, not a signed-in account.
  /// Exactly one of the three actor columns is set (database check constraint).
  actorPersonId      String?
  actorNameSnapshot  String
  beforeSnapshot     Json
  afterSnapshot      Json
  responseSnapshot   Json
  createdAt          DateTime                  @default(now())

  event               Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration        Registration          @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  attendee            RegistrationAttendee? @relation(fields: [attendeeId], references: [id], onDelete: Restrict)
  actor               User?                 @relation("RegistrationOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorAttendeeAccount AttendeeAccount?     @relation("RegistrationOperationActorAttendeeAccount", fields: [actorAttendeeAccountId], references: [id], onDelete: Restrict)
  actorPerson         Person?               @relation("RegistrationOperationActorPerson", fields: [actorPersonId], references: [id], onDelete: Restrict)

  @@unique([eventId, clientRequestId])
  @@index([registrationId, createdAt])
  @@index([attendeeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorAttendeeAccountId, createdAt])
  @@index([actorPersonId, createdAt])
}

/// A staff change to what a registration owes (#396): a scholarship, a
/// discount, a promo code applied after submission, or a correction.
/// `amountCents` is negative when it lowers the amount owed. Lines are never
/// edited; a reversal is a new line pointing at the one it cancels. The
/// registration total is the priced total plus every line.
model RegistrationAdjustment {
  id                    String                     @id @default(cuid())
  eventId               String
  registrationId        String
  kind                  RegistrationAdjustmentKind
  amountCents           Int
  reason                String
  promoCodeId           String?
  promoCodeSnapshot     String?
  /// Set when the adjustment is for one person in the registration (#397).
  registrationAttendeeId String?
  reversesAdjustmentId  String?                    @unique
  createdByUserId       String?
  createdByNameSnapshot String
  createdAt             DateTime                   @default(now())

  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  promoCode    PromoCode?              @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  attendee     RegistrationAttendee?   @relation(fields: [registrationAttendeeId], references: [id], onDelete: SetNull)
  reverses     RegistrationAdjustment? @relation("AdjustmentReversal", fields: [reversesAdjustmentId], references: [id], onDelete: Restrict)
  reversedBy   RegistrationAdjustment? @relation("AdjustmentReversal")

  @@index([registrationId, createdAt])
  @@index([eventId, kind])
  @@index([registrationAttendeeId])
}

enum RegistrationAdjustmentKind {
  SCHOLARSHIP
  DISCOUNT
  PROMO_CODE
  CORRECTION
}

model Payment {
  id                String        @id @default(cuid())
  eventId           String
  registrationId    String
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus
  method            PaymentMethod
  externalReference String?
  receivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  refunds        Refund[]
  paymentAttempt PaymentAttempt?

  @@index([eventId, status])
  @@index([registrationId])
}

model PaymentAttempt {
  id                        String               @id @default(cuid())
  eventId                   String
  registrationId            String
  registrationAccessTokenId String?
  paymentId                 String?              @unique
  provider                  String               @default("SQUARE")
  environment               String
  clientIdempotencyKey      String               @unique
  providerIdempotencyKey    String               @unique
  activeRegistrationKey     String?              @unique
  amountCents               Int
  /// The card processing surcharge inside `amountCents`, for a registration
  /// whose total did not already price one in — a pay-later registrant
  /// settling a balance by card. It is added to the registration total when
  /// the payment succeeds, never at quote time, so an abandoned checkout
  /// leaves the balance exactly as it was.
  surchargeCents            Int                  @default(0)
  currency                  String               @default("USD")
  status                    PaymentAttemptStatus @default(PROCESSING)
  providerPaymentId         String?              @unique
  providerStatus            String?
  providerStatusAt          DateTime?
  failureCode               String?
  failureMessage            String?
  requestCount              Int                  @default(1)
  lastRequestedAt           DateTime?
  completedAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  event                   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration            Registration             @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationAccessToken RegistrationAccessToken? @relation(fields: [registrationAccessTokenId], references: [id], onDelete: SetNull)
  payment                 Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  webhookEvents           SquareWebhookEvent[]

  @@index([eventId, status, createdAt])
  @@index([registrationId, createdAt])
}

model Refund {
  id                String       @id @default(cuid())
  eventId           String
  paymentId         String
  amount            Decimal      @db.Decimal(12, 2)
  status            RefundStatus
  externalReference String?
  reason            String?
  /// One key per reviewed manual refund operation (#525). A retry with the
  /// same key returns the recorded refund instead of recording another.
  /// Null for provider-driven and older refunds (nulls never collide).
  idempotencyKey    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, externalReference])
  @@unique([paymentId, idempotencyKey])
  @@index([eventId, status])
  @@index([paymentId])
}

/// An event-owned merchandise product (a shirt, a mug). Disabling the product,
/// or its event being unpublished, hides it from any future public catalog
/// without touching the order history already recorded against it (issue
/// #144). No public checkout exists yet; this is the domain foundation.
model MerchandiseProduct {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  isArchived  Boolean  @default(false)
  position    Int      @default(0)
  artworkAssetId String?
  artworkAltText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event      Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artwork    EventAsset?                  @relation("MerchandiseProductArtwork", fields: [artworkAssetId], references: [id], onDelete: Restrict)
  variants   MerchandiseProductVariant[]
  orderLines MerchandiseOrderLine[]

  @@index([eventId, isEnabled, isArchived, position])
}

/// A purchasable option of a product, such as a size. A variant that has ever
/// sold is never hard-deleted by application code — only disabled — but the
/// schema also tolerates deletion (`onDelete: SetNull` on order lines) so a
/// historical line still reads correctly if a row is ever removed by hand.
model MerchandiseProductVariant {
  id        String   @id @default(cuid())
  productId String
  label     String
  sku       String?
  position  Int      @default(0)
  isEnabled Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      MerchandiseProduct                @relation(fields: [productId], references: [id], onDelete: Cascade)
  availability MerchandiseVariantAvailability[]
  orderLines   MerchandiseOrderLine[]

  @@unique([productId, label])
  @@index([productId, isEnabled, position])
}

/// The price/tax/fee/inventory terms a variant sells under. A row is never
/// edited after it is created — changing terms supersedes it with a new row
/// and deactivates the old one — so an order line can always cite the exact
/// availability it was priced from and a later catalog edit can never rewrite
/// a past purchase. Only one row per variant may have `isActive = true`; the
/// migration carries the partial unique index Prisma cannot express, plus a
/// check constraint tying `inventoryQuantity` to `inventoryPolicy`.
model MerchandiseVariantAvailability {
  id                String                     @id @default(cuid())
  variantId         String
  versionNumber     Int
  priceCents        Int
  taxTreatment      MerchandiseTaxTreatment
  feePolicy         MerchandiseFeePolicy
  inventoryPolicy   MerchandiseInventoryPolicy @default(UNLIMITED)
  inventoryQuantity Int?
  isActive          Boolean                    @default(true)
  createdByUserId   String
  reason            String?
  salesStartsAt     DateTime?
  salesEndsAt       DateTime?
  minQuantity       Int      @default(1)
  maxQuantity       Int?
  attendeeAvailability String @default("ALL")
  createdAt         DateTime                   @default(now())

  variant    MerchandiseProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy  User                      @relation("MerchandiseAvailabilityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  orderLines MerchandiseOrderLine[]

  @@unique([variantId, versionNumber])
  @@index([variantId, isActive, salesStartsAt, salesEndsAt])
}

/// Event-level switch and human approval gate for the catalog. Saving a draft
/// never activates public sales; only an explicit APPROVED state can do that.
model MerchandiseCatalog {
  id        String                   @id @default(cuid())
  eventId   String                   @unique
  isEnabled Boolean                  @default(false)
  status    MerchandiseCatalogStatus @default(DRAFT)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// A merchandise purchase. Deliberately independent of `Registration.status`
/// (issue #144): an order can be paid while a registration is still a draft,
/// and a cancelled registration does not retroactively cancel an order.
/// `registrationId` is kept only for buyer context; totals are this order's
/// own and are never folded into `Registration.totalAmount`.
/// `clientRequestId` plus the unique index below make order creation
/// retry-safe the same way `RegistrationOperation.clientRequestId` does:
/// a retry with the same key and the same basket replays the stored order,
/// and `requestFingerprint` catches a key reused for a different basket
/// instead of silently returning someone else's order.
/// `paymentMethod`/`paymentReference` are allocation fields for the append-only
/// accounting direction in #74; they intentionally do not force every order
/// through the Square-specific `Payment`/`PaymentAttempt` tables, so cash and
/// check settlement do not have to pretend to be a card workflow.
model MerchandiseOrder {
  id                String                 @id @default(cuid())
  eventId           String
  registrationId    String?
  purchaserSnapshot Json
  clientRequestId   String
  requestFingerprint String
  status            MerchandiseOrderStatus @default(PENDING)
  subtotalCents     Int
  feeCents          Int                    @default(0)
  taxCents          Int                    @default(0)
  totalCents        Int
  paymentMethod     PaymentMethod?
  paymentReference  String?
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  event         Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration  Registration?                  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  createdBy     User?                          @relation("MerchandiseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines         MerchandiseOrderLine[]
  statusChanges MerchandiseOrderStatusChange[]

  @@unique([eventId, clientRequestId])
  @@index([eventId, status, createdAt])
  @@index([registrationId])
}

/// One purchased line. Every commercial fact is copied at order time and never
/// re-read from the catalog — `productId`/`variantId`/`availabilityId` are
/// live-reference conveniences only, all nullable and `SetNull` on delete — so
/// a later price change, product rename, or variant deletion/disablement can
/// never rewrite an existing order line (issue #144 acceptance criteria).
model MerchandiseOrderLine {
  id                     String                  @id @default(cuid())
  orderId                String
  eventId                String
  productId              String?
  productNameSnapshot    String
  variantId              String?
  variantLabelSnapshot   String
  availabilityId         String?
  unitPriceCentsSnapshot Int
  quantity               Int
  taxTreatmentSnapshot   MerchandiseTaxTreatment
  feePolicySnapshot      MerchandiseFeePolicy
  lineTotalCents         Int
  createdAt              DateTime                @default(now())

  order        MerchandiseOrder                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event        Event                            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product      MerchandiseProduct?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      MerchandiseProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  availability MerchandiseVariantAvailability?  @relation(fields: [availabilityId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([eventId, createdAt])
  @@index([productId])
  @@index([variantId])
}

/// Staff-driven order status transitions, carrying actor and reason the same
/// way `RegistrationOperation` does for registration changes (issue #144:
/// "Staff mutations carry actor and reason where applicable").
model MerchandiseOrderStatusChange {
  id          String                 @id @default(cuid())
  orderId     String
  eventId     String
  fromStatus  MerchandiseOrderStatus
  toStatus    MerchandiseOrderStatus
  actorUserId String
  reason      String?
  createdAt   DateTime               @default(now())

  order MerchandiseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User             @relation("MerchandiseOrderStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([eventId, createdAt])
}

model SquareWebhookEvent {
  id               String                   @id @default(cuid())
  eventId          String?
  paymentAttemptId String?
  providerEventId  String                   @unique
  eventType        String
  objectId         String?
  payloadHash      String
  status           SquareWebhookEventStatus
  reason           String?
  occurredAt       DateTime
  receivedAt       DateTime                 @default(now())
  processedAt      DateTime

  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([eventType, objectId, occurredAt])
  @@index([paymentAttemptId, occurredAt])
  @@index([eventId, occurredAt])
}

model CheckIn {
  id                     String    @id @default(cuid())
  eventId                String
  registrationAttendeeId String
  idempotencyKey         String
  checkedInAt            DateTime  @default(now())
  undoneAt               DateTime?
  undoReason             String?
  createdAt              DateTime  @default(now())

  event    Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)

  /// Migration-level partial unique index permits history but allows only one
  /// row with `undoneAt IS NULL` for each registration attendee.
  @@unique([eventId, idempotencyKey])
  @@index([eventId, checkedInAt])
  @@index([registrationAttendeeId])
}

model Announcement {
  id              String               @id @default(cuid())
  eventId         String
  createdByUserId String
  title           String
  body            String
  audience        Json
  placement       String
  status          AnnouncementStatus   @default(DRAFT)
  priority        AnnouncementPriority @default(NORMAL)
  publishedAt     DateTime?
  pinnedAt        DateTime?
  pinnedByUserId  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdByUserId], references: [id])
  pinnedBy  User? @relation("AnnouncementPinnedBy", fields: [pinnedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, status, publishedAt])
  @@index([eventId, status, pinnedAt, publishedAt])
}

/// Event-level controls keep attendee discussion off until staff publish the
/// conduct agreement and deliberately enable it.
model EventCommunitySettings {
  id              String   @id @default(cuid())
  eventId         String   @unique
  isEnabled       Boolean  @default(false)
  allowNewPosts   Boolean  @default(true)
  allowReplies    Boolean  @default(true)
  conductVersion  Int      @default(1)
  conductText     String   @default("Be kind, protect privacy, and keep posts focused on the retreat. Do not share another person's personal information without permission. Event staff may hide content that is unsafe, disruptive, or unrelated to the event.")
  retentionDays   Int      @default(30)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("CommunitySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

/// Acceptance and in-app notification choices are event-scoped. A person can
/// participate in one retreat without silently opting into another.
model CommunityParticipation {
  id                     String                          @id @default(cuid())
  eventId                String
  accountId              String
  acceptedConductVersion Int?
  conductAcceptedAt      DateTime?
  notificationPreference CommunityNotificationPreference @default(REPLIES)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([eventId, accountId])
  @@index([eventId, notificationPreference])
}

model CommunityPost {
  id                String              @id @default(cuid())
  eventId           String
  authorAccountId   String
  parentId          String?
  body              String
  status            CommunityPostStatus @default(PUBLISHED)
  moderatedAt       DateTime?
  moderatedByUserId String?
  moderationNote    String?
  /// Author deletion is a tombstone: the body and moderation/report evidence
  /// remain available to authorized staff rather than being physically erased.
  authorDeletedAt   DateTime?
  lastEditedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author        AttendeeAccount         @relation("CommunityPostAuthor", fields: [authorAccountId], references: [id], onDelete: Cascade)
  parent        CommunityPost?          @relation("CommunityPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       CommunityPost[]         @relation("CommunityPostReplies")
  moderatedBy   User?                   @relation("CommunityPostModeratedBy", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  reports       CommunityReport[]
  notifications CommunityNotification[]
  revisions     CommunityPostRevision[]

  @@index([eventId, status, createdAt])
  @@index([parentId, createdAt])
  @@index([authorAccountId, createdAt])
}

/// Immutable prior bodies captured whenever an attendee edits their own post.
/// The public community surface only shows that a post was edited; revision
/// contents remain for authorized operational review and audit correlation.
model CommunityPostRevision {
  id        String        @id @default(cuid())
  postId    String
  body      String
  createdAt DateTime      @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model CommunityReport {
  id                String                @id @default(cuid())
  eventId           String
  postId            String
  reporterAccountId String
  reason            CommunityReportReason
  detail            String?
  status            CommunityReportStatus @default(OPEN)
  resolutionNote    String?
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  post       CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   AttendeeAccount @relation("CommunityReportReporter", fields: [reporterAccountId], references: [id], onDelete: Cascade)
  resolvedBy User?           @relation("CommunityReportResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterAccountId])
  @@index([eventId, status, createdAt])
}

model CommunityNotification {
  id                 String                    @id @default(cuid())
  eventId            String
  recipientAccountId String
  actorAccountId     String
  postId             String
  kind               CommunityNotificationKind
  readAt             DateTime?
  createdAt          DateTime                  @default(now())

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient AttendeeAccount @relation("CommunityNotificationRecipient", fields: [recipientAccountId], references: [id], onDelete: Cascade)
  actor     AttendeeAccount @relation("CommunityNotificationActor", fields: [actorAccountId], references: [id], onDelete: Cascade)
  post      CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([recipientAccountId, postId, kind])
  @@index([recipientAccountId, readAt, createdAt])
  @@index([eventId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  eventId       String?
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  correlationId String
  summary       String
  metadata      Json?
  createdAt     DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
}

model ImportRun {
  id              String          @id @default(cuid())
  eventId         String
  startedByUserId String
  sourceSystem    String
  sourceRunKey    String
  fileName        String?
  sourceChecksum  String?
  status          ImportRunStatus @default(PENDING)
  recordsCreated  Int             @default(0)
  recordsUpdated  Int             @default(0)
  recordsSkipped  Int             @default(0)
  warnings        Int             @default(0)
  errors          Int             @default(0)
  summary         Json?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?

  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startedBy User           @relation(fields: [startedByUserId], references: [id])
  records   ImportRecord[]

  @@unique([sourceSystem, sourceRunKey])
  @@index([eventId, startedAt])
}

model ImportRecord {
  id                    String             @id @default(cuid())
  importRunId           String
  sourceRow             Int
  sourceRecordKey       String
  confirmationCode      String?
  status                ImportRecordStatus
  proposedAction        String
  matchedPersonId       String?
  matchedRegistrationId String?
  committedEntityId     String?
  rawSnapshot           Json
  normalizedData        Json?
  differences           Json?
  warnings              Json?
  errors                Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@unique([importRunId, sourceRow])
  @@index([importRunId, status])
  @@index([sourceRecordKey])
}

model RegistrationForm {
  id              String                 @id @default(cuid())
  eventId         String
  createdByUserId String
  name            String
  slug            String
  status          RegistrationFormStatus @default(DRAFT)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  event                 Event                             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy             User                              @relation("RegistrationFormCreatedBy", fields: [createdByUserId], references: [id])
  versions              RegistrationFormVersion[]
  capacityReservations  RegistrationCapacityReservation[]
  programAssignmentRuns ProgramAssignmentRun[]

  @@unique([eventId, slug])
  @@index([eventId, status, updatedAt])
}

model RegistrationFormVersion {
  id              String                 @id @default(cuid())
  formId          String
  createdByUserId String
  versionNumber   Int
  status          RegistrationFormStatus @default(DRAFT)
  definition      Json
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  form                  RegistrationForm                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdBy             User                              @relation("RegistrationFormVersionCreatedBy", fields: [createdByUserId], references: [id])
  testSubmissions       FormTestSubmission[]
  publicSubmissions     PublicRegistrationSubmission[]
  capacityReservations  RegistrationCapacityReservation[]
  programAssignmentRuns ProgramAssignmentRun[]

  @@unique([formId, versionNumber])
  @@index([formId, status, versionNumber])
}

/// A reusable, versioned event blueprint (#152). `status` is the template's
/// own lifecycle: DRAFT until its first publish, PUBLISHED once a version has
/// been published, and ARCHIVED — sticky — once a staff member archives it
/// (saving and publishing are then refused). Each `EventTemplateVersion`
/// carries its own status so a published version's payload is immutable and
/// a later draft never touches it. The audience (#481) a template creates
/// lives only in its version payload, so the picker and apply always agree;
/// `createdBy` is its owner.
model EventTemplate {
  id              String              @id @default(cuid())
  name            String
  description     String              @default("")
  status          EventTemplateStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy    User                       @relation("EventTemplateCreatedBy", fields: [createdByUserId], references: [id])
  versions     EventTemplateVersion[]
  applications EventTemplateApplication[]

  @@index([status, updatedAt])
}

/// One immutable-once-published revision of an `EventTemplate`'s payload
/// (#152). `payload` is validated against `eventTemplatePayloadSchema` before
/// it is ever stored, and again — against current form templates, message
/// template keys, and other module references — the moment it is applied, so
/// a reference that has since become unavailable is caught before any event
/// is created. The migration also carries two partial unique indexes Prisma
/// cannot express: at most one PUBLISHED and at most one DRAFT version per
/// template (`EventTemplateVersion_one_published_per_template`,
/// `EventTemplateVersion_one_draft_per_template`), matching
/// `RegistrationFormVersion`.
model EventTemplateVersion {
  id              String              @id @default(cuid())
  templateId      String
  createdByUserId String
  versionNumber   Int
  status          EventTemplateStatus @default(DRAFT)
  payload         Json
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  template     EventTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("EventTemplateVersionCreatedBy", fields: [createdByUserId], references: [id])
  applications EventTemplateApplication[]

  @@unique([templateId, versionNumber])
  @@index([templateId, status, versionNumber])
}

/// Records the one-time, non-live copy an "apply" makes (#152): the new event
/// gets its own editable rows (forms, attendee types, etc.), never a link
/// back to the template, and this row is the permanent provenance record of
/// exactly which template/version produced it. `requestKey` is the caller's
/// idempotency key, unique per actor — a retried apply with the same key and
/// the same `requestInput` returns the event already created instead of
/// creating a second one, and the same key with different input is refused —
/// and `eventId` is unique because a given draft event can only ever come
/// from one apply.
model EventTemplateApplication {
  id                String   @id @default(cuid())
  templateId        String
  templateVersionId String
  eventId           String   @unique
  actorUserId       String
  requestKey        String
  /// The new event's details as requested (name, slug, startsOn, endsOn):
  /// what a retry with the same `requestKey` is compared against.
  requestInput      Json
  /// A full copy of the version's payload at the moment it was applied
  /// (#152) — the permanent record of what was requested, including the
  /// report selections, which have no owning domain to apply themselves to
  /// yet and are snapshot-only in this slice.
  payloadSnapshot   Json
  createdAt         DateTime @default(now())

  template        EventTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion EventTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor           User                 @relation("EventTemplateApplicationActor", fields: [actorUserId], references: [id])

  @@unique([actorUserId, requestKey])
  @@index([templateId, createdAt])
}

model FormTestSubmission {
  id                String   @id @default(cuid())
  eventId           String
  formVersionId     String
  submittedByUserId String
  responses         Json
  validation        Json
  isValid           Boolean
  createdAt         DateTime @default(now())

  event       Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formVersion RegistrationFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  submittedBy User                    @relation("FormTestSubmissionSubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([eventId, createdAt])
  @@index([formVersionId, createdAt])
}

model PublicRegistrationSubmission {
  id                String   @id @default(cuid())
  eventId           String
  formVersionId     String
  registrationId    String   @unique
  idempotencyKey    String
  requestHash       String
  responses         Json
