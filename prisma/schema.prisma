/// A feature turned on for one event (#741). A row means "enabled"; the
/// catalog of keys, their titles and applicability live in code
/// (`modules/event-modules`), so there is no boolean column per module.
/// Turning a module off removes only this row, never the data behind it.
/// Only system administrators change rows.
model EventModule {
  id        String   @id @default(cuid())
  eventId   String
  moduleKey String
  enabledAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, moduleKey])
}

enum ModuleRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// An event admin's request that a system administrator turn an event module on
/// (#741 slice 3). Only a system administrator decides. The migration adds a
/// partial unique index Prisma cannot express, `ModuleRequest_one_pending_per_module`
/// on (eventId, moduleKey) WHERE status = 'PENDING', so concurrent submissions
/// leave one pending request. A declined request stays as history and may be
/// asked for again.
model ModuleRequest {
  id                String              @id @default(cuid())
  eventId           String
  moduleKey         String
  requestedByUserId String?
  /// Why the event needs it. Free text from the requester; kept out of audit metadata.
  reason            String
  status            ModuleRequestStatus @default(PENDING)
  decidedByUserId   String?
  decidedAt         DateTime?
  /// Why a system administrator declined. Required to decline; kept out of audit metadata.
  declineReason     String?
  createdAt         DateTime            @default(now())

  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("ModuleRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedBy   User?  @relation("ModuleRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([status, createdAt])
}

/// One site of a multi-location event (#413), e.g. one Honors Weekend site or
/// one Camporee campus. An event with no locations behaves as before; with
/// active locations every new club registration picks one. `firstDay` and
/// `lastDay` are date-only `YYYY-MM-DD` strings in the event's time zone, like
/// `Event.registrationClosesOn`; when unset the event's own dates apply.
/// `capacity` is counted the same way as `Event.capacity`. `name` is unique per
/// event case-insensitively, enforced by the `normalizedName` unique index.
/// Deactivate instead of deleting once any registration uses a location.
model EventLocation {
  id                   String   @id @default(cuid())
  eventId              String
  name                 String
  normalizedName       String
  address              String?
  firstDay             String?
  lastDay              String?
  capacity             Int?
  registrationClosesOn String?
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  /// The Area Coordinator for this location (#599): an attendee account that
  /// holds an active `AreaCoordinatorGrant`. Optional. Whether the person is
  /// still active is decided when it matters (emails, the portal), so a revoked
  /// or expired coordinator simply stops being notified.
  coordinatorAccountId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event           Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coordinator     AttendeeAccount?         @relation("EventLocationCoordinator", fields: [coordinatorAccountId], references: [id], onDelete: SetNull)
  registrations   Registration[]
  waitlistChanges LocationWaitlistChange[]
  honorSessions   HonorSession[]
  honorOfferings  HonorOffering[]
  honorRooms      HonorRoom[]

  @@unique([eventId, normalizedName])
  @@index([eventId, isActive, sortOrder])
  @@index([coordinatorAccountId])
  generalLinkSubmissions GeneralLinkSubmission[]
}

enum LocationWaitlistChangeKind {
  JOINED
  PROMOTED
  REMOVED
}

/// One change to a location's waitlist (#599): a club joined, was promoted, or
/// was removed. Written in the same transaction as the registration change and
/// read by the daily digest to Area Coordinators and event staff. `digestedAt`
/// is set once a digest covering the row has been queued. The club, location
/// and counts are snapshots, so the digest reads as things were when they
/// happened. `place` is the club's place in line at that location (joined:
/// after joining; removed: where it stood; promoted: where it had stood).
model LocationWaitlistChange {
  id             String                     @id @default(cuid())
  eventId        String
  locationId     String
  registrationId String
  kind           LocationWaitlistChangeKind
  clubName       String
  locationName   String
  attendeeCount  Int
  place          Int?
  occurredAt     DateTime                   @default(now())
  digestedAt     DateTime?

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location     EventLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([digestedAt, occurredAt])
  @@index([locationId, occurredAt])
  @@index([registrationId])
}

/// Event-owned identity used by registration, pricing, capacity, and restriction
/// modules. `label` is mutable; RegistrationAttendee.attendeeType is the snapshot.
model EventAttendeeType {
  id          String   @id @default(cuid())
  eventId     String
  code        String
  label       String
  description String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  minimumAge  Int?
  maximumAge  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendees RegistrationAttendee[]
  mealPrices EventMealPrice[]
  consentPolicyApplicabilities EventConsentPolicyApplicability[]

  @@unique([eventId, code])
  @@index([eventId, isActive, sortOrder, label])
}

/// Orthogonal event-owned groupings. An attendee has one type but can have any
/// number of categories, tracks, and departments.
model EventAttendeeClassification {
  id          String                     @id @default(cuid())
  eventId     String
  kind        AttendeeClassificationKind
  code        String
  label       String
  description String                     @default("")
  sortOrder   Int                        @default(0)
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  event       Event                              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments RegistrationAttendeeClassification[]

  @@unique([eventId, kind, code])
  @@index([eventId, kind, isActive, sortOrder, label])
}

enum NoteVisibility {
  STAFF
  RESTRICTED
}

/// Configured event vocabulary staff apply to registrations and attendees.
/// Never free text: `normalizedName` enforces one spelling per event, so
/// filters and exports do not fracture across near-duplicate tag names.
model EventTag {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  normalizedName String
  color          String
  description    String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event                   Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationAssignments RegistrationTagAssignment[]
  attendeeAssignments     AttendeeTagAssignment[]

  @@unique([eventId, normalizedName])
  @@index([eventId, isActive, name])
}

/// Applying and removing a tag are both recorded rows. Removal sets
/// `removedAt`/`removedByUserId` rather than deleting the row, so the history
/// that a tag was once applied survives even after it is taken off.
model RegistrationTagAssignment {
  id              String    @id @default(cuid())
  eventId         String
  registrationId  String
  tagId           String
  appliedByUserId String
  appliedAt       DateTime  @default(now())
  removedByUserId String?
  removedAt       DateTime?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tag          EventTag     @relation(fields: [tagId], references: [id], onDelete: Restrict)
  appliedBy    User         @relation("RegistrationTagAppliedBy", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  removedBy    User?        @relation("RegistrationTagRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, registrationId, removedAt])
  @@index([tagId, removedAt])
}

/// Attendee-level counterpart of `RegistrationTagAssignment`, same
/// apply/remove-preserves-history shape.
model AttendeeTagAssignment {
  id              String    @id @default(cuid())
  eventId         String
  attendeeId      String
  tagId           String
  appliedByUserId String
  appliedAt       DateTime  @default(now())
  removedByUserId String?
  removedAt       DateTime?

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee  RegistrationAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  tag       EventTag             @relation(fields: [tagId], references: [id], onDelete: Restrict)
  appliedBy User                 @relation("AttendeeTagAppliedBy", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  removedBy User?                @relation("AttendeeTagRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, attendeeId, removedAt])
  @@index([tagId, removedAt])
}

/// Attached to exactly one of a registration, an attendee, or a person (a
/// database check constraint enforces the XOR Prisma cannot express). The
/// note itself never carries body text — `StaffNoteRevision` rows are the
/// append-only history, mirroring how `RegistrationOperation` treats history.
/// Not for medical, safeguarding, or incident detail: see #44 and #79.
model StaffNote {
  id                   String         @id @default(cuid())
  eventId              String
  registrationId       String?
  attendeeId           String?
  personId             String?
  visibility           NoteVisibility @default(STAFF)
  /// Required, and only meaningful, when visibility is RESTRICTED: the named
  /// EventPermission a viewer must hold to read this note's body.
  restrictedPermission String?
  authorUserId         String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration?         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     RegistrationAttendee? @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  person       Person?               @relation(fields: [personId], references: [id], onDelete: Cascade)
  author       User                  @relation("StaffNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  revisions    StaffNoteRevision[]

  @@index([eventId, registrationId])
  @@index([eventId, attendeeId])
  @@index([eventId, personId])
}

/// One row per version of a note's body, oldest first by `sequence`. Editing
/// a note appends a revision; nothing is ever overwritten or deleted.
model StaffNoteRevision {
  id           String   @id @default(cuid())
  noteId       String
  sequence     Int
  body         String
  authorUserId String
  createdAt    DateTime @default(now())

  note   StaffNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User      @relation("StaffNoteRevisionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([noteId, sequence])
  @@index([noteId, createdAt])
}

/// A reviewed, preview-only record of who an event message would reach (#176). It stores the audit facts a later
/// scheduler (#177) needs to refuse a changed audience: the normalized query, its version, the audience fingerprint and
/// the counts. It never stores a recipient, an address, a name or a note, and creating one sends or schedules nothing.
/// `id` is the client-generated UUID, so a lost-response retry with the same fingerprint returns the same row.
model EventAudienceSnapshot {
  id                 String   @id
  eventId            String
  createdByUserId    String
  sourceQueryVersion String
  queryHash          String
  query              Json
  fingerprint        String
  recipientCount     Int
  exclusionCount     Int
  registrationCount  Int
  createdAt          DateTime @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation("EventAudienceSnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([eventId, fingerprint])
}

/// How a scheduled email batch is timed (#177). ONE_TIME is a calendar date and wall-clock time in the event's own
/// time zone; the others are a number of calendar days before an event anchor, at a wall-clock time in that zone.
enum ScheduledEmailTrigger {
  ONE_TIME
  BEFORE_REGISTRATION_CLOSE
  BEFORE_EVENT_START
  BEFORE_PAYMENT_DUE
}

/// SCHEDULED: written and reviewed, but not approved; nothing will send. ACTIVE: a person approved it, so the sweep
/// sends it at `sendAt`. PAUSED: approval is held (a person paused it, or the event or template changed under it).
/// CANCELLED: stopped by a person; rows already sent stay sent. COMPLETED: every recipient was dealt with.
/// FAILED: it could not run (the reason is on the row).
enum ScheduledEmailBatchStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  FAILED
}

enum ScheduledEmailRecipientStatus {
  /// Reviewed and approved; no message exists yet.
  PLANNED
  /// A message was queued in the outbox (`outboxMessageId`); its own status says whether it was sent.
  QUEUED
  /// Re-checked at send time and no longer eligible; `exclusionCode` says why. No message was or will be sent.
  EXCLUDED
  /// The schedule was cancelled before this recipient was queued.
  CANCELLED
}

/// One reviewed, human-approved email batch that goes out at a future time in the event's time zone (#177).
/// It never activates or sends itself: `activatedByUserId` is a person, and only the sweep sends an ACTIVE row.
model ScheduledEmailBatch {
  /// Client-generated UUID, so a retried request is the same batch.
  id                       String                    @id
  eventId                  String
  name                     String
  templateKey              MessageTemplateKey
  announcementTitle        String?
  announcementBody         String?
  /// The published template version reviewed; a different published version at send time pauses the schedule.
  templateVersionId        String?
  templateVersionNumber    Int?
  trigger                  ScheduledEmailTrigger
  /// ONE_TIME: the calendar date (YYYY-MM-DD) in the event's time zone.
  localDate                String?
  /// Wall-clock time (HH:MM, 24 hours) in the event's time zone.
  localTime                String
  /// Relative triggers: calendar days before the anchor's calendar date.
  daysBefore               Int?
  /// The event's time zone and anchor instant as they were when the schedule was last reviewed. A later change to
  /// either pauses the schedule, because its projected time no longer holds.
  eventTimezone            String
  anchorAt                 DateTime?
  sendAt                   DateTime
  /// NONE, GAP_SHIFTED (the wall time does not exist that day) or AMBIGUOUS_FIRST (it happens twice; the first is used).
  dstBehavior              String                    @default("NONE")
  /// The plain sentence the approver was shown about daylight saving, kept so the list says the same thing.
  dstNote                  String?
  audienceQuery           Json
  audienceQueryVersion     String
  audienceQueryHash        String
  audienceFingerprint      String
  /// Counts from the review that was approved.
  eligibleCount            Int                       @default(0)
  excludedCount            Int                       @default(0)
  revision                 Int                       @default(1)
  status                   ScheduledEmailBatchStatus @default(SCHEDULED)
  createdByUserId          String
  activatedByUserId        String?
  activatedAt              DateTime?
  pausedAt                 DateTime?
  pauseReason              String?
  cancelledAt              DateTime?
  cancelledByUserId        String?
  /// Set by the one worker that claimed the send. A second worker, or a retry, cannot claim a held claim.
  claimToken               String?
  claimedAt                DateTime?
  completedAt              DateTime?
  failedAt                 DateTime?
  failureReason            String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  event       Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User                       @relation("ScheduledEmailCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activatedBy User?                      @relation("ScheduledEmailActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  recipients  ScheduledEmailRecipient[]

  @@index([eventId, createdAt])
  @@index([status, sendAt])
}

/// One reviewed recipient of a scheduled batch: an address and the registration it is for. Created when staff activate
/// the batch, so the approved audience is a fixed list that send time can only shrink, never grow.
model ScheduledEmailRecipient {
  id              String                        @id @default(cuid())
  batchId         String
  eventId         String
  registrationId  String
  recipientEmail  String
  recipientName   String
  /// The audience roles that reached the address on this registration, so send time can re-check an adult role.
  roles           String[]
  status          ScheduledEmailRecipientStatus @default(PLANNED)
  exclusionCode   String?
  outboxMessageId String?                       @unique
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  batch   ScheduledEmailBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  message MessageOutbox?      @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)

  @@unique([batchId, registrationId, recipientEmail])
  @@index([batchId, status])
  @@index([eventId])
}

model EventMembership {
  id          String            @id @default(cuid())
  eventId     String
  userId      String
  role        EventRole
  permissions EventPermission[] @default([])
  status      MembershipStatus  @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model Person {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  normalizedEmail String?  @unique
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  householdMembers   HouseholdMember[]
  heldRegistrations  Registration[]
  groupBillingRegistrations GroupEventRegistration[]
  billingResponsibilities   RegistrationBillingResponsibility[]
  groupContactOperations RegistrationOperation[] @relation("RegistrationOperationActorPerson")
  registrationEvents RegistrationAttendee[]
  externalIdentities ExternalIdentity[]
  notes              StaffNote[]
  attendeeAccountLinks AttendeeAccountPersonLink[]
  userLinks            UserPersonLink[]
  matchCandidatesAsA   PersonMatchCandidate[] @relation("PersonMatchCandidateAsA")
  matchCandidatesAsB   PersonMatchCandidate[] @relation("PersonMatchCandidateAsB")
  clubRosterMemberships ClubRosterMember[]
  healthSnapshots       HealthRecordSnapshot[]
  healthSnapshotHolds   HealthSnapshotHold[]
  healthSnapshotBreakGlass HealthSnapshotBreakGlass[]
  healthBreakGlassUses     HealthBreakGlassUse[]
  honorInstructorRoles  HonorInstructor[]
  backgroundCheckMatch  BackgroundCheckMatch?
  backgroundChecksPre527 BackgroundCheckPre527[] @ignore
  driverVerification    DriverVerification?

  memberHonorEntries    MemberHonorEntry[]
  memberTransfers       MemberTransfer[] @relation("MemberTransferPerson")
  pendingMemberTransfer MemberTransfer?  @relation("MemberTransferPendingPerson")
  clubOrderNeeds        ClubOrderNeed[]
  memberClassCompletions MemberClassCompletion[]
  guardianAuthoritiesAsMinor GuardianAuthority[] @relation("GuardianAuthorityMinor")
  guardianAuthoritiesAsAdult GuardianAuthority[] @relation("GuardianAuthorityAdult")
  guardianAuthoritiesDeclared GuardianAuthority[] @relation("GuardianAuthorityActorPerson")
  acknowledgmentEvidenceAsSubject AcknowledgmentEvidence[] @relation("AcknowledgmentEvidenceSubject")
  acknowledgmentEvidenceActed AcknowledgmentEvidence[] @relation("AcknowledgmentEvidenceActedBy")
  guardianConflictsAsMinor   GuardianAuthorityConflict[] @relation("GuardianConflictMinor")
  guardianConflictsAsAdult   GuardianAuthorityConflict[] @relation("GuardianConflictAdult")
  lodgingRoommateAsker       EventLodgingRoommateRequest[] @relation("LodgingRoommateFromPerson")
  lodgingRoommateAsked       EventLodgingRoommateRequest[] @relation("LodgingRoommateTargetPerson")
  lodgingRulesAsA            EventLodgingRule[] @relation("LodgingRulePersonA")
  lodgingRulesAsB            EventLodgingRule[] @relation("LodgingRulePersonB")

  @@index([lastName, firstName])
