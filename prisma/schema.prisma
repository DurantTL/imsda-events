  @@index([eventId, status, pinnedAt, publishedAt])
}

/// An email address that opted out of event announcements (#838). The preference lives on the normalised address,
/// not on a registration or person, so it follows the address across registrations. Only announcements can be opted
/// out of; confirmations, receipts, waitlist and transfer notices, balance reminders and safety notices always go.
/// `scopeKey` is the event id for an EVENT row and "ALL" for a global one, so one row per address and scope is unique
/// (a nullable event id would not be).
model EmailAnnouncementOptOut {
  id              String                       @id @default(cuid())
  normalizedEmail String
  scope           EmailAnnouncementOptOutScope
  eventId         String?
  scopeKey        String
  /// How it was recorded: the unsubscribe page, or the one-click POST a mail client sends.
  source          String
  createdAt       DateTime                     @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([normalizedEmail, scopeKey])
  @@index([eventId, createdAt])
  @@index([normalizedEmail])
}

/// The opaque unsubscribe link an announcement carries (#838). The link holds only a random-looking token; this row is
/// what says which address and event it is for, so the address never appears in a URL, a request log or a header. Only
/// the SHA-256 of the token is stored, so a copy of this table cannot be used to unsubscribe anyone. A token stays valid
/// after the signing secret is rotated, because it is looked up, not re-derived.
model EmailUnsubscribeToken {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  normalizedEmail String
  eventId         String
  createdAt       DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

