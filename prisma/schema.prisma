model RegistrationOperation {
  id                 String                    @id @default(cuid())
  eventId            String
  registrationId     String
  attendeeId         String?
  type               RegistrationOperationType
  clientRequestId    String
  requestFingerprint String
  /// Set when the amendment engine ran for a staff user. Mutually exclusive
  /// with `actorAttendeeAccountId` (enforced by a database check
  /// constraint), same XOR shape as `AttendeeAccountPersonLink`.
  actorUserId        String?
  /// Set when a club director reopened and amended their own club
  /// registration (H3b, #366) instead of a staff user amending it.
  actorAttendeeAccountId String?
  /// Set when the contact of a "Group" registration (#650) changed it through
  /// the registration's private manage link: a person, not a signed-in account.
  /// Exactly one of the three actor columns is set (database check constraint).
  actorPersonId      String?
  actorNameSnapshot  String
  beforeSnapshot     Json
  afterSnapshot      Json
  responseSnapshot   Json
  createdAt          DateTime                  @default(now())

  event               Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration        Registration          @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  attendee            RegistrationAttendee? @relation(fields: [attendeeId], references: [id], onDelete: Restrict)
  actor               User?                 @relation("RegistrationOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorAttendeeAccount AttendeeAccount?     @relation("RegistrationOperationActorAttendeeAccount", fields: [actorAttendeeAccountId], references: [id], onDelete: Restrict)
  actorPerson         Person?               @relation("RegistrationOperationActorPerson", fields: [actorPersonId], references: [id], onDelete: Restrict)

  @@unique([eventId, clientRequestId])
  @@index([registrationId, createdAt])
  @@index([attendeeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorAttendeeAccountId, createdAt])
  @@index([actorPersonId, createdAt])
}

/// A staff change to what a registration owes (#396): a scholarship, a
/// discount, a promo code applied after submission, or a correction.
/// `amountCents` is negative when it lowers the amount owed. Lines are never
/// edited; a reversal is a new line pointing at the one it cancels. The
/// registration total is the priced total plus every line.
model RegistrationAdjustment {
  id                    String                     @id @default(cuid())
  eventId               String
  registrationId        String
  kind                  RegistrationAdjustmentKind
  amountCents           Int
  reason                String
  promoCodeId           String?
  promoCodeSnapshot     String?
  /// Set when the adjustment is for one person in the registration (#397).
  registrationAttendeeId String?
  reversesAdjustmentId  String?                    @unique
  createdByUserId       String?
  createdByNameSnapshot String
  createdAt             DateTime                   @default(now())

  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  promoCode    PromoCode?              @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  attendee     RegistrationAttendee?   @relation(fields: [registrationAttendeeId], references: [id], onDelete: SetNull)
  reverses     RegistrationAdjustment? @relation("AdjustmentReversal", fields: [reversesAdjustmentId], references: [id], onDelete: Restrict)
  reversedBy   RegistrationAdjustment? @relation("AdjustmentReversal")
  mealLedgerEntry EventMealLedgerEntry?
  assetLedgerEntry AssetLedgerEntry?
  scholarshipAward ScholarshipAward?

  @@index([registrationId, createdAt])
  @@index([eventId, kind])
  @@index([registrationAttendeeId])
}

enum RegistrationAdjustmentKind {
  SCHOLARSHIP
  DISCOUNT
  PROMO_CODE
  CORRECTION
  /// A charge or credit posted by the meal ledger (#210). Never reversed by hand: change the meal order instead.
  MEAL
  /// A charge posted for a lost or damaged issued item, or its waiver (#214). Never reversed by hand: waive it from the issued-asset closeout.
  ASSET
}

model Payment {
  id                String        @id @default(cuid())
  eventId           String
  registrationId    String
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus
  method            PaymentMethod
  externalReference String?
  /// The registration's reservation deposit (#415): at most one per registration counts at a time.
  /// Set on a card payment whose attempt was a deposit and on a staff-recorded deposit. A
  /// reservation counts as held exactly while a deposit payment's net amount is above zero.
  isDeposit         Boolean       @default(false)
  receivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  refunds        Refund[]
  paymentAttempt PaymentAttempt?

  @@index([eventId, status])
  @@index([registrationId])
}

model PaymentAttempt {
  id                        String               @id @default(cuid())
  eventId                   String
  registrationId            String
  registrationAccessTokenId String?
  paymentId                 String?              @unique
  provider                  String               @default("SQUARE")
  environment               String
  clientIdempotencyKey      String               @unique
  providerIdempotencyKey    String               @unique
  activeRegistrationKey     String?              @unique
  /// EMBEDDED unless the payer is using Square's hosted checkout page (#327).
  channel                   PaymentAttemptChannel @default(EMBEDDED)
  /// Set when this attempt's payment arrived after another payment had already settled the balance
  /// it was quoted for (first recorded payment wins). The money was taken, so the payment row is
  /// kept as PENDING and a `SquareDuplicateCharge` holds the evidence; it never counts toward the
  /// balance and sends no receipt.
  duplicateReason           String?
  /// This attempt pays the form's fixed reservation deposit, not the whole balance (#415). The
  /// resulting payment is marked `isDeposit`. The surcharge below is the card fee on the deposit.
  isDeposit                 Boolean              @default(false)
  amountCents               Int
  /// The card processing surcharge inside `amountCents`, for a registration
  /// whose total did not already price one in — a pay-later registrant
  /// settling a balance by card. It is added to the registration total when
  /// the payment succeeds, never at quote time, so an abandoned checkout
  /// leaves the balance exactly as it was.
  surchargeCents            Int                  @default(0)
  currency                  String               @default("USD")
  status                    PaymentAttemptStatus @default(PROCESSING)
  providerPaymentId         String?              @unique
  providerStatus            String?
  providerStatusAt          DateTime?
  failureCode               String?
  failureMessage            String?
  requestCount              Int                  @default(1)
  lastRequestedAt           DateTime?
  completedAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  event                   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration            Registration             @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationAccessToken RegistrationAccessToken? @relation(fields: [registrationAccessTokenId], references: [id], onDelete: SetNull)
  payment                 Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  webhookEvents           SquareWebhookEvent[]
  hostedCheckout          SquareHostedCheckout?
  duplicateCharges        SquareDuplicateCharge[]

  @@index([eventId, status, createdAt])
  @@index([registrationId, createdAt])
}

/// The server-owned mapping between one hosted "Pay on Square" link and the payment attempt that
/// owns its amount (#327). The attempt's `amountCents` and `surchargeCents` are the immutable quote;
/// nothing here restates an amount. Square's order id is how a webhook finds the attempt, because a
/// payment-link payment carries `order_id` and no `reference_id`.
model SquareHostedCheckout {
  id                    String                     @id @default(cuid())
  eventId               String
  registrationId        String
  paymentAttemptId      String                     @unique
  environment           String
  status                SquareHostedCheckoutStatus @default(CREATING)
  providerPaymentLinkId String?                    @unique
  providerOrderId       String?                    @unique
  /// Square's hosted page address. Anyone holding it can pay the quoted amount and nothing else,
  /// so it is not a credential; it is still only ever returned to the registrant who asked.
  checkoutUrl           String?
  /// SHA-256 of the opaque return id Square sends the payer back to (`/pay/square/return/<id>`).
  /// The id is a status-only capability, never the registrant's private manage token, so Square
  /// never holds a link that opens their registration.
  returnTokenHash       String?                    @unique
  returnExpiresAt       DateTime?
  expiresAt             DateTime
  invalidationReason    String?
  invalidatedAt         DateTime?
  /// Set once Square has deleted the link (which cancels its order), or reported it already gone.
  providerDeletedAt     DateTime?
  providerDeleteError   String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([registrationId, status])
  @@index([status, expiresAt])
}

/// A processor-level exception (#327): a Square payment that must not count toward the balance and
/// needs a human refund. A duplicate of a balance another payment had settled, a second payment on an
/// order that already has one, or an amount other than the quote (a split payment). Several may share
/// one attempt. Evidence only; refunds stay a human action through the normal audited flow.
/// `evidence` holds a whitelisted copy of Square's payment (ids, status, amount, order, timestamps),
/// never card or payer details.
model SquareDuplicateCharge {
  id                String                      @id @default(cuid())
  eventId           String
  registrationId    String
  paymentAttemptId  String
  paymentId         String?
  providerPaymentId String                      @unique
  providerOrderId   String?
  environment       String
  reason            String
  amountCents       Int
  currency          String                      @default("USD")
  winningPaymentId  String?
  evidence          Json
  status            SquareDuplicateChargeStatus @default(OPEN)
  detectedAt        DateTime                    @default(now())
  resolvedAt        DateTime?

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([paymentAttemptId])
  @@index([eventId, status])
  @@index([registrationId])
}

/// One immutable version of an event's cancellation rules (#169). Changing the rules adds a new version with its own
/// effective date; a version is never edited or deleted (a trigger rejects both, except while the whole event is being
/// deleted). Calculations copy the rules they used, so a later version cannot change an earlier outcome. Separate from
/// `Event.refundPolicy` (#891), which is display text only.
model EventCancellationPolicyVersion {
  id                    String   @id @default(cuid())
  eventId               String
  /// 1, 2, 3 ... per event.
  version               Int
  /// From this instant the version applies to new calculations.
  effectiveFrom         DateTime
  /// Shape of `rules`, so a later change to the rules format can read old rows.
  rulesSchema           Int      @default(1)
  rules                 Json
  note                  String?
  createdByUserId       String?
  createdByNameSnapshot String
  createdAt             DateTime @default(now())

  event        Event                     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  calculations CancellationCalculation[]

  @@unique([eventId, version])
  @@index([eventId, effectiveFrom])
}

/// A recorded cancellation calculation (#169): the policy version used, the facts it was computed from and the
/// proposed outcome. Immutable, and never an instruction: recording one cancels nothing, refunds nothing and creates
/// no credit. `registrationId` is deliberately not a foreign key so this history outlives the registration it describes.
model CancellationCalculation {
  id              String   @id @default(cuid())
  eventId         String
  registrationId  String?
  /// Null when no version was in effect.
  policyVersionId String?
  policyVersion   Int?
  /// REGISTRATION for an authorized registration, SYNTHETIC for staff-entered preview input.
  source          String
  status          String
  scope           String
  evaluatedAt     DateTime
  facts           Json
  result          Json
  createdByUserId String?
  createdAt       DateTime @default(now())

  event         Event                           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  policyVersionRow EventCancellationPolicyVersion? @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  requests         CancellationRequest[]

  @@index([eventId, createdAt])
  @@index([registrationId, createdAt])
  @@index([policyVersionId])
}

/// Where a cancellation request stands (#170). A request is only ever a request: no state here cancels a registration,
/// refunds money or issues credit. APPROVED records a human decision; carrying it out is a later slice (#171).
enum CancellationRequestStatus {
  REQUESTED
  UNDER_REVIEW
  INFORMATION_NEEDED
  APPROVED
  DECLINED
  WITHDRAWN
  SUPERSEDED
}

/// A registrant's request to cancel a registration, one attendee or a component (#170). It cites the recorded
/// calculation (policy version, rules and facts) the registrant was shown, so the proposed outcome can never change
/// after the fact. `registrationId` is deliberately not a foreign key, like the calculation, so history outlives it.
/// The request row's status moves; every move is also appended to CancellationRequestEvent, which is immutable.
model CancellationRequest {
  id                    String                    @id @default(cuid())
  eventId               String
  registrationId        String
  calculationId         String
  policyVersionId       String?
  policyVersion         Int?
  /// FULL_REGISTRATION, ATTENDEE or COMPONENT, as the registrant chose it.
  scope                 String
  attendeeIds           String[]                  @default([])
  chargeIds             String[]                  @default([])
  /// The scope and its ids in one canonical string, so a repeat of the same request is recognised.
  scopeKey              String
  status                CancellationRequestStatus @default(REQUESTED)
  /// The registrant's own words. Never copied into an email, an audit entry or a log.
  reason                String
  /// EMAIL or PHONE: how the registrant would like the event team to reach them about this request.
  contactMethod         String
  /// The proposed outcome that was shown when the request was made (the calculation's, never recalculated).
  proposedRefundCents   Int
  proposedRetainedCents Int
  /// A hash of the registration facts the calculation used, so staff can see whether the registration has changed since.
  stateFingerprint      String
  /// The registration state when requested: status, attendee and charge ids, paid and deposit amounts. No names.
  registrationState     Json
  /// MANAGE_LINK or ATTENDEE_PORTAL.
  requestedVia          String
  requestedByAccountId  String?
  /// One key per submit attempt, so a retry returns the same request instead of making another.
  idempotencyKey        String
  supersededById        String?
  /// What staff asked the registrant to provide, while INFORMATION_NEEDED. Shown on the registrant's page, never emailed.
  registrantNote        String?
  decidedByUserId       String?
  decidedByNameSnapshot String?
  decisionReason        String?
  decidedAt             DateTime?
  /// True when the registration had changed since the request and the decider acknowledged it.
  decidedWithChanges    Boolean                   @default(false)
  /// The registration state fingerprint at the moment of approval (#171), written in the same update that approves. Carrying
  /// the request out refuses when the registration no longer matches it. Null on a request approved before #171.
  approvedStateFingerprint String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  event       Event                      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  calculation CancellationCalculation    @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  timeline    CancellationRequestEvent[]
  execution   CancellationExecution?

  @@unique([registrationId, idempotencyKey])
  @@index([eventId, status, createdAt])
  @@index([registrationId, status])
}

/// One step in a request's timeline (#170). Append-only, like a calculation. Names are snapshots; the note never holds
/// the registrant's reason.
model CancellationRequestEvent {
  id                String                     @id @default(cuid())
  eventId           String
  requestId         String
  fromStatus        CancellationRequestStatus?
  toStatus          CancellationRequestStatus
  /// REGISTRANT, STAFF or SYSTEM. A system step never approves or declines.
  actorKind         String
  actorUserId       String?
  actorNameSnapshot String?
  note              String?
  createdAt         DateTime                   @default(now())

  event   Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  request CancellationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([eventId, createdAt])
}

enum CancellationExecutionStatus {
  REQUESTED
  PROCESSOR_PENDING
  COMPLETED
  FAILED
}

enum CancellationRefundMethod {
  SQUARE
  OFFLINE
}

enum CancellationStepStatus {
  PENDING
  DONE
  FAILED
}

/// Carrying out one approved cancellation request (#171), by a named staff member. One row per request, kept apart from
/// the request so the request stays final once decided. Holds the approved snapshot it was started from; the amounts and
/// the method never change after creation (the database refuses it).
model CancellationExecution {
  id                       String                      @id @default(cuid())
  eventId                  String
  requestId                String                      @unique
  registrationId           String
  /// REQUESTED, PROCESSOR_PENDING (a refund is with the processor), COMPLETED or FAILED. A failed step can be retried.
  status                   CancellationExecutionStatus @default(REQUESTED)
  scope                    String
  attendeeIds              String[]                    @default([])
  /// The approved refund. Everything refunded for this execution adds up to at most this.
  approvedRefundCents      Int
  /// Null only when the approved refund is zero.
  refundMethod             CancellationRefundMethod?
  /// The fingerprint the registration had when approved, which the registration matched when this was started.
  approvedStateFingerprint String
  executedByUserId         String
  executedByNameSnapshot   String
  cancelStatus             CancellationStepStatus      @default(PENDING)
  cancelFailureCode        String?
  cancelledAt              DateTime?
  attempts                 Int                         @default(1)
  lastFailureCode          String?
  startedAt                DateTime                    @default(now())
  completedAt              DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  event   Event                        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  request CancellationRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  refunds CancellationExecutionRefund[]

  @@index([eventId, status])
  @@index([registrationId])
}

/// One refund an execution makes against one payment (#171). The key is fixed at creation, so a retry sends the same key
/// and can never refund twice. `refundId` points at the `Refund` row once the processor accepted it or it was recorded.
model CancellationExecutionRefund {
  id                String                 @id @default(cuid())
  eventId           String
  executionId       String
  paymentId         String
  amountCents       Int
  idempotencyKey    String                 @unique
  /// PENDING (not sent or not confirmed), DONE (the refund succeeded) or FAILED (the processor declined or could not be reached).
  status            CancellationStepStatus @default(PENDING)
  refundId          String?
  providerRefundId  String?
  failureCode       String?
  attempts          Int                    @default(0)
  /// A failed refund that a named person settled outside this tool, with a required note (no money moves). Only a FAILED leg.
  resolvedAt             DateTime?
  resolvedByUserId       String?
  resolvedByNameSnapshot String?
  resolutionNote         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  execution CancellationExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@unique([executionId, paymentId])
  @@index([eventId, status])
}

model Refund {
  id                String       @id @default(cuid())
  eventId           String
  paymentId         String
  amount            Decimal      @db.Decimal(12, 2)
  status            RefundStatus
  externalReference String?
  reason            String?
  /// One key per reviewed manual refund operation (#525). A retry with the
  /// same key returns the recorded refund instead of recording another.
  /// Null for provider-driven and older refunds (nulls never collide).
  idempotencyKey    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, externalReference])
  @@unique([paymentId, idempotencyKey])
  @@index([eventId, status])
  @@index([paymentId])
  /// Operations search (#180): net-paid per payment without reading refunds outside the event.
  @@index([eventId, paymentId, status])
}

/// An event-owned merchandise product (a shirt, a mug). Disabling the product,
/// or its event being unpublished, hides it from any future public catalog
/// without touching the order history already recorded against it (issue
/// #144). No public checkout exists yet; this is the domain foundation.
model MerchandiseProduct {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  isArchived  Boolean  @default(false)
  position    Int      @default(0)
  artworkAssetId String?
  artworkAltText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event      Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artwork    EventAsset?                  @relation("MerchandiseProductArtwork", fields: [artworkAssetId], references: [id], onDelete: Restrict)
  variants   MerchandiseProductVariant[]
  orderLines MerchandiseOrderLine[]

  @@index([eventId, isEnabled, isArchived, position])
}

/// A purchasable option of a product, such as a size. A variant that has ever
/// sold is never hard-deleted by application code — only disabled — but the
/// schema also tolerates deletion (`onDelete: SetNull` on order lines) so a
/// historical line still reads correctly if a row is ever removed by hand.
model MerchandiseProductVariant {
  id        String   @id @default(cuid())
  productId String
  label     String
  sku       String?
  position  Int      @default(0)
  isEnabled Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      MerchandiseProduct                @relation(fields: [productId], references: [id], onDelete: Cascade)
  availability MerchandiseVariantAvailability[]
  orderLines   MerchandiseOrderLine[]

  @@unique([productId, label])
  @@index([productId, isEnabled, position])
}

/// The price/tax/fee/inventory terms a variant sells under. A row is never
/// edited after it is created — changing terms supersedes it with a new row
/// and deactivates the old one — so an order line can always cite the exact
/// availability it was priced from and a later catalog edit can never rewrite
/// a past purchase. Only one row per variant may have `isActive = true`; the
/// migration carries the partial unique index Prisma cannot express, plus a
/// check constraint tying `inventoryQuantity` to `inventoryPolicy`.
model MerchandiseVariantAvailability {
  id                String                     @id @default(cuid())
  variantId         String
  versionNumber     Int
  priceCents        Int
  taxTreatment      MerchandiseTaxTreatment
  feePolicy         MerchandiseFeePolicy
  inventoryPolicy   MerchandiseInventoryPolicy @default(UNLIMITED)
  inventoryQuantity Int?
  isActive          Boolean                    @default(true)
  createdByUserId   String
  reason            String?
  salesStartsAt     DateTime?
  salesEndsAt       DateTime?
  minQuantity       Int      @default(1)
  maxQuantity       Int?
  attendeeAvailability String @default("ALL")
  createdAt         DateTime                   @default(now())

  variant    MerchandiseProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy  User                      @relation("MerchandiseAvailabilityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  orderLines MerchandiseOrderLine[]

  @@unique([variantId, versionNumber])
  @@index([variantId, isActive, salesStartsAt, salesEndsAt])
}

/// Event-level switch and human approval gate for the catalog. Saving a draft
/// never activates public sales; only an explicit APPROVED state can do that.
model MerchandiseCatalog {
  id        String                   @id @default(cuid())
  eventId   String                   @unique
  isEnabled Boolean                  @default(false)
  status    MerchandiseCatalogStatus @default(DRAFT)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// A merchandise purchase. Deliberately independent of `Registration.status`
/// (issue #144): an order can be paid while a registration is still a draft,
/// and a cancelled registration does not retroactively cancel an order.
/// `registrationId` is kept only for buyer context; totals are this order's
/// own and are never folded into `Registration.totalAmount`.
/// `clientRequestId` plus the unique index below make order creation
/// retry-safe the same way `RegistrationOperation.clientRequestId` does:
/// a retry with the same key and the same basket replays the stored order,
/// and `requestFingerprint` catches a key reused for a different basket
/// instead of silently returning someone else's order.
/// `paymentMethod`/`paymentReference` are allocation fields for the append-only
/// accounting direction in #74; they intentionally do not force every order
/// through the Square-specific `Payment`/`PaymentAttempt` tables, so cash and
/// check settlement do not have to pretend to be a card workflow.
model MerchandiseOrder {
  id                String                 @id @default(cuid())
  eventId           String
  registrationId    String?
  purchaserSnapshot Json
  clientRequestId   String
  requestFingerprint String
  status            MerchandiseOrderStatus @default(PENDING)
  subtotalCents     Int
  feeCents          Int                    @default(0)
  taxCents          Int                    @default(0)
  totalCents        Int
  paymentMethod     PaymentMethod?
  paymentReference  String?
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  event         Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration  Registration?                  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  createdBy     User?                          @relation("MerchandiseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines         MerchandiseOrderLine[]
  statusChanges MerchandiseOrderStatusChange[]

  @@unique([eventId, clientRequestId])
  @@index([eventId, status, createdAt])
  @@index([registrationId])
}

/// One purchased line. Every commercial fact is copied at order time and never
/// re-read from the catalog — `productId`/`variantId`/`availabilityId` are
/// live-reference conveniences only, all nullable and `SetNull` on delete — so
/// a later price change, product rename, or variant deletion/disablement can
/// never rewrite an existing order line (issue #144 acceptance criteria).
model MerchandiseOrderLine {
  id                     String                  @id @default(cuid())
  orderId                String
  eventId                String
  productId              String?
  productNameSnapshot    String
  variantId              String?
  variantLabelSnapshot   String
  availabilityId         String?
  unitPriceCentsSnapshot Int
  quantity               Int
  taxTreatmentSnapshot   MerchandiseTaxTreatment
  feePolicySnapshot      MerchandiseFeePolicy
  lineTotalCents         Int
  createdAt              DateTime                @default(now())

  order        MerchandiseOrder                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event        Event                            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product      MerchandiseProduct?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      MerchandiseProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  availability MerchandiseVariantAvailability?  @relation(fields: [availabilityId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([eventId, createdAt])
  @@index([productId])
  @@index([variantId])
}

/// Staff-driven order status transitions, carrying actor and reason the same
/// way `RegistrationOperation` does for registration changes (issue #144:
/// "Staff mutations carry actor and reason where applicable").
model MerchandiseOrderStatusChange {
  id          String                 @id @default(cuid())
  orderId     String
  eventId     String
  fromStatus  MerchandiseOrderStatus
  toStatus    MerchandiseOrderStatus
  actorUserId String
  reason      String?
  createdAt   DateTime               @default(now())

  order MerchandiseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User             @relation("MerchandiseOrderStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([eventId, createdAt])
}

model SquareWebhookEvent {
  id               String                   @id @default(cuid())
  eventId          String?
  paymentAttemptId String?
  providerEventId  String                   @unique
  eventType        String
  objectId         String?
  payloadHash      String
  status           SquareWebhookEventStatus
  reason           String?
  occurredAt       DateTime
  receivedAt       DateTime                 @default(now())
  processedAt      DateTime

  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([eventType, objectId, occurredAt])
  @@index([paymentAttemptId, occurredAt])
  @@index([eventId, occurredAt])
}

model CheckIn {
  id                     String    @id @default(cuid())
  eventId                String
  registrationAttendeeId String
  idempotencyKey         String
  checkedInAt            DateTime  @default(now())
  undoneAt               DateTime?
  undoReason             String?
  createdAt              DateTime  @default(now())

  event    Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)

  /// Migration-level partial unique index permits history but allows only one
  /// row with `undoneAt IS NULL` for each registration attendee.
  @@unique([eventId, idempotencyKey])
  @@index([eventId, checkedInAt])
  @@index([registrationAttendeeId])
}

model Announcement {
  id              String               @id @default(cuid())
  eventId         String
  createdByUserId String
  title           String
  body            String
  audience        Json
  placement       String
  status          AnnouncementStatus   @default(DRAFT)
  priority        AnnouncementPriority @default(NORMAL)
  publishedAt     DateTime?
  pinnedAt        DateTime?
  pinnedByUserId  String?
  /// Reaches people who opted out of announcements (#838). Set by an event manager or above, audited.
  isEssential     Boolean              @default(false)
  /// The inbox preview line (preheader) of the announcement's email (#836). Plain text, tokens allowed like the subject.
  /// Null when none was written; the email then uses the template version's own line, if it has one.
  preheader       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdByUserId], references: [id])
