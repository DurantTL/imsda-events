  sourceTemplateVersionId String?
  /// The newer template version whose "template changed" notice staff dismissed for this form (#1065). Dismissing never
  /// touches `sourceTemplateVersionId`; a later template version differs from it, so it notifies again.
  dismissedTemplateVersionId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  event                 Event                             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy             User                              @relation("RegistrationFormCreatedBy", fields: [createdByUserId], references: [id])
  sourceTemplateVersion    SeededFormTemplateVersion? @relation("RegistrationFormSourceTemplateVersion", fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  dismissedTemplateVersion SeededFormTemplateVersion? @relation("RegistrationFormDismissedTemplateVersion", fields: [dismissedTemplateVersionId], references: [id], onDelete: Restrict)
  versions              RegistrationFormVersion[]
  capacityReservations  RegistrationCapacityReservation[]
  programAssignmentRuns ProgramAssignmentRun[]
