  ABSORBED_BY_EVENT
  PASSED_TO_BUYER
}

enum MerchandiseCatalogStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}

/// ATTENDEE_PAY is the existing behavior: attendees choose a payment method and
/// may owe an online balance. DEFERRED_ORGANIZATION_INVOICE is for club/church
/// group registrations (e.g. Spring Camporee): no attendee balance or online
/// payment is created, and the responsible organization is billed later based
/// on final attendance. See issue #143.
enum EventBillingMode {
  ATTENDEE_PAY
  DEFERRED_ORGANIZATION_INVOICE
}

enum SquareWebhookEventStatus {
