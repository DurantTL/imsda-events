/// A named consent, waiver, acknowledgment, or approval-required policy.
/// `kind` and `scope` are fixed at creation. Organization-scoped policies have
/// `eventId` null and may be configured by any event; event-scoped policies belong
/// to exactly one event. Policy text itself is staff-entered data — no legal
/// text belongs in this repository.
model ConsentPolicy {
  id               String      @id @default(cuid())
  eventId          String?
  kind             PolicyKind
  scope            PolicyScope
  slug             String
  name             String
  /// The most recently published version. Informational only — the version
  /// presented to a person is selected by effective date, never by this.
  currentVersionId String?     @unique
  createdByUserId  String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  event           Event?                            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy       User                              @relation("ConsentPolicyCreatedBy", fields: [createdByUserId], references: [id])
  currentVersion  ConsentPolicyVersion?             @relation("ConsentPolicyCurrentVersion", fields: [currentVersionId], references: [id])
  versions        ConsentPolicyVersion[]            @relation("ConsentPolicyVersions")
  applicabilities EventConsentPolicyApplicability[]

  @@unique([eventId, slug])
  @@index([scope, updatedAt])
}

/// An immutable published (or in-progress draft) version of a policy's text.
/// Once `publishedAt` is set, no field of this row is ever updated again — a
/// correction is a new version with the next `versionNumber`. The repository
/// guards this and a database trigger rejects any UPDATE of a published row.
/// `isMaterialChange` is a human judgment the publisher records, not something
/// inferred by diffing text; it is the input to re-consent in a later slice.
model ConsentPolicyVersion {
  id                String                     @id @default(cuid())
  policyId          String
  createdByUserId   String
  publishedByUserId String?
  versionNumber     Int
  status            ConsentPolicyVersionStatus @default(DRAFT)
  title             String
  bodyText          String
  contentHash       String?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  isMaterialChange  Boolean?
  publishedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  policy          ConsentPolicy  @relation("ConsentPolicyVersions", fields: [policyId], references: [id], onDelete: Cascade)
  currentOfPolicy ConsentPolicy? @relation("ConsentPolicyCurrentVersion")
  createdBy       User           @relation("ConsentPolicyVersionCreatedBy", fields: [createdByUserId], references: [id])
  publishedBy     User?          @relation("ConsentPolicyVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  acknowledgmentEvidence AcknowledgmentEvidence[]

  @@unique([policyId, versionNumber])
  @@index([policyId, status, versionNumber])
  @@index([policyId, effectiveFrom, effectiveTo])
}

/// Per-event configuration of which policies apply, to whom, and whether
/// agreement is required to proceed. `attendeeTypeDefinition` and the age band
/// mirror `EventAttendeeType`; a null condition matches every attendee for
/// that dimension. `role` is free-form staff-entered text — no attendee-role
/// vocabulary exists elsewhere in this schema yet. The policy must be
/// organization-scoped or belong to the same event; the migration enforces it.
/// Rows are deactivated rather than deleted, and an attendee type referenced
/// here cannot be deleted out from under a required policy.
model EventConsentPolicyApplicability {
  id                       String   @id @default(cuid())
  eventId                  String
  policyId                 String
  attendeeTypeDefinitionId String?
  role                     String?
  minimumAge               Int?
  maximumAge               Int?
  isRequired               Boolean  @default(true)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  event                  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  policy                 ConsentPolicy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  attendeeTypeDefinition EventAttendeeType? @relation(fields: [attendeeTypeDefinitionId], references: [id], onDelete: Restrict)

  @@index([eventId, isActive])
  @@index([policyId])
  @@index([attendeeTypeDefinitionId])
}

model MessageOutbox {
  id                     String                         @id @default(cuid())
  // Null for account email — activation and password reset belong to a person,
  // not to an event, and must be deliverable before any event exists.
  eventId                String?
  registrationId         String?
  // Set only on account email. The delivery step mints the one-time link from
  // this, so the raw token is never written to the outbox.
  accountUserId          String?
  // The attendee equivalent. Exclusive with `accountUserId`: a message belongs
  // to one population or the other, never both.
  accountAttendeeId      String?
  templateVersionId      String?
  templateKey            MessageTemplateKey
  recipientKind          MessageRecipientKind
  recipientEmail         String
  recipientName          String?
  senderNameSnapshot     String
  senderEmailSnapshot    String?
  replyToEmailSnapshot   String?
  subjectSnapshot        String
  bodyTextSnapshot       String
  /// The formatted body, rendered from the same template and context as
  /// `bodyTextSnapshot` in the same call. Null for rows queued before HTML
  /// bodies existed; those are delivered as text only, because the untrusted
  /// spans a safe HTML render depends on cannot be recovered from the text.
  bodyHtmlSnapshot       String?
  /// The inbox preview line as rendered at enqueue (#836), shown as the hidden preheader. Null for rows queued before
  /// it existed, and for messages with no line; those render exactly as they always did.
  preheaderSnapshot      String?
  metadata               Json?
  idempotencyKey         String                         @unique
  correlationId          String
  status                 MessageOutboxStatus            @default(PENDING)
  availableAt            DateTime                       @default(now())
  lockedAt               DateTime?
  lockToken              String?
  attemptCount           Int                            @default(0)
  capturedAt             DateTime?
  sentAt                 DateTime?
  provider               String?
  providerMessageId      String?                        @unique
  providerDeliveryStatus MessageProviderDeliveryStatus?
  providerStatusAt       DateTime?
  deliveredAt            DateTime?
  failedAt               DateTime?
  lastError              String?
  retryOfMessageId       String?
  /// One file sent with the message (#168: an invoice PDF), stored once in `MessageAttachment` and shared by every
  /// message that carries it, so a resend attaches the very same bytes.
  attachmentId           String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  attachment      MessageAttachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  event           Event?                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration    Registration?            @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  accountUser     User?                    @relation("AccountMessageRecipient", fields: [accountUserId], references: [id], onDelete: Cascade)
  accountAttendee AttendeeAccount?         @relation("AttendeeMessageRecipient", fields: [accountAttendeeId], references: [id], onDelete: Cascade)
  templateVersion MessageTemplateVersion?  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  retryOf         MessageOutbox?           @relation("MessageRetry", fields: [retryOfMessageId], references: [id], onDelete: SetNull)
  retries         MessageOutbox[]          @relation("MessageRetry")
  attempts        MessageDeliveryAttempt[]
  providerEvents  MessageProviderEvent[]
  invoiceRecipients InvoiceDeliveryRecipient[]
  files             MessageOutboxFile[]
  staffInvitations  StaffInvitation[]
  scheduledEmailRecipient ScheduledEmailRecipient?

  @@index([status, availableAt, createdAt])
  @@index([eventId, createdAt])
  @@index([registrationId, createdAt])
  @@index([accountUserId, createdAt])
  @@index([accountAttendeeId, createdAt])
  @@index([retryOfMessageId])
  @@index([attachmentId])
  @@index([provider, providerDeliveryStatus, providerStatusAt])
}

/// A file attached to outbox messages (#168), stored once and immutable (database trigger); `sha256` is the hash of
/// `content` (a check constraint keeps them equal). Never publicly addressable: it is read only by the delivery
/// worker and by staff routes that check the event permission.
model MessageAttachment {
  id          String   @id @default(cuid())
  eventId     String?
  filename    String
  contentType String
  sizeBytes   Int
  sha256      String
  content     Bytes
  createdAt   DateTime @default(now())

  event           Event?                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages        MessageOutbox[]
  invoiceDocument InvoiceVersionDocument?
  registrationPdf RegistrationPdfDocument?

  @@index([eventId])
}

/// How a stored message file travels with an email (#824). An ATTACHMENT is a download; an INLINE image is embedded
/// by content id so a mail client shows it without "download pictures".
enum MessageFileDisposition {
  ATTACHMENT
  INLINE
}

/// A file staff uploaded for email (#824): a template or announcement attachment, or an image inserted in a body.
/// Stored privately on disk under a generated key (never the uploaded name) and immutable once written; `sha256`
/// is checked again before every send. Read only by the delivery worker and by staff routes that check
/// MANAGE_COMMUNICATIONS for the event.
model MessageFile {
  id               String   @id @default(cuid())
  eventId          String
  filename         String
  contentType      String
  sizeBytes        Int
  sha256           String
  storageKey       String   @unique
  /// True for an image uploaded to be embedded in a body; false for a downloadable attachment.
  isInlineImage    Boolean  @default(false)
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  event            Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy       User?                        @relation("MessageFileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  templateVersions MessageTemplateVersionFile[]
  announcements    AnnouncementFile[]
  outboxLinks      MessageOutboxFile[]

  @@index([eventId, createdAt])
}

model MessageTemplateVersionFile {
  templateVersionId String
  fileId            String
  position          Int      @default(0)
  createdAt         DateTime @default(now())

  templateVersion MessageTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  file            MessageFile            @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([templateVersionId, fileId])
  @@index([fileId])
}

model AnnouncementFile {
  announcementId String
  fileId         String
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  file         MessageFile  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([announcementId, fileId])
  @@index([fileId])
}

/// The durable reference from an outbox row to the files it sends, written when the message is queued, so every
/// delivery attempt, retry and staff resend sends the very same files.
model MessageOutboxFile {
  messageOutboxId String
  fileId          String
  disposition     MessageFileDisposition
  position        Int                    @default(0)
  createdAt       DateTime               @default(now())

  message MessageOutbox @relation(fields: [messageOutboxId], references: [id], onDelete: Cascade)
  file    MessageFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([messageOutboxId, fileId])
  @@index([fileId])
}

model MessageDeliveryAttempt {
  id                String               @id @default(cuid())
  messageOutboxId   String
  attemptNumber     Int
  provider          String
  status            MessageAttemptStatus
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  providerMetadata  Json?
  startedAt         DateTime             @default(now())
  completedAt       DateTime?

  message MessageOutbox @relation(fields: [messageOutboxId], references: [id], onDelete: Cascade)

  @@unique([messageOutboxId, attemptNumber])
  @@index([status, startedAt])
}

model MessageProviderEvent {
  id                   String                         @id @default(cuid())
  messageOutboxId      String?
  provider             String
  providerEventId      String
  providerMessageId    String
  eventType            String
  mappedDeliveryStatus MessageProviderDeliveryStatus?
  occurredAt           DateTime
  payload              Json
  receivedAt           DateTime                       @default(now())

  message MessageOutbox? @relation(fields: [messageOutboxId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([provider, providerMessageId, occurredAt])
  @@index([messageOutboxId, occurredAt])
}

/// Why an address is not being sent to (#863).
enum EmailSuppressionReason {
  /// SES reported a permanent (hard) bounce.
  BOUNCE
  /// The recipient reported a message as spam.
  COMPLAINT
}

/// An address that receives no email at all (#863): a hard bounce or a spam complaint reported by SES through SNS stops
/// confirmations, receipts and announcements alike, to protect the sending reputation. One row per normalized address.
/// It is "active" while `reenabledAt` is null. A system administrator can re-enable it (audited, with who and when); a
/// later bounce or complaint (one that happened after the re-enable) switches it back on. Only the normalized address is
/// kept, which suppression needs; the provider payloads and audit entries hold ids and counts, never the address.
model EmailAddressSuppression {
  id                   String                 @id @default(cuid())
  normalizedEmail      String                 @unique
  reason               EmailSuppressionReason
  provider             String
  /// The SNS MessageId of the notification that suppressed it, for tracing. Not an address.
  sourceProviderEventId String?
  /// The outbox message that bounced, when the provider message id matched one.
  sourceMessageOutboxId String?
  suppressedAt         DateTime
  reenabledAt          DateTime?
  reenabledByUserId    String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  reenabledBy User? @relation("EmailSuppressionReenabledBy", fields: [reenabledByUserId], references: [id], onDelete: SetNull)

  @@index([reenabledAt, suppressedAt])
}

model ProgramAssignmentRun {
  id                     String   @id @default(cuid())
  eventId                String
  formId                 String
  formVersionId          String
  fieldId                String
  fieldKeySnapshot       String
  fieldLabelSnapshot     String
  formNameSnapshot       String
  formVersionNumber      Int
  optionsSnapshot        Json
  limitsSnapshot         Json
  summarySnapshot        Json
  sourceFingerprint      String
  sourceParticipantCount Int
  clientRequestId        String
  appliedByUserId        String?
  appliedByNameSnapshot  String
  supersedesRunId        String?
  invalidatedAt          DateTime?
  appliedAt              DateTime @default(now())
  createdAt              DateTime @default(now())

  event        Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  form         RegistrationForm            @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion  RegistrationFormVersion     @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  appliedBy    User?                       @relation("ProgramAssignmentAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  supersedes   ProgramAssignmentRun?       @relation("ProgramAssignmentSupersession", fields: [supersedesRunId], references: [id], onDelete: SetNull)
  supersededBy ProgramAssignmentRun[]      @relation("ProgramAssignmentSupersession")
  assignments  ProgramAttendeeAssignment[]

  @@unique([eventId, clientRequestId])
  @@index([eventId, formVersionId, fieldId, invalidatedAt, appliedAt])
  @@index([supersedesRunId])
}

model ProgramAttendeeAssignment {
  id                       String                   @id @default(cuid())
  runId                    String
  attendeeIdSnapshot       String
  registrationIdSnapshot   String
  confirmationCodeSnapshot String
  registrationSubmittedAt  DateTime?
  attendeePositionSnapshot Int
  stableOrder              Int
  firstNameSnapshot        String
  lastNameSnapshot         String
  attendeeTypeSnapshot     String
  preferencesSnapshot      Json
  optionValue              String?
  preferenceRank           Int?
  outcome                  ProgramAssignmentOutcome
  unassignedReason         ProgramUnassignedReason?
  createdAt                DateTime                 @default(now())

  run ProgramAssignmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, attendeeIdSnapshot])
  @@index([runId, optionValue, stableOrder])
  @@index([runId, outcome, stableOrder])
}

/// Staff-maintained catalog of Pathfinder/Adventurer honors (#357). Global,
/// not per event, so every Honors Weekend site offers from the same list.
model Honor {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  normalizedName String
  description    String         @default("")
  isActive       Boolean        @default(true)
  /// The AdventSource catalog number for this honor's patch (#531), kept as
  /// a string so leading zeros survive. Every "X - Advanced" honor shares
  /// 007400 (the Advanced Honor Star), so this is never unique.
  catalogNumber  String?
  /// The General Conference honor category (#531).
  category       HonorCategory?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  offerings       HonorOffering[]
  /// Every class (offering) that teaches this honor (#812), primary or not.
  offeringHonors  HonorOfferingHonor[]
  offeringPrerequisites HonorOfferingPrerequisite[]
  weekendCompletionLinks HonorWeekendCompletionLink[]
  memberEntries   MemberHonorEntry[]
  clubSupplyItems ClubSupplyItem[]
  masterAwardGroupHonors MasterAwardRuleGroupHonor[]

  @@index([isActive, name])
  @@index([normalizedName])
  @@index([category])
}

/// The General Conference honor categories (#531), plus Master Awards.
enum HonorCategory {
  NATURE
  HEALTH_AND_SCIENCE
  SPIRITUAL_GROWTH_OUTREACH_AND_HERITAGE
  ARTS_CRAFTS_AND_HOBBIES
  RECREATION
  HOUSEHOLD_ARTS
  VOCATIONAL
  OUTDOOR_INDUSTRIES
  MISCELLANEOUS_HONORS
  MASTER_AWARDS
}

/// Every section of the club supply catalog (#531). The last ten are the
/// honor categories (same names as `HonorCategory`); their rows link to a
/// matching `Honor` when one exists.
enum ClubSupplySection {
  INVESTITURE
  CAMPOREES
  PATHFINDER_BIBLE_EXPERIENCE
  TEEN_LEADERSHIP_TRAINING
  MISCELLANEOUS
  CLASS_A_DRESS_APPAREL
  CLASS_A_UNIFORM_ACCESSORIES
  OTHER_APPAREL
  NATURE
  HEALTH_AND_SCIENCE
  SPIRITUAL_GROWTH_OUTREACH_AND_HERITAGE
  ARTS_CRAFTS_AND_HOBBIES
  RECREATION
  HOUSEHOLD_ARTS
  VOCATIONAL
  OUTDOOR_INDUSTRIES
  MISCELLANEOUS_HONORS
  MASTER_AWARDS
}

/// A conference-wide club supply catalog item (#531): one AdventSource order
/// line, one row per size. Identity is section plus normalized name; catalog
/// numbers repeat in the real data (Good Conduct Stars, belts, every
/// Advanced honor), so they are indexed, never unique. Changed only by the
/// staff CSV import and the active toggle; nothing is auto-seeded.
model ClubSupplyItem {
  id             String            @id @default(cuid())
  section        ClubSupplySection
  name           String
  normalizedName String
  /// Kept as a string so leading zeros survive; optional (conference-made
  /// camporee patches have none).
  catalogNumber  String?
  /// A size parsed from the item name ("Size 8", "XL"), or null.
  sizeLabel      String?
  isActive       Boolean           @default(true)
  /// The honor this row is the patch for, when an honor-section row's name
  /// matches an existing `Honor`.
  honorId        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  honor Honor?            @relation(fields: [honorId], references: [id], onDelete: SetNull)
  stock ClubSupplyStock[]
  orderNeeds ClubOrderNeed[]
  orderLines ClubSupplyOrderLine[]
  orderListLines ClubOrderListLine[]
  eventAwardItems EventAwardItem[]
  masterAwardRules MasterAwardRule[]

  @@unique([section, normalizedName])
  @@index([catalogNumber])
  @@index([honorId])
  @@index([isActive, section, name])
}

/// How many of one catalog item a club has on hand (#531). One row per club
/// per item. Directors and deputies edit it; registrars and Area
/// Coordinators only view it.
model ClubSupplyStock {
  id                 String   @id @default(cuid())
  organizationId     String
  itemId             String
  quantityOnHand     Int      @default(0)
  updatedByAccountId String?
  /// Set instead of `updatedByAccountId` for a staff "act as" director (#442).
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item             ClubSupplyItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  updatedByAccount AttendeeAccount? @relation("ClubSupplyStockUpdatedByAccount", fields: [updatedByAccountId], references: [id], onDelete: SetNull)
  updatedByUser    User?            @relation("ClubSupplyStockUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, itemId])
  @@index([itemId])
}

/// Where a `ClubOrderNeed` came from (#487). Honors is the first source;
/// uniform ordering (#497) is the second (a director records the need by hand,
/// so its `sourceId` is a generated key). Earned awards (#532) are the third:
/// class insignia, event patches, Good Conduct/TLT and Master Awards, with
/// stable keys for the suggested ones and a generated key for hand-picked
/// ones. No change to this table's shape.
enum ClubOrderSourceType {
  HONOR
  UNIFORM
  AWARD
}

/// How one need for a catalog item has moved along (#487): completed/needed
/// (no row yet — computed from the source), then ordered, received, and
/// finally awarded (handed to the person) or issued.
enum ClubOrderNeedStatus {
  NEEDED
  ORDERED
  RECEIVED
  AWARDED
}

/// One club's need for one catalog item, for one person, from one source
/// instance (#487): an honor completion today, a uniform size or an earned
/// award tomorrow. `sourceType`/`sourceId` is the only source-specific part;
/// everything else — the item, the person, and the fulfillment state — is
/// generic. Unique on the source pair, so re-scanning a source never creates
/// the same need twice. For honors the `sourceId` is `personId:honorId`, so a
/// re-completion or a completion-date correction (#486 records are
/// append-only) never makes a second need for the same patch.
model ClubOrderNeed {
  id             String              @id @default(cuid())
  organizationId String
  sourceType     ClubOrderSourceType
  sourceId       String
  personId       String
  /// Null when the source item has no matching `ClubSupplyItem` at all (an
  /// unmatched honor); flagged in the order list rather than silently dropped.
  itemId         String?
  /// What the source calls this need, for the screen when there's no catalog
  /// item to name it by (an honor's name today). Never a personal field.
  sourceLabel    String              @default("")
  /// The calendar date (`YYYY-MM-DD`) the need arose at the source (an honor's
  /// completion date), or blank when the source has none. Lets a club mark
  /// "already handed out" everything completed before a date (#487).
  sourceDate     String              @default("")
  status         ClubOrderNeedStatus @default(NEEDED)
  batchId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  item         ClubSupplyItem?       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch        ClubSupplyOrderBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([organizationId, status])
  @@index([itemId])
  @@index([batchId])
}

/// A director's edit to one line of the club's order helper list (#654): the
/// quantity the club wants on the list for one catalog item, replacing the
/// count worked out from honors, uniforms and awards. 0 takes the item off
/// the list; a positive number on an item with no need adds it. Deleting the
/// row puts the line back to the computed count. It is a planning aid only;
/// nothing is ordered from it.
model ClubOrderListLine {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         ClubSupplyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([organizationId, itemId])
  @@index([itemId])
}

/// A `ClubSupplyOrderBatch`'s own two states: placed, or received.
enum ClubSupplyOrderBatchStatus {
  ORDERED
  RECEIVED
}

/// One AdventSource order a club placed (#487): a set of catalog items and
/// quantities, moved from ordered to received in bulk. Receiving adds each
/// line's `quantityOrdered` to the club's stock; awarding a specific person's
/// item later draws down that same stock.
model ClubSupplyOrderBatch {
  id                  String    @id @default(cuid())
  organizationId      String
  status              ClubSupplyOrderBatchStatus @default(ORDERED)
  createdByAccountId  String?
  /// Set instead of `createdByAccountId` for a staff "act as" director (#442).
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  receivedAt          DateTime?
  receivedByAccountId String?
  /// Set instead of `receivedByAccountId` for a staff "act as" director (#442).
  receivedByUserId    String?

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByAccount  AttendeeAccount?      @relation("ClubSupplyOrderBatchCreatedByAccount", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser     User?                 @relation("ClubSupplyOrderBatchCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receivedByAccount AttendeeAccount?      @relation("ClubSupplyOrderBatchReceivedByAccount", fields: [receivedByAccountId], references: [id], onDelete: SetNull)
  receivedByUser    User?                 @relation("ClubSupplyOrderBatchReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  lines             ClubSupplyOrderLine[]
  needs             ClubOrderNeed[]

  @@index([organizationId, status])
}

/// One catalog item's line on an order batch (#487): the count needed and any
/// extras at the moment the order was placed, and the stock on hand then
/// (context for later review; never re-derived).
model ClubSupplyOrderLine {
  id               String   @id @default(cuid())
  batchId          String
  itemId           String
  neededCount      Int
  extraCount       Int      @default(0)
  stockAtOrderTime Int
  /// What was actually put on the AdventSource order: needed plus extras,
  /// less the stock free to cover them then, never below zero. Receiving adds
  /// exactly this to stock (#487).
  quantityOrdered  Int
  createdAt        DateTime @default(now())

  batch ClubSupplyOrderBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  item  ClubSupplyItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([batchId, itemId])
  @@index([itemId])
}

/// A named class period at one Honors Weekend site (event). Names differ by
/// site, so they are data, never hard-coded.
model HonorSession {
  id             String   @id @default(cuid())
  eventId        String
  /// Site of a multi-location event (#589); null when the event has none, or
  /// for a session every site shares.
  locationId     String?
  name           String
  normalizedName String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location  EventLocation?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  offerings HonorOffering[]

  // Name uniqueness is two partial unique indexes the migration adds (Prisma
  // can't model them, and `migrate diff` leaves them alone): (eventId,
  // normalizedName) WHERE locationId IS NULL, and (eventId, locationId,
  // normalizedName) WHERE locationId IS NOT NULL.
  @@index([eventId, sortOrder])
  @@index([locationId])
}

/// A room inside a site (#834), with a seat capacity. A class placed in the
/// room (`HonorOffering.roomId`) can't have more seats than the room. Name
/// uniqueness is two partial unique indexes the migration adds, like sessions:
/// (eventId, normalizedName) WHERE locationId IS NULL and (eventId, locationId,
/// normalizedName) WHERE locationId IS NOT NULL. The migration also adds the
/// triggers that keep a class within its room's capacity.
model HonorRoom {
  id             String   @id @default(cuid())
  eventId        String
  /// The site the room is in; null when the event has no sites.
  locationId     String?
  name           String
  normalizedName String
  capacity       Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  site      EventLocation?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  offerings HonorOffering[]

  @@index([eventId, locationId, sortOrder])
  @@index([locationId])
}

/// A class taught at a site: in one session, or across all sessions. A class
/// teaches one or more catalog honors (#812), listed in `honors`
/// (`HonorOfferingHonor`); a person enrolled in the class is enrolled in each.
/// `capacity` counts youth seats only. The migration adds CHECK constraints.
model HonorOffering {
  id           String            @id @default(cuid())
  eventId      String
  /// The class's PRIMARY honor (#812): the first of its `honors`, kept so older
  /// readers and a plain `honorId` filter still work. A trigger inserts its
  /// `HonorOfferingHonor` row (position 0) with the class, and the repository
  /// keeps the two in step on every change. Never read it to learn what the
  /// class teaches: read `honors`.
  honorId      String
  sessionId    String?
  /// Site of an ALL_SESSIONS class (#589); a single-session class takes its
  /// site from its session, so this stays null for it (a CHECK enforces that).
  /// `location` below is the room; this is the site.
  locationId   String?
  span         HonorOfferingSpan
  capacity     Int
  minimumAge   Int?
  /// The lowest Investiture class level a youth may take this class at (#832),
  /// compared with the member's current class level on the club roster. Null: no minimum.
  minimumClassLevel ClubClassLevel?
  perClubLimit Int?
  teacherName  String            @default("")
  location     String            @default("")
  /// The room the class is placed in on the schedule board (#834); null: not placed.
  /// While set, `location` (the free-text room shown on grids) mirrors the room's name.
  /// A partial unique index (roomId, sessionId) WHERE both set AND active keeps one class
  /// per room per session; an all-sessions class is checked in the repository.
  roomId       String?
  /// Extra cost of this class in cents (#651); null means none. Shown on the public class grid.
  additionalCostCents Int?
  /// A special requirement shown as a badge on the public class grid (#651), e.g. "Bring a flashlight".
  requirementNote String         @default("")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  honor       Honor             @relation(fields: [honorId], references: [id], onDelete: Restrict)
  session     HonorSession?     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  site        EventLocation?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  room        HonorRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments HonorEnrollment[]
  honors      HonorOfferingHonor[]
  instructorClasses HonorInstructorClass[]
  /// Honors a youth must have completed first (#832); every one is required.
  prerequisites HonorOfferingPrerequisite[]
  waitlist     HonorClassWaitlistEntry[]
  classChanges HonorClassChange[]

  // "No honor twice in a session" and the all-sessions rules now live on
  // `HonorOfferingHonor`, one row per honor taught (#812).
  @@index([eventId, isActive])
  @@index([locationId])
  @@index([honorId])
  @@index([roomId])
}

/// An honor a youth must have completed before taking a class (#832), checked
/// against the member's honor record (`MemberHonorEntry`). A class can have
/// several; the youth needs all of them. Per class, not per honor taught.
model HonorOfferingPrerequisite {
  id         String   @id @default(cuid())
  offeringId String
  honorId    String
  createdAt  DateTime @default(now())

  offering HonorOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  honor    Honor         @relation(fields: [honorId], references: [id], onDelete: Restrict)

  @@unique([offeringId, honorId])
  @@index([honorId])
}

/// One honor taught by one class (#812). `eventId`, `sessionId` and `locationId`
/// copy the class's own, kept in step by triggers in the migration (insert fills
/// them; a change to the class's session or site updates them), so the database
/// itself can say "no honor twice in one session" and "one all-sessions class
/// per honor per site": the same rules `HonorOffering` had when it held one
/// honor, now per honor taught. `position` orders the honors on the class;
/// position 0 is the primary honor, which is also `HonorOffering.honorId`.
/// Besides the `@@unique`s below, the migration adds two partial unique
/// indexes (all-sessions classes: one per honor per event with no site, one per
/// honor per site), which Prisma can't model and `migrate diff` leaves alone.
model HonorOfferingHonor {
  id         String   @id @default(cuid())
  offeringId String
  honorId    String
  eventId    String
  sessionId  String?
  locationId String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  offering HonorOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  honor    Honor         @relation(fields: [honorId], references: [id], onDelete: Restrict)

  @@unique([offeringId, honorId])
  @@unique([sessionId, honorId])
  @@index([honorId])
  @@index([eventId, honorId])
}

/// One person on one club's roster for one club year (#356). Birth dates are
/// sealed with `lib/secret-box.ts` (purpose `club-roster:birth-date`) and never
/// stored in plain text (ADR 0005 Addendum A).
model ClubRosterMember {
  id                   String                 @id @default(cuid())
  healthRecord        HealthRecord?
  healthRecordLinks   HealthRecordLink[]
  organizationId       String
  clubYear             String
  personId             String?
  attendeeType         ClubRosterAttendeeType
  role                 String                 @default("")
  classLevel           ClubClassLevel?
  /// Age as a form reported it (#376), for people imported without a birth
  /// date. Shown with "birth date needed" until the director adds one.
  reportedAge          Int?
  gender               ClubRosterGender?
  sealedBirthDate      String?
  status               ClubRosterStatus       @default(ACTIVE)
  source               ClubRosterSource
  sourceRegistrationId String?
  createdByAccountId   String?
  /// Set instead of `createdByAccountId` for a staff "act as" director (#442).
  createdByUserId      String?
  removedAt            DateTime?
  /// Unused since #544: the app no longer has any driving feature, and roster
  /// writes ignore this field. The column stays until a human-approved
  /// migration removes it.
  willingToDrive       Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person             Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdBy          AttendeeAccount? @relation("ClubRosterMemberCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser      User?            @relation("ClubRosterMemberCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Transfer requests (#489) that matched this row as the sending club's member.
  transferAsSender   MemberTransfer[] @relation("MemberTransferFromRoster")
  /// The transfer, if any, that created this row at the receiving club (#489).
  transferAsReceiver MemberTransfer?  @relation("MemberTransferToRoster")
  clubFormSubmissions ClubFormSubmission[]
  /// Submissions added or linked to this member with "Add to roster" (#721).
  clubFormRosterActions ClubFormSubmission[] @relation("ClubFormSubmissionRosterAction")
  clubFormLinks       ClubFormLink[]
  meetingAttendance   ClubMeetingAttendance[]
  /// Up to two guardian contacts (#510). Deleted with the member's removal.
  guardians           ClubRosterGuardian[]

  @@unique([organizationId, clubYear, personId])
  @@index([organizationId, clubYear, status])
  @@index([personId])
}

/// A guardian contact for a roster member (#510): slot 1 or 2, every field
/// optional, plain text (director decision Oct 1, 2026: not encrypted). Only
/// the club's director and deputy, Area Coordinators and staff holding
/// VIEW_SENSITIVE_DATA may read it. The row lives exactly as long as the
/// member is on the roster: it cascades with the member and is deleted when the
/// member is removed or erased. Values never go into audit metadata or logs.
model ClubRosterGuardian {
  id             String   @id @default(cuid())
  rosterMemberId String
  /// 1 or 2 (a CHECK constraint in the migration enforces it).
  position       Int
  name           String   @default("")
  relationship   String   @default("")
  email          String   @default("")
  phone          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rosterMember ClubRosterMember @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)

  @@unique([rosterMemberId, position])
}

/// A club-owned, named roster export format (#490): which columns, in what
/// order, and under what header names to hand a specific outside camporee.
/// `columns` holds only that structure (an ordered array of `{key, header}`)
/// and is never a copy of any roster row.
model ClubRosterExportFormat {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  columns            Json
  createdByAccountId String?
  /// Set instead of `createdByAccountId` for a staff "act as" director (#442).
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     AttendeeAccount? @relation("ClubRosterExportFormatCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser User?            @relation("ClubRosterExportFormatCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
}

/// A director confirming that a club started its next club year's roster by
/// carrying last year's people forward (#414). One row per club and target
/// year (the unique key makes a repeat refuse cleanly), recording counts only:
/// never a person, a name or a birth date. The carried people are ordinary
/// `ClubRosterMember` rows for the new year.
model ClubRosterCarryForward {
  id                   String   @id @default(cuid())
  organizationId       String
  fromClubYear         String
  toClubYear           String
  carriedCount         Int
  /// Last year's active people the director left unticked.
  leftBehindCount      Int
  /// Carried people whose type changed (a Pathfinder becoming staff, say).
  typeChangedCount     Int
  confirmedByAccountId String?
  /// Set instead of `confirmedByAccountId` for a staff "act as" director (#442).
  confirmedByUserId    String?
  createdAt            DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  confirmedBy     AttendeeAccount? @relation("ClubRosterCarryForwardByAccount", fields: [confirmedByAccountId], references: [id], onDelete: SetNull)
  confirmedByUser User?            @relation("ClubRosterCarryForwardByUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, toClubYear])
}

/// The pre-#527 one-row-per-person background-check table, kept read-only
/// for one release after the #527 migration carried every row over to the
/// list below (renamed from "BackgroundCheck"; nothing writes to it any
/// more). A later migration drops it — see
/// docs/BACKGROUND-CHECK-LIST-MIGRATION.md. Ignored by Prisma Client so no
/// code can read or write it; modelled here only so the migration history
/// and this schema agree.
model BackgroundCheckPre527 {
  id               String                           @id(map: "BackgroundCheck_pkey") @default(cuid())
  personId         String                           @unique(map: "BackgroundCheck_personId_key")
  provider         String                           @default("STERLING")
  checkedOn        String?
  expiresOn        String?
  complianceStatus BackgroundCheckComplianceStatus?
  issuesNote       String?
  recordedByUserId String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade, map: "BackgroundCheck_personId_fkey")

  @@index([expiresOn], map: "BackgroundCheck_expiresOn_idx")
  @@map("BackgroundCheck_pre527")
  @@ignore
}

/// The single stored background-check list (#527). Both the Sterling
/// Volunteers CSV and the roster compliance CSV feed this same list; each
/// upload is the complete current export and replaces it entirely (the
/// `BackgroundCheckUpload.format` on the current entries records which
/// layout produced them). Matching a person happens at lookup, from
/// `BackgroundCheckMatch` — never re-run on every render.
model BackgroundCheckUpload {
  id               String   @id @default(cuid())
  format           String
  rowCount         Int
  added            Int
  changed          Int
  dropped          Int
  uploadedByUserId String
  createdAt        DateTime @default(now())

  entries BackgroundCheckEntry[]

  @@index([createdAt])
}

/// One row of the currently uploaded list (#527), kept whether or not it
/// matches anyone today ("the CSV is the base"). Replaced wholesale by the
/// next upload (cascades from `BackgroundCheckUpload`).
model BackgroundCheckEntry {
  id       String @id @default(cuid())
  uploadId String
  line     Int
  firstName String
  lastName  String
  /// `matchableName(firstName + " " + lastName)`, indexed so matching a
  /// person against the list is a lookup, not a scan. Computed in
  /// TypeScript only, never in SQL: null on an entry carried over by the #527
  /// migration until the first refresh or upload fills it in
  /// (`backfillNormalizedNames`).
  normalizedName String?
  email          String?
  /// Sealed the same way roster birth dates are sealed (ADR 0005 Addendum A,
  /// `modules/club-rosters/birth-dates.ts`). Never stored in plain text.
  sealedBirthDate String?
  /// The person's club or sponsoring church (the roster format's `sites`).
  site            String?
  /// The roster CSV's `user_id`, when the row has one (Sterling rows never do).
  sourceUserId    String?
  /// What recognizes the same entry across uploads
  /// (`backgroundCheckIdentityKey`): `userId:<user_id>` when the row has one
  /// — the same format `ExternalIdentity.externalId` (provider
  /// `ROSTER_IMPORT`) uses — otherwise a key derived from the row's own
  /// identifying fields.
  identityKey      String
  /// Set by a roster row's `compliance` column (y/!/n). Null for a Sterling
  /// row, which is current/expired by `expiresOn` instead.
  complianceStatus BackgroundCheckComplianceStatus?
  /// Calendar dates ("2026-09-23"). Current through `expiresOn`. Null for a
  /// roster row, which has no expiration date at all.
  checkedOn String?
  expiresOn String?
  /// The roster row's `issues` column: the check and training dates. Staff
  /// only, never shown to a club director or on a club's own portal roster.
  issuesNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  upload  BackgroundCheckUpload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  match   BackgroundCheckMatch?
  review  BackgroundCheckReview?

  @@index([normalizedName])
  @@index([uploadId])
  @@index([identityKey])
}

/// The derived, fast-to-read match from a person to their current list entry
/// (#527) — a single indexed row per person, so a roster render or event flag
/// check is a join, never a scan. Refreshed at upload, when a person or
/// roster member is added or edited, and when staff resolve a review.
model BackgroundCheckMatch {
  id        String                     @id @default(cuid())
  personId  String                     @unique
  entryId   String                     @unique
  matchedBy BackgroundCheckMatchSource
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  person Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  entry  BackgroundCheckEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

/// How a `BackgroundCheckMatch` was decided. `IDENTITY`: a remembered
/// `user_id` whose name still agrees. `AUTO`: normalized name plus exactly
/// one of email, birth date, or site, with nothing else it could be. `MANUAL`:
/// a staff decision; it holds across refreshes and uploads (carried to the
/// next upload's entry with the same `identityKey`) until staff undo it.
/// `MIGRATED`: carried over from the old per-person `BackgroundCheck` row
/// when this list replaced it (#527), so nobody's status changed that day.
/// `NAME_ONLY` (#598): the name is the only person and only row with it and
/// nothing contradicts it, but the row's site didn't match; recomputed like
/// `AUTO`, and shown to staff for an informational spot check. Since #619 a
/// `user_id` row's name-only match is remembered like `AUTO`, so the next
/// upload finds it as `IDENTITY`; a first-name variant with one agreeing
/// detail is also `NAME_ONLY` (not remembered).
enum BackgroundCheckMatchSource {
  IDENTITY
  AUTO
  MANUAL
  MIGRATED
  NAME_ONLY
}

/// A list entry that could match more than one person, or whose only
/// candidate people also match another entry — never guessed (#527). Staff
/// resolve it by hand from `candidatePersonIds`; picking one becomes a
/// `MANUAL` match that holds on the next upload. At most one per entry.
/// "None of these is right" keeps the row with `dismissedAt` set: a
/// dismissed entry is matched to no one — not by a refresh, not at read
/// time — until the next upload replaces the list.
model BackgroundCheckReview {
  id                 String    @id @default(cuid())
  entryId            String    @unique
  reason             String
  candidatePersonIds Json
  dismissedAt        DateTime?
  createdAt          DateTime  @default(now())

  entry BackgroundCheckEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

/// Staff said a list row is not a given person (#598, "Not the same person" on
/// a name-only match). Keyed by the row's `identityKey`, not its entry id, so
/// the decision survives every upload; matching never offers that person for
/// that row (name-only, automatic, or variant) until staff match them by
/// hand, which clears it. No foreign keys: a row's key outlives any one
/// upload, and a deleted person just leaves an inert pair. Any future person
/// merge must re-point `personId` here (there is no foreign key to do it).
model BackgroundCheckRejectedPairing {
  id               String   @id @default(cuid())
  identityKey      String
  personId         String
  rejectedByUserId String
  createdAt        DateTime @default(now())

  @@unique([identityKey, personId])
}

/// A name-only or first-name-variant match (#619) of a list row with no roster
/// `user_id`, remembered by the row's `identityKey` so a later upload matches
/// it again (as `IDENTITY`, so it isn't listed as new). Rows with a `user_id`
/// use `ExternalIdentity` instead. `matchedName` is the row's normalized name
/// when it was made; a later upload uses the memory only while that name, the
/// person, and the row's email and birth date still fit, and no staff
/// rejection exists. Deleted by "not the same person" and by a match by hand.
/// No foreign keys, like `BackgroundCheckRejectedPairing`: a deleted person
/// just leaves an inert row. Any future person merge must re-point `personId`.
model BackgroundCheckRememberedMatch {
  id          String   @id @default(cuid())
  identityKey String   @unique
  personId    String
  matchedName String
  matchedBy   String
  createdAt   DateTime @default(now())
}

/// A background check's compliance mark from a roster import (#427): the
/// CSV's `compliance` column, y/yes → `CLEAR`, "!" → `FLAGGED` (expiring soon;
/// still current at events, and `issuesNote` gives the dates), n/no →
/// `NOT_COMPLIANT`. Any other value is a row-level parse problem, never
/// guessed into one of these.
enum BackgroundCheckComplianceStatus {
  CLEAR
  FLAGGED
  NOT_COMPLIANT
}

/// Unused since #544: the app no longer has any driving feature (this table
/// held #491 driver review decisions and #544 staff overrides). No code reads
/// or writes it; the table stays until a human-approved migration removes it.
model DriverVerification {
  id                  String    @id @default(cuid())
  personId            String    @unique
  clearedToTransport  Boolean
  note                String    @default("")
  reviewedByAccountId String?
  reviewedByUserId    String?
  reviewedAt          DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  person         Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  reviewedBy     AttendeeAccount? @relation("DriverVerificationReviewedBy", fields: [reviewedByAccountId], references: [id], onDelete: SetNull)
  reviewedByUser User?           @relation("DriverVerificationReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([reviewedByAccountId])
  @@index([reviewedByUserId])
}

/// A club's single registration for a club event (#358): an ordinary
/// Registration, billed to the church, tied to the club that made it.
model ClubEventRegistration {
  id                   String   @id @default(cuid())
  eventId              String
  organizationId       String
  registrationId       String   @unique
  /// The team's name as the director typed it (#809), on an event that lets a club register more than one team
  /// (`EventTeamSettings.allowMultipleTeams`). Null on every other event, so those rows read exactly as before.
  teamName             String?
  /// The team name, normalized (case, spacing), or the empty string for a club's one registration on an event without
  /// teams. It is part of the key `(eventId, organizationId, teamKey)`, which is today's one-per-club rule when the key is
  /// always `''`, and a hand-written partial unique index makes a named team's key unique within the whole event.
  teamKey              String   @default("")
  submittedByAccountId String?
  /// Set instead of `submittedByAccountId` for a staff "act as" director (#442).
  submittedByUserId    String?
  createdAt            DateTime @default(now())

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registration    Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  submittedBy     AttendeeAccount? @relation("ClubEventRegistrationSubmittedBy", fields: [submittedByAccountId], references: [id], onDelete: SetNull)
  submittedByUser User?            @relation("ClubEventRegistrationSubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  assignment      ClubEventAssignment?
  teamResults     ClubTeamResult[]
  teamLevelCheckIns ClubTeamLevelCheckIn[]
  teamPermissions ClubTeamMemberPermission[]

  @@unique([eventId, organizationId, teamKey])
  @@index([organizationId])
}

/// A "Group" registration on a club event (#650): people who are not in a
/// club (homeschoolers, unaffiliated adults) registered by one contact. It is an
/// ordinary Registration, but it is deliberately NOT a `ClubEventRegistration`:
/// it names no club or church, creates no roster members, and the contact is
/// the billing party (billed on the back end after the event).
model GroupEventRegistration {
  id              String   @id @default(cuid())
  eventId         String
  registrationId  String   @unique
  /// The contact person the group is billed to after the event.
  billingPersonId String
  createdAt       DateTime @default(now())

  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration  Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  billingPerson Person       @relation(fields: [billingPersonId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([billingPersonId])
}

/// A staff-set campsite/duty/activity assignment for one club's event
/// registration (#410). Kept separate from `ClubEventRegistration` /
/// `PublicRegistrationSubmission` so a club's submitted preferences and
/// staff's assignment decisions never overwrite each other. Simple and
/// replaceable by the general grouping engine (#89) if that lands later.
///
/// `version` bumps on every staff edit; `lastEmailedVersion` records which
/// version the assignment email last went out for. When they differ (or
/// nothing has been sent yet while something is set), the assignment has
/// "changed since sent".
model ClubEventAssignment {
  id                      String   @id @default(cuid())
  eventId                 String
  organizationId          String
  clubEventRegistrationId String   @unique
  campsiteLocation        String   @default("")
  campsiteNotes           String   @default("")
  dutyLabel               String   @default("")
  dutyDay                 String   @default("")
  dutyTime                String   @default("")
  activityLabel           String   @default("")
  notes                   String   @default("")
  version                 Int      @default(1)
  lastEmailSentAt         DateTime?
  lastEmailedVersion      Int?
  updatedByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  event                 Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clubEventRegistration ClubEventRegistration @relation(fields: [clubEventRegistrationId], references: [id], onDelete: Cascade)
  updatedBy             User?                 @relation("ClubEventAssignmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  /// One per `ClubEventRegistration` (`clubEventRegistrationId` is unique), so a club with several teams (#809) has one
  /// per team; `(eventId, organizationId)` is therefore an ordinary index, not a key.
  @@index([eventId, organizationId])
  @@index([eventId, updatedAt])
}

/// A director's unsubmitted club registration, saved as they work so a reload
/// or closed tab loses nothing. Never holds birth dates: people are roster IDs.
model ClubRegistrationDraft {
  id                 String   @id @default(cuid())
  eventId            String
  organizationId     String
  selectedMemberIds  String[]
  /// People going who aren't on the roster (#388), e.g. a visiting parent:
  /// [{ id, firstName, lastName, age, email }]. For this event only; they're
  /// never added to the roster. The server reads them from here at submit.
  guests             Json     @default("[]")
  responses          Json     @default("{}")
  attendeeResponses  Json     @default("{}")
  /// Honors picked while registering (#618): { [attendee client id]: [offering id] }.
  /// Only a draft; seats are taken by the enrollment domain after the registration is submitted.
  honorSelections    Json     @default("{}")
  /// Ages typed in for roster people with no birth date on file (#639):
  /// { [roster member id]: age on the event date }. For this registration only.
  rosterAges         Json     @default("{}")
  /// Roster member ids whose typed-in age should NOT also be saved to the roster
  /// when the registration is submitted (#639). Saving back is the default.
  rosterAgeSaveOff   Json     @default("[]")
  /// The location the director picked (#659), kept so a reload doesn't lose it.
  /// Not a foreign key: a location removed later is explained on restore rather
  /// than blocking the draft. A draft reserves no seats.
  locationId         String?
  /// Which of the club's drafts this is (#809). `''` on an event without teams, so it has the one draft it always had;
  /// on an event with teams, a random id the page picks for each team being registered. Not the team's key: a name can
  /// change while typing, and the registration's own key is made from the name at submit.
  draftKey           String   @default("")
  /// The team name typed so far (#809); empty on an event without teams.
  teamName           String   @default("")
  /// Bumped by every save. A save must name the revision it was based on, so a
  /// second tab's stale save is refused instead of silently overwriting (#659).
  revision           Int      @default(0)
  /// The client id of the last save, so a retry of a save whose response was lost
  /// is recognised as already landed rather than a conflict (#659).
  lastSaveId         String?
  updatedByAccountId String?
  /// Set instead of `updatedByAccountId` for a staff "act as" director (#442).
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy     AttendeeAccount? @relation("ClubRegistrationDraftUpdatedBy", fields: [updatedByAccountId], references: [id], onDelete: SetNull)
  updatedByUser User?            @relation("ClubRegistrationDraftUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, organizationId, draftKey])
}

/// A person's place in an Honors Weekend class (#359). Taken on the server
/// inside a serializable transaction with the class rows locked, so a class
/// can't be overfilled. Only youth consume a seat (`consumesSeat`).
model HonorEnrollment {
  id                     String   @id @default(cuid())
  eventId                String
  offeringId             String
  registrationId         String
  registrationAttendeeId String
  /// The club that holds the seat. Null for a "Group" registration (#650),
  /// which is never attributable to a club: its per-club limit is counted per
  /// registration instead.
  organizationId         String?
  consumesSeat           Boolean
  /// The director confirmed the youth meets the class's minimum level when the roster had no level (#832).
  /// "ByDirector" also covers staff acting as the director (#442), who set it through the same screen.
  levelConfirmedByDirector Boolean @default(false)
  /// The director (or staff acting as the director) confirmed the youth completed the class's prerequisite honors when the honor record showed none (#832).
  prerequisitesConfirmedByDirector Boolean @default(false)
  /// Why staff placed the youth although a level or prerequisite rule was not met (#832). Null when no override was used.
  requirementOverrideReason String?
  /// The staff user who overrode; cleared if that user is deleted (the audit log keeps the entry).
  requirementOverriddenByUserId String?
  requirementOverriddenByUser User? @relation("HonorEnrollmentRequirementOverriddenBy", fields: [requirementOverriddenByUserId], references: [id], onDelete: SetNull)
  /// Why a system administrator placed the youth although the class was full or class changes had closed (#962). Set only by
  /// that explicit, audited action, never by a normal pick save or automatically. Null for every normal pick.
  adminPlacementReason   String?
  /// True when the placement went into a class with no seat left: that seat is on top of the class's seat limit, so it is not
  /// counted toward the limit (the limit, and the waitlist and live offers that depend on it, are unchanged) and reports show the
  /// class over capacity. False for a placement that took a free seat (after class changes closed, when a normal pick can't):
  /// it counts like any other seat. Only meaningful with a reason.
  adminPlacementOverCapacity Boolean @default(false)
  adminPlacedAt          DateTime?
  /// The system administrator who placed the youth; cleared if that user is deleted (the audit log keeps the entry).
  adminPlacedByUserId    String?
  adminPlacedByUser      User? @relation("HonorEnrollmentAdminPlacedBy", fields: [adminPlacedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())

  event                Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offering             HonorOffering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  registration         Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationAttendee RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// One per honor the class teaches (#812), once written back.
  weekendCompletions   HonorWeekendCompletionLink[]
  /// The class instructor's attendance and completion mark (#833), if any.
  instructorMark       HonorEnrollmentMark?

  @@unique([registrationAttendeeId, offeringId])
  @@index([offeringId, consumesSeat])
  @@index([offeringId, organizationId, consumesSeat])
  @@index([registrationId])
  @@index([adminPlacedByUserId])
}

enum HonorClassWaitlistStatus {
  /// In line, in the order they joined.
  WAITING
  /// A seat is held for them until `offerExpiresAt`; the director accepts or the offer passes on.
  OFFERED
  /// The director accepted: the youth holds the seat (an enrollment).
  ACCEPTED
  /// The director turned the offer down; it passed to the next youth.
  DECLINED
  /// The offer was not accepted in time; it passed to the next youth.
  EXPIRED
  /// Taken off the list (the director, staff, or the registration or person left).
  REMOVED
}

/// One youth's place on a full Honors Weekend class's waitlist (#831). A spot takes no seat and doesn't count toward a club's per-club limit; only a live offer reserves a seat (counted with the taken seats) and an accepted one becomes an `HonorEnrollment`.
model HonorClassWaitlistEntry {
  id                     String                   @id @default(cuid())
  eventId                String
  offeringId             String
  registrationId         String
  registrationAttendeeId String
  /// The club that holds the registration; waitlists are for clubs only.
  organizationId         String?
  /// The order they joined, assigned by the database so two joins at once still have a strict order.
  joinOrder              Int                      @default(autoincrement())
  status                 HonorClassWaitlistStatus @default(WAITING)
  /// How the youth got past the class's level or prerequisite rules when they joined, kept for acceptance (#832): the same facts an enrollment records.
  levelConfirmedByDirector         Boolean        @default(false)
  prerequisitesConfirmedByDirector Boolean        @default(false)
  requirementOverrideReason        String?
  requirementOverriddenByUserId    String?
  joinedAt               DateTime                 @default(now())
  offeredAt              DateTime?
  offerExpiresAt         DateTime?
  /// How many times a seat was offered (an offer released because of a conflict is offered again later).
  offerCount             Int                      @default(0)
  resolvedAt             DateTime?
  /// A short fixed reason for the last change ("Offer expired", "Registration cancelled"); never free text from a person.
  resolution             String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  event                Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offering             HonorOffering        @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  registration         Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationAttendee RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requirementOverriddenByUser User?         @relation("HonorClassWaitlistOverriddenBy", fields: [requirementOverriddenByUserId], references: [id], onDelete: SetNull)

  // One open entry (WAITING or OFFERED) per person and class is a partial unique index in the migration.
  @@index([offeringId, status, joinOrder])
  @@index([registrationId, status])
  @@index([registrationAttendeeId])
  @@index([status, offerExpiresAt])
  @@index([eventId])
}

enum MemberHonorStatus {
  IN_PROGRESS
  COMPLETED
}

/// One append-only entry in a member's year-round honor record (#486). The
/// record follows the durable `Person`, never a `ClubRosterMember` row, so it
/// carries across a club-year rollover (#414) and a future club transfer
/// (#489) without copying. A correction is never edited in place: it is a new
/// entry, and `seq` (not `createdAt`, which can tie under a bulk write) orders
/// history so the highest `seq` per (personId, honorId) is always the current
/// status. `organizationId` records which club made the entry, for the audit
/// trail only — it is never part of the identity or the read key.
model MemberHonorEntry {
  id                  String            @id @default(cuid())
  seq                 Int               @default(autoincrement())
  personId            String
  honorId             String
  status              MemberHonorStatus
  /// A calendar date (`YYYY-MM-DD`), required for COMPLETED and blank for
  /// IN_PROGRESS. Never a birth date or any other sealed field.
  completionDate      String            @default("")
  note                String            @default("")
  organizationId      String
  recordedByAccountId String?
  /// Set instead of `recordedByAccountId` for a staff "act as" director (#442).
  recordedByUserId    String?
  createdAt           DateTime          @default(now())

  person            Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  honor             Honor            @relation(fields: [honorId], references: [id], onDelete: Restrict)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recordedByAccount AttendeeAccount? @relation("MemberHonorEntryRecordedBy", fields: [recordedByAccountId], references: [id], onDelete: SetNull)
  recordedByUser    User?            @relation("MemberHonorEntryRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  weekendCompletionLinks HonorWeekendCompletionLink[]
  /// Set when the entry was voided (#591); the entry row itself is never changed.
  void                   MemberHonorEntryVoid?

  @@index([personId, honorId, seq])
  @@index([organizationId, createdAt])
  @@index([honorId])
}

/// An audited void of one `MemberHonorEntry` (#591): its own append-only
/// record, so the entry row is never edited or deleted. Current status is the
/// highest non-voided `seq` per (personId, honorId), so every current-status
/// reader skips an entry that has a void row; when all of a person's entries
/// for an honor are voided, they have no status for it. Unique on `entryId`
/// (a second void of the same entry is refused) and there is no un-void: to
/// restore, record a new entry. Exactly one of `voidedByAccountId` /
/// `voidedByUserId` is set when written (a staff "act as" director uses the
/// user); the FK is SET NULL so deleting the actor's account keeps the void,
/// so the migration's CHECK allows at most one, never both.
model MemberHonorEntryVoid {
  id                String   @id @default(cuid())
  entryId           String   @unique
  /// 3 to 500 characters, enforced in the app and by a CHECK.
  reason            String
  voidedByAccountId String?
  voidedByUserId    String?
  createdAt         DateTime @default(now())

  entry           MemberHonorEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  voidedByAccount AttendeeAccount? @relation("MemberHonorEntryVoidedBy", fields: [voidedByAccountId], references: [id], onDelete: SetNull)
  voidedByUser    User?            @relation("MemberHonorEntryVoidedByUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)
}

/// Marks one Honors Weekend class enrollment (#357–#360) as already written
/// back into the member's year-round honor record (#487, #486). Unique on
/// (`enrollmentId`, `honorId`), one link per honor a class teaches (#812), so
/// writing back is idempotent: running the job again over
/// the same enrollments creates nothing new. Not unique on the entry: when
/// the member's latest entry for that honor is already COMPLETED (recorded by
/// hand, or by an earlier weekend), the enrollment links to that entry rather
/// than appending a second one.
model HonorWeekendCompletionLink {
  id                 String   @id @default(cuid())
  enrollmentId       String
  /// The honor of the class this link completed (#812): a class can teach
  /// several, and each gets its own link and its own member record.
  honorId            String
  memberHonorEntryId String
  createdAt          DateTime @default(now())

  enrollment       HonorEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  honor            Honor            @relation(fields: [honorId], references: [id], onDelete: Restrict)
  memberHonorEntry MemberHonorEntry @relation(fields: [memberHonorEntryId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, honorId])
  @@index([memberHonorEntryId])
  @@index([honorId])
}

/// How a club member transfer (#489) was brought to a close.
enum MemberTransferResolution {
  /// The sending club accepted the request itself.
  SENDING_CLUB_ACCEPTED
  /// Conference staff finished a request the sending club had not answered within 14 days.
  STAFF_FINISHED
  /// Conference staff overrode the request (any time, with a note): a decline, an unmatched request, or one routed to staff.
  STAFF_OVERRIDDEN
}

/// What a `MemberTransferEvent` recorded happening, for both clubs' history and staff's audit trail.
enum MemberTransferEventType {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  STAFF_FINISHED
  STAFF_OVERRIDDEN
  REGISTRATION_MOVE_QUEUED
  REGISTRATION_MOVE_APPROVED
  REGISTRATION_MOVE_SKIPPED
  NOTIFIED
}

enum MemberTransferStatus {
  /// Matched to one active member of the named club, waiting on that club.
  PENDING
  /// No single exact match (or it could not be sent to the club): on the conference staff list only.
  UNMATCHED
  /// The sending club declined: on the conference staff list.
  DECLINED
  COMPLETED
  CANCELLED
}

/// Why a request needs conference staff rather than the sending club (#489).
enum MemberTransferStaffReason {
  /// No active member of the named club has exactly that name this club year.
  NO_MATCH
  /// More than one active member of the named club has exactly that name.
  AMBIGUOUS_MATCH
  /// The matched person already has another open transfer.
  ALREADY_PENDING
  /// The requesting director also leads the sending club: no self-acknowledgment (#489 N6).
  SAME_DIRECTOR
}

/// A club member transfer request (#489). The receiving club's director
/// enters the member's exact name and current club; the server matches on
/// normalized exact names inside that club's current-year roster and always
/// answers "request sent", so the request can't be used to probe a roster.
/// A match goes to the sending club (`PENDING`); anything else goes to the
/// conference staff list (`UNMATCHED`). The receiving club's roster row
/// (`toRosterMember`) is created only when the transfer completes, and the
/// sending row is erased at that moment (ADR 0005 Addendum A section 6).
///
/// Once the person is erased from every roster (their `Person` deleted),
/// `personId` and `pendingPersonId` fall to null and the typed names are
/// blanked: the record keeps the two clubs, the dates, the status, and the
/// reason, but nothing that names the person.
model MemberTransfer {
  id                   String                     @id @default(cuid())
  personId             String?
  /// Set only while a matched request is open (PENDING or DECLINED): one open matched transfer per person, enforced here.
  pendingPersonId      String?                    @unique
  /// Hash of receiving club, sending club, and the normalized typed name, set while the request is open: no duplicate open request from one club.
  requestKey           String?                    @unique
  clubYear             String
  fromOrganizationId   String
  toOrganizationId     String
  fromRosterMemberId   String?
  toRosterMemberId     String?                    @unique
  requestedFirstName   String
  requestedLastName    String
  reason               String
  status               MemberTransferStatus       @default(PENDING)
  staffReason          MemberTransferStaffReason?
  /// True once the sending club has been shown this request (a match), so an unmatched request never appears on another club's page.
  sendingClubVisible   Boolean                    @default(false)
  resolution           MemberTransferResolution?
  initiatedByAccountId String?
  /// Set instead of `initiatedByAccountId` for a staff "act as" director (#442).
  initiatedByUserId    String?
  initiatedAt          DateTime                   @default(now())
  /// `initiatedAt` + 14 days: when a pending request becomes overdue for the conference staff queue.
  acknowledgeDueAt     DateTime
  declinedAt           DateTime?
  resolvedByAccountId  String?
  resolvedByUserId     String?
  /// Completed or cancelled.
  resolvedAt           DateTime?
  staffNote            String                     @default("")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  person             Person?                          @relation("MemberTransferPerson", fields: [personId], references: [id], onDelete: SetNull)
  pendingPerson      Person?                          @relation("MemberTransferPendingPerson", fields: [pendingPersonId], references: [id], onDelete: SetNull)
  fromOrganization   Organization                     @relation("MemberTransferFrom", fields: [fromOrganizationId], references: [id], onDelete: Restrict)
  toOrganization     Organization                     @relation("MemberTransferTo", fields: [toOrganizationId], references: [id], onDelete: Restrict)
  fromRosterMember   ClubRosterMember?                @relation("MemberTransferFromRoster", fields: [fromRosterMemberId], references: [id], onDelete: SetNull)
  toRosterMember     ClubRosterMember?                @relation("MemberTransferToRoster", fields: [toRosterMemberId], references: [id], onDelete: SetNull)
  initiatedByAccount AttendeeAccount?                 @relation("MemberTransferInitiatedByAccount", fields: [initiatedByAccountId], references: [id], onDelete: SetNull)
  initiatedByUser    User?                            @relation("MemberTransferInitiatedByUser", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  resolvedByAccount  AttendeeAccount?                 @relation("MemberTransferResolvedByAccount", fields: [resolvedByAccountId], references: [id], onDelete: SetNull)
  resolvedByUser     User?                            @relation("MemberTransferResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  events             MemberTransferEvent[]
  registrationMoves  MemberTransferRegistrationMove[]

  @@index([personId])
  @@index([fromRosterMemberId])
  @@index([toOrganizationId, createdAt])
  @@index([fromOrganizationId, createdAt])
  @@index([status, acknowledgeDueAt])
}

/// One append-only entry in a transfer's audit trail (#489), shown as the
/// transfer's history on both clubs' roster pages and to conference staff.
model MemberTransferEvent {
  id             String                  @id @default(cuid())
  transferId     String
  type           MemberTransferEventType
  actorAccountId String?
  actorUserId    String?
  note           String                  @default("")
  metadata       Json?
  createdAt      DateTime                @default(now())

  transfer     MemberTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  actorAccount AttendeeAccount? @relation("MemberTransferEventActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorUser    User?            @relation("MemberTransferEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([transferId, createdAt])
}

enum MemberTransferRegistrationMoveStatus {
  PENDING
  APPROVED
  SKIPPED
}

/// One of a transferred member's open club-billed event registrations,
/// waiting on conference staff (#489 decision 2). Completing a transfer
/// moves nothing on its own: staff approve or skip each move. An approved
/// move takes the attendee and every row keyed to them to the receiving
/// club's registration for that event; nothing is repriced.
model MemberTransferRegistrationMove {
  id                     String                               @id @default(cuid())
  transferId             String
  eventId                String
  registrationAttendeeId String?
  fromRegistrationId     String?
  /// The receiving club's registration the attendee moved to, once approved.
  toRegistrationId       String?
  status                 MemberTransferRegistrationMoveStatus @default(PENDING)
  decidedByUserId        String?
  decidedAt              DateTime?
  note                   String                               @default("")
  createdAt              DateTime                             @default(now())

  transfer         MemberTransfer        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee         RegistrationAttendee? @relation(fields: [registrationAttendeeId], references: [id], onDelete: SetNull)
  fromRegistration Registration?         @relation("MemberTransferMoveFrom", fields: [fromRegistrationId], references: [id], onDelete: SetNull)
  toRegistration   Registration?         @relation("MemberTransferMoveTo", fields: [toRegistrationId], references: [id], onDelete: SetNull)
  decidedBy        User?                 @relation("MemberTransferMoveDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([transferId, registrationAttendeeId])
  @@index([status, createdAt])
  @@index([eventId])
  @@index([registrationAttendeeId])
  @@index([fromRegistrationId])
  @@index([toRegistrationId])
}

enum CalendarEntryStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
}

/// What a calendar entry is (#444). A closure ("Conference office closed")
/// is shown with its own label and icon rather than as an ordinary date.
enum CalendarEntryType {
  STANDARD
  CLOSURE
  /// Something is due (#910). Never on the public calendar or its feeds; shown
  /// to club directors and Area Coordinators as a deadline, with reminders.
  DEADLINE
}

enum DeadlineReminderStatus {
  /// Prepared, waiting for one staff click to send.
  PENDING
  /// Staff approved it; its emails were queued in the outbox.
  SENT
  /// Taken back before approval because the deadline changed, was cancelled or hidden, or passed.
  WITHDRAWN
  /// Staff chose not to send it.
  DISMISSED
}

/// An informational item on the public conference calendar (#107) for
/// something registered or managed elsewhere. Dates are calendar dates in the
/// conference's time zone; `timeLabel` is shown as written ("7–9 pm").
model CalendarEntry {
  id              String              @id @default(cuid())
  title           String
  description     String              @default("")
  startsOn        String
  endsOn          String
  timeLabel       String              @default("")
  location        String              @default("")
  category        String              @default("")
  linkUrl         String?
  status          CalendarEntryStatus @default(SCHEDULED)
  entryType       CalendarEntryType   @default(STANDARD)
  /// RFC 5545 RRULE value (e.g. `FREQ=WEEKLY;BYDAY=MO,WE;COUNT=6`), or null
  /// for a one-off. `startsOn`/`endsOn` describe the first occurrence.
  repeatRule      String?
  /// Skipped occurrences (EXDATEs): start dates, YYYY-MM-DD, that don't happen.
  repeatExceptions String[]           @default([])
  isPublished     Boolean             @default(false)
  /// Imported from an ICS feed (#444 part B). All null for entries staff made.
  /// The feed link is cleared (not the entry deleted) when its feed is deleted.
  sourceFeedId              String?
  sourceUid                 String?
  /// The overridden occurrence's id for a RECURRENCE-ID item; "" for the master.
  sourceRecurrenceId        String?
  /// Hash of the last imported mapped fields; an unchanged hash means no write.
  sourceHash                String?
  /// The deleted feed's keyed address fingerprint, written when the feed is
  /// deleted. Only a feed with the same address may re-link this item.
  sourceUrlFingerprint      String?
  /// Set when the item is gone from the feed. It is unpublished, never deleted,
  /// so anything linked to it (#445) survives and relinks if it comes back.
  sourceRemovedAt           DateTime?
  sourceRemovedWasPublished Boolean             @default(false)
  /// Mapped fields staff changed after import; a refresh never overwrites these.
  locallyEditedFields       String[]            @default([])
  /// Hidden by staff here only; a refresh never unhides it.
  isHiddenLocally           Boolean             @default(false)
  /// The registration event this item is the placeholder for (#445). A linked pair shows once, as the event's own
  /// entry with Register. Never touched by a feed refresh, so the link survives every import. Several items can link to
  /// one event (#1086), and then each shows on its own date with Register. Deleting the event restores the items on
  /// their own.
  linkedEventId             String?
  linkedAt                  DateTime?
  linkedByUserId            String?
  /// The item's dates when staff last acknowledged them (#445): set when the item is linked, if they matched the
  /// event's then, and at every Update or Keep. The event's date banner appears only when the item's dates move away
  /// from these. Null while the item and event have differed since linking ("differs", not "moved").
  baselineStartsOn          String?
  baselineEndsOn            String?
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  sourceFeed CalendarFeed? @relation(fields: [sourceFeedId], references: [id], onDelete: SetNull)
  linkedEvent Event? @relation("CalendarEntryLinkedEvent", fields: [linkedEventId], references: [id], onDelete: SetNull)
  matchDismissals CalendarEventMatchDismissal[]

  deadlineReminderBatches DeadlineReminderBatch[]

  @@unique([sourceFeedId, sourceUid, sourceRecurrenceId])
  @@index([isPublished, startsOn])
  @@index([linkedEventId])
}

/// "Not the same" (#445): staff said this calendar item and this registration event are different things, so the
/// calendar admin never suggests that pair again. Permanent; ids only.
model CalendarEventMatchDismissal {
  calendarEntryId   String
  eventId           String
  dismissedByUserId String
  createdAt         DateTime @default(now())

  calendarEntry CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  event         Event         @relation("CalendarMatchDismissalEvent", fields: [eventId], references: [id], onDelete: Cascade)

  @@id([calendarEntryId, eventId])
  @@index([eventId])
}

/// One reminder for one deadline at one reminder point, 14 or 2 days before it is
/// due (#910). Prepared automatically; emailed only after staff approve it. The
/// unique key means a deadline, reminder point and due date are never prepared
/// twice, and a sent batch is final for that due date (a deadline that moves gets
/// its points prepared again for the new date). `title`, `dueOn` and `linkUrl` follow the entry while the
/// batch is pending and are frozen once it is decided.
model DeadlineReminderBatch {
  id                String                 @id @default(cuid())
  calendarEntryId   String?
  /// 14 or 2 (a check constraint in the migration).
  daysBefore        Int
  title             String
  dueOn             String
  linkUrl           String?
  status            DeadlineReminderStatus @default(PENDING)
  /// Why a batch was withdrawn or dismissed.
  statusReason      String?
  preparedAt        DateTime               @default(now())
  decidedAt         DateTime?
  decidedByUserId   String?
  /// Set when it is sent: how many emails were queued.
  recipientCount    Int?
  /// No longer written since #915 (deadline reminders go to people who opted out of announcements); null on new rows.
  optedOutCount     Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  calendarEntry CalendarEntry? @relation(fields: [calendarEntryId], references: [id], onDelete: SetNull)

  @@unique([calendarEntryId, daysBefore, dueOn])
  @@index([status, dueOn])
}

enum CalendarFeedStatus {
  OK
  FAILED
}

/// A read-only ICS feed (for example a Google Calendar) whose events are
/// imported into the public calendar (#444 part B). The URL can be a private
/// "secret address", so it is stored sealed and only a short hint is shown back.
model CalendarFeed {
  id               String              @id @default(cuid())
  name             String
  sealedUrl        String
  /// Host and the last four characters: the only form of the URL ever shown.
  urlHint          String
  /// Keyed HMAC of the normalized address: finds a duplicate or the same calendar without opening any sealed URL.
  urlFingerprint   String              @unique
  defaultCategory  String              @default("")
  defaultEntryType CalendarEntryType   @default(STANDARD)
  publishNewItems  Boolean             @default(false)
  isEnabled        Boolean             @default(true)
  refreshMinutes   Int                 @default(60)
  lastFetchedAt    DateTime?
  lastSucceededAt  DateTime?
  lastStatus       CalendarFeedStatus?
  /// A short, sanitized message. Never contains the feed URL.
  lastError        String?
  lastItemCount    Int?
  createdByUserId  String
  updatedByUserId  String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  entries CalendarEntry[]
}

/// A passkey an attendee registered as their second step (e.g. to open club
/// rosters). Only the public key is stored; nothing biometric ever reaches
/// the server. Removing one sets `revokedAt` and it never verifies again.
model AttendeePasskey {
  id           String    @id @default(cuid())
  accountId    String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  account AttendeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
}

enum PasskeyChallengePurpose {
  REGISTER
  VERIFY
  SIGN_IN
}

/// A one-time WebAuthn challenge, tied to the attendee session that asked for
/// it and consumed on first use so a response can't be replayed.
/// A single-use passkey prompt. REGISTER and VERIFY belong to a signed-in
/// session; SIGN_IN (#374) has none yet: it is tied to the browser by a
/// short-lived cookie holding its id, and the account is found only from the
/// verified credential.
model AttendeePasskeyChallenge {
  id        String                  @id @default(cuid())
  sessionId String?
  purpose   PasskeyChallengePurpose
  challenge String                  @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  session AttendeeSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, purpose])
  @@index([purpose, expiresAt])
}

/// A passkey a staff account (`User`) registered, either as a second factor
/// alongside a password or, for a UV (user-verified) assertion, as a
/// phishing-resistant way to complete sign-in on its own (#429). Kept in a
/// table separate from `AttendeePasskey`: the two principals' sign-in and
/// session models never share state. Only the public key is stored; nothing
/// biometric ever reaches the server. Removing one sets `revokedAt` and it
/// never verifies again.
model UserPasskey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// A one-time WebAuthn challenge for a staff passkey ceremony, consumed on
/// first use so a response can't be replayed. Mirrors
/// `AttendeePasskeyChallenge`: REGISTER and VERIFY belong to a signed-in
/// session; SIGN_IN has none yet and is tied to the browser by a short-lived
/// cookie holding its id, with the account found only from the verified
/// credential.
model UserPasskeyChallenge {
  id        String                  @id @default(cuid())
  sessionId String?
  purpose   PasskeyChallengePurpose
  challenge String                  @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, purpose])
  @@index([purpose, expiresAt])
}

/// Provenance for one reviewed annual clone (#157): a new draft `Event` built
/// from the configuration of a prior event. `resultEventId` is unique, so one
/// clone request yields one event; `(actorUserId, requestKey)` makes retries
/// idempotent. `sourceEventId` is nulled if the source is ever deleted; the
/// `snapshot` keeps the source's name and slug so provenance still reads.
/// Nothing here is a live link: the clone never follows later source edits.
model EventCloneRecord {
  id                String   @id @default(cuid())
  sourceEventId     String?
  resultEventId     String   @unique
  actorUserId       String
  requestKey        String
  /// The confirm body as sent (minus the key): what a retry with the same
  /// `requestKey` is compared against.
  requestInput      Json
  /// Hash of the source configuration the reviewer previewed; the clone was
  /// refused with SOURCE_CHANGED unless the source still matched it.
  sourceFingerprint String
  /// Ids and version numbers of the source configuration that was copied:
  /// registration form versions and message template versions.
  sourceVersions    Json
  /// Which domains were included, and which were excluded.
  selections        Json
  exclusions        Json
  /// Counts, the values that were reset or supplied anew, and the source's
  /// identity, as of the clone. Ids and counts only.
  snapshot          Json
  createdAt         DateTime @default(now())

  sourceEvent Event? @relation("EventCloneSource", fields: [sourceEventId], references: [id], onDelete: SetNull)
  resultEvent Event  @relation("EventCloneResult", fields: [resultEventId], references: [id], onDelete: Cascade)
  actor       User   @relation("EventCloneRecordActor", fields: [actorUserId], references: [id])

  @@unique([actorUserId, requestKey])
  @@index([sourceEventId, createdAt])
}

/// A class a member finished, recorded by a director (#532). The roster only
/// stores a member's *current* class (`ClubRosterMember.classLevel`), so this
/// is the explicit, least-invasive signal that "completed a class" happened:
/// one row per club, person and class. Recording it never orders anything; it
/// only makes that class's insignia set a *suggestion* the director confirms
/// (`insigniaDismissedAt` is set when the director chooses "Not now").
model MemberClassCompletion {
  id                  String         @id @default(cuid())
  organizationId      String
  personId            String
  classLevel          ClubClassLevel
  /// The calendar date (`YYYY-MM-DD`) the class was completed.
  completedOn         String
  insigniaDismissedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([organizationId, personId, classLevel])
  @@index([personId])
}

/// A catalog item staff link to a club event (#532): the camporee or PBE
/// patch or pin attendees earn. Linking never orders anything; it lets the
/// awards screen *suggest* the item for every member who attended.
model EventAwardItem {
  id        String   @id @default(cuid())
  eventId   String
  itemId    String
  createdAt DateTime @default(now())

  event Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item  ClubSupplyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([eventId, itemId])
  @@index([itemId])
}

/// Where a Master Award rule stands (#532). Rules arrive as DRAFT from the
/// staff-reviewed import; only ACTIVE rules are used for progress.
enum MasterAwardRuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// A Master Award's requirements, stored as data (#532): one or more honor
/// groups, each with a minimum; the award is earned when every group reaches
/// its minimum. Changed only by a system administrator, and audited.
model MasterAwardRule {
  id               String                @id @default(cuid())
  name             String
  normalizedName   String                @unique
  /// The Master Awards catalog item this rule's patch is (matched by name at import).
  itemId           String?
  status           MasterAwardRuleStatus @default(DRAFT)
  /// Parsed only partly, or honors that didn't match: a system administrator
  /// must clear this before the rule can be activated.
  needsManualCheck Boolean               @default(false)
  reviewNote       String                @default("")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  item   ClubSupplyItem?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  groups MasterAwardRuleGroup[]

  @@index([status])
}

model MasterAwardRuleGroup {
  id                  String   @id @default(cuid())
  ruleId              String
  position            Int
  minimum             Int
  /// Honor names from the import that matched no `Honor` row, shown for review.
  unmatchedHonorNames String[]

  rule   MasterAwardRule              @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  honors MasterAwardRuleGroupHonor[]

  @@unique([ruleId, position])
}

model MasterAwardRuleGroupHonor {
  groupId String
  honorId String

  group MasterAwardRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  honor Honor                @relation(fields: [honorId], references: [id], onDelete: Cascade)

  @@id([groupId, honorId])
  @@index([honorId])
}

enum ClubFormSubmissionStatus {
  DRAFT
  SUBMITTED
}

/// What a director did with a submitted club form on the roster (#721).
/// ADDED created a new roster member; LINKED recorded an existing one.
enum ClubFormRosterAction {
  ADDED
  LINKED
}

/// How a club form submission was entered (#610): a club director or deputy
/// signed in with their own account, a system administrator acting as that
/// director, or the person who opened a single-use private link.
enum ClubFormEntryChannel {
  ATTENDEE
  STAFF_ACTING
  LINK
}

/// OPEN links can still be used (until `expiresAt`); USED links submitted once
/// and are dead; REVOKED links were withdrawn by the club or lost an email
/// delivery. Expiry is derived from `expiresAt`, never stored.
enum ClubFormLinkStatus {
  OPEN
  USED
  REVOKED
}

/// A conference-managed club form (#610): forms that are not tied to an event
/// (membership application, staff service form, permission slip, passenger
/// list). `definition` is validated by the registration-form definition
/// schema, so the builder's field types and validation apply. Every template
/// is off (`enabled = false`) until a system administrator turns it on, and
/// clubs never see a disabled one. Sensitive fields are marked per field key.
model ClubFormTemplate {
  id                 String    @id @default(cuid())
  key                String    @unique
  name               String
  description        String    @default("")
  /// Bumped when the seeded definition changes; submissions record the
  /// version they were filled in against.
  version            Int       @default(1)
  definition         Json
  /// Display-only paragraphs per section id, for text a field label cannot
  /// carry (the Pathfinder Pledge and Law, approval and waiver text).
  sectionNotes       Json      @default("{}")
  /// Field keys whose answers are sealed with `lib/secret-box.ts`, redacted
  /// for Area Coordinators, and left out of CSVs, drafts and logs.
  sensitiveFieldKeys String[]  @default([])
  /// The birth-date class of sensitive field, a subset of `sensitiveFieldKeys`:
  /// readable only by the club's own director and deputies and system
  /// administrators (ADR 0005 Addendum A); Event Admins and Area Coordinators
  /// see "Restricted".
  birthDateFieldKeys String[]  @default([])
  /// Field keys a private-link filler never sees (for example office use).
  staffOnlyFieldKeys String[]  @default([])
  /// "STANDARD", or "PASSENGER_LIST" for the roll-call print layout.
  printLayout        String    @default("STANDARD")
  /// Field keys kept in the definition (so their sensitive flags and old
  /// answers stay put) but not offered to new fills (#712).
  hiddenFieldKeys    String[]  @default([])
  /// The "Allow adding to the roster" setting (#721): whether a submitted form
  /// can be added to the club roster, as which roster type, and which form
  /// fields fill which roster fields (by field key, never an answer). Null
  /// until set in the builder; a seeded template then falls back to the code's
  /// pre-filled mapping, which is off. Birth-date and sensitive fields map only
  /// to protected roster fields and health fields never map (validated in code).
  rosterMapping      Json?
  /// Addresses emailed when this form is submitted (#1017), at most 10, set from the form's settings page and not
  /// versioned with the definition. Empty means no email. The email never carries answers.
  submissionNotifyEmails String[] @default([])
  sortOrder          Int       @default(0)
  enabled            Boolean   @default(false)
  enabledAt          DateTime?
  enabledByUserId    String?
  /// Set the first time the template is edited or created in the app (#712).
  /// `club-forms:sync` never overwrites a customized template.
  customizedAt       DateTime?
  /// The unpublished draft of the next version (#712): the whole spec as JSON.
  /// Null when there is no draft. Publishing writes it to the columns above,
  /// bumps `version` and records a `ClubFormTemplateVersion`.
  draft                Json?
  draftUpdatedAt       DateTime?
  /// The published `version` the draft was started on (#712). A code sync that moves the version on makes the draft stale.
  draftBaseVersion     Int?
  draftUpdatedByUserId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enabledBy   User?                     @relation("ClubFormTemplateEnabledBy", fields: [enabledByUserId], references: [id], onDelete: SetNull)
  submissions ClubFormSubmission[]
  links       ClubFormLink[]
  versions    ClubFormTemplateVersion[]
}

/// A frozen copy of one published version of a club form template (#712), so a
/// submission is always shown and exported against the version it was filled
/// in against. Rows are only ever added.
model ClubFormTemplateVersion {
  id                 String   @id @default(cuid())
  templateId         String
  version            Int
  name               String
  description        String   @default("")
  definition         Json
  sectionNotes       Json     @default("{}")
  sensitiveFieldKeys String[] @default([])
  birthDateFieldKeys String[] @default([])
  staffOnlyFieldKeys String[] @default([])
  hiddenFieldKeys    String[] @default([])
  printLayout        String   @default("STANDARD")
  createdByUserId    String?
  createdAt          DateTime @default(now())

  template ClubFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, version])
}

/// One filled-in club form (#610). `answers` holds only non-sensitive answers;
/// sensitive ones are sealed into `sealedSensitiveAnswers` (AES-256-GCM, key
/// bound to this row's id). Every read of a row with sensitive answers writes
/// an audit row that carries no answer text.
model ClubFormSubmission {
  id                     String                   @id @default(cuid())
  templateId             String
  organizationId         String
  clubYear               String
  rosterMemberId         String?
  /// A display label for lists ("by member"): the roster member's name, or
  /// what the director typed for a non-member form.
  subjectName            String                   @default("")
  status                 ClubFormSubmissionStatus @default(DRAFT)
  answers                Json                     @default("{}")
  sealedSensitiveAnswers String?
  hasSensitiveAnswers    Boolean                  @default(false)
  templateVersion        Int
  enteredVia             ClubFormEntryChannel
  enteredByAccountId     String?
  /// Set instead of `enteredByAccountId` for a staff "act as" director.
  enteredByUserId        String?
  linkId                 String?                  @unique
  submittedAt            DateTime?
  /// "Add to roster" outcome (#721): the roster member this form was added to
  /// or linked to. The answers are never changed. `rosterActionAt` stays set
  /// if the member is later erased (the member id then goes null).
  rosterAction           ClubFormRosterAction?
  rosterActionMemberId   String?
  rosterActionAt         DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  template         ClubFormTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  rosterActionMember ClubRosterMember? @relation("ClubFormSubmissionRosterAction", fields: [rosterActionMemberId], references: [id], onDelete: SetNull)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember     ClubRosterMember? @relation(fields: [rosterMemberId], references: [id], onDelete: SetNull)
  enteredByAccount AttendeeAccount?  @relation("ClubFormSubmissionEnteredByAccount", fields: [enteredByAccountId], references: [id], onDelete: SetNull)
  enteredByUser    User?             @relation("ClubFormSubmissionEnteredByUser", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  link             ClubFormLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([organizationId, templateId, status])
  @@index([organizationId, clubYear])
  @@index([rosterMemberId])
  @@index([rosterActionMemberId])
  @@index([templateId, submittedAt])
}

/// A single-use, expiring private link (#610) for a parent or staff person to
/// fill in one form for one club, with no account. Only the SHA-256 of the
/// token is stored (`tokenHash`); the token itself is minted when the email is
/// delivered and never written to the outbox or a log.
model ClubFormLink {
  id                 String             @id @default(cuid())
  templateId         String
  organizationId     String
  clubYear           String
  rosterMemberId     String?
  /// The director's own label for who this link is for; never shown on the
  /// public page.
  subjectName        String             @default("")
  recipientEmail     String
  status             ClubFormLinkStatus @default(OPEN)
  tokenHash          String?            @unique
  expiresAt          DateTime
  usedAt             DateTime?
  revokedAt          DateTime?
  /// The outbox message that carries the link, for delivery-time minting.
  messageId          String?            @unique
  createdByAccountId String?
  createdByUserId    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  template         ClubFormTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember     ClubRosterMember?   @relation(fields: [rosterMemberId], references: [id], onDelete: SetNull)
  createdByAccount AttendeeAccount?    @relation("ClubFormLinkCreatedByAccount", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByUser    User?               @relation("ClubFormLinkCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submission       ClubFormSubmission?

  @@index([organizationId, status])
  @@index([templateId, organizationId])
  @@index([status, expiresAt])
}

// ---------------------------------------------------------------------------
// Pathfinder Health Record (#611). Built switched off behind
// HEALTH_RECORDS_ENABLED; see ADR 0005 Addendum B (Proposed).

enum HealthRecordLinkStatus {
  OPEN
  USED
  REVOKED
}

enum HealthRecordEntryChannel {
  DIRECTOR
  LINK
}

/// One health record for one club member (#611). It holds no health text: every
/// health field is a separate `HealthRecordField` row, sealed with
/// `lib/secret-box.ts`. `hasHealthNote` is the plain "a record exists" flag.
model HealthRecord {
  id                String                    @id @default(cuid())
  organizationId    String
  rosterMemberId    String                    @unique
  /// The club year (for example "2026-27") the record was last confirmed or
  /// saved in. Anything else shows "Needs update".
  confirmedClubYear String?
  hasHealthNote     Boolean                   @default(false)
  /// When it was last saved or confirmed (#923). The one date a Registrar, who can
  /// enter a record but not read it, is shown. Plain, carries no text.
  lastConfirmedAt   DateTime?
  lastEnteredVia    HealthRecordEntryChannel?
  /// Set when the record came from the 2026 Cognito form import (#878) and a director has not yet reviewed it.
  /// Cleared when a director saves or confirms the record. Plain, carries no text.
  importedAt        DateTime?
  /// Who last saved it: an attendee account id, or a staff user id for an act-as. Never shown.
  lastSavedByActor  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember ClubRosterMember    @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)
  fields       HealthRecordField[]

  @@index([organizationId])
}

/// A person's one-time privacy acknowledgment before health access works (#923,
/// ADR 0005 Addendum B). One row per signed-in person and wording version: a staff
/// user (`userId`) or an attendee account (`attendeeAccountId`), exactly one of the
/// two. A new `version` means acknowledging again. It holds no health data and
/// refers to no event, club, roster row or Person, so event and roster-member
/// deletion never touch it; it goes with the account that made it.
model HealthPrivacyAcknowledgment {
  id                String   @id @default(cuid())
  userId            String?
  attendeeAccountId String?
  version           String
  acknowledgedAt    DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendeeAccount AttendeeAccount? @relation(fields: [attendeeAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@unique([attendeeAccountId, version])
}

/// One sealed health field. `sealedValue` is `v1.<nonce>.<tag>.<ciphertext>`
/// under the purpose `health-record:<recordId>:<fieldKey>`.
model HealthRecordField {
  id          String   @id @default(cuid())
  recordId    String
  fieldKey    String
  sealedValue String
  updatedAt   DateTime @updatedAt

  record HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, fieldKey])
}

enum HealthSnapshotTrigger {
  CHECK_IN
  EVENT_START
}

/// How a snapshot's keep-until date was worked out (ADR 0005 Addendum B, #924).
enum HealthSnapshotAgeBasis {
  /// Under 18 on the event: kept until the 26th birthday.
  MINOR
  /// 18 or over on the event: kept 5 years after the event.
  ADULT
  /// No birth date: the longer of 5 years after the event and the 26th birthday on the latest plausible reading.
  UNKNOWN
}

enum HealthSnapshotHoldScope {
  PERSON
  EVENT
}

/// A sealed, immutable copy of one person's health record and consent as it stood
/// for one event (#924, ADR 0005 Addendum B). One per person per event. Every
/// field is a `HealthRecordSnapshotField` row sealed with `lib/secret-box.ts` under
/// `health-snapshot:<snapshotId>:<fieldKey>`. The row itself holds no health text and no
/// birth date: only dates, a version and counts. It is separate from the live
/// record, so deleting the live record leaves it. Database triggers refuse every
/// UPDATE and every DELETE except the retention job's and event deletion's.
/// Opened only through break-glass.
model HealthRecordSnapshot {
  id             String                 @id @default(cuid())
  personId       String
  eventId        String
  trigger        HealthSnapshotTrigger
  takenAt        DateTime               @default(now())
  /// The event's first calendar day (event time zone), the date age was worked out on.
  eventDate      String
  consentVersion String?
  /// The date on the signature (YYYY-MM-DD). Plain; the typed name is sealed.
  signedOn       String?
  ageBasis       HealthSnapshotAgeBasis
  /// The day this copy is deleted, unless a legal hold applies. Computed once, from the birth date at the event.
  expiresAt      DateTime
  fieldCount     Int
  createdAt      DateTime               @default(now())

  /// Restrict: removing a person who has a sealed copy is refused; the copy outlives the roster row.
  person Person                 @relation(fields: [personId], references: [id], onDelete: Restrict)
  event  Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields HealthRecordSnapshotField[]

  @@unique([personId, eventId])
  @@index([expiresAt])
  @@index([eventId])
}

model HealthRecordSnapshotField {
  id          String @id @default(cuid())
  snapshotId  String
  fieldKey    String
  sealedValue String

  snapshot HealthRecordSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, fieldKey])
}

/// A legal hold (#924): while one is active nothing it covers is deleted. Placed and
/// lifted by a system administrator with a reason; both are audited. Exactly one of
/// `personId` and `eventId`, matching `scope`. Holds are kept after they are lifted.
model HealthSnapshotHold {
  id             String                  @id @default(cuid())
  scope          HealthSnapshotHoldScope
  personId       String?
  eventId        String?
  reason         String
  placedByUserId String?
  placedAt       DateTime                @default(now())
  liftedAt       DateTime?
  liftedByUserId String?
  liftReason     String?

  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  event    Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placedBy User?   @relation("HealthSnapshotHoldPlacedBy", fields: [placedByUserId], references: [id], onDelete: SetNull)
  liftedBy User?   @relation("HealthSnapshotHoldLiftedBy", fields: [liftedByUserId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([eventId])
}

/// A break-glass grant (#924): one system administrator, one person's snapshots, a typed
/// reason, 24 hours. Every use is audited with ids and counts, never values.
model HealthSnapshotBreakGlass {
  id        String   @id @default(cuid())
  userId    String?
  personId  String?
  reason    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Deleting the person keeps the grant (the review trail), with the person id cleared (#929).
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  healthUses HealthBreakGlassUse[]

  @@index([userId, personId, expiresAt])
}

enum HealthBreakGlassUseKind {
  LIVE_RECORD
  SEALED_COPIES
}

/// One use of a break-glass grant (#929): which grant, whose record and what was opened. The grant covers a person's
/// live record and sealed copies alike. Ids, a kind and a time only: never a health value. Feeds the monthly review.
model HealthBreakGlassUse {
  id        String                  @id @default(cuid())
  grantId   String?
  userId    String?
  personId  String?
  kind      HealthBreakGlassUseKind
  createdAt DateTime                @default(now())

  // The review trail outlives the person and the grant: deleting either keeps the use row with the id cleared.
  grant  HealthSnapshotBreakGlass? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  user   User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  person Person?                   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([grantId, createdAt])
  @@index([createdAt])
}

/// A single-use, expiring private link for a parent to fill in one member's
/// health record, with no account. Only the SHA-256 of the token is stored.
model HealthRecordLink {
  id             String                 @id @default(cuid())
  organizationId String
  rosterMemberId String
  clubYear       String
  recipientEmail String
  status         HealthRecordLinkStatus @default(OPEN)
  tokenHash      String?                @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  messageId      String?                @unique
  /// Attendee account id or staff user id of the sender, for attribution only.
  createdByActor String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterMember ClubRosterMember @relation(fields: [rosterMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([rosterMemberId])
  @@index([status, expiresAt])
}

/// An organization's billing contact (#165), usually the church treasurer. Entered by office
/// staff once and reused for every event. Effective-dated: replacing it ends the previous row
/// (`effectiveTo`) and starts a new, unverified one; a row is never edited in place or deleted
/// (a trigger refuses DELETE). At most one row per organization is active (`effectiveTo` IS
/// NULL), enforced by a partial unique index the migration adds. Distinct from the club
/// director, the registration submitter, and any registration-facing contact.
model OrganizationBillingContact {
  id               String               @id @default(cuid())
  organizationId   String
  name             String
  email            String
  phone            String?
  /// A label such as "Treasurer".
  roleLabel        String
  source           BillingContactSource @default(STAFF_ENTERED)
  effectiveFrom    DateTime             @default(now())
  effectiveTo      DateTime?
  verifiedAt       DateTime?
  verifiedByUserId String?
  createdByUserId  String?
  endedByUserId    String?
  endReason        String?
  createdAt        DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  verifiedBy   User?        @relation("BillingContactVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("BillingContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedBy      User?        @relation("BillingContactEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, effectiveFrom])
}

/// A non-billing contact for an organization, today the church pastor (#977). One active row
/// (effectiveTo NULL) per organization and kind, enforced by a partial unique index the migration
/// adds. Rows are ended, never deleted or rewritten. Never used to address invoices or any message.
model OrganizationContact {
  id              String                  @id @default(cuid())
  organizationId  String
  kind            OrganizationContactKind
  name            String
  email           String?
  phone           String?
  effectiveFrom   DateTime                @default(now())
  effectiveTo     DateTime?
  createdByUserId String?
  endedByUserId   String?
  endReason       String?
  createdAt       DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("OrganizationContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedBy      User?        @relation("OrganizationContactEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, kind, effectiveFrom])
}

/// Who is financially responsible for one deferred-invoice registration (#165). One current row
/// per registration; every change also appends a `RegistrationBillingResponsibilityChange`.
/// STAFF_LINKED and STAFF_OVERRIDE rows are human decisions that re-resolution never replaces.
model RegistrationBillingResponsibility {
  id             String                      @id @default(cuid())
  eventId        String
  registrationId String                      @unique
  kind           BillingResponsibleKind
  organizationId String?
  personId       String?
  source         BillingResponsibilitySource
  /// Why staff chose this (required for an override).
  reason         String?
  setByUserId    String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  setBy        User?         @relation("BillingResponsibilitySetBy", fields: [setByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, kind])
  @@index([organizationId])
}

/// Append-only history of responsibility changes (#165): the before and after of each one.
model RegistrationBillingResponsibilityChange {
  id                 String                          @id @default(cuid())
  eventId            String
  registrationId     String
  changeType         BillingResponsibilityChangeType
  fromKind           BillingResponsibleKind?
  fromOrganizationId String?
  fromPersonId       String?
  fromSource         BillingResponsibilitySource?
  toKind             BillingResponsibleKind
  toOrganizationId   String?
  toPersonId         String?
  toSource           BillingResponsibilitySource
  reason             String?
  actorUserId        String?
  createdAt          DateTime                        @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("BillingResponsibilityChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([registrationId, createdAt])
  @@index([eventId, createdAt])
}

/// A staff correction of one registered person's attendance on a deferred-invoice event (#166):
/// "came but was missed at check-in" (MARK_ATTENDED), "checked in by mistake" (MARK_NOT_ATTENDED),
/// or CLEAR (go back to the check-in record). Append-only: a correction is never edited; a later one
/// for the same person supersedes it (`supersededAt`), and the database keeps one active row per
/// person. The reason is required and the actor is recorded.
model AttendanceCorrection {
  id                       String                   @id @default(cuid())
  eventId                  String
  registrationId           String
  registrationAttendeeId   String
  kind                     AttendanceCorrectionKind
  reason                   String
  actorUserId              String?
  createdAt                DateTime                 @default(now())
  supersededAt             DateTime?
  supersededByCorrectionId String?

  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     RegistrationAttendee @relation(fields: [registrationAttendeeId], references: [id], onDelete: Cascade)
  actor        User?                @relation("AttendanceCorrectionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([registrationId])
  @@index([registrationAttendeeId, createdAt])
}

/// One reconciliation of attended people into billable units for a deferred-invoice event (#166).
/// DRAFT -> APPROVED -> SUPERSEDED. Everything but the status fields is an immutable snapshot of the
/// inputs, the rule version and the per-registration and per-group counts, enforced by triggers.
/// `fingerprint` hashes those facts: preparing again with nothing changed returns the existing
/// version (a partial unique index lets only one non-superseded version carry a fingerprint), and at
/// most one version per event is APPROVED.
model AttendanceReconciliationVersion {
  id                    String                         @id @default(cuid())
  eventId               String
  versionNumber         Int
  status                AttendanceReconciliationStatus @default(DRAFT)
  fingerprint           String
  ruleVersion           String
  invoiceGrouping       InvoiceGrouping
  registeredCount       Int
  checkedInCount        Int
  noShowCount           Int
  addedByStaffCount     Int
  removedByStaffCount   Int
  billableCount         Int
  /// What the registered roster would cost (the #409 estimate), for comparison.
  estimatedCents        Int
  billableCents         Int
  snapshot              Json
  preparedByUserId      String?
  createdAt             DateTime                       @default(now())
  approvedByUserId      String?
  approvedAt            DateTime?
  supersededAt          DateTime?
  supersededByVersionId String?

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  preparedBy User? @relation("AttendanceVersionPreparedBy", fields: [preparedByUserId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("AttendanceVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  invoiceVersions InvoiceVersion[]

  @@unique([eventId, versionNumber])
  @@index([eventId, status])
}

/// Staff acknowledgement that a registration's prices may not belong to the people now on its roster
/// (a member was transferred after pricing, #166). The figure for that registration is prorated from
/// its estimate, and approval waits for this record. `reviewKey` names exactly the mismatch seen, so a
/// new transfer needs a new acknowledgement. Append-only with supersede (like corrections); the reason is
/// required and the actor recorded.
model AttendanceReviewAcknowledgement {
  id             String   @id @default(cuid())
  eventId        String
  registrationId String
  reviewKey      String
  /// The basis staff chose to bill: the per-person best match, or the prorated estimate.
  choice         AttendanceReviewChoice
  reason         String
  actorUserId    String?
  createdAt      DateTime @default(now())
  /// Set when staff acknowledge the same review again with a different choice or reason: the latest wins.
  supersededAt   DateTime?
  supersededById String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AttendanceReviewAckActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one active (not superseded) row per registration and review key.
  @@index([registrationId, reviewKey])
  @@index([eventId, createdAt])
}

/// A declaration of who is responsible for a minor at an event (#131), made on the registration form or by
/// staff. Append-only. Authority exists only here: household, surname, email, canManage and being the
/// account holder never create a row. `adultPersonId` is null when the registrant chose "None of us".
/// One ACTIVE row per (event, minor) by a partial unique index; a change supersedes the old row, staff
/// can revoke with a reason, and a trigger refuses every other edit and every delete. Grants no access
/// to health, incident or other registration data.
model GuardianAuthority {
  id               String                  @id @default(cuid())
  eventId          String
  /// The registration the declaration was made on (for staff, the minor's registration they acted on).
  registrationId   String
  minorPersonId    String
  adultPersonId    String?
  source           GuardianAuthoritySource
  state            GuardianAuthorityState  @default(ACTIVE)
  declaredAt       DateTime                @default(now())
  /// Why staff set this (required for a staff declaration; null for the registration form).
  declarationReason String?
  /// The private-link access grant a manage-link declaration was made through (plain id: grants are revoked and expire).
  accessTokenId    String?
  /// Who declared: staff (`actorUserId`) or the registrant (`actorPersonId`).
  actorUserId      String?
  actorPersonId    String?
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?
  supersededAt     DateTime?
  supersededById   String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  minor        Person       @relation("GuardianAuthorityMinor", fields: [minorPersonId], references: [id], onDelete: Restrict)
  adult        Person?      @relation("GuardianAuthorityAdult", fields: [adultPersonId], references: [id], onDelete: Restrict)
  actorUser    User?        @relation("GuardianAuthorityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPerson  Person?      @relation("GuardianAuthorityActorPerson", fields: [actorPersonId], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("GuardianAuthorityRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one ACTIVE row per (event, minor).
  @@index([eventId, minorPersonId, declaredAt])
  @@index([registrationId])
  @@index([adultPersonId])
}

/// How an acknowledgment was given (#150): the registrant online, staff typing it in for the person, or a paper
/// form staff recorded.
enum AcknowledgmentChannel {
  ONLINE
  STAFF_ENTERED
  PAPER
}

/// What an acknowledgment pointed at: the exact text on the form version, or a published #129 policy version.
enum AcknowledgmentSource {
  TEXT
  POLICY_VERSION
}

/// Evidence that someone acknowledged exactly what a form showed (#150). Append-only: a trigger refuses every UPDATE
/// and DELETE (event deletion included; the deletion service refuses an event that holds evidence), so what a person
/// saw can never be rewritten or silently lost. No typed signature: the submission audit already says who and when.
/// Every reference is RESTRICT, including the one to the policy version, so evidence can never be orphaned.
/// `registrationAttendeeId` is a plain id on purpose: an attendee removed later leaves the evidence behind, still
/// naming the person (`subjectPersonId`). Two partial unique indexes, one per subject kind, stop a retry or a second
/// entry of the same content from creating a conflicting duplicate. Never read by exports, logs, analytics or messages.
model AcknowledgmentEvidence {
  id                     String                @id @default(cuid())
  eventId                String
  registrationId         String
  /// Null when the subject is the registration itself.
  registrationAttendeeId String?
  /// The attendee the acknowledgment is about; null for a registration-level one.
  subjectPersonId        String?
  /// The person who acknowledged (the registrant, or whoever signed the paper): the subject, or a declared guardian.
  actedByPersonId        String
  /// Staff who typed it in or recorded the paper; null online.
  recordedByUserId       String?
  channel                AcknowledgmentChannel
  formVersionId          String
  fieldId                String
  fieldKey               String
  /// The checkbox statement the person ticked, as shown.
  fieldLabel             String
  source                 AcknowledgmentSource
  /// The exact text shown when `source` is TEXT; null for a policy version (the version row holds it).
  shownText              String?
  policyVersionId        String?
  /// SHA-256 of the text, or the policy version's own content hash.
  contentHash            String
  /// Identifies what was acknowledged, for the natural-key unique indexes: `text:<hash>` or `policy:<versionId>`.
  contentRef             String
  /// MINOR, ADULT or UNKNOWN on the event's start date when it was given.
  subjectMinorStatus     String
  /// The #131 declaration that let the person act for a minor (plain id: declarations are never deleted).
  guardianAuthorityId    String?
  acknowledgedAt         DateTime
  recordedAt             DateTime              @default(now())
  /// Only keys on the approved list (`approvedRequestMetadata`); a check constraint enforces the same list.
  requestMetadata        Json                  @default("{}")
  idempotencyKey         String
  requestHash            String
  /// How many earlier rows for this same subject, field and content were voided (#150). A voided acknowledgment can be
  /// recorded again as the next generation; a trigger makes this exactly that count, so there is never a second live row.
  generation             Int                   @default(0)

  void          AcknowledgmentVoid?
  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration  Registration            @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  subjectPerson Person?                 @relation("AcknowledgmentEvidenceSubject", fields: [subjectPersonId], references: [id], onDelete: Restrict)
  actedBy       Person                  @relation("AcknowledgmentEvidenceActedBy", fields: [actedByPersonId], references: [id], onDelete: Restrict)
  recordedBy    User?                   @relation("AcknowledgmentEvidenceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  formVersion   RegistrationFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  policyVersion ConsentPolicyVersion?   @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  /// Migration-level partial unique indexes: one row per (registration, field, content) for a registration subject
  /// and per (attendee, field, content) for an attendee subject.
  @@unique([eventId, idempotencyKey])
  @@index([registrationId, fieldKey, acknowledgedAt])
  @@index([registrationAttendeeId, fieldKey, acknowledgedAt])
  @@index([policyVersionId])
  @@index([subjectPersonId])
}

/// A correction to acknowledgment evidence (#150): staff with VIEW_SENSITIVE_DATA void a row with a reason. The evidence row is
/// never modified or deleted; this separate append-only row says it no longer counts. One void per evidence row, so voiding
/// twice is the same void. The reason is kept here and never in the audit log.
model AcknowledgmentVoid {
  id               String   @id @default(cuid())
  eventId          String
  registrationId   String
  evidenceId       String   @unique
  voidedByUserId   String
  reason           String
  voidedAt         DateTime @default(now())

  event        Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration         @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  evidence     AcknowledgmentEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  voidedBy     User                 @relation("AcknowledgmentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([eventId])
}

/// A second adult claiming a minor who already has an ACTIVE declaration from a different registration
/// (#131). Never resolved automatically: it waits for staff, and neither adult is silently blocked.
/// Changes only from OPEN to RESOLVED, once.
model GuardianAuthorityConflict {
  id                   String                         @id @default(cuid())
  eventId              String
  registrationId       String
  minorPersonId        String
  claimedAdultPersonId String
  /// The ACTIVE declaration that stood when the claim arrived (plain id: history rows are never deleted).
  existingAuthorityId  String
  declaredAt           DateTime                       @default(now())
  state                GuardianAuthorityConflictState @default(OPEN)
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolutionReason     String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  minor        Person       @relation("GuardianConflictMinor", fields: [minorPersonId], references: [id], onDelete: Restrict)
  claimedAdult Person       @relation("GuardianConflictAdult", fields: [claimedAdultPersonId], references: [id], onDelete: Restrict)
  resolvedBy   User?        @relation("GuardianConflictResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one OPEN row per (event, minor, claiming adult).
  @@index([eventId, state])
  @@index([minorPersonId])
}

enum InvoiceVersionStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
  /// A draft staff threw away (never numbered); kept for the record, hidden from the screens.
  DISCARDED
}

/// How a version was built: from the approved attendance reconciliation, by copying the prior
/// finalized version with only the billing contact refreshed (a contact-only revision), or from a
/// church's sponsored promo code redemptions (#399).
enum InvoiceVersionBasis {
  RECONCILIATION
  CONTACT_ONLY_COPY
  /// Built from what a church's sponsored promo codes covered on a GENERAL event (#399): no reconciliation behind it.
  CHURCH_PROMO_CODES
}

/// What is owed on one finalized invoice version. OPEN until the version is superseded by a revision.
/// Payment states arrive when the ledger links in (#117-#120); see docs/INVOICES.md.
enum InvoiceReceivableStatus {
  OPEN
  SUPERSEDED
}

/// One invoice for one invoice group of a deferred-invoice event (#167). The number is assigned exactly
/// once, when the first version is finalized; revisions are versions of this invoice (`-R1`, `-R2`).
model Invoice {
  id              String                 @id @default(cuid())
  eventId         String
  /// The #165 invoice group key (a church, a club under per-club grouping, or a billing person).
  groupKey        String
  invoiceGrouping InvoiceGrouping
  partyKind       BillingResponsibleKind
  partyId         String?
  clubId          String?
  /// "SC27-0001": null until the first finalization, then never changed.
  baseNumber      String?                @unique
  numberCode      String?
  numberYear      Int?
  numberSequence  Int?
  createdAt       DateTime               @default(now())

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions    InvoiceVersion[]
  receivables InvoiceReceivable[]
  deliveries  InvoiceDelivery[]
  arPostings  InvoiceArPosting[]
  payments    InvoicePayment[]

  @@unique([eventId, groupKey])
  @@index([eventId])
}

/// An invoice version: a DRAFT is replaced only by regeneration; FINALIZED and SUPERSEDED versions are
/// immutable snapshots (database trigger). `snapshot` holds the lines; the columns hold what the
/// screen and the receivable read.
model InvoiceVersion {
  id                      String               @id @default(cuid())
  invoiceId               String
  eventId                 String
  /// 0 for the original, 1 for -R1, and so on.
  revision                Int
  status                  InvoiceVersionStatus @default(DRAFT)
  basis                   InvoiceVersionBasis
  /// The finalized version this one revises.
  supersedesVersionId     String?
  /// Null only for a version built from a church's promo code redemptions (#399), which has no reconciliation behind it.
  reconciliationVersionId String?
  /// Full number such as "SC27-0001-R1", assigned at finalization only.
  number                  String?              @unique
  groupTitle              String
  organizationName        String
  contactName             String?
  contactEmail            String?
  contactRoleLabel        String?
  contactVerified         Boolean              @default(false)
  registeredCount         Int
  billableCount           Int
  amountDueCents          Int
  /// Hash of every billable amount (lines, credits, promo, charges, total); a revision with the same
  /// fingerprint as the finalized version it replaces changed no billable amount.
  amountsFingerprint      String
  snapshot                Json
  /// Staff-added custom lines (patch orders and the like, #780): item, description, quantity and rate. Editable only on a
  /// DRAFT, frozen with it. `amountDueCents` and `amountsFingerprint` include them.
  manualLines             Json                 @default("[]")
  revisionReason          String?
  createdByUserId         String?
  createdAt               DateTime             @default(now())
  regenerationCount       Int                  @default(0)
  regeneratedAt           DateTime?
  finalizedAt             DateTime?
  finalizedByUserId       String?
  /// The approver's name as it was when they finalized.
  finalizedByName         String?
  finalizeIdempotencyKey  String?              @unique
  supersededAt            DateTime?
  supersededByVersionId   String?
  discardedAt             DateTime?

  event                 Event                           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice               Invoice                         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reconciliationVersion AttendanceReconciliationVersion? @relation(fields: [reconciliationVersionId], references: [id], onDelete: NoAction)
  createdBy             User?                           @relation("InvoiceVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  finalizedBy           User?                           @relation("InvoiceVersionFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  receivable            InvoiceReceivable?
  document              InvoiceVersionDocument?
  deliveries            InvoiceDelivery[]
  arPostings            InvoiceArPosting[]
  payments              InvoicePayment[]

  /// A migration-level partial unique index allows one non-discarded version per invoice and revision.
  @@index([invoiceId, revision])
  @@index([eventId, status])
  @@index([reconciliationVersionId])
}

/// The per-invoice receivable (#167): one row per finalized version, created in the finalization
/// transaction. A later ledger links to `invoiceVersionId`.
model InvoiceReceivable {
  id                    String                  @id @default(cuid())
  eventId               String
  invoiceId             String
  invoiceVersionId      String                  @unique
  amountCents           Int
  status                InvoiceReceivableStatus @default(OPEN)
  createdAt             DateTime                @default(now())
  supersededAt          DateTime?
  supersededByVersionId String?

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  payments       InvoicePayment[]

  @@index([eventId, status])
  @@index([invoiceId])
}

/// The running invoice number for one event's code and year (#167). One row per (code, year), so a number
/// can never be issued twice across events; allocated by an atomic increment inside the finalize transaction.
model InvoiceNumberCounter {
  id         String   @id @default(cuid())
  eventId    String
  code       String
  year       Int
  lastNumber Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([code, year])
  @@index([eventId])
}

/// Whether a payment entry records money received or reverses an earlier entry (#168).
enum InvoicePaymentEntryKind {
  PAYMENT
  REVERSAL
}

/// Who an invoice email went to (#168): the church's billing contact, or the director of a club on the invoice.
enum InvoiceRecipientKind {
  BILLING_CONTACT
  CLUB_DIRECTOR
}

/// The PDF of one finalized invoice version (#168), made once from the immutable snapshot at the first send or
/// download and never regenerated: a resend attaches these very bytes. `sha256` is the hash of the stored file.
model InvoiceVersionDocument {
  id                  String   @id @default(cuid())
  eventId             String
  invoiceId           String
  invoiceVersionId    String   @unique
  attachmentId        String   @unique
  sha256              String
  /// The layout version of the generator, so a later layout change is visible on old documents.
  generatorVersion    Int
  /// The finance setting and organization name as they were when the PDF was made.
  paymentInstructions String
  headerName          String
  /// The header block, bill-to address, club-type heading and payments total the layout used (#780); null on a document made before it.
  layoutInputs        Json?
  createdAt           DateTime @default(now())

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion    @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  attachment     MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  deliveries     InvoiceDelivery[]

  @@index([eventId])
}

/// One staff send (or resend) of a finalized invoice version (#168). Append-only. Each recipient is one outbox
/// message, whose status, bounce and suppression the outbox and provider events keep up to date.
model InvoiceDelivery {
  id                              String   @id @default(cuid())
  eventId                         String
  invoiceId                       String
  invoiceVersionId                String
  documentId                      String
  /// 1 for the first send of the version, 2 for the first resend, and so on.
  sequence                        Int
  sentByUserId                    String?
  sentByName                      String
  subject                         String
  /// The current billing contact was not the contact the invoice was finalized with (staff saw the flag first).
  contactChangedSinceFinalization Boolean  @default(false)
  idempotencyKey                  String   @unique
  createdAt                       DateTime @default(now())

  event          Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion             @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  document       InvoiceVersionDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sentBy         User?                      @relation("InvoiceDeliverySentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  recipients     InvoiceDeliveryRecipient[]

  @@unique([invoiceVersionId, sequence])
  @@index([eventId, createdAt])
}

model InvoiceDeliveryRecipient {
  id                String               @id @default(cuid())
  deliveryId        String
  kind              InvoiceRecipientKind
  /// The director's attendee account, or null for the billing contact.
  attendeeAccountId String?
  /// The club a director leads on this invoice, or null for the billing contact.
  clubId            String?
  messageOutboxId   String               @unique
  createdAt         DateTime             @default(now())

  delivery InvoiceDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  message  MessageOutbox   @relation(fields: [messageOutboxId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

/// Staff marked a finalized version "Posted to AR" in the conference's own accounting (#168). One root row per
/// version; a correction is a new row that corrects the latest one (append-only, never edited).
model InvoiceArPosting {
  id                String            @id @default(cuid())
  eventId           String
  invoiceId         String
  invoiceVersionId  String
  postedOn          DateTime          @db.Date
  reference         String?
  correctsPostingId String?           @unique
  reason            String?
  recordedByUserId  String?
  recordedByName    String
  createdAt         DateTime          @default(now())

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion    @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  corrects       InvoiceArPosting? @relation("InvoiceArPostingCorrection", fields: [correctsPostingId], references: [id], onDelete: NoAction)
  correctedBy    InvoiceArPosting? @relation("InvoiceArPostingCorrection")
  recordedBy     User?             @relation("InvoiceArPostingRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  /// A migration-level partial unique index allows one root (uncorrecting) posting per version.
  @@index([invoiceId, createdAt])
  @@index([eventId])
}

/// A check received against an invoice, recorded by hand (#168). Append-only: a mistake is voided by a REVERSAL
/// entry that names the payment and gives a reason. Outstanding is computed across every entry on the invoice.
model InvoicePayment {
  id                String                  @id @default(cuid())
  eventId           String
  invoiceId         String
  /// The finalized version the entry was recorded against, and that version's receivable.
  invoiceVersionId  String
  receivableId      String
  kind              InvoicePaymentEntryKind
  amountCents       Int
  checkNumber       String?
  receivedOn        DateTime                @db.Date
  note              String?
  reversesPaymentId String?                 @unique
  reason            String?
  /// Minted by the page and reused on a retry, so a double click records one entry.
  requestKey        String?                 @unique
  recordedByUserId  String?
  recordedByName    String
  createdAt         DateTime                @default(now())

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceVersion InvoiceVersion    @relation(fields: [invoiceVersionId], references: [id], onDelete: Cascade)
  receivable     InvoiceReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  reverses       InvoicePayment?   @relation("InvoicePaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: NoAction)
  reversedBy     InvoicePayment?   @relation("InvoicePaymentReversal")
  recordedBy     User?             @relation("InvoicePaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Lodging inventory and availability (#198, slice 1). Facility data only: no
// person, assignment, preference or waitlist is stored here (those are #199 and
// #200). The property templates are code data synced by `npm run lodging:sync`.
// Actor columns are plain user ids (no foreign key) so the append-only history
// never has to be rewritten when a user is deleted.
// ---------------------------------------------------------------------------

enum LodgingUnitKind {
  ROOM
  RV_SITE
  TENT
}

enum LodgingBedType {
  QUEEN
  DOUBLE
  TWIN
  /// A bunk bed: a lower and an upper twin, so it sleeps two.
  TWIN_BUNK
}

enum LodgingBathroom {
  PRIVATE
  SHARED
  BATHHOUSE
  UNSPECIFIED
}

/// The categories an event can set an optional rate for (never seeded).
enum LodgingCategory {
  DORM_ROOM
  CONFERENCE_CENTER_ROOM
  RV_SITE
  TENT_WITH_POWER
  TENT
}

enum LodgingRateBasis {
  PER_UNIT_NIGHT
  PER_PERSON_NIGHT
  /// Flat for the whole event, per room or site (Man Camp housing choices).
  PER_UNIT_PER_EVENT
  /// Flat for the whole event, per person.
  PER_PERSON_PER_EVENT
}

enum LodgingHoldKind {
  STAFF
  MAINTENANCE
  /// A room or site blocked for safety (#214). Like every hold it blocks availability only; assignments are never touched.
  SAFETY
  /// A room or site blocked for damage found at check-out (#214).
  DAMAGE
}

enum LodgingHoldHistoryType {
  CREATED
  WINDOW_CHANGED
  RELEASED
}

model LodgingProperty {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  /// The template version last applied by the sync.
  templateVersion Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buildings LodgingBuilding[]
  units     LodgingUnit[]
  events    EventLodging[]
}

model LodgingBuilding {
  id         String   @id @default(cuid())
  propertyId String
  key        String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property LodgingProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units    LodgingUnit[]

  @@unique([propertyId, key])
}

/// One reservable unit: a room, a numbered RV site, or a counted area (`isArea`).
model LodgingUnit {
  id                 String           @id @default(cuid())
  propertyId         String
  buildingId         String
  key                String
  name               String
  kind               LodgingUnitKind
  /// A counted area with a capacity but no numbered sites.
  isArea             Boolean          @default(false)
  category           LodgingCategory?
  floor              Int?
  groundLevel        Boolean          @default(false)
  bathroom           LodgingBathroom  @default(UNSPECIFIED)
  linensProvided     Boolean?
  specialUse         Boolean          @default(false)
  /// False for storage and similar: never has capacity.
  assignable         Boolean          @default(true)
  /// "Sleeps up to"; null means no fixed limit.
  defaultCapacity    Int?
  defaultUnavailable Boolean          @default(false)
  defaultHoldKind    LodgingHoldKind?
  defaultHoldReason  String?
  notes              String?
  sortOrder          Int              @default(0)
  activeFrom         DateTime?        @db.Date
  activeUntil        DateTime?        @db.Date
  /// Set when a later template version no longer lists the unit; never deleted.
  retiredAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  property   LodgingProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building   LodgingBuilding    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  beds       LodgingBed[]
  eventUnits EventLodgingUnit[]

  @@unique([propertyId, key])
  @@index([buildingId, sortOrder])
}

model LodgingBed {
  id       String         @id @default(cuid())
  unitId   String
  position Int
  type     LodgingBedType
  sleeps   Int

  unit LodgingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, position])
}

/// An event's use of one property. External hotel details stay on Event and are never inventory.
model EventLodging {
  id              String    @id @default(cuid())
  eventId         String    @unique
  propertyId      String
  templateVersion Int
  /// Optional bookable-night window; defaults to the event's own dates (last night = day before the end date).
  firstNight      DateTime? @db.Date
  lastNight       DateTime? @db.Date
  /// Whether registrants choose a lodging category when they register (#199). Off for club events, where staff assign.
  collectsPreferences Boolean @default(false)
  /// Last day a registrant may change their lodging preference (inclusive, event time zone); null follows the event's registration close date.
  preferencesDeadline DateTime? @db.Date
  /// What a full category shows: "Full" only, or "Full" with a waitlist (the waitlist itself is #200).
  fullBehavior    LodgingFullBehavior @default(SHOW_FULL)
  settingsUpdatedByUserId String?
  /// Attendees see their approved building, room and instructions on the private registration page only after staff
  /// publish assignments (#200). Off by default.
  showAssignmentsToAttendees Boolean @default(false)
  /// Roommates shown by first name only, and only when staff turn this on. Contact details are never shown.
  showRoommateFirstNames Boolean @default(false)
  /// Event-wide instructions shown beside a published assignment (no personal data).
  attendeeInstructions String?
  assignmentSettingsUpdatedByUserId String?
  /// Bumped by every writer that changes what the event's lodging can hold or has promised (holds, closures, capacity
  /// overrides, requests, submissions), inside its transaction and under the unit locks. A Serializable reader that
  /// read capacity before such a write fails on its own bump of this row and is retried.
  capacityVersion Int @default(0)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  property LodgingProperty    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  units    EventLodgingUnit[]
  rates    EventLodgingRate[]
  buckets  EventLodgingBucket[]

  @@unique([id, eventId])
}

/// Per-event state for one unit. The row doubles as the lock #200 takes (FOR UPDATE) before allocating.
model EventLodgingUnit {
  id                String   @id @default(cuid())
  eventId           String
  eventLodgingId    String
  unitId            String
  /// Snapshot of the property layout when the event chose it (or last updated it): later template
  /// versions reach an event only through the explicit "Update to latest property layout" action.
  /// "Sleeps up to"; null is no fixed limit.
  defaultCapacity   Int?
  bedsSummary       String   @default("")
  assignable        Boolean  @default(true)
  /// The unit was dropped by a template version this event has adopted.
  retired           Boolean  @default(false)
  capacityOverride  Int?
  unavailable       Boolean  @default(false)
  unavailableReason String?
  updatedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  eventLodging EventLodging       @relation(fields: [eventLodgingId, eventId], references: [id, eventId], onDelete: Cascade)
  unit         LodgingUnit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  holds        EventLodgingHold[]
  assignments  EventLodgingAssignment[]
  facilityIssues FacilityIssue[]
  assetIssuances AssetIssuance[]

  @@unique([eventLodgingId, unitId])
  @@unique([id, eventId])
}

/// A staff or maintenance hold: whole-unit, for a window of nights (both ends inclusive). Released, never deleted.
model EventLodgingHold {
  id                 String          @id @default(cuid())
  eventId            String
  eventLodgingUnitId String
  kind               LodgingHoldKind
  reason             String
  firstNight         DateTime        @db.Date
  lastNight          DateTime        @db.Date
  /// Placed by the property template's default (cooks, nurse), not by staff; follows the event's nights.
  systemDefault      Boolean         @default(false)
  createdByUserId    String?
  createdAt          DateTime        @default(now())
  releasedAt         DateTime?
  releasedByUserId   String?
  releaseReason      String?

  eventUnit EventLodgingUnit          @relation(fields: [eventLodgingUnitId, eventId], references: [id, eventId], onDelete: Cascade)
  history   EventLodgingHoldHistory[]
  facilityIssues FacilityIssue[]

  @@unique([id, eventId])
  @@index([eventLodgingUnitId, releasedAt])
  @@index([eventId])
}

/// Append-only: one row per change to a hold.
model EventLodgingHoldHistory {
  id          String                 @id @default(cuid())
  eventId     String
  holdId      String
  type        LodgingHoldHistoryType
  actorUserId String?
  at          DateTime               @default(now())
  kind        LodgingHoldKind?
  reason      String?
  firstNight  DateTime?              @db.Date
  lastNight   DateTime?              @db.Date

  hold EventLodgingHold @relation(fields: [holdId, eventId], references: [id, eventId], onDelete: Cascade)

  @@index([holdId, at])
}

/// Optional rate for a category. No row means lodging is included or free. Set only by a person; never seeded.
model EventLodgingRate {
  id              String           @id @default(cuid())
  eventId         String
  eventLodgingId  String
  category        LodgingCategory
  amountCents     Int
  basis           LodgingRateBasis
  minimumNights   Int?
  updatedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  eventLodging EventLodging @relation(fields: [eventLodgingId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([eventLodgingId, category])
}

// ---------------------------------------------------------------------------
// Lodging preferences, roommate requests, household rules (#199, slice 2).
// A request is what a guest asked for; it is never an assignment (#200).
// Accessibility is two yes/no flags: no medical free text exists in these tables.
// ---------------------------------------------------------------------------

enum LodgingFullBehavior {
  SHOW_FULL
  WAITLIST
}

enum LodgingRequestSource {
  REGISTRANT
  STAFF
  REGISTRATION_FORM
}

enum LodgingHouseholdPreference {
  /// Everyone on the registration stays together (the default).
  TOGETHER
  /// The party can be placed in more than one unit.
  FLEXIBLE
}

enum LodgingRoommateDecision {
  PENDING
  APPROVED
  DECLINED
}

enum LodgingRuleKind {
  /// Join: the two people are kept together, wherever their registrations are.
  KEEP_TOGETHER
  /// Split: one person is taken out of their registration's default household.
  SPLIT_HOUSEHOLD
  /// The two people are never placed together.
  SEPARATE
}

/// One lodging request per registration (the current pointer); every change is a new, immutable version row.
model EventLodgingRequest {
  id             String   @id @default(cuid())
  eventId        String
  registrationId String
  currentVersion Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event        Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration                 @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  versions     EventLodgingRequestVersion[]

  @@unique([eventId, registrationId])
  @@unique([id, eventId])
}

/// Append-only snapshot of a request. Earlier versions are the history a registrant change never overwrites.
model EventLodgingRequestVersion {
  id                   String                     @id @default(cuid())
  eventId              String
  requestId            String
  version              Int
  category             LodgingCategory?
  /// Nights slept, both ends inclusive; both null means the event's whole night window.
  firstNight           DateTime?                  @db.Date
  lastNight            DateTime?                  @db.Date
  partySize            Int
  /// Yes/no flags only. Never medical detail.
  groundFloorNeeded    Boolean                    @default(false)
  accessibleRoomNeeded Boolean                    @default(false)
  privateRoomRequested Boolean                    @default(false)
  householdPreference  LodgingHouseholdPreference @default(TOGETHER)
  /// Rooms the registrant chose (room-type categories); 1 for a site, a tent or a request that names no category (#803).
  roomCount            Int                        @default(1)
  /// The registrant saw that the party is larger than the beds in the chosen rooms and will bring extra bedding (#803).
  bringsExtraBedding   Boolean                    @default(false)
  source               LodgingRequestSource
  /// The registration form version the choice came from (plain id: forms are versioned elsewhere).
  sourceFormVersionId  String?
  actorUserId          String?
  accessTokenId        String?
  changeReason         String?
  /// Made after the lodging deadline (a staff override); the review queue lists it.
  afterDeadline        Boolean                    @default(false)
  createdAt            DateTime                   @default(now())

  request EventLodgingRequest @relation(fields: [requestId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([requestId, version])
  @@index([eventId, category])
}

/// "I would like to room with ...", directional until both sides ask or staff approve. Never carries contact details.
model EventLodgingRoommateRequest {
  id                   String                  @id @default(cuid())
  eventId              String
  fromRegistrationId   String
  targetRegistrationId String
  /// Optional: which person on each registration (person ids); null means the registration as a whole.
  fromPersonId         String?
  targetPersonId       String?
  source               LodgingRequestSource
  actorUserId          String?
  accessTokenId        String?
  decision             LodgingRoommateDecision @default(PENDING)
  decidedAt            DateTime?
  decidedByUserId      String?
  decisionReason       String?
  withdrawnAt          DateTime?
  withdrawnByUserId    String?
  withdrawalReason     String?
  createdAt            DateTime                @default(now())

  event              Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromRegistration   Registration @relation("LodgingRoommateFrom", fields: [fromRegistrationId], references: [id], onDelete: Cascade)
  targetRegistration Registration @relation("LodgingRoommateTarget", fields: [targetRegistrationId], references: [id], onDelete: Cascade)
  fromPerson         Person?      @relation("LodgingRoommateFromPerson", fields: [fromPersonId], references: [id], onDelete: Restrict)
  targetPerson       Person?      @relation("LodgingRoommateTargetPerson", fields: [targetPersonId], references: [id], onDelete: Restrict)

  /// A migration-level partial unique index allows one open request per (event, from, target, people).
  @@index([eventId, fromRegistrationId])
  @@index([eventId, targetRegistrationId])
}

/// Staff keep-together, split and separation rules, with who, why, scope and effective nights.
/// Ended, never deleted. The household default and the responsible-adult rule are derived, not stored.
model EventLodgingRule {
  id             String          @id @default(cuid())
  eventId        String
  kind           LodgingRuleKind
  personAId      String
  /// Null for a split; otherwise the other person (the pair is stored in id order).
  personBId      String?
  reason         String
  actorUserId    String?
  /// First and last night the rule applies (inclusive); null is open.
  effectiveFrom  DateTime?       @db.Date
  effectiveUntil DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  endedAt        DateTime?
  endedByUserId  String?
  endReason      String?

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personA Person  @relation("LodgingRulePersonA", fields: [personAId], references: [id], onDelete: Restrict)
  personB Person? @relation("LodgingRulePersonB", fields: [personBId], references: [id], onDelete: Restrict)

  @@index([eventId, kind])
  @@index([personAId])
  @@index([personBId])
}

/// A staff acknowledgement of a review item. The fingerprint changes when the item changes, so a changed item reappears.
model EventLodgingReviewAck {
  id          String   @id @default(cuid())
  eventId     String
  itemKey     String
  fingerprint String
  note        String
  actorUserId String?
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, itemKey, fingerprint])
}

/// A registrant's change that their event's edit policy keeps from applying itself (a priced lodging type once money
/// is on the registration). Nothing is applied: it waits in the staff review queue until staff act on it or dismiss it.
/// It never carries the accessibility flags (those are staff-only after the first version).
model EventLodgingChangeRequest {
  id                   String                     @id @default(cuid())
  eventId              String
  registrationId       String
  category             LodgingCategory?
  firstNight           DateTime?                  @db.Date
  lastNight            DateTime?                  @db.Date
  partySize            Int
  privateRoomRequested Boolean                    @default(false)
  householdPreference  LodgingHouseholdPreference @default(TOGETHER)
  roomCount            Int                        @default(1)
  bringsExtraBedding   Boolean                    @default(false)
  accessTokenId        String?
  createdAt            DateTime                   @default(now())
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolution           String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId, resolvedAt])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Lodging assignment, moves, waitlist and attendee display (#200, slice 3).
// Capacity and exclusivity are enforced night by night under the EventLodgingUnit row locks plus the capacityVersion
// bump. The assignment history is append-only (database triggers); rows go only with their event. Actor columns are
// plain user ids. Nothing here ever changes a registration's charge.
// ---------------------------------------------------------------------------

enum LodgingBucketKind {
  HOTEL
  AIRBNB
  HOME
  OFFSITE
  OTHER
}

enum LodgingAssignmentSource {
  STAFF
  PROPOSAL
  CSV_IMPORT
  WAITLIST
}

enum LodgingAssignmentEventType {
  ASSIGNED
  MOVED_IN
  MOVED_OUT
  SPLIT_REMAINDER
  CANCELLED
  TRANSFERRED_IN
  TRANSFERRED_OUT
  LATE_ARRIVAL
  EARLY_DEPARTURE
  LINKED
}

enum LodgingWaitlistStatus {
  JOINED
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  REMOVED
  PROMOTED
}

/// Alternate housing (hotel, Airbnb, home, offsite, other): counts as assigned, uses no on-site inventory. Staff rename the label.
model EventLodgingBucket {
  id              String            @id @default(cuid())
  eventId         String
  eventLodgingId  String
  kind            LodgingBucketKind
  label           String
  updatedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  eventLodging EventLodging             @relation(fields: [eventLodgingId, eventId], references: [id, eventId], onDelete: Cascade)
  assignments  EventLodgingAssignment[]

  @@unique([eventLodgingId, kind])
  @@unique([id, eventId])
}

/// An expected guest or group (staff, a pastor, a club) not registered yet. It can be assigned and later linked to a registration attendee.
model EventLodgingPlaceholder {
  id               String    @id @default(cuid())
  eventId          String
  displayName      String
  /// People this placeholder stands for (a club of 14 is one placeholder with headcount 14).
  headcount        Int       @default(1)
  note             String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  linkedAttendeeId String?
  linkedAt         DateTime?
  linkedByUserId   String?
  archivedAt       DateTime?
  archivedByUserId String?

  event          Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  linkedAttendee RegistrationAttendee?    @relation(fields: [linkedAttendeeId], references: [id], onDelete: NoAction)
  assignments    EventLodgingAssignment[]

  @@unique([id, eventId])
  @@index([eventId])
  @@index([linkedAttendeeId])
}

/// The current placement of one occupant (a registration attendee or a placeholder) for a range of nights (both ends
/// inclusive): in an on-site unit, or in an alternate-housing bucket. A move, trim or cancellation changes this row
/// and always appends to EventLodgingAssignmentHistory, which is never rewritten.
model EventLodgingAssignment {
  id                 String                  @id @default(cuid())
  eventId            String
  eventLodgingUnitId String?
  bucketId           String?
  attendeeId         String?
  placeholderId      String?
  people             Int                     @default(1)
  firstNight         DateTime                @db.Date
  lastNight          DateTime                @db.Date
  source             LodgingAssignmentSource
  /// Bumped by every change to this row.
  revision           Int                     @default(1)
  reason             String?
  actorUserId        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelReason       String?

  event       Event                           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventUnit   EventLodgingUnit?               @relation(fields: [eventLodgingUnitId, eventId], references: [id, eventId], onDelete: Cascade)
  bucket      EventLodgingBucket?             @relation(fields: [bucketId, eventId], references: [id, eventId], onDelete: Cascade)
  attendee    RegistrationAttendee?           @relation(fields: [attendeeId], references: [id], onDelete: NoAction)
  placeholder EventLodgingPlaceholder?        @relation(fields: [placeholderId, eventId], references: [id, eventId], onDelete: Cascade)
  history     EventLodgingAssignmentHistory[]
  assetIssuances AssetIssuance[]

  /// Migration-level: a night-range exclusion per occupant and a CHECK that exactly one place and one occupant are set.
  @@unique([id, eventId])
  @@index([eventId, eventLodgingUnitId])
  @@index([eventId, bucketId])
  @@index([attendeeId])
  @@index([placeholderId])
}

/// Append-only: one row per assignment event (assigned, moved, split, cancelled, transferred, late arrival, early departure).
model EventLodgingAssignmentHistory {
  id                  String                     @id @default(cuid())
  eventId             String
  assignmentId        String
  type                LodgingAssignmentEventType
  at                  DateTime                   @default(now())
  actorUserId         String?
  reason              String?
  source              LodgingAssignmentSource?
  /// Occupant at the time (plain ids: history never has to be rewritten).
  attendeeId          String?
  placeholderId       String?
  people              Int                        @default(1)
  eventLodgingUnitId  String?
  bucketId            String?
  firstNight          DateTime?                  @db.Date
  lastNight           DateTime?                  @db.Date
  previousUnitId      String?
  previousBucketId    String?
  previousFirstNight  DateTime?                  @db.Date
  previousLastNight   DateTime?                  @db.Date
  /// A late arrival or early departure that deliberately keeps the nights (capacity stays held).
  preservedCapacity   Boolean                    @default(false)
  revision            Int
  /// The paired row of a move, split or transfer.
  relatedAssignmentId String?

  event      Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignment EventLodgingAssignment @relation(fields: [assignmentId, eventId], references: [id, eventId], onDelete: Cascade)

  @@index([eventId, at])
  @@index([assignmentId, at])
  @@index([attendeeId])
}

/// A room notice staff sent to one registration, with the assignment version it described. A later change makes it obsolete.
model EventLodgingAssignmentNotice {
  id                String   @id @default(cuid())
  eventId           String
  registrationId    String
  outboxMessageId   String?
  /// The registration's assignment version when the notice was written (history rows for its attendees).
  assignmentVersion Int
  /// Hash of what the notice said (stays, roommates, closed rooms, instructions): a later difference makes it obsolete.
  contentHash       String
  sentByUserId      String?
  createdAt         DateTime @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: NoAction)

  @@index([eventId, registrationId])
}

/// Lodging waitlist: joined, offered (with expiry), accepted, declined, expired, removed, promoted. One open entry per registration.
model EventLodgingWaitlistEntry {
  id             String                @id @default(cuid())
  eventId        String
  registrationId String
  category       LodgingCategory
  /// Nights wanted, both ends inclusive; both null means the event's whole night window.
  firstNight     DateTime?             @db.Date
  lastNight      DateTime?             @db.Date
  partySize      Int
  /// Rooms wanted (room-type categories), set from the request when joining; counted in rooms against rooms available (#803).
  roomCount      Int                   @default(1)
  status         LodgingWaitlistStatus @default(JOINED)
  /// 0 until the first offer; each offer (including a re-offer after expiry) is the next number.
  offerNumber    Int                   @default(0)
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  offerMessageId String?
  createdVia     LodgingRequestSource
  joinedAt       DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  event        Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration                  @relation(fields: [registrationId], references: [id], onDelete: NoAction)
  history      EventLodgingWaitlistHistory[]

  /// A migration-level partial unique index allows one open entry (JOINED, OFFERED or ACCEPTED) per registration.
  @@unique([id, eventId])
  @@index([eventId, status, joinedAt])
  @@index([registrationId])
}

/// Append-only history of a waitlist entry.
model EventLodgingWaitlistHistory {
  id             String                @id @default(cuid())
  eventId        String
  entryId        String
  status         LodgingWaitlistStatus
  at             DateTime              @default(now())
  actorUserId    String?
  accessTokenId  String?
  reason         String?
  offerNumber    Int                   @default(0)
  offerExpiresAt DateTime?
  messageId      String?

  event Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entry EventLodgingWaitlistEntry @relation(fields: [entryId, eventId], references: [id, eventId], onDelete: Cascade)

  @@index([entryId, at])
}

/// Team rules for a club event (#809): whether a club may register more than one team, how many members a team has,
/// the alternate, and the date ages are counted on. A row exists only for an event that uses teams (the Pathfinder Bible
/// Experience); an event without one behaves exactly as a club event always has. One row per event.
model EventTeamSettings {
  eventId            String   @id
  /// A club may register several teams, each with its own unique name (#809). Off: one registration per club.
  allowMultipleTeams Boolean  @default(false)
  /// Fewest and most team members (everyone but the coaches) a registration may have; null for no limit.
  minTeamMembers     Int?
  maxTeamMembers     Int?
  /// Most team members that may be marked the alternate; 0 means the event has no alternate.
  maxAlternates      Int      @default(0)
  /// Ages are counted on this calendar date (`YYYY-MM-DD`) instead of the event's first day; null counts on the event date.
  ageAsOf            String?
  /// The oldest a team member may be on that date; null for no limit. Coaches are never held to it.
  maxMemberAge       Int?
  /// The line under the title on the printed form, e.g. the books the team studies.
  booksLine          String   @default("")
  /// The dates and places of the levels above this event's Area level, for the printed form and the results report.
  /// `[{ level: "CONFERENCE" | "UNION", date: "YYYY-MM-DD", place: string }]`.
  levelInfo          Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum TeamResultLevel {
  AREA
  CONFERENCE
  UNION
}

/// How a team did at one level of a multi-level event (#809): a free-text placement or score and whether it qualified
/// for the next level. The Conference and Union levels are not registrations of their own, so their results live here,
/// beside the one registration the team made for the Area level. Entered by staff; the club's director reads them.
model ClubTeamResult {
  id                      String          @id @default(cuid())
  clubEventRegistrationId String
  level                   TeamResultLevel
  /// Free text from before placement was a number (#809): kept readable and flagged for staff to re-enter (#945). New entries leave it empty.
  placement               String          @default("")
  /// The place as a number (#945): 1 is first. Ties share a number; 1st and 2nd advance. Null until staff enter it.
  placementRank           Int?
  /// Whether the team advances to the next level (#945): the rule's answer (placement 1 or 2) unless `advanceOverride` says otherwise.
  qualified               Boolean         @default(false)
  /// Staff's decision (#945): true advances the team, false keeps it from advancing, whatever its place. Null follows the rule; kept when places are recomputed.
  advanceOverride         Boolean?
  notes                   String          @default("")
  updatedByUserId         String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  clubEventRegistration ClubEventRegistration @relation(fields: [clubEventRegistrationId], references: [id], onDelete: Cascade)
  updatedBy             User?                 @relation("ClubTeamResultUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([clubEventRegistrationId, level])
}

/// A team checked in for a level above Area (#945): the Conference or Union day of the same event. The team never
/// registers again, so this is one row per team and level rather than the per-person Area check-in. Undoing keeps the row.
model ClubTeamLevelCheckIn {
  id                      String          @id @default(cuid())
  eventId                 String
  clubEventRegistrationId String
  level                   TeamResultLevel
  checkedInAt             DateTime        @default(now())
  checkedInByUserId       String?
  undoneAt                DateTime?
  createdAt               DateTime        @default(now())

  event                 Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clubEventRegistration ClubEventRegistration @relation(fields: [clubEventRegistrationId], references: [id], onDelete: Cascade)
  checkedInBy           User?                 @relation("ClubTeamLevelCheckInBy", fields: [checkedInByUserId], references: [id], onDelete: SetNull)

  @@unique([clubEventRegistrationId, level])
  @@index([eventId, level])
}

enum TeamPermissionStatus {
  PENDING
  GRANTED
  DECLINED
}

/// A team member who is 18 or older on the event's age date needs the Area Coordinator's permission (#809). The team
/// registers anyway: this is a flag, not a block. One row per PERSON on a team, so a decision outlives the attendee row it
/// was made about: a person who stops needing the flag (a coach, removed, under 18) keeps a granted or declined decision
/// (marked inactive) and gets it back if they become a team member of 18 or older on that team again; only a pending flag is
/// deleted. Decided by the Area Coordinator (who does not direct the team's own club), or staff who manage registrations;
/// a declined person must become a coach or leave before the team can be saved again.
model ClubTeamMemberPermission {
  id                      String               @id @default(cuid())
  eventId                 String
  clubEventRegistrationId String
  personId                String
  /// The person's current attendee row on the team; null while the flag is inactive.
  registrationAttendeeId  String?              @unique
  active                  Boolean              @default(true)
  status                  TeamPermissionStatus @default(PENDING)
  /// The age on the age date when it was flagged, kept for the Area Coordinator's view.
  ageOnAgeDate            Int
  decidedByUserId         String?
  decidedByAccountId      String?
  decidedAt               DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  clubEventRegistration ClubEventRegistration @relation(fields: [clubEventRegistrationId], references: [id], onDelete: Cascade)
  attendee              RegistrationAttendee? @relation(fields: [registrationAttendeeId], references: [id], onDelete: SetNull)
  decidedByUser         User?                 @relation("ClubTeamPermissionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByAccount      AttendeeAccount?      @relation("ClubTeamPermissionDecidedByAccount", fields: [decidedByAccountId], references: [id], onDelete: SetNull)

  @@unique([clubEventRegistrationId, personId])
  @@index([eventId, status])
}

// ---------------------------------------------------------------------------
// New club applications (#817)

enum NewClubApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NewClubApplicationType {
  PATHFINDER
  ADVENTURER
}

/// How the applicant arrived: the public "Register a new club" page, or a private link a system administrator sent.
enum NewClubApplicationSource {
  PUBLIC
  INVITE
}

/// A request to start a new club, mirroring the paper Pathfinder Program Club Application. It creates nothing until a
/// system administrator approves it; approving makes the club (an Organization of type CLUB) and sends its director the
/// ordinary club invite, once. The attachment (signed paper page or church board minutes) is a private file seen only by
/// system administrators and Area Coordinators. Free text (names, address, phones, signatures, the note) never goes into
/// audit metadata or the notification email.
model NewClubApplication {
  id                    String                   @id @default(cuid())
  status                NewClubApplicationStatus @default(PENDING)
  source                NewClubApplicationSource
  clubName              String
  clubType              NewClubApplicationType
  /// The sponsoring church from the directory, or null when the applicant typed one instead (`sponsoringChurchOther`).
  sponsoringChurchId    String?
  sponsoringChurchOther String?
  pastorName            String
  directorName          String
  directorAddress       String
  /// Lower-cased. Matched to an existing account or person for the Sterling Volunteers flag, and the invite goes here.
  directorEmail         String
  directorHomePhone     String?
  directorWorkPhone     String?
  philosophyAgreed      Boolean
  pastorSignature       String
  headElderSignature    String
  clerkSignature        String
  directorSignature     String
  otherBoardMembers     String[]
  /// The day it was submitted, in the conference time zone.
  applicationDate       DateTime                 @db.Date
  note                  String?
  attachmentName        String?
  attachmentContentType String?
  attachmentByteSize    Int?
  attachmentChecksum    String?
  attachmentStorageKey  String?                  @unique
  inviteId              String?                  @unique
  /// The address the private link was sent to, kept so the queue can flag a director email that differs from it.
  invitedEmail          String?
  decidedByUserId       String?
  decidedAt             DateTime?
  /// Why it was declined; goes to the applicant in the email only, never into audit metadata.
  declineReason         String?
  /// Set once, in the same transaction that approves: the claim that makes a second approval impossible.
  createdOrganizationId String?                  @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  sponsoringChurch    Organization?             @relation("NewClubApplicationChurch", fields: [sponsoringChurchId], references: [id], onDelete: SetNull)
  createdOrganization Organization?             @relation("NewClubApplicationCreatedClub", fields: [createdOrganizationId], references: [id], onDelete: SetNull)
  decidedBy           User?                     @relation("NewClubApplicationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  invite              NewClubApplicationInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([directorEmail])
  @@index([sponsoringChurchId])
}

/// A private link a system administrator sends to a prospective director (#817). Single use: submitting the application
/// uses it up. Like the club form link, the email body holds a sentinel and the token is minted when the message is
/// delivered; only its SHA-256 is stored.
model NewClubApplicationInvite {
  id              String    @id @default(cuid())
  email           String
  name            String    @default("")
  tokenHash       String?   @unique
  /// The outbox message that carries the link, for delivery-time minting.
  messageId       String?   @unique
  expiresAt       DateTime
  usedAt          DateTime?
  cancelledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  createdBy   User?               @relation("NewClubApplicationInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  application NewClubApplication?

  @@index([email])
}

/// An Honors Weekend class instructor (#833): a person staff invited to teach
/// one or more classes at one event. Instructors are attendee-account people,
/// like club directors: staff invite by email, and the invited person accepts
/// from their own signed-in account, whose verified email must be the invite's
/// (no secret in the email). Accepting sets `attendeeAccountId`. Nothing else
/// grants a roster: not the class's free-text teacher name, not a club role.
/// One row per (event, email); the classes they teach are `HonorInstructorClass`.
/// `personId` is the durable person the Sterling Volunteers check is matched to.
model HonorInstructor {
  id                String    @id @default(cuid())
  eventId           String
  personId          String
  /// Lower-cased; the address the invite went to and the account must verify.
  email             String
  name              String
  attendeeAccountId String?
  createdByUserId   String?
  sentAt            DateTime?
  sentCount         Int       @default(0)
  acceptedAt        DateTime?
  revokedAt         DateTime?
  revokedByUserId   String?
  /// How the instructor hears about youth joining or leaving their classes (#1098). Set only by the instructor.
  classChangeEmails HonorClassChangeEmails @default(DAILY)
  /// The end of the last daily summary's window (#1098): changes at or before it are never summarized again.
  classChangeSummaryAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person          Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  attendeeAccount AttendeeAccount? @relation(fields: [attendeeAccountId], references: [id], onDelete: SetNull)
  classes         HonorInstructorClass[]
  marks           HonorEnrollmentMark[]

  @@unique([eventId, email])
  @@index([attendeeAccountId])
  @@index([email])
}

/// One class an instructor teaches (#833). A class may have several instructors.
model HonorInstructorClass {
  id           String   @id @default(cuid())
  instructorId String
  offeringId   String
  createdAt    DateTime @default(now())

  instructor HonorInstructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  offering   HonorOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([instructorId, offeringId])
  @@index([offeringId])
}

/// One youth joining or leaving a class (#1098), written in the same transaction as the enrollment change. It is the
/// source for the instructor's daily summary (a join then a leave nets out) and for right-away emails. `enrollmentId` and
/// `registrationAttendeeId` are plain ids, not keys: the enrollment (or the attendee) may be gone by the time it is read.
/// The name, club and age are copied when the change happens so the summary never needs the youth's record (and never a birth date).
model HonorClassChange {
  id                     String               @id @default(cuid())
  eventId                String
  offeringId             String
  enrollmentId           String
  registrationAttendeeId String
  kind                   HonorClassChangeKind
  youthName              String
  clubName               String?
  ageOnEventDate         Int?
  at                     DateTime             @default(now())
  /// Set once the right-away emails for this change were queued (or none were due), so a sweep never queues them twice.
  immediateHandledAt     DateTime?

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offering HonorOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, at])
  @@index([at])
  @@index([immediateHandledAt, at])
  @@index([eventId])
}

/// A staff "honor watch" (#1099): a few addresses told, once a day, which youth joined or left classes that teach chosen honors
/// (or chosen classes). It holds no youth data: only the staff's own choices (a name, addresses, honor and class ids) and the
/// end of the last summary's window. What a summary lists is read from `HonorClassChange`, which retention prunes after 8 days.
model HonorWatch {
  id          String    @id @default(cuid())
  eventId     String
  position    Int       @default(0)
  name        String
  /// Lower-cased typed addresses, at most 10.
  recipients  String[]
  /// Catalog honor ids: a class matches when ANY honor it teaches is listed (#812).
  honorIds    String[]
  /// Specific class (offering) ids.
  offeringIds String[]
  /// The end of the last daily summary's window: changes at or before it are never summarized again. Moved by one conditional
  /// update (as `HonorInstructor.classChangeSummaryAt` is). Saving the watch never moves it, even when its targets change.
  summaryAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
}

/// An instructor's mark on one class enrollment (#833): attended, and
/// completed (which always includes attended; the migration's CHECK says so).
/// Completed is what feeds the Honors Weekend write-back. Absence of a row
/// means the instructor has made no decision for that person.
model HonorEnrollmentMark {
  id                   String   @id @default(cuid())
  enrollmentId         String   @unique
  attended             Boolean
  completed            Boolean
  markedByInstructorId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  enrollment         HonorEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  markedByInstructor HonorInstructor? @relation(fields: [markedByInstructorId], references: [id], onDelete: SetNull)

  @@index([markedByInstructorId])
}

/// A person's confirmation that one manual item on the System readiness page is done (#870). One row per item key
/// while it is ticked; unticking deletes the row, and the audit log keeps who ticked, who unticked and why.
/// Ticking never performs the action it records. The name is a snapshot so the page still reads correctly if the
/// account is later renamed or removed.
model SystemReadinessTick {
  itemKey          String   @id
  tickedByUserId   String?
  tickedByName     String
  tickedAt         DateTime @default(now())
  note             String?
}

// ---------------------------------------------------------------------------
// Issued assets (#213, slice 1): keys, keycards, wristbands, radios, welcome packets and other event items.
// A type is serialized (one numbered item, one holder at a time) or quantity (a lot of N identical items).
// An issuance is one holder's claim on one asset; it changes only to END (transferred, replaced, corrected) and every
// change appends to AssetIssuanceHistory, which is never rewritten (database triggers). Slice 2 (#214) adds
// return, loss, damage and charge outcomes as further end reasons and history types, without touching these rows.
// Money never lives here: a type carries only a *reference* to the deposit/replacement policy.
// ---------------------------------------------------------------------------

enum IssuedAssetMode {
  SERIALIZED
  QUANTITY
}

enum IssuedAssetAssigneeKind {
  ATTENDEE
  REGISTRATION
  STAFF
  ROOM
  VEHICLE
  TEAM
}

enum IssuedAssetCondition {
  NEW
  GOOD
  WORN
  DAMAGED
}

/// Staff-controlled stock status. "Issued" is never stored: it is read from the open issuances.
enum IssuedAssetAvailability {
  AVAILABLE
  UNAVAILABLE
  RETIRED
}

enum IssuedAssetEntryMethod {
  MANUAL
  SCAN
  /// Recorded on a device without a connection and sent later; `issuedAt` is when it really happened.
  OFFLINE
}

enum IssuedAssetEndReason {
  TRANSFERRED
  REPLACED
  CORRECTED
  /// Slice 2 (#214): the holder gave it back. `endQuantity` says how many of a lot.
  RETURNED
  LOST
  /// Given back, but damaged beyond ordinary wear.
  DAMAGED
}

enum IssuedAssetEventType {
  ISSUED
  TRANSFERRED_OUT
  TRANSFERRED_IN
  REPLACED_OUT
  REPLACED_IN
  CORRECTED
  RETURNED
  LOST
  DAMAGED
  /// The part of a lot that stayed out after a partial return or loss: a new issuance continuing the old one.
  REMAINDER_ISSUED
  /// An administrator corrected a recorded outcome (a lost key found, a return that was really a loss); `correctedEndReason` is the corrected fate (#214).
  OUTCOME_CORRECTED
  /// A loss, or the original of a replacement, written off with a reason: nothing is charged and nothing more is owed.
  WRITTEN_OFF
  /// Staff reviewed an exception the closeout raised (a correction after money was recorded, a waiver that left a line on a registration), with a reason.
  EXCEPTION_REVIEWED
}

/// What happens to a cash deposit when a covered item does not come back (#214).
enum AssetDepositShortfall {
  /// The whole deposit is kept.
  KEEP_ALL
  /// The replacement fee of each missing or damaged item is kept (never more than the deposit); the rest is handed back.
  KEEP_FEES
}

enum AssetLedgerKind {
  DEPOSIT_RECEIVED
  DEPOSIT_RETURNED
  DEPOSIT_KEPT
  CHARGE
  WAIVER
  /// Cash handed back at the desk after a correction showed an item a kept deposit was kept for had come back. Recorded, never a provider refund; capped at what was kept.
  DEPOSIT_HANDED_BACK_LATE
}

enum AssetChargeCategory {
  REPLACEMENT
  DAMAGE
  OTHER
}

enum AssetLedgerSettlement {
  /// Cash taken, handed back or kept at the desk. Recorded here; no money moves through the system.
  CASH_AT_DESK
  /// Posted to the registration as an ASSET adjustment line (or reversed by one).
  REGISTRATION_ADJUSTMENT
  /// Recorded only: the holder has no registration to post to, or staff chose not to post.
  RECORD_ONLY
}

enum FacilityTargetKind {
  /// A room or RV site of the event's lodging.
  UNIT
  ASSET
  OTHER
}

enum FacilityIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FacilityIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum FacilityIssueSource {
  REPORT
  CHECKOUT_INSPECTION
}

enum FacilityIssueHistoryType {
  REPORTED
  UPDATED
  BLOCK_PLACED
  RESOLVED
  DISMISSED
}

model IssuedAssetType {
  id                   String                    @id @default(cuid())
  eventId              String
  name                 String
  mode                 IssuedAssetMode
  active               Boolean                   @default(true)
  assigneeKinds        IssuedAssetAssigneeKind[]
  /// Issuing to an attendee or registration records the lodging room and the exact assignment it came from.
  roomLinked           Boolean                   @default(false)
  /// A reference (a name or code staff recognise) to the deposit and replacement policy.
  depositPolicyRef     String?
  replacementPolicyRef String?
  /// Slice 2 (#214): the usual cash deposit for one holder's items of this kind (zero: no deposit), what happens to it when
  /// an item is missing or damaged, and the fee for replacing one item. Amounts are in cents; staff may take a different
  /// deposit amount at the desk.
  depositCents         Int                       @default(0)
  depositShortfall     AssetDepositShortfall     @default(KEEP_ALL)
  replacementFeeCents  Int                       @default(0)
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assets IssuedAsset[]
  ledgerEntries AssetLedgerEntry[]

  @@unique([eventId, name])
  @@unique([id, eventId])
}

/// One numbered item (quantityTotal 1) or one quantity lot (quantityTotal N) of a type.
model IssuedAsset {
  id              String                  @id @default(cuid())
  eventId         String
  assetTypeId     String
  /// What staff read and say: "K-214".
  identifier      String
  /// What the barcode or QR encodes; defaults to the identifier. Unique per event.
  scanCode        String
  quantityTotal   Int                     @default(1)
  condition       IssuedAssetCondition    @default(GOOD)
  location        String?
  availability    IssuedAssetAvailability @default(AVAILABLE)
  /// Bumped by every issuance writer after it locks the row, so two writers racing for one asset cannot both commit
  /// on what they read (the loser is rolled back and retried), like the lodging capacity version.
  issueVersion    Int                     @default(0)
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assetType IssuedAssetType       @relation(fields: [assetTypeId, eventId], references: [id, eventId], onDelete: NoAction)
  issuances AssetIssuance[]
  facilityIssues FacilityIssue[]

  @@unique([eventId, identifier])
  @@unique([eventId, scanCode])
  @@unique([id, eventId])
  @@index([eventId, assetTypeId])
}

/// One holder's claim on one asset. Open while `endedAt` is null. Migration-level: a serialized asset has at most one
/// open issuance, open quantities never exceed the lot, the holder columns match the kind, and a row changes only to end.
model AssetIssuance {
  id                 String                  @id @default(cuid())
  eventId            String
  assetId            String
  /// Snapshot of the type's mode, so the database can keep one open issuance per serialized asset.
  serialized         Boolean
  quantity           Int                     @default(1)
  assigneeKind       IssuedAssetAssigneeKind
  attendeeId         String?
  registrationId     String?
  /// A staff member's user id (plain, like every actor column).
  staffUserId        String?
  /// The room: the holder when the kind is ROOM, otherwise the room the key opens (a snapshot of the assignment's room).
  roomUnitId         String?
  /// The exact lodging assignment a room-linked item was issued against. A later move cancels that assignment; the
  /// issuance keeps pointing at it, which is how history stays correct.
  sourceAssignmentId String?
  /// The holder when the kind is VEHICLE or TEAM (no such records exist yet).
  assigneeLabel      String?
  purpose            String
  expectedReturnAt   DateTime?
  /// When it really happened (an offline desk records the moment); `createdAt` is when the server recorded it.
  issuedAt           DateTime
  issuedByUserId     String
  entryMethod        IssuedAssetEntryMethod
  idempotencyKey     String?
  /// The issuance this one continues (transfer or replacement).
  previousIssuanceId String?
  endedAt            DateTime?
  endReason          IssuedAssetEndReason?
  endedByUserId      String?
  endNote            String?
  /// How many of the issuance the ending outcome applies to (a return, loss or damage). A partial outcome ends the
  /// issuance and a new one continues the remainder.
  endQuantity        Int?
  revision           Int                     @default(1)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  event            Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  asset            IssuedAsset                  @relation(fields: [assetId, eventId], references: [id, eventId], onDelete: Cascade)
  attendee         RegistrationAttendee?       @relation(fields: [attendeeId], references: [id], onDelete: NoAction)
  registration     Registration?               @relation(fields: [registrationId], references: [id], onDelete: NoAction)
  roomUnit         EventLodgingUnit?           @relation(fields: [roomUnitId, eventId], references: [id, eventId], onDelete: NoAction)
  sourceAssignment EventLodgingAssignment?     @relation(fields: [sourceAssignmentId, eventId], references: [id, eventId], onDelete: NoAction)
  history          AssetIssuanceHistory[]
  deposits         AssetDepositCover[]
  ledgerEntries    AssetLedgerEntry[]

  @@unique([eventId, idempotencyKey])
  @@unique([id, eventId])
  @@index([eventId, assetId])
  @@index([attendeeId])
  @@index([registrationId])
  @@index([eventId, roomUnitId])
}

/// Append-only: one row per issuance event, with the holder and the lodging reference as they were at the time.
model AssetIssuanceHistory {
  id                 String                  @id @default(cuid())
  eventId            String
  issuanceId         String
  assetId            String
  type               IssuedAssetEventType
  at                 DateTime                @default(now())
  /// When the server wrote the row; `at` is when it happened (an offline desk sets it earlier).
  recordedAt         DateTime                @default(now())
  actorUserId        String
  reason             String?
  entryMethod        IssuedAssetEntryMethod
  quantity           Int
  assigneeKind       IssuedAssetAssigneeKind
  attendeeId         String?
  registrationId     String?
  staffUserId        String?
  roomUnitId         String?
  sourceAssignmentId String?
  assigneeLabel      String?
  /// The paired issuance of a transfer or replacement.
  relatedIssuanceId  String?
  revision           Int
  /// Slice 2 (#214): the saved retry key of a return, so a repeated or replayed offline return writes nothing twice.
  idempotencyKey     String?
  /// The corrected fate of an OUTCOME_CORRECTED row (RETURNED, LOST or DAMAGED). The ended issuance itself never changes.
  correctedEndReason IssuedAssetEndReason?
  /// An EXCEPTION_REVIEWED row names the closeout exception it answers (its code) and the entry that raised it (a correction's history id or a waiver's ledger id): a review clears only that one.
  reviewedCode       String?
  reviewedRefId      String?
  /// The change this row made to a lot's stock count (negative: units taken off the lot). A correction reverses exactly what was applied, never more.
  stockDelta         Int                   @default(0)
  /// A reference to the evidence of the item's condition (a photo number, an incident or work-order number). Text only.
  evidenceRef        String?
  /// The condition the item was found in (a return, loss or damage).
  condition          IssuedAssetCondition?

  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issuance AssetIssuance @relation(fields: [issuanceId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([eventId, idempotencyKey])
  @@index([eventId, at])
  @@index([issuanceId, at])
  @@index([assetId, at])
}

/// Append-only money record for issued assets (#214), in the pattern of the meal ledger: cash deposits received,
/// handed back or kept at the desk (recorded, never moved), and charges and waivers. A charge may also be posted to the
/// registration as an ASSET adjustment line (`registrationAdjustmentId`); a waiver of a posted charge is the reversing line.
/// Nothing is edited or deleted; the follow-up entries of a deposit or charge are its state.
model AssetLedgerEntry {
  id                       String                  @id @default(cuid())
  eventId                  String
  kind                     AssetLedgerKind
  /// Always positive; the kind gives the direction.
  amountCents              Int
  assetTypeId              String?
  issuanceId               String?
  registrationId           String?
  /// A return or keep points at the deposit it settles.
  depositEntryId           String?
  /// A waiver points at the charge it waives.
  waivesEntryId            String?
  chargeCategory           AssetChargeCategory?
  settlement               AssetLedgerSettlement
  registrationAdjustmentId String?                 @unique
  reason                   String
  actorUserId              String
  actorNameSnapshot        String
  idempotencyKey           String?
  /// A received deposit remembers the terms it was taken under, so a later edit of the kind never changes a deposit already held.
  depositShortfallSnapshot AssetDepositShortfall?
  replacementFeeSnapshotCents Int?
  /// A charge made after a deposit already kept money for the same loss is only the part above what the deposit kept.
  depositOffsetCents       Int                     @default(0)
  createdAt                DateTime                @default(now())

  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assetType    IssuedAssetType?        @relation(fields: [assetTypeId, eventId], references: [id, eventId], onDelete: NoAction)
  issuance     AssetIssuance?          @relation(fields: [issuanceId, eventId], references: [id, eventId], onDelete: NoAction)
  registration Registration?           @relation(fields: [registrationId], references: [id], onDelete: NoAction)
  adjustment   RegistrationAdjustment? @relation(fields: [registrationAdjustmentId], references: [id], onDelete: NoAction)
  depositEntry AssetLedgerEntry?       @relation("AssetDepositSettlement", fields: [depositEntryId, eventId], references: [id, eventId], onDelete: NoAction)
  settlements  AssetLedgerEntry[]      @relation("AssetDepositSettlement")
  waivesEntry  AssetLedgerEntry?       @relation("AssetChargeWaiver", fields: [waivesEntryId, eventId], references: [id, eventId], onDelete: NoAction)
  waivedBy     AssetLedgerEntry[]      @relation("AssetChargeWaiver")
  covers       AssetDepositCover[]

  @@unique([eventId, idempotencyKey])
  @@unique([id, eventId])
  @@index([eventId, createdAt])
  @@index([registrationId, createdAt])
  @@index([issuanceId])
}

/// The issuances a cash deposit covers (#214). An issuance is covered by at most one deposit, and whatever continues it
/// (a transfer, replacement or the remainder of a partial return) is covered by the same one. Insert-only.
model AssetDepositCover {
  issuanceId     String
  eventId        String
  depositEntryId String
  createdAt      DateTime @default(now())

  issuance AssetIssuance    @relation(fields: [issuanceId, eventId], references: [id, eventId], onDelete: NoAction)
  deposit  AssetLedgerEntry @relation(fields: [depositEntryId, eventId], references: [id, eventId], onDelete: NoAction)

  @@id([issuanceId])
  @@index([depositEntryId])
}

/// A problem with a room, site, item or place found at check-out or reported any time (#214). The issue is a ticket
/// (status, severity, assignee and resolution change); every change appends a full snapshot to FacilityIssueHistory.
/// `holdId` links the lodging hold that blocks the room, when staff blocked it: blocking never touches assignments.
model FacilityIssue {
  id               String                @id @default(cuid())
  eventId          String
  targetKind       FacilityTargetKind
  eventUnitId      String?
  assetId          String?
  targetLabel      String?
  title            String
  description      String?
  severity         FacilityIssueSeverity
  status           FacilityIssueStatus   @default(OPEN)
  source           FacilityIssueSource
  /// The issuance being checked out when an inspection found it.
  sourceIssuanceId String?
  assigneeUserId   String?
  resolution       String?
  holdId           String?
  reportedByUserId String
  reportedAt       DateTime              @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  revision         Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  event   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  unit    EventLodgingUnit?      @relation(fields: [eventUnitId, eventId], references: [id, eventId], onDelete: NoAction)
  asset   IssuedAsset?           @relation(fields: [assetId, eventId], references: [id, eventId], onDelete: NoAction)
  hold    EventLodgingHold?      @relation(fields: [holdId, eventId], references: [id, eventId], onDelete: NoAction)
  history FacilityIssueHistory[]

  @@unique([id, eventId])
  @@index([eventId, status])
  @@index([eventUnitId])
}

/// Append-only: one row per change to a facility issue, with the fields as they were after it.
model FacilityIssueHistory {
  id             String                   @id @default(cuid())
  eventId        String
  issueId        String
  type           FacilityIssueHistoryType
  at             DateTime                 @default(now())
  actorUserId    String
  status         FacilityIssueStatus
  severity       FacilityIssueSeverity
  assigneeUserId String?
  note           String?
  holdId         String?
  revision       Int

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issue FacilityIssue @relation(fields: [issueId, eventId], references: [id, eventId], onDelete: Cascade)

  @@index([issueId, at])
}

// ---------------------------------------------------------------------------
// Meals (#210): services, plans, pricing, selections and the meal ledger.
// A selection is what was ordered or entitled. Redemption (#211) and kitchen
// counts and preparation (#212) are separate and never live in these tables.
// ---------------------------------------------------------------------------

enum MealType {
  BREAKFAST
  LUNCH
  SUPPER
  SNACK
  OTHER
}

enum MealServiceStatus {
  ACTIVE
  CANCELLED
}

enum MealTicketing {
  TICKETED
  /// No ticket is sold (Camp Meeting Sabbath lunch). Nothing can be selected for it.
  DONATION_ONLY
}

enum MealPayer {
  ATTENDEE
  /// Staff, pastor and volunteer meals the conference pays for (#804): the attendee is never charged.
  CONFERENCE
}

enum MealAgeGroup {
  ADULT
  CHILD
}

enum MealEntitlement {
  PAID
  INCLUDED
}

enum MealSelectionStatus {
  ACTIVE
  CANCELLED
}

enum MealSelectionSource {
  REGISTRATION_FORM
  STAFF
  WALK_UP
  PLAN_ASSIGNMENT
}

enum MealChangeType {
  CREATED
  QUANTITY_CHANGED
  PLAN_CHANGED
  SUBSTITUTED
  CANCELLED
  SERVICE_CANCELLED
}

enum MealServiceChangeType {
  CREATED
  UPDATED
  CANCELLED
  REINSTATED
}

enum MealLedgerKind {
  CHARGE
  CREDIT
}

enum MealSettlement {
  /// Already inside the registration's priced total (the registration form priced it).
  IN_REGISTRATION_PRICING
  /// Posted to the registration as a MEAL adjustment line.
  REGISTRATION_ADJUSTMENT
  /// Paid or voided at the counter by staff (walk-up order); no registration.
  AT_COUNTER
  /// The registration is cancelled or waitlisted, so nothing is posted to it; the credit is on the ledger only.
  REGISTRATION_NOT_LIVE
}

/// One meal occurrence: a date, a serving window, a place and a capacity. Dates and times are event-local text
/// (YYYY-MM-DD, HH:mm), so they never shift with a time zone. Cancelling keeps the row and its history.
model EventMealService {
  id              String            @id @default(cuid())
  eventId         String
  name            String
  mealType        MealType
  serviceDate     String
  startTime       String
  endTime         String?
  location        String?
  ticketing       MealTicketing     @default(TICKETED)
  capacity        Int?
  status          MealServiceStatus @default(ACTIVE)
  cancelledAt     DateTime?
  cancelReason    String?
  position        Int               @default(0)
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  event      Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  changes    EventMealServiceChange[]
  planLinks  EventMealPlanService[]
  selections EventMealSelection[]
  ledger     EventMealLedgerEntry[]

  @@unique([eventId, serviceDate, name])
  @@index([eventId, serviceDate, startTime])
  @@index([eventId, status])
}

/// Append-only history of a service: created, edited, cancelled, reinstated, with who and why.
model EventMealServiceChange {
  id          String                @id @default(cuid())
  eventId     String
  serviceId   String
  type        MealServiceChangeType
  actorUserId String?
  reason      String?
  before      Json?
  after       Json?
  createdAt   DateTime              @default(now())

  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service EventMealService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@index([eventId, createdAt])
}

/// A named bundle of meals with a payer. An ATTENDEE plan sells tickets at its prices; a CONFERENCE plan entitles
/// people to meals the conference pays for. `isDefaultTicketPlan` marks the plan registration-form tickets use.
model EventMealPlan {
  id                  String          @id @default(cuid())
  eventId             String
  code                String
  name                String
  description         String          @default("")
  payer               MealPayer       @default(ATTENDEE)
  isDefaultTicketPlan Boolean         @default(false)
  /// Every ticketed service of the event is covered, at `defaultEntitlement`, unless a plan service row says otherwise.
  includesAllServices Boolean         @default(false)
  defaultEntitlement  MealEntitlement @default(PAID)
  isActive            Boolean         @default(true)
  position            Int             @default(0)
  createdByUserId     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  event      Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  services   EventMealPlanService[]
  prices     EventMealPrice[]
  selections EventMealSelection[]

  @@unique([eventId, code])
  @@index([eventId, isActive, position])
}

/// A plan's entry for one service: PAID tickets or INCLUDED (complimentary).
model EventMealPlanService {
  id          String          @id @default(cuid())
  eventId     String
  planId      String
  serviceId   String
  entitlement MealEntitlement @default(PAID)
  createdAt   DateTime        @default(now())

  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plan    EventMealPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service EventMealService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceId])
  @@index([eventId])
  @@index([serviceId])
}

/// What a plan charges per meal type for an age group or an attendee type (a price for an attendee type wins;
/// zero makes that role complimentary). Under a CONFERENCE plan the amount is the rate the conference is billed
/// per meal used (read by #212); the attendee is never charged. A selection copies the amount, so editing a price
/// never rewrites a past order.
model EventMealPrice {
  id              String        @id @default(cuid())
  eventId         String
  planId          String
  mealType        MealType
  ageGroup        MealAgeGroup?
  attendeeTypeId  String?
  amountCents     Int
  updatedByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plan         EventMealPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  attendeeType EventAttendeeType? @relation(fields: [attendeeTypeId], references: [id], onDelete: Cascade)

  /// The migration adds partial unique indexes (one price per plan, meal type and age group, or attendee type) and a
  /// check that exactly one of age group and attendee type is set.
  @@index([planId, mealType])
  @@index([eventId])
  @@index([attendeeTypeId])
}

/// What was ordered or entitled: `quantity` meals of a type for an age group under a plan, optionally pinned to one
/// service (an unpinned selection is a ticket good for any service of that meal type, which is how Camp Meeting
/// sells them). Never a redemption or a preparation count. Price, plan, payer and source form version are copied
/// here when it is made. Rows are never deleted; a change is a new EventMealSelectionChange.
model EventMealSelection {
  id                     String              @id @default(cuid())
  eventId                String
  planId                 String
  mealType               MealType
  serviceId              String?
  registrationId         String?
  registrationAttendeeId String?
  ageGroup               MealAgeGroup
  attendeeTypeCode       String?
  quantity               Int
  status                 MealSelectionStatus @default(ACTIVE)
  source                 MealSelectionSource
  payer                  MealPayer
  unitPriceCents         Int
  /// The plan price a conference-paid selection would be billed at, per meal, when it is used (#212). Zero otherwise.
  conferenceRateCents    Int                 @default(0)
  pricingSnapshot        Json
  sourceFormVersionId    String?
  sourceFieldKey         String?
  /// Configured, non-medical dietary categories only (see modules/meals/domain.ts). Never allergies or accommodation notes.
  dietaryCategories      String[]            @default([])
  /// A short label for a walk-up order. Never a medical or personal detail.
  orderLabel             String?
  clientRequestId        String?
  replacesSelectionId    String?
  createdByUserId        String?
  cancelledAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  event        Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plan         EventMealPlan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  service      EventMealService?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  registration Registration?              @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     RegistrationAttendee?      @relation(fields: [registrationAttendeeId], references: [id], onDelete: SetNull)
  changes      EventMealSelectionChange[]
  ledger       EventMealLedgerEntry[]
  tickets      EventMealTicket[]

  /// The migration adds: one active selection per registration, attendee, meal type, service and age group; a
  /// unique client request id per event; and checks on quantity, price and the walk-up shape.
  @@index([eventId, status, mealType])
  @@index([registrationId, status])
  @@index([registrationAttendeeId])
  @@index([serviceId, status])
  @@index([planId])
}

/// One café ticket (#916): a unit of an active selection, with a number that is unique within the event and is never
/// reused. A quantity increase adds tickets with new numbers; a decrease or cancellation sets `cancelledAt` on the
/// highest-numbered active ones. Numbers come from the sequence "EventMealTicket_number_seq" (see the migration), so no event-wide row is written.
model EventMealTicket {
  id          String    @id @default(cuid())
  eventId     String
  selectionId String
  number      Int
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selection   EventMealSelection    @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  redemptions EventMealRedemption[]

  @@unique([eventId, number])
  @@index([selectionId, cancelledAt])
}

enum MealScannerSource {
  /// The Google Sheet the café scanner syncs with, downloaded as CSV: our own export with redeemed columns filled in.
  SHEET
  /// The scanner's own `transactions.csv` (no ticket id; matched by registration, guest, meal and local date).
  TRANSACTIONS
}

enum MealRedemptionKind {
  REDEEMED
  /// A correction: staff accepted a later file that showed the ticket as not redeemed.
  UNREDEEMED
}

/// One accepted upload of café scanner results (#1028). Append-only; only a confirmed upload that adds events makes one.
/// Holds ids and counts, never file content or names.
model EventMealImportBatch {
  id               String            @id @default(cuid())
  eventId          String
  uploadedByUserId String
  source           MealScannerSource
  fileName         String
  fileSha256       String
  rowCount         Int
  redeemedCount    Int
  unredeemedCount  Int
  reviewCount      Int
  createdAt        DateTime          @default(now())

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  redemptions EventMealRedemption[]

  @@index([eventId, createdAt])
}

/// Append-only record that a café ticket was served (REDEEMED) or that staff corrected that (UNREDEEMED). A ticket's
/// current state is its latest event. `sourceKey` is unique per event, so importing the same row again adds nothing.
model EventMealRedemption {
  id             String             @id @default(cuid())
  eventId        String
  ticketId       String
  batchId        String
  kind           MealRedemptionKind
  /// When the scanner served the meal (UNREDEEMED: when staff accepted the correction).
  occurredAt     DateTime
  /// The scanner's own `redeemed_by` text, as it wrote it.
  redeemedByText String?
  sourceKey      String
  createdAt      DateTime           @default(now())

  event  Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket EventMealTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  batch  EventMealImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([eventId, sourceKey])
  @@index([ticketId, createdAt])
  @@index([batchId])
}

/// Never holds a row (#920). A public registration submission locks this table (`LOCK TABLE ... IN EXCLUSIVE MODE`) as the
/// first statement of its SERIALIZABLE transaction, so simultaneous submissions queue instead of aborting each other:
/// the lock wait must happen before the transaction's snapshot is taken, and a table lock is the one lock that can
/// (`pg_advisory_xact_lock` is a query, so it takes the snapshot first). See docs/MEALS.md, "Simultaneous submissions".
model PublicSubmissionGate {
  id Int @id
}

/// Append-only history of a selection: every creation, quantity change, plan change, substitution and
/// cancellation, with who did it, why, and the selection before and after.
model EventMealSelectionChange {
  id          String         @id @default(cuid())
  eventId     String
  selectionId String
  type        MealChangeType
  actorUserId String?
  actorName   String
  reason      String?
  before      Json?
  after       Json
  createdAt   DateTime       @default(now())

  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selection EventMealSelection     @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  ledger    EventMealLedgerEntry[]

  @@index([selectionId, createdAt])
  @@index([eventId, createdAt])
}

/// Append-only meal charges and credits. A cancellation or a lower quantity is a CREDIT at the price that was
/// charged; nothing is edited. `settlement` says where the money went: already in the registration's priced total,
/// a MEAL adjustment line, or the counter (walk-up). The sum of a registration's entries is its meal total.
model EventMealLedgerEntry {
  id                       String         @id @default(cuid())
  eventId                  String
  selectionId              String
  changeId                 String
  registrationId           String?
  serviceId                String?
  mealType                 MealType
  ageGroup                 MealAgeGroup
  kind                     MealLedgerKind
  quantity                 Int
  unitPriceCents           Int
  amountCents              Int
  payer                    MealPayer
  settlement               MealSettlement
  registrationAdjustmentId String?        @unique
  reason                   String?
  createdAt                DateTime       @default(now())

  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selection    EventMealSelection       @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  change       EventMealSelectionChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  registration Registration?            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  service      EventMealService?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  adjustment   RegistrationAdjustment?  @relation(fields: [registrationAdjustmentId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([registrationId, createdAt])
  @@index([selectionId])
}

/// A shared form template whose content is seeded data, not source (#153): the
/// Women's Retreat, Camp Meeting and Spring Camporee registration forms. The
/// content lives in `prisma/seed-data/form-templates/*.json`; `npm run
/// form-templates:sync` brings this row to the file's `version` (the same
/// versioned-template pattern as `ClubFormTemplate` and `LodgingProperty`).
/// New forms are created from this row, and creating one copies the
/// definition into the new form's own `RegistrationFormVersion`, so a later
/// version here never reaches a form or event that already exists.
model SeededFormTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  /// The latest version number. Code sync bumps it from the seed file's version while `latestSource` is CODE; each app save adds one (#1064).
  version     Int
  name        String
  description String   @default("")
  audience    String
  definition  Json
  /// Where the latest version came from (#1064). `form-templates:sync` updates a template only while this is CODE;
  /// once a system administrator saves it in the app it is APP and sync never changes it again.
  latestSource FormTemplateSource @default(CODE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions SeededFormTemplateVersion[]
}

/// Where a form template version came from (#1064): the code (`form-templates:sync`) or a system administrator's save in the app.
enum FormTemplateSource {
  CODE
  APP
}

/// A frozen copy of one version of a seeded form template (#153), added by
/// sync each time a version is applied and never changed or removed, so what a
/// form was created from can always be read back.
model SeededFormTemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  version     Int
  name        String
  description String   @default("")
  audience    String
  definition  Json
  /// Whether sync (CODE) or a system administrator (APP) wrote this version (#1064).
  source      FormTemplateSource @default(CODE)
  /// The system administrator who saved an APP version; null for CODE versions. A plain id, like ClubFormTemplateVersion's.
  createdByUserId String?
  createdAt   DateTime @default(now())

  template SeededFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  formsCreatedFrom  RegistrationForm[] @relation("RegistrationFormSourceTemplateVersion")
  formsDismissed    RegistrationForm[] @relation("RegistrationFormDismissedTemplateVersion")
  informationFormsCreatedFrom InformationForm[] @relation("InformationFormSourceTemplateVersion")

  @@unique([templateId, version])
}

enum GeneralLinkSubmissionStatus {
  /// Waiting for staff to confirm or reassign the club. Holds no registration, seat, invoice line or check-in record.
  PENDING
  /// Attached to a club as an ordinary club registration (`registrationId`).
  CONFIRMED
  /// Refused by staff, with a reason. The submitted answers are removed.
  REJECTED
  /// Nobody resolved it by 30 days after the event ended: the retention sweep removed the submitted answers.
  EXPIRED
}

enum GeneralLinkResolution {
  /// The submitted director email matched a current director or deputy of the club the director picked.
  AUTO_EMAIL_MATCH
  /// Staff confirmed the club the director picked.
  STAFF_CONFIRMED
  /// Staff attached it to a different club than the one picked ("Not listed" included).
  STAFF_REASSIGNED
  STAFF_REJECTED
  /// The retention sweep removed a still-waiting submission's answers after the event.
  RETENTION_EXPIRED
}

/// A team registered through an event's general registration link (#931), with no account. A submission whose director
/// email matches a current director or deputy of the picked club is created already CONFIRMED, in the same transaction as
/// its club registration. Any other waits here as PENDING: it is NOT a Registration, so it is in no club count, invoice,
/// report or check-in list until staff confirm or reassign the club, which runs the ordinary club submission once and
/// links it (`registrationId`). While PENDING it keeps the validated answers (`payload`, including the team members'
/// names and ages) for staff only; the payload is cleared the moment the row is resolved.
model GeneralLinkSubmission {
  id                      String                      @id @default(cuid())
  eventId                 String
  status                  GeneralLinkSubmissionStatus @default(PENDING)
  resolution              GeneralLinkResolution?
  confirmationCode        String                      @unique
  /// The director's own submission key: a retried POST replays this row.
  idempotencyKey          String
  requestHash             String
  /// The club as the director named it: a directory club's name, or the typed name for "Not listed".
  clubNameAsEntered       String
  /// The directory club the director picked, if it was one; null for "Not listed". Only a suggestion until resolved.
  suggestedOrganizationId String?
  /// The club the team belongs to once resolved.
  organizationId          String?
  /// The submitted director email, normalized (trimmed, lowercase).
  directorEmail           String
  directorName            String
  teamName                String
  /// The normalized team name; unique among PENDING submissions of an event, like a registered team's key.
  teamKey                 String
  locationId              String?
  attendeeCount           Int
  /// The validated request (answers and typed-in people), while PENDING only; cleared when resolved.
  payload                 Json?
  registrationId          String?                     @unique
  rejectReason            String?
  resolvedByUserId        String?
  resolvedAt              DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  event                 Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  suggestedOrganization Organization?  @relation("GeneralLinkSubmissionSuggestedClub", fields: [suggestedOrganizationId], references: [id], onDelete: SetNull)
  organization          Organization?  @relation("GeneralLinkSubmissionClub", fields: [organizationId], references: [id], onDelete: SetNull)
  location              EventLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  registration          Registration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  resolvedBy            User?          @relation("GeneralLinkSubmissionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, idempotencyKey])
  @@index([eventId, status, createdAt])
}

/// An event's scholarship fund (#398): one per event, and nothing carries over
/// to another event or year. Contributions record money received from a church
/// or a sponsor; awards are scholarship adjustment lines (#396) that draw on it.
/// This records money; it never moves any.
model ScholarshipFund {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())

  event         Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contributions ScholarshipContribution[]
  awards        ScholarshipAward[]

  /// Lets contributions and awards prove they belong to the fund's own event.
  @@unique([id, eventId])
}

enum ScholarshipContributionMethod {
  CASH
  CHECK
  CARD
  BANK_TRANSFER
  OTHER
}

/// Money received into an event's fund, in integer cents. Lines are never
/// edited: a mistake is cancelled by a negative reversal line pointing at the
/// original. `sponsorKey` groups lines for matching: the directory
/// organization's id, else the normalized free-text name.
model ScholarshipContribution {
  id                     String                        @id @default(cuid())
  eventId                String
  fundId                 String
  organizationId         String?
  sponsorName            String
  sponsorKey             String
  amountCents            Int
  receivedOn             DateTime                      @db.Date
  method                 ScholarshipContributionMethod
  /// A check number or short note; for a reversal, the reason.
  note                   String?
  reversesContributionId String?                       @unique
  createdByUserId        String?
  createdByNameSnapshot  String
  createdAt              DateTime                      @default(now())

  fund         ScholarshipFund          @relation(fields: [fundId, eventId], references: [id, eventId], onDelete: Cascade)
  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reverses     ScholarshipContribution? @relation("ScholarshipContributionReversal", fields: [reversesContributionId], references: [id], onDelete: Restrict)
  reversedBy   ScholarshipContribution? @relation("ScholarshipContributionReversal")

  @@index([fundId, receivedOn])
  @@index([fundId, sponsorKey])
}

/// One scholarship adjustment line that draws on the fund. It counts against
/// the fund only while its adjustment line has not been reversed. A funded
/// award cannot take the fund below zero; a pledged one (`pledged` and not yet
/// `settledAt`) is promised money that has not arrived, so it can exceed the
/// balance and shows as outstanding for its sponsor until staff settle it.
model ScholarshipAward {
  id              String    @id @default(cuid())
  eventId         String
  fundId          String
  registrationId  String
  adjustmentId    String    @unique
  /// Positive cents; the adjustment line itself is negative.
  amountCents     Int
  pledged         Boolean   @default(false)
  organizationId  String?
  sponsorName     String?
  sponsorKey      String?
  settledAt       DateTime?
  settledByUserId String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  fund         ScholarshipFund        @relation(fields: [fundId, eventId], references: [id, eventId], onDelete: Cascade)
  registration Registration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  adjustment   RegistrationAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([fundId, sponsorKey])
  @@index([registrationId])
}

/// Which group a personal staff invitation puts its registration in (#804). Shown beside the registration wherever staff look at it.
enum StaffInvitationGroup {
  STAFF
  PASTOR
  VOLUNTEER
}

/// The office's decision on a registration made through a personal staff invitation (#804). The registration itself is a
/// DRAFT (not a confirmed one) until it is APPROVED, so a waiting one is in no count, report or room list.
enum StaffInvitationApproval {
  WAITING
  APPROVED
  DECLINED
}

/// A personal registration link for one person at one event (#804), made in bulk from a CSV of email addresses. One link per
/// email: it allows exactly one registration (the person plus their eligible family), always for $0, and it waits for the
/// office to approve it. The link is never stored. It is derived from this row's id and `linkVersion` (HMAC with the
/// private-link secret), so the office can copy it again, and reissuing bumps `linkVersion` and makes every earlier copy
/// useless. Invitations are only ever emailed by a person pressing Send; `lastMessageId` is the latest message queued.
model StaffInvitation {
  id              String                   @id @default(cuid())
  eventId         String
  /// The invited address, normalized (trimmed, lowercase). One live (not superseded) invitation per address per event.
  email           String
  firstName       String                   @default("")
  lastName        String                   @default("")
  group           StaffInvitationGroup
  linkVersion     Int                      @default(1)
  /// Which import created it (one id per confirmed CSV), so the office can find a file's rows together.
  importBatchId   String?
  createdByUserId String?
  /// The latest time a person queued this invitation's email, how many times, and the message (its delivery status is the invitation's).
  sentAt          DateTime?
  sendCount       Int                      @default(0)
  lastMessageId   String?
  revokedAt       DateTime?
  /// The registration made through the link; set exactly once, in the same transaction that creates it.
  registrationId  String?                  @unique
  registeredAt    DateTime?
  approval        StaffInvitationApproval?
  decidedAt       DateTime?
  decidedByUserId String?
  /// What the invited person said about housing when registering: whether they need on-site housing, and a short note.
  needsHousing    Boolean?
  housingNote     String                   @default("")
  /// Set when the office re-invited this person after a decline (#1027): a new invitation row carries the address from then on, and
  /// this one stays as history with its declined registration. A superseded link never opens.
  supersededAt    DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  lastMessage  MessageOutbox? @relation(fields: [lastMessageId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("StaffInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  decidedBy    User?          @relation("StaffInvitationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  /// The migration adds a partial unique index: one invitation per address per event among those not superseded.
  @@index([eventId, email])
  @@index([eventId, group])
  @@index([eventId, approval])
  @@index([lastMessageId])
}

enum MealCloseoutReviewStatus {
  ACKNOWLEDGED
  REOPENED
}

/// Append-only staff review of one meal closeout exception (#212). `exceptionKey` names the exception (a code and its scope);
/// the latest row of a key is its current review. `detailDigest` is a hash of the exception's figures when it was reviewed,
/// so an exception whose figures changed afterwards reads as open again. Records a decision only: nothing here moves money,
/// edits a charge, a credit or a count, or issues a refund.
model EventMealCloseoutReview {
  id              String                     @id @default(cuid())
  eventId         String
  exceptionKey    String
  status          MealCloseoutReviewStatus
  detailDigest    String
  note            String
  reviewedByUserId String
  createdAt       DateTime                   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, exceptionKey, createdAt])
}

enum MealKitchenCountKind {
  PREPARED
  WASTED
  DONATED
  TRANSFERRED
}

/// Append-only kitchen-entered count for one meal service (#1029). A correction is a new row whose `supersedesId` names the
/// row it replaces; the latest row of a (service, kind) chain is the current figure and every earlier row stays visible.
/// `serviceDate` is empty for a ticket good on any day (same convention as the served report). Never touches redemptions.
model EventMealKitchenCount {
  id              String               @id @default(cuid())
  eventId         String
  serviceDate     String
  mealType        MealType
  kind            MealKitchenCountKind
  quantity        Int
  note            String?
  enteredByUserId String
  supersedesId    String?              @unique
  createdAt       DateTime             @default(now())

  event      Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supersedes EventMealKitchenCount? @relation("KitchenCountSupersedes", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy EventMealKitchenCount? @relation("KitchenCountSupersedes")

  @@index([eventId, serviceDate, mealType, kind, createdAt])
}

/// An easy-to-read PDF copy of a registration (#1082). One row per version: version 1 is made when the registration is
/// submitted, and a later change by a director or staff adds the next version, marked "Updated". The bytes are a stored
/// `MessageAttachment`, made once and never regenerated, so every email and download of a version is the same file;
/// `sha256` is the hash of that file, checked again at send and at download. `contentHash` is the hash of what the PDF
/// SAYS (no dates or version marks), so a save that changes nothing visible does not add a version.
model RegistrationPdfDocument {
  id               String   @id @default(cuid())
  eventId          String
  registrationId   String
  version          Int
  attachmentId     String   @unique
  sha256           String
  contentHash      String
  /// The layout version of the generator, so a later layout change is visible on old documents.
  generatorVersion Int
  /// The published form version the registration was on when this copy was made (#1044/#1050).
  formVersionId    String?
  /// True from version 2 on: the PDF carries the "Updated" mark.
  updated          Boolean  @default(false)
  createdAt        DateTime @default(now())

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attachment   MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([registrationId, version])
  @@index([eventId])
}

/// One email notification of a registration form (#1081): who is told when someone registers, optionally only when one
/// answer matches (`conditionFieldKey` is a registration-level field key, or `__location` with a location id), and
/// optionally with only some of the form's sections in its PDF (`sectionIds`, empty = all). Staff-typed addresses only.
model RegistrationFormNotification {
  id                String   @id @default(cuid())
  formId            String
  position          Int
  name              String
  recipients        String[]
  conditionFieldKey String?
  /// EQUALS or NOT_EQUALS ("is" / "is not"), the existing field condition shape.
  conditionOperator String?
  conditionValue    String?
  sectionIds        String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  form       RegistrationForm                   @relation(fields: [formId], references: [id], onDelete: Cascade)
  deliveries RegistrationNotificationDelivery[]

  @@index([formId, position])
}

/// What a notification last sent for one registration (#1081): the hash of what its included sections said, so a later
/// change is re-sent only when that content changed. No addresses or answers are stored here.
model RegistrationNotificationDelivery {
  id               String   @id @default(cuid())
  notificationId   String
  registrationId   String
  contentHash      String
  /// The included sections when it was sent, so editing the notification's sections starts a new baseline, not an "Updated".
  sectionSignature String
  sendCount        Int      @default(1)
  lastSentAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  notification RegistrationFormNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  registration Registration                 @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, registrationId])
  @@index([registrationId])
}

/// A saved question (#1070): reusable question configuration kept in the question library. `definition` is a
/// fragment (`{ fields: [...] }`) validated with the form definition's own field schema; it holds configuration only,
/// never answers, registrations, people or any other operational record. Adding one to a form inserts an independent
/// copy with fresh ids and keys, so an edit or delete here never touches an inserted question or a published version.
/// Anyone who can build forms may save and add; only system administrators rename, edit or delete (archive).
model QuestionLibraryItem {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  definition  Json
  /// The user who saved it. A plain id (like SeededFormTemplateVersion's), so removing a user never blocks or erases the item.
  createdByUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set when an administrator deletes the item: it leaves the library but the row stays for the audit trail.
  archivedAt  DateTime?

  @@index([archivedAt, name])
}
