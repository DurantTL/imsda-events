generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SYSTEM_ADMIN
}

/// An invited account holds an unusable random hash until its owner activates
/// it. Without this the schema cannot tell that account apart from a live one.
enum UserAccountStatus {
  PENDING_ACTIVATION
  ACTIVE
}

enum AccountTokenPurpose {
  PASSWORD_RESET
  ACCOUNT_ACTIVATION
}

enum EventRole {
  EVENT_ADMIN
  REGISTRATION_MANAGER
  FINANCE_MANAGER
  COMMUNICATIONS_MANAGER
  CHECK_IN_STAFF
  READ_ONLY_STAFF
