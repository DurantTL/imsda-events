  MANAGE_FINANCE
  MANAGE_COMMUNICATIONS
  MANAGE_CHECK_IN
  VIEW_REPORTS
  MANAGE_STAFF
  VIEW_SENSITIVE_DATA
  MANAGE_IMPORTS
  MANAGE_FORMS
}

