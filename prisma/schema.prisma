generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SYSTEM_ADMIN
}

/// An invited account holds an unusable random hash until its owner activates
/// it. Without this the schema cannot tell that account apart from a live one.
enum UserAccountStatus {
  PENDING_ACTIVATION
  ACTIVE
}

enum AccountTokenPurpose {
  PASSWORD_RESET
  ACCOUNT_ACTIVATION
}

enum EventRole {
  EVENT_ADMIN
  REGISTRATION_MANAGER
  FINANCE_MANAGER
  COMMUNICATIONS_MANAGER
  CHECK_IN_STAFF
  READ_ONLY_STAFF
  /// Kitchen staff (#1029): enter prepared, wasted, donated and transferred counts. Holds no registration or people access.
  KITCHEN_STAFF
}

enum EventPermission {
  VIEW_EVENT
  CONFIGURE_EVENT
  MANAGE_REGISTRATION
  MANAGE_FINANCE
  MANAGE_COMMUNICATIONS
  MANAGE_CHECK_IN
  VIEW_REPORTS
  MANAGE_STAFF
  VIEW_SENSITIVE_DATA
  MANAGE_IMPORTS
  MANAGE_FORMS
  /// Allergies (as entered), emergency contacts and the medical-need flag for
  /// club event attendees (#658, ADR 0005 Addendum C). Never part of a role:
  /// only a system administrator grants it, one membership at a time.
  VIEW_HEALTH_INFORMATION
  /// Finalizing a deferred-organization invoice (#167, ADR 0008): assigns its number and commits the
  /// conference to the amount. Never part of a role (Event Admin and MANAGE_FINANCE do not include
  /// it): a system administrator has it everywhere and grants it to named people one membership at a time.
  FINALIZE_INVOICES
  /// Enter the kitchen's own meal counts (#1029). Carried by the Kitchen staff role and Event Admin; opens no registration or people page.
  MANAGE_KITCHEN_COUNTS
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

/// CHURCH and CLUB predate the eAdventist organizations import (#649) and keep
/// their meaning everywhere. The rest are the kinds that import brings in:
/// COMPANY and GROUP are congregations that are not yet organized churches.
enum OrganizationType {
  CHURCH
  CLUB
  COMPANY
  GROUP
  SCHOOL
  EARLY_CHILDHOOD
  BOOKSTORE
  COMMUNITY_CENTER
  CAMP
  CONFERENCE
  ASSOCIATION
}

/// A person's authority over one club (#354, #375). DEPUTY carries the same
/// club access as DIRECTOR. REGISTRAR keeps the roster and registers for
/// events but sees ages, never full birth dates. REPORTER submits monthly
/// reports only. Order matters: the first role listed wins when one person
/// holds two.
enum ClubDirectorRole {
  DIRECTOR
  DEPUTY
  REGISTRAR
  REPORTER
}

/// Pathfinder class level on a club roster (#375). No level is stored as null.
enum ClubClassLevel {
  FRIEND
  COMPANION
  EXPLORER
  RANGER
  VOYAGER
  GUIDE
  TLT
  MASTER_GUIDE
}

enum ExternalSystem {
  EADVENTIST
  ULTRACAMP
  STERLING
  CMMS
  WR26
  /// The old website's Fluent Forms entries (#376). Scope is `form-<id>:<club year>`.
  FLUENT_FORMS
  /// A background check roster import's `user_id` (#427), so a later upload
  /// matches the same person by id first instead of by name again.
  ROSTER_IMPORT
}

/// How an account-to-person link was established. Recorded on the link
/// itself so the link's provenance survives independently of whoever reads
/// it later — see `AttendeeAccountPersonLink` and `UserPersonLink`.
enum PersonLinkProvenance {
  /// The account holder verified their own identity (e.g. matched and
  /// confirmed a prefilled record) without staff involvement.
  SELF_SERVICE_VERIFICATION
  /// A staff member established the link directly.
  STAFF_ACTION
  /// The link was produced by a data import.
  IMPORT
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum RegistrationAccessTokenPurpose {
  MANAGE_REGISTRATION
}

enum RegistrationOperationType {
  TRANSFER
  ATTENDEE_SUBSTITUTION
  AMENDMENT
}

enum WaitlistEntryStatus {
  WAITING
  PROMOTED
  REMOVED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

enum PaymentMethod {
  CARD_REFERENCE
  CASH
  CHECK
  MANUAL
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentAttemptStatus {
  PROCESSING
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

/// How the payer reaches Square for an attempt (#327): the embedded Web Payments form, or Square's
/// own hosted checkout page ("Pay on Square"). Both write the same payment, receipt, and surcharge path.
enum PaymentAttemptChannel {
  EMBEDDED
  HOSTED_LINK
}

/// CREATING: the attempt exists but Square has not confirmed the link yet. ACTIVE: payable. PAID: a
/// payment arrived through it (a duplicate is still PAID; the money was taken). INVALIDATED: this
/// app has withdrawn it; `providerDeletedAt` says whether Square has been told. FAILED: Square
/// refused to create it.
enum SquareHostedCheckoutStatus {
  CREATING
  ACTIVE
  PAID
  INVALIDATED
  FAILED
}

enum SquareDuplicateChargeStatus {
  OPEN
  RESOLVED
}

enum RegistrationPaymentChoice {
  CARD
  PAY_LATER
}

/// Deliberately distinct from `RegistrationStatus` (issue #144): a merchandise
/// order's lifecycle never stands in for a registration's, even when the same
/// person owns both.
enum MerchandiseOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum MerchandiseInventoryPolicy {
  UNLIMITED
  TRACKED
}

enum MerchandiseTaxTreatment {
  TAXABLE
  TAX_EXEMPT
}

/// Who bears the card-processing fee on a merchandise order, mirroring the
/// absorbed/passed-through choice `RegistrationPaymentChoice` makes for
/// registrations.
enum MerchandiseFeePolicy {
  ABSORBED_BY_EVENT
  PASSED_TO_BUYER
}

enum MerchandiseCatalogStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}

/// ATTENDEE_PAY is the existing behavior: attendees choose a payment method and
/// may owe an online balance. DEFERRED_ORGANIZATION_INVOICE is for club/church
/// group registrations (e.g. Spring Camporee): no attendee balance or online
/// payment is created, and the responsible organization is billed later based
/// on final attendance. See issue #143.
enum EventBillingMode {
  ATTENDEE_PAY
  DEFERRED_ORGANIZATION_INVOICE
}

/// How a deferred-invoice event groups registrations on invoices (#165):
/// PER_CHURCH puts every club of one sponsoring church on that church's
/// invoice (each club its own line); PER_CLUB gives each club its own invoice.
enum InvoiceGrouping {
  PER_CHURCH
  PER_CLUB
}

/// Where an organization billing contact came from (#165). Only office staff
/// enter one for now; it is never inferred from an email domain, a form answer,
/// the club director, or the submitter.
enum BillingContactSource {
  STAFF_ENTERED
}

/// Kinds of non-billing church contact (#977). A treasurer is the billing contact and lives in
/// `OrganizationBillingContact`; this table never feeds invoice recipient resolution.
enum OrganizationContactKind {
  PASTOR
}

enum BillingResponsibleKind {
  ORGANIZATION
  PERSON
  UNRESOLVED
}

/// How a registration's responsible party was decided (#165). STAFF_* rows are
/// human decisions and survive re-resolution; the rest are derived by rule.
enum BillingResponsibilitySource {
  CLUB_SPONSORING_CHURCH
  GROUP_BILLING_PERSON
  UNRESOLVED_CLUB_HAS_NO_CHURCH
  UNRESOLVED_NO_ORGANIZATION_LINKED
  STAFF_LINKED
  STAFF_OVERRIDE
}

enum BillingResponsibilityChangeType {
  RESOLVED
  RE_RESOLVED
  STAFF_LINKED
  STAFF_OVERRIDE
  OVERRIDE_CLEARED
}

/// How a guardian-authority declaration was made (#131). Authority is only ever declared, never inferred.
enum GuardianAuthoritySource {
  REGISTRATION_FORM
  /// The registrant changed it from their private registration page (the manage link).
  MANAGE_LINK
  STAFF
}

enum GuardianAuthorityState {
  ACTIVE
  REVOKED
  SUPERSEDED
}

enum GuardianAuthorityConflictState {
  OPEN
  RESOLVED
}

/// A staff correction of who actually attended (#166). CLEAR withdraws an earlier correction so the
/// check-in record decides again.
enum AttendanceCorrectionKind {
  MARK_ATTENDED
  MARK_NOT_ATTENDED
  CLEAR
}

/// What staff chose to bill for a registration whose prices cannot be matched to people with certainty (#166).
enum AttendanceReviewChoice {
  PER_PERSON
  PRORATED
}

enum AttendanceReconciliationStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum SquareWebhookEventStatus {
  PROCESSED
  IGNORED
}

/// Explicit event audience (#481): GENERAL is the default; CLUB marks a
/// Pathfinder/club or church event. Independent of `billingMode` — a CLUB
/// event may still be attendee-paid (e.g. Man Camp) — so club and church
/// navigation, club registration oversight, and club reports key off this
/// field rather than inferring "club event" from deferred-organization
/// billing.
enum EventAudience {
  GENERAL
  CLUB
}

enum PromoDiscountType {
  FIXED_CENTS
  PERCENT_BPS
}

/// An `EventTemplate`'s lifecycle (#152), independent of its versions' own
/// `EventTemplateVersion.status`: a template stays DRAFT or PUBLISHED until a
/// staff member archives it, which hides it from "Start from template"
/// without touching events already applied from it.
enum EventTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

/// What an announcement opt-out covers (#838): one event's announcements, or every IMSDA Events announcement.
enum EmailAnnouncementOptOutScope {
  EVENT
  ALL
}

enum CommunityPostStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum CommunityReportReason {
  CONDUCT
  HARASSMENT
  PRIVACY
  SPAM
  OTHER
}

enum CommunityReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CommunityNotificationPreference {
  NONE
  REPLIES
  ALL
}

enum CommunityNotificationKind {
  NEW_POST
  REPLY
}

/// What a section of an event page holds. Two kinds cover the pages IMSDA
/// publishes today: prose (lodging, notes, who to contact) and a row of
/// resources (a flyer, a schedule, a link back to a ministry page).
enum EventContentSectionKind {
  RICH_TEXT
  RESOURCE_LINKS
  /// An info card: a titled plain-text message with a tone, and optional links.
  NOTICE
  /// An info card: numbered steps, each a short title and text.
  STEPS
  /// An info card: a titled list of items to have ready.
  CHECKLIST
  /// Header banner (#816): one large uploaded image with title and button.
  HERO
  /// A photo with a caption and optional text beside it (#816).
  IMAGE
  /// Several uploaded images in a grid, opening a larger view (#816).
  GALLERY
  /// Markdown subset: headings, bold, italic, links, lists. Never raw HTML (#816).
  FORMATTED_TEXT
  /// A YouTube, Vimeo, or Google Maps embed, stored as provider and id (#816).
  EMBED
  /// Questions and answers as a disclosure list (#816).
  FAQ
  /// Sanitized custom HTML. SYSTEM_ADMIN only, enforced on the server (#816).
  CUSTOM_HTML
  /// Rows of day, time, title, location and description (#816).
  SCHEDULE
  /// Speaker cards: photo, name, role and short bio (#816).
  SPEAKERS
  /// Contact cards with mailto and tel links (#816).
  CONTACT
  /// Counts down to the event start or a chosen date (#816).
  COUNTDOWN
}

/// The look and meaning of a NOTICE card. Rendered with a text label and an
/// icon as well as colour, so the tone never depends on colour alone.
enum EventContentTone {
  INFO
  DEADLINE
  REQUIREMENT
  SUCCESS
  HELP
}

/// Where a section is shown. The four older kinds only ever use PUBLIC_PAGE.
enum EventContentPlacement {
  PUBLIC_PAGE
  REGISTRATION_FORM
  BOTH
}

enum AttendeeClassificationKind {
  CATEGORY
  TRACK
  DEPARTMENT
}

enum ImportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportRecordStatus {
  READY
  WARNING
  ERROR
  CREATED
  UPDATED
  SKIPPED
}

enum RegistrationFormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// What a policy version's acceptance represents. Consent, waiver,
/// acknowledgment, and staff discretionary approval are never interchangeable:
/// each kind carries its own evidence semantics in the slice that consumes
/// these versions, and the kind is fixed for the life of the policy.
enum PolicyKind {
  CONSENT
  WAIVER
  ACKNOWLEDGMENT
  APPROVAL_REQUIRED
}

/// Event-scoped policies belong to exactly one event (eventId set);
/// organization-scoped policies have no eventId and any event may configure
/// them. A policy applies to an event only through its applicability rows.
enum PolicyScope {
  EVENT
  ORGANIZATION
}

/// Versions are never archived: a published version stays PUBLISHED forever so
/// date-based selection and evidence references can always reach it.
enum ConsentPolicyVersionStatus {
  DRAFT
  PUBLISHED
}

enum MfaMethod {
  TOTP
}

enum MfaStatus {
  PENDING
  ACTIVE
}

enum MfaChallengeKind {
  SIGN_IN
}

/// A registrant's own account, which is not staff. Deliberately a separate type
/// from `UserAccountStatus`: the two populations never share a status value, so
/// a query cannot accidentally treat one as the other (ADR 0003).
enum AttendeeAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
}

enum AttendeeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// What a freshly emailed code is being spent on. Only registration edits need
/// one today; the enum exists so adding the next reason is not a migration.
enum AttendeeStepUpPurpose {
  REGISTRATION_EDIT
}

enum AttendeeEditPolicy {
  TIERED
  VERIFY_EVERY_EDIT
}

enum AttendeeIdentityProvider {
  GOOGLE
}

enum MessageTemplateKey {
  REGISTRATION_CONFIRMATION_PAID
  REGISTRATION_CONFIRMATION_UNPAID
  WORKER_CONFIRMATION
  INTERNAL_NEW_REGISTRATION
  WAITLIST_JOINED
  WAITLIST_PROMOTED
  WAITLIST_REMOVED
  REGISTRATION_CANCELLED
  REGISTRATION_REACTIVATED
  REGISTRATION_CONTACT_UPDATED
  REGISTRATION_UPDATED
  PAYMENT_RECEIPT
  REFUND_NOTICE
  BALANCE_REMINDER
  REGISTRATION_TRANSFERRED_NEW_CONTACT
  REGISTRATION_TRANSFERRED_PRIOR_CONTACT
  ATTENDEE_SUBSTITUTED
  SHIRT_SIZE_REQUEST
  REGISTRATION_ACCESS_RECOVERY
  EVENT_ANNOUNCEMENT
  ACCOUNT_ACTIVATION
  ACCOUNT_PASSWORD_RESET
  ATTENDEE_EMAIL_VERIFICATION
  ATTENDEE_PASSWORD_RESET
  ATTENDEE_EDIT_VERIFICATION
  REGISTRATION_CONFIRMATION_ORGANIZATION_BILLED
  CLUB_INVITE
  CLUB_ASSIGNMENTS
  /// A staff-written message sent only by hand to chosen registrations (#850).
  CUSTOM_MESSAGE
  CLUB_TEAM_ROLE_NOTIFICATION
  /// A staff sign-in was locked by repeated wrong passwords or wrong two-step
  /// codes (#456). Covers both the email to the account holder and the short
  /// alert to the configured security alert address.
  ACCOUNT_LOCKOUT
  /// The attendee/club-leader equivalent of ACCOUNT_LOCKOUT.
  ATTENDEE_LOCKOUT
  /// The daily digest of location waitlist changes to Area Coordinators and
  /// event staff (#599). Sent without an event, one email per person.
  LOCATION_WAITLIST_DIGEST
  /// A reminder that a calendar deadline is coming up, sent to club directors
  /// and Area Coordinators after staff approve the batch (#910). No event.
  DEADLINE_REMINDER
  /// A team member of 18 or older needs the Area Coordinator's permission (#809): sent to the location's Area Coordinator, else event staff.
  TEAM_PERMISSION_REQUEST
  /// A club member transfer (#489) was started: sent to the sending club.
  MEMBER_TRANSFER_STARTED
  /// A club member transfer (#489) was resolved (acknowledged, staff-finished,
  /// or staff-overridden): sent to both clubs, and the member or guardian if
  /// an email is on file.
  MEMBER_TRANSFER_COMPLETED
  /// The single-use private link to fill in a club form (#610). The body
  /// carries a sentinel; the link is minted when the email is delivered.
  CLUB_FORM_LINK
  HEALTH_RECORD_LINK
  /// An event admin asked for an event module to be turned on (#741 slice 3):
  /// sent to the conference office address.
  MODULE_REQUEST_SUBMITTED
  /// A system administrator approved or declined that request: sent to the requester.
  MODULE_REQUEST_DECIDED
  /// A finalized invoice sent to its billing contact and club directors by conference staff (#168).
  /// One message per recipient, with the invoice PDF attached. Not an event template: staff write it per send.
  INVOICE_DELIVERY
  /// A lodging waitlist offer (#200), sent to one registration by an explicit staff action. Not an event template.
  LODGING_WAITLIST_OFFER
  /// A room notice (#200), sent to one registration by an explicit staff action. Not an event template.
  LODGING_ASSIGNMENT_NOTICE
  /// A new club application arrived (#817): sent to the configured notification address. Club name, church and director name plus a link, nothing else.
  NEW_CLUB_APPLICATION_SUBMITTED
  /// A new club application was declined (#817): sent to the applicant, with the reason when one was given.
  NEW_CLUB_APPLICATION_DECLINED
  /// A system administrator invited someone to apply for a new club (#817). The body carries a sentinel; the link is minted at delivery.
  NEW_CLUB_APPLICATION_INVITE
  /// A seat in a full Honors Weekend class was offered to a youth on its waitlist (#831): one email to that club's director. Not an event template.
  HONOR_CLASS_WAITLIST_OFFER
  /// A reinstated or promoted registration came back without some Honors Weekend class picks because the class was full or the club's limit was reached (#880): one email to that club's director. Not an event template.
  HONOR_CLASS_PICKS_NOT_RESTORED
  /// A team advanced to the next level of a multi-level event (#945): one email to the team's director, queued and sent only when staff press "Send notices". Not an event template.
  CLUB_TEAM_ADVANCEMENT_NOTICE
  /// A club form was submitted (#1017): one internal email per address on the form's alert list. Names, a time and a staff link; never an answer.
  CLUB_FORM_SUBMITTED
  /// A registrant's cancellation request was received (#170). Status only: never the reason, the amount or the outcome.
  CANCELLATION_REQUEST_RECEIVED
  /// A cancellation request changed status (#170). Status only: never the reason, the amount or a staff note.
  CANCELLATION_REQUEST_UPDATED
  /// The daily summary of youth who joined or left an Honors Weekend instructor's classes (#1098): one email per instructor, names, clubs and ages only. Not an event template.
  HONOR_INSTRUCTOR_CLASS_SUMMARY
  /// One youth joined or left an Honors Weekend instructor's class, sent right away when the instructor chose that (#1098). Not an event template.
  HONOR_INSTRUCTOR_CLASS_CHANGE
  /// The daily summary of youth who joined or left classes an event's honor watch looks at (#1099): one email per watch address, names, clubs and ages only. Not an event template.
  HONOR_WATCH_SUMMARY
}

enum MessageTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageDeliveryMode {
  DISABLED
  LOCAL_CAPTURE
  EXTERNAL_EMAIL
}

enum MessageRecipientKind {
  REGISTRANT
  INTERNAL
  TEST
  ACCOUNT
  /// A church billing contact receiving an invoice (#168).
  BILLING_CONTACT
  /// A club director copied on an invoice (#168).
  CLUB_DIRECTOR
